open PkgI4 (Qbar GQ CF coeff IsNewform)

variable {N : ℕ}

/-- `a₀(f) = 0` for a cusp form. -/
theorem coeff_zero_eq (f : CF N 2) : coeff f 0 = 0 := by
  unfold coeff
  exact CuspFormClass.qExpansion_coeff_zero f one_pos (by simp [CongruenceSubgroup.strictPeriods_Gamma1])

/-- The field generated by the `a_p(f)` (`p` prime) and the values `χ(d)`, `d ∈ (ℤ/N)^×`. -/
def genField (χ : DirichletCharacter ℂ N) (f : CF N 2) : IntermediateField ℚ ℂ :=
  IntermediateField.adjoin ℚ
    (Set.range (fun p : Nat.Primes => coeff f (p : ℕ)) ∪ Set.range (fun d : (ZMod N)ˣ => χ (d : ZMod N)))

theorem chi_mem_genField (χ : DirichletCharacter ℂ N) (f : CF N 2) (n : ℕ) :
    χ (n : ZMod N) ∈ genField χ f := by
  by_cases h : IsUnit (n : ZMod N)
  · exact IntermediateField.subset_adjoin ℚ _ (Or.inr ⟨h.unit, rfl⟩)
  · rw [χ.map_nonunit h]; exact zero_mem _

theorem prime_mem_genField (χ : DirichletCharacter ℂ N) (f : CF N 2) {p : ℕ} (hp : p.Prime) :
    coeff f p ∈ genField χ f :=
  IntermediateField.subset_adjoin ℚ _ (Or.inl ⟨⟨p, hp⟩, rfl⟩)

/-- **The Hecke recurrence pins every coefficient.** For a normalized eigenform (`a₁ = 1`,
`a_m a_n = Σ_{d ∣ (m,n)} χ(d) d a_{mn/d²}`), every `a_n(f)` lies in `ℚ(a_p(f), χ(d))`. -/
theorem coeff_mem_genField (χ : DirichletCharacter ℂ N) (f : CF N 2)
    (hf : PkgI4.IsNormalizedEigenform f χ) (n : ℕ) : coeff f n ∈ genField χ f := by
  obtain ⟨-, h1, hrec⟩ := hf
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  rcases Nat.lt_or_ge n 2 with hn | hn
  · interval_cases n
    · rw [coeff_zero_eq]; exact zero_mem _
    · rw [h1]; exact one_mem _
  obtain ⟨p, hp, hpn⟩ : ∃ p, p.Prime ∧ p ∣ n := ⟨n.minFac, Nat.minFac_prime (by omega), Nat.minFac_dvd n⟩
  obtain ⟨e, m, hpm, rfl⟩ : ∃ e m : ℕ, ¬ p ∣ m ∧ n = p ^ (e + 1) * m := by
    refine ⟨n.factorization p - 1, n / p ^ n.factorization p,
      Nat.not_dvd_ordCompl hp (by omega), ?_⟩
    have hpos : 0 < n.factorization p := hp.factorization_pos_of_dvd (by omega) hpn
    rw [Nat.sub_add_cancel hpos, Nat.ordProj_mul_ordCompl_eq_self]
  have hm0 : 0 < m := Nat.pos_of_ne_zero (by rintro rfl; simp at hn)
  have hpe : 1 < p ^ (e + 1) := Nat.one_lt_pow (by omega) hp.one_lt
  rcases Nat.lt_or_ge 1 m with hm1 | hm1
  · -- coprime factorization
    have hcop : Nat.gcd (p ^ (e + 1)) m = 1 :=
      Nat.Coprime.pow_left _ ((Nat.Prime.coprime_iff_not_dvd hp).2 hpm)
    have key := hrec (p ^ (e + 1)) m (by positivity) hm0
    rw [hcop, Nat.divisors_one, Finset.sum_singleton] at key
    simp only [Nat.cast_one, map_one, one_pow, one_zpow, _root_.one_mul, Nat.div_one] at key
    rw [← key]
    refine mul_mem (ih _ ?_) (ih _ ?_)
    · calc p ^ (e + 1) = p ^ (e + 1) * 1 := (_root_.mul_one _).symm
        _ < p ^ (e + 1) * m := Nat.mul_lt_mul_of_pos_left hm1 (by positivity)
    · calc m = 1 * m := (_root_.one_mul _).symm
        _ < p ^ (e + 1) * m := Nat.mul_lt_mul_of_lt_of_le hpe le_rfl hm0
  · have hm : m = 1 := by omega
    subst hm
    rw [_root_.mul_one] at ih ⊢
    rcases e with _ | e
    · rw [pow_one]; exact prime_mem_genField χ f hp
    · -- a_p a_{p^{e+1}} = a_{p^{e+2}} + χ(p) p a_{p^e}
      have key := hrec p (p ^ (e + 1)) hp.pos (pow_pos hp.pos _)
      have hg : Nat.gcd p (p ^ (e + 1)) = p := Nat.gcd_eq_left (dvd_pow_self p (by omega))
      rw [hg, hp.divisors, Finset.sum_pair (by have := hp.one_lt; omega)] at key
      have e1 : p * p ^ (e + 1) / 1 ^ 2 = p ^ (e + 1 + 1) := by rw [one_pow, Nat.div_one, pow_succ' p (e+1)]
      have e2 : p * p ^ (e + 1) / p ^ 2 = p ^ e := by
        rw [show p * p ^ (e + 1) = p ^ e * p ^ 2 by ring]
        exact Nat.mul_div_cancel _ (pow_pos hp.pos _)
      rw [e1, e2] at key
      simp only [Nat.cast_one, map_one, one_pow, one_zpow, _root_.one_mul] at key
      have : coeff f (p ^ (e + 1 + 1)) =
          coeff f p * coeff f (p ^ (e + 1)) - χ (p : ZMod N) * ((p : ℂ) ^ ((2 : ℤ) - 1)) * coeff f (p ^ e) := by
        rw [key]; ring
      rw [this]
      have hlt1 : p ^ (e + 1) < p ^ (e + 1 + 1) := Nat.pow_lt_pow_right hp.one_lt (by omega)
      have hlt2 : p ^ e < p ^ (e + 1 + 1) := Nat.pow_lt_pow_right hp.one_lt (by omega)
      refine sub_mem (mul_mem (prime_mem_genField χ f hp) (ih _ hlt1))
        (mul_mem (mul_mem (chi_mem_genField χ f p) ?_) (ih _ hlt2))
      norm_num


/-! ## Uniqueness from the universal property of `A_f` -/

variable {X : Over SpecQ} [IsIntegral X.left] {J : AbVar ℚ}

/-- Composite of homomorphisms of abelian varieties. -/
def homComp {A B C : AbVar ℚ} (f : AbVar.Hom A B) (g : AbVar.Hom B C) : AbVar.Hom A C :=
  Hom.mk' (f.hom ≫ g.hom)

@[simp] theorem homComp_hom {A B C : AbVar ℚ} (f : AbVar.Hom A B) (g : AbVar.Hom B C) :
    (homComp f g).hom = f.hom ≫ g.hom := rfl

theorem killsIf_comp (χ : DirichletCharacter ℂ N) (f : CF N 2) (tp : Nat.Primes → AbVar.End J)
    (δ : (ZMod N)ˣ → AbVar.End J) {B C : AbVar ℚ} (φ : AbVar.Hom J B) (g : AbVar.Hom B C)
    (h : KillsIf χ f tp δ φ) : KillsIf χ f tp δ (homComp φ g) := by
  intro h0 hh
  have := h h0 hh
  simp only [homComp_hom, Hom.hom_zero] at this ⊢
  rw [← Category.assoc, this, MonObj.one_comp]

/-- **Homomorphisms out of `A_f` are determined by their composite with `π`** (from the uniqueness
in the universal property). -/
theorem hom_ext_of_isAfQuotient {χ : DirichletCharacter ℂ N} {f : CF N 2}
    {tp : Nat.Primes → AbVar.End J} {δ : (ZMod N)ˣ → AbVar.End J} {A : AbVar ℚ} {π : AbVar.Hom J A}
    (hQ : IsAfQuotient χ f tp δ A π) {B : AbVar ℚ} (e e' : AbVar.Hom A B)
    (h : π.hom ≫ e.hom = π.hom ≫ e'.hom) : e = e' := by
  obtain ⟨-, hK, hU⟩ := hQ
  obtain ⟨ψ, -, hψ⟩ := hU B (homComp π e) (killsIf_comp χ f tp δ π e hK)
  exact (hψ e rfl).trans (hψ e' (by rw [homComp_hom, h])).symm

/-- **`A_f` is unique up to unique isomorphism compatible with the projection.** -/
theorem isAfQuotient_unique {χ : DirichletCharacter ℂ N} {f : CF N 2}
    {tp : Nat.Primes → AbVar.End J} {δ : (ZMod N)ˣ → AbVar.End J} {A A' : AbVar ℚ}
    {π : AbVar.Hom J A} {π' : AbVar.Hom J A'}
    (hQ : IsAfQuotient χ f tp δ A π) (hQ' : IsAfQuotient χ f tp δ A' π') :
    ∃ e : A.X ≅ A'.X, IsMonHom e.hom ∧ π.hom ≫ e.hom = π'.hom ∧
      ∀ φ : AbVar.Hom A A', π.hom ≫ φ.hom = π'.hom → φ.hom = e.hom := by
  obtain ⟨ψ, hψ, uψ⟩ := hQ.2.2 A' π' hQ'.2.1
  obtain ⟨ψ', hψ', -⟩ := hQ'.2.2 A π hQ.2.1
  have h1 : homComp ψ ψ' = (1 : AbVar.End A) :=
    hom_ext_of_isAfQuotient hQ _ _ (by
      change π.hom ≫ ψ.hom ≫ ψ'.hom = π.hom ≫ 𝟙 _
      rw [← Category.assoc, hψ, hψ', Category.comp_id])
  have h2 : homComp ψ' ψ = (1 : AbVar.End A') :=
    hom_ext_of_isAfQuotient hQ' _ _ (by
      change π'.hom ≫ ψ'.hom ≫ ψ.hom = π'.hom ≫ 𝟙 _
      rw [← Category.assoc, hψ', hψ, Category.comp_id])
  refine ⟨⟨ψ.hom, ψ'.hom, congrArg Hom.hom h1, congrArg Hom.hom h2⟩, inferInstance, hψ,
    fun φ hφ => congrArg Hom.hom (uψ φ hφ)⟩

/-- **The induced endomorphisms correspond under the isomorphism**: if `π ≫ e = t ≫ π` and
`π' ≫ e' = t ≫ π'`, then `e ≫ ι = ι ≫ e'` for the isomorphism `ι` of `isAfQuotient_unique`. -/
theorem induced_comm {χ : DirichletCharacter ℂ N} {f : CF N 2}
    {tp : Nat.Primes → AbVar.End J} {δ : (ZMod N)ˣ → AbVar.End J} {A A' : AbVar ℚ}
    {π : AbVar.Hom J A} {π' : AbVar.Hom J A'} (hQ : IsAfQuotient χ f tp δ A π)
    (io : AbVar.Hom A A') (hio : π.hom ≫ io.hom = π'.hom) (t : AbVar.End J) (e : AbVar.End A)
    (e' : AbVar.End A') (he : t.hom ≫ π.hom = π.hom ≫ e.hom) (he' : t.hom ≫ π'.hom = π'.hom ≫ e'.hom) :
    e.hom ≫ io.hom = io.hom ≫ e'.hom := by
  have := hom_ext_of_isAfQuotient hQ (homComp e io) (homComp io e') (by
    simp only [homComp_hom]
    rw [← Category.assoc, ← he, Category.assoc, hio, he', ← Category.assoc, hio])
  exact congrArg Hom.hom this

/-- **`θ` is pinned (gap 3).** Two actions `θ, θ'` of `K_f` on `A_f` with `IsAfAction` agree: they agree on
the `a_p(f)` and on the `χ(d)` (the induced endomorphisms are unique by the universal property), and
these generate `K_f` by the Hecke recurrence (`coeff_mem_genField`). -/
theorem theta_unique {χ : DirichletCharacter ℂ N} {f : CF N 2} (hf : IsNewform f χ)
    {tp : Nat.Primes → AbVar.End J} {δ : (ZMod N)ˣ → AbVar.End J} {A : AbVar ℚ}
    {π : AbVar.Hom J A} (hQ : IsAfQuotient χ f tp δ A π) {θ θ' : coeffField f →+* A.End0}
    (hθ : IsAfAction χ f tp δ π θ) (hθ' : IsAfAction χ f tp δ π θ') : θ = θ' := by
  let T : IntermediateField ℚ ℂ :=
    { carrier := {z | ∃ h : z ∈ coeffField f, θ ⟨z, h⟩ = θ' ⟨z, h⟩}
      mul_mem' := by
        rintro a b ⟨ha, ea⟩ ⟨hb, eb⟩
        refine ⟨mul_mem ha hb, ?_⟩
        have : (⟨a * b, mul_mem ha hb⟩ : coeffField f) = ⟨a, ha⟩ * ⟨b, hb⟩ := rfl
        rw [this, map_mul, map_mul, ea, eb]
      add_mem' := by
        rintro a b ⟨ha, ea⟩ ⟨hb, eb⟩
        refine ⟨add_mem ha hb, ?_⟩
        have : (⟨a + b, add_mem ha hb⟩ : coeffField f) = ⟨a, ha⟩ + ⟨b, hb⟩ := rfl
        rw [this, map_add, map_add, ea, eb]
      algebraMap_mem' := by
        intro q
        refine ⟨IntermediateField.algebraMap_mem _ q, ?_⟩
        have : (⟨algebraMap ℚ ℂ q, IntermediateField.algebraMap_mem _ q⟩ : coeffField f) =
            algebraMap ℚ (coeffField f) q := rfl
        rw [this]
        exact congrArg (fun g : ℚ →+* A.End0 => g q)
          (RingHom.ext_rat (θ.comp (algebraMap ℚ (coeffField f))) (θ'.comp (algebraMap ℚ (coeffField f))))
      inv_mem' := by
        rintro a ⟨ha, ea⟩
        refine ⟨inv_mem ha, ?_⟩
        by_cases h0 : a = 0
        · subst h0
          have : (⟨(0 : ℂ)⁻¹, inv_mem ha⟩ : coeffField f) = 0 := Subtype.ext (by simp)
          rw [this, map_zero, map_zero]
        · have hx : (⟨a, ha⟩ : coeffField f) ≠ 0 := fun h => h0 (congrArg Subtype.val h)
          have : (⟨a⁻¹, inv_mem ha⟩ : coeffField f) = (⟨a, ha⟩ : coeffField f)⁻¹ := rfl
          rw [this]
          have i1 : θ (⟨a, ha⟩ : coeffField f)⁻¹ * θ ⟨a, ha⟩ = 1 := by
            rw [← map_mul, inv_mul_cancel₀ hx, map_one]
          have i2 : θ' ⟨a, ha⟩ * θ' (⟨a, ha⟩ : coeffField f)⁻¹ = 1 := by
            rw [← map_mul, mul_inv_cancel₀ hx, map_one]
          calc θ (⟨a, ha⟩ : coeffField f)⁻¹ = θ (⟨a, ha⟩ : coeffField f)⁻¹ * (θ' ⟨a, ha⟩ * θ' (⟨a, ha⟩ : coeffField f)⁻¹) := by rw [i2, _root_.mul_one]
            _ = (θ (⟨a, ha⟩ : coeffField f)⁻¹ * θ ⟨a, ha⟩) * θ' (⟨a, ha⟩ : coeffField f)⁻¹ := by rw [ea, _root_.mul_assoc]
            _ = θ' (⟨a, ha⟩ : coeffField f)⁻¹ := by rw [i1, _root_.one_mul] }
  have hgen : genField χ f ≤ T := by
    rw [genField, IntermediateField.adjoin_le_iff]
    rintro z (⟨p, rfl⟩ | ⟨d, rfl⟩)
    · refine ⟨coeff_mem_coeffField f p, ?_⟩
      obtain ⟨e, he, hθe⟩ := hθ.1 p
      obtain ⟨e', he', hθe'⟩ := hθ'.1 p
      have : e = e' := hom_ext_of_isAfQuotient hQ e e' (he.symm.trans he')
      rw [hθe, hθe', this]
    · obtain ⟨c, e, hc, he, hθe⟩ := hθ.2 d
      obtain ⟨c', e', hc', he', hθe'⟩ := hθ'.2 d
      have hcc : c = c' := Subtype.ext (hc.trans hc'.symm)
      subst hcc
      have : e = e' := hom_ext_of_isAfQuotient hQ e e' (he.symm.trans he')
      have hm : χ (d : ZMod N) ∈ coeffField f := hc ▸ c.2
      refine ⟨hm, ?_⟩
      have hcz : (⟨χ (d : ZMod N), hm⟩ : coeffField f) = c := Subtype.ext hc.symm
      change θ ⟨χ (d : ZMod N), hm⟩ = θ' ⟨χ (d : ZMod N), hm⟩
      rw [hcz, hθe, hθe', this]
  have hle : coeffField f ≤ T := by
    rw [coeffField, IntermediateField.adjoin_le_iff]
    rintro z ⟨n, rfl⟩
    exact hgen (coeff_mem_genField χ f hf.1 n)
  ext x
  obtain ⟨h, e⟩ := hle x.2
  exact congrArg (fun g => g) e

/-! ## Matrices `γ ∈ Γ₀(N)` with prescribed lower-right entry -/

open scoped MatrixGroups

theorem exists_gamma (N : ℕ) (d : ℤ) (h : IsCoprime d (N : ℤ)) :
    ∃ g : SL(2, ℤ), (N : ℤ) ∣ g 1 0 ∧ ((g 1 1 : ℤ) : ZMod N) = (d : ZMod N) := by
  obtain ⟨a, b, hab⟩ := h
  refine ⟨⟨!![a, -b; (N : ℤ), d], ?_⟩, ?_, ?_⟩
  · rw [Matrix.det_fin_two_of]; linear_combination hab
  · simp
  · simp

theorem exists_gamma_prime (N : ℕ) (p : Nat.Primes) (hp : ¬ (p : ℕ) ∣ N) :
    ∃ g : SL(2, ℤ), (N : ℤ) ∣ g 1 0 ∧ ((g 1 1 : ℤ) : ZMod N) = ((p : ℕ) : ZMod N) := by
  have hc : Nat.Coprime p N := (Nat.Prime.coprime_iff_not_dvd p.2).2 hp
  obtain ⟨g, h1, h2⟩ := exists_gamma N (p : ℕ) (Int.isCoprime_iff_gcd_eq_one.2 (by simpa using hc))
  exact ⟨g, h1, by simpa using h2⟩

theorem exists_gamma_unit (N : ℕ) [NeZero N] (d : (ZMod N)ˣ) :
    ∃ g : SL(2, ℤ), (N : ℤ) ∣ g 1 0 ∧ ((g 1 1 : ℤ) : ZMod N) = (d : ZMod N) := by
  have hc : Nat.Coprime (d : ZMod N).val N := ZMod.val_coe_unit_coprime d
  obtain ⟨g, h1, h2⟩ := exists_gamma N ((d : ZMod N).val : ℤ)
    (Int.isCoprime_iff_gcd_eq_one.2 (by rw [Int.gcd_natCast_natCast]; exact hc))
  exact ⟨g, h1, by rw [h2, Int.cast_natCast, ZMod.natCast_zmod_val]⟩

/-! ## Formal divisors on `ℍ` and the double-coset operators on them -/

/-- Formal `ℤ`-combinations of points of `ℍ`. -/
abbrev Dv : Type := UpperHalfPlane →₀ ℤ

/-- `[τ]`. -/
abbrev pt (τ : UpperHalfPlane) : Dv := Finsupp.single τ 1

/-- The degree. -/
def deg : Dv →ₗ[ℤ] ℤ := Finsupp.linearCombination ℤ (fun _ => 1)

@[simp] theorem deg_pt (τ : UpperHalfPlane) : deg (pt τ) = 1 := by simp [deg]

/-- Degree-`0` divisors. -/
def D0 : Submodule ℤ Dv := LinearMap.ker deg

/-- `[τ] − [τ₀]` span the degree-`0` divisors. -/
theorem D0_le_span (τ₀ : UpperHalfPlane) :
    D0 ≤ Submodule.span ℤ (Set.range fun τ => pt τ - pt τ₀) := by
  intro D hD
  have hdeg : deg D = 0 := hD
  have hsum : D = D.sum (fun τ n => n • (pt τ - pt τ₀)) + (deg D) • pt τ₀ := by
    have e1 : D.sum (fun τ n => n • (pt τ - pt τ₀)) = D.sum (fun τ n => n • pt τ) - (D.sum fun _ n => n) • pt τ₀ := by
      simp only [Finsupp.sum, smul_sub, Finset.sum_sub_distrib, Finset.sum_smul]
    have e2 : deg D = D.sum fun _ n => n := by simp [deg, Finsupp.linearCombination_apply]
    rw [e1, e2, sub_add_cancel]
    conv_lhs => rw [← Finsupp.sum_single D]
    simp [Finsupp.smul_single]
  rw [hsum, hdeg, zero_smul, add_zero]
  exact Submodule.sum_mem _ fun τ _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨τ, rfl⟩)

theorem eqOn_D0 {M : Type*} [AddCommGroup M] (τ₀ : UpperHalfPlane) (u v : Dv →ₗ[ℤ] M)
    (h : ∀ τ, u (pt τ - pt τ₀) = v (pt τ - pt τ₀)) : ∀ D ∈ D0, u D = v D := by
  intro D hD
  exact LinearMap.eqOn_span' (s := Set.range fun τ => pt τ - pt τ₀) (by rintro _ ⟨τ, rfl⟩; exact h τ)
    (D0_le_span τ₀ hD)

/-- `T̃_p[τ] = Σ_{j<p} [(τ+j)/p] + [g(pτ)]` (the last term only for `p ∤ N`). -/
def tDiv (N : ℕ) (p : ℕ) (g : SL(2, ℤ)) (τ : UpperHalfPlane) : Dv :=
  (∑ j : Fin p, pt (shiftDiv p j τ)) + if p ∣ N then 0 else pt (g • mulNat p τ)

/-- `⟨d⟩~[τ] = [gτ]`. -/
def dDiv (g : SL(2, ℤ)) (τ : UpperHalfPlane) : Dv := pt (g • τ)

/-- The lifted operators on formal divisors. -/
def tOp (N p : ℕ) (g : SL(2, ℤ)) : Module.End ℤ Dv := Finsupp.linearCombination ℤ (tDiv N p g)

def dOp (g : SL(2, ℤ)) : Module.End ℤ Dv := Finsupp.linearCombination ℤ (dDiv g)

theorem deg_tDiv (N p : ℕ) (g : SL(2, ℤ)) (τ : UpperHalfPlane) :
    deg (tDiv N p g τ) = (p + if p ∣ N then 0 else 1 : ℤ) := by
  unfold tDiv; split_ifs <;> simp [map_sum]

theorem tOp_D0 (N p : ℕ) (g : SL(2, ℤ)) {D : Dv} (hD : D ∈ D0) : tOp N p g D ∈ D0 := by
  have : deg ∘ₗ tOp N p g = (p + if p ∣ N then 0 else 1 : ℤ) • deg := by
    apply Finsupp.lhom_ext; intro τ n
    simp only [LinearMap.comp_apply, LinearMap.smul_apply, tOp, Finsupp.linearCombination_single,
      map_zsmul, deg_tDiv]
    simp [deg]; ring
  change deg (tOp N p g D) = 0
  have h2 := LinearMap.congr_fun this D
  simp only [LinearMap.comp_apply, LinearMap.smul_apply] at h2
  rw [h2, show deg D = 0 from hD, smul_zero]

theorem dOp_D0 (g : SL(2, ℤ)) {D : Dv} (hD : D ∈ D0) : dOp g D ∈ D0 := by
  have : deg ∘ₗ dOp g = deg := by
    apply Finsupp.lhom_ext; intro τ n
    simp [dOp, dDiv, deg]
  change deg (dOp g D) = 0
  rw [← LinearMap.comp_apply, this]; exact hD

/-- Chosen matrices: `gT p` with `N ∣ c`, `d ≡ p` (`p ∤ N`), `gD d` with `N ∣ c`, `d' ≡ d`. -/
def gT (N : ℕ) (p : Nat.Primes) : SL(2, ℤ) :=
  if h : (p : ℕ) ∣ N then 1 else (exists_gamma_prime N p h).choose

def gD (N : ℕ) [NeZero N] (d : (ZMod N)ˣ) : SL(2, ℤ) := (exists_gamma_unit N d).choose

/-- The free algebra acting on formal divisors through `T̃_p`, `⟨d⟩~`. -/
def heckeD (N : ℕ) [NeZero N] : HeckeFree N →ₐ[ℤ] Module.End ℤ Dv :=
  FreeAlgebra.lift ℤ (Sum.elim (fun p => tOp N p (gT N p)) (fun d => dOp (gD N d)))

theorem heckeD_D0 (N : ℕ) [NeZero N] (h : HeckeFree N) {D : Dv} (hD : D ∈ D0) : heckeD N h D ∈ D0 := by
  induction h using FreeAlgebra.induction generalizing D with
  | grade0 r =>
    rw [AlgHom.commutes, Module.algebraMap_end_apply]; exact Submodule.smul_mem _ _ hD
  | grade1 x =>
    rcases x with p | d
    · simp only [heckeD, FreeAlgebra.lift_ι_apply, Sum.elim_inl]; exact tOp_D0 _ _ _ hD
    · simp only [heckeD, FreeAlgebra.lift_ι_apply, Sum.elim_inr]; exact dOp_D0 _ hD
  | mul a b ha hb => rw [map_mul, Module.End.mul_apply]; exact ha (hb hD)
  | add a b ha hb => rw [map_add, LinearMap.add_apply]; exact add_mem (ha hD) (hb hD)

/-! ## The class map `Div(ℍ) → J(ℂ)` through the points `x_τ`, and its Hecke equivariance -/

/-- `Σ n_τ [τ] ↦ Σ n_τ aj(x_τ)` (written additively in `J(ℂ)`). -/
def cls (aj : X ⟶ J.X) (x : UpperHalfPlane → CPt X) : Dv →ₗ[ℤ] Additive (J.Pt ℂ) :=
  Finsupp.linearCombination ℤ (fun τ => Additive.ofMul (ajC aj (x τ)))

/-- An endomorphism on `J(ℂ)`, additively. -/
def endA (t : AbVar.End J) : Additive (J.Pt ℂ) →ₗ[ℤ] Additive (J.Pt ℂ) :=
  (MonoidHom.toAdditive (ptMap (L := ℂ) t)).toIntLinearMap

theorem endA_apply (t : AbVar.End J) (y : J.Pt ℂ) :
    endA t (Additive.ofMul y) = Additive.ofMul (endC t y) := rfl

theorem cls_pt_sub (aj : X ⟶ J.X) (x : UpperHalfPlane → CPt X) (τ τ' : UpperHalfPlane) :
    cls aj x (pt τ - pt τ') = Additive.ofMul (ajC aj (x τ) / ajC aj (x τ')) := by
  simp [cls, ofMul_div]

theorem cls_pt (aj : X ⟶ J.X) (x : UpperHalfPlane → CPt X) (τ : UpperHalfPlane) :
    cls aj x (pt τ) = Additive.ofMul (ajC aj (x τ)) := by
  simp [cls]

theorem endA_mul (t s : AbVar.End J) (y : Additive (J.Pt ℂ)) :
    endA (t * s) y = endA t (endA s y) := rfl

theorem endA_intCast (n : ℤ) (y : Additive (J.Pt ℂ)) : endA (n : AbVar.End J) y = n • y := by
  change Additive.ofMul (Additive.toMul y ≫ (n : AbVar.End J).hom) = n • y
  have : (n : AbVar.End J).hom = (𝟙 J.X) ^ n := by
    rw [show (n : AbVar.End J) = n • (1 : AbVar.End J) by simp]
    rfl
  rw [this, GrpObj.comp_zpow, Category.comp_id]
  rfl

theorem endA_add (t s : AbVar.End J) (y : Additive (J.Pt ℂ)) :
    endA (t + s) y = endA t y + endA s y := by
  change Additive.ofMul (Additive.toMul y ≫ (t + s).hom) = _
  rw [Hom.hom_add, MonObj.comp_mul]; rfl

variable (N) in
/-- **Every `τ ∈ ℍ` has a point `x_τ`** (see `X1TauPoints`). -/
def TauPts (jX tX : X.left.functionField) : Prop := ∀ τ : UpperHalfPlane, ∃ x : CPt X, AtTau N jX tX x τ

/-- **Claim A.** The class map intertwines the lifted operators on degree-0 divisors with the
endomorphisms `heckeJ h` of `J`, for any choice of points `x_τ`. -/
theorem cls_heckeD [NeZero N] {jX tX : X.left.functionField} (aj : X ⟶ J.X)
    (x : UpperHalfPlane → CPt X) (hx : ∀ τ, AtTau N jX tX (x τ) τ)
    {tp : Nat.Primes → AbVar.End J} {δ : (ZMod N)ˣ → AbVar.End J}
    (htp : ∀ p : Nat.Primes, IsHeckeT N jX tX aj (p : ℕ) (tp p))
    (hδ : ∀ d : (ZMod N)ˣ, IsDiamond N jX tX aj d (δ d)) (h : HeckeFree N) :
    ∀ D ∈ D0, cls aj x (heckeD N h D) = endA (heckeJ tp δ h) (cls aj x D) := by
  have τ₀ : UpperHalfPlane := UpperHalfPlane.I
  induction h using FreeAlgebra.induction with
  | grade0 r =>
    intro D _
    rw [AlgHom.commutes, AlgHom.commutes, Module.algebraMap_end_apply, map_zsmul]
    rw [show algebraMap ℤ (AbVar.End J) r = (r : AbVar.End J) from rfl, endA_intCast]
  | grade1 g =>
    rcases g with p | d
    · simp only [heckeD, heckeJ, FreeAlgebra.lift_ι_apply, Sum.elim_inl]
      refine eqOn_D0 τ₀ (cls aj x ∘ₗ tOp N p (gT N p)) (endA (tp p) ∘ₗ cls aj x) ?_
      intro τ
      simp only [LinearMap.comp_apply, cls_pt_sub, endA_apply]
      obtain ⟨hT1, hT2⟩ := htp p τ τ₀ (x τ) (x τ₀) (fun i => x (shiftDiv p i τ))
        (fun i => x (shiftDiv p i τ₀)) (hx τ) (hx τ₀) (fun i => hx _) (fun i => hx _)
      simp only [map_sub, tOp, Finsupp.linearCombination_single, one_smul, tDiv, map_add, map_sum,
        cls_pt]
      by_cases hpN : (p : ℕ) ∣ N
      · simp only [hpN, ite_true, map_zero, add_zero]
        rw [hT1 hpN, ← Finset.sum_sub_distrib]
        simp only [← ofMul_div, ← ofMul_prod]
      · simp only [hpN, ite_false, cls_pt]
        have hg : (N : ℤ) ∣ (gT N p) 1 0 ∧ (((gT N p) 1 1 : ℤ) : ZMod N) = ((p : ℕ) : ZMod N) := by
          simp only [gT, hpN, dite_false]; exact (exists_gamma_prime N p hpN).choose_spec
        rw [hT2 hpN (gT N p) hg.1 hg.2 _ _ (hx _) (hx _)]
        simp only [ofMul_mul, ofMul_div, ofMul_prod, Finset.sum_sub_distrib]
        abel
    · simp only [heckeD, heckeJ, FreeAlgebra.lift_ι_apply, Sum.elim_inr]
      refine eqOn_D0 τ₀ (cls aj x ∘ₗ dOp (gD N d)) (endA (δ d) ∘ₗ cls aj x) ?_
      intro τ
      simp only [LinearMap.comp_apply, cls_pt_sub, endA_apply]
      simp only [map_sub, dOp, Finsupp.linearCombination_single, one_smul, dDiv, cls_pt]
      have hg := (exists_gamma_unit N d).choose_spec
      rw [hδ d (gD N d) hg.1 hg.2 τ τ₀ (x τ) (x τ₀) _ _ (hx τ) (hx τ₀) (hx _) (hx _), ofMul_div]
  | mul a b ha hb =>
    intro D hD
    rw [map_mul, Module.End.mul_apply, ha _ (heckeD_D0 N b hD), hb D hD, map_mul, endA_mul]
  | add a b ha hb =>
    intro D hD
    rw [map_add, LinearMap.add_apply, map_add, ha D hD, hb D hD, map_add, endA_add]

/-! ## The Eichler integral side -/

/-- **`F` is a holomorphic primitive of `f` on `ℍ`** (an Eichler integral of `f`, up to the factor
`2πi` and an additive constant): `d/dτ F(τ) = f(τ)`. -/
def IsPrimitive (f : CF N 2) (F : UpperHalfPlane → ℂ) : Prop :=
  ∀ τ : UpperHalfPlane, HasDerivAt (fun z : ℂ => F (UpperHalfPlane.ofComplex z)) (f τ) (τ : ℂ)

/-- `Σ n_τ [τ] ↦ Σ n_τ F(τ)`. -/
def psi (F : UpperHalfPlane → ℂ) : Dv →ₗ[ℤ] ℂ := Finsupp.linearCombination ℤ F

theorem psi_pt (F : UpperHalfPlane → ℂ) (τ : UpperHalfPlane) : psi F (pt τ) = F τ := by
  simp [psi]

/-- **GLUE (Eichler integral, existence).** Every weight-2 cusp form on `Γ₁(N)` has a holomorphic primitive
on `ℍ` (Diamond–Shurman §6.1–6.3 integrate `f(τ) dτ` along paths in `ℍ`; `ℍ` is simply connected). Provable
in Lean: e.g. `G(q) = ∫ (cuspFunction f)(q)/q` on the unit disc (Mathlib's primitives on discs) and
`F(τ) = G(e^{2πiτ})/(2πi)`. -/
def EichlerPrimitive : Prop := ∀ (N : ℕ) (f : CF N 2), ∃ F, IsPrimitive f F

/-- **GLUE (Hecke and diamond operators on the Eichler integral).** For a normalized eigenform `f` of weight
2 with nebentypus `χ` and any primitive `F` of `f`, differences of `F` transform under DS's double cosets:
`Σ_{j<p} F((τ+j)/p) + [p ∤ N] F(γ(pτ))` and `a_p F(τ)` differ by a constant (`γ ∈ Γ₀(N)`, lower-right
entry `≡ p`), and `F(γτ) − χ(d)F(τ)` is constant (`γ ∈ Γ₀(N)`, lower-right entry `≡ d`). Proof sketch
(glue, provable in Lean): differentiate; the derivative of the left side is `T_p f` in DS's weight-2
normalization (Prop. 5.2.1: `(1/p)Σ f((τ+j)/p) + p (f|γ)(pτ)`), which is `a_p f` by the coefficient
relations of `IsNormalizedEigenform` and the `q`-expansion; `(f|₂γ) = χ(d) f` is `HasNebentypus`;
`ℍ` is connected. -/
def EichlerHecke : Prop :=
  ∀ (N : ℕ) (χ : DirichletCharacter ℂ N) (f : CF N 2), 2 ≤ N → PkgI4.IsNormalizedEigenform f χ →
    ∀ F, IsPrimitive f F →
      (∀ (p : Nat.Primes) (g : SL(2, ℤ)),
        ((p : ℕ) ∣ N ∨ ((N : ℤ) ∣ g 1 0 ∧ ((g 1 1 : ℤ) : ZMod N) = ((p : ℕ) : ZMod N))) →
        ∀ τ τ' : UpperHalfPlane,
          (∑ j : Fin p, (F (shiftDiv p j τ) - F (shiftDiv p j τ'))) +
            (if (p : ℕ) ∣ N then 0 else F (g • mulNat p τ) - F (g • mulNat p τ')) =
          coeff f p * (F τ - F τ')) ∧
      (∀ (d : (ZMod N)ˣ) (g : SL(2, ℤ)), (N : ℤ) ∣ g 1 0 → ((g 1 1 : ℤ) : ZMod N) = (d : ZMod N) →
        ∀ τ τ' : UpperHalfPlane, F (g • τ) - F (g • τ') = χ (d : ZMod N) * (F τ - F τ'))

/-- **Claim B.** On degree-0 divisors, `Ψ ∘ h̃ = evF(h) · Ψ`. -/
theorem psi_heckeD [NeZero N] (hN : 2 ≤ N) (hH : EichlerHecke) {χ : DirichletCharacter ℂ N}
    {f : CF N 2} (hf : PkgI4.IsNormalizedEigenform f χ) {F : UpperHalfPlane → ℂ} (hF : IsPrimitive f F)
    (h : HeckeFree N) : ∀ D ∈ D0, psi F (heckeD N h D) = evF χ f h * psi F D := by
  have τ₀ : UpperHalfPlane := UpperHalfPlane.I
  obtain ⟨hT, hDm⟩ := hH N χ f hN hf F hF
  induction h using FreeAlgebra.induction with
  | grade0 r =>
    intro D _
    rw [AlgHom.commutes, AlgHom.commutes, Module.algebraMap_end_apply, map_zsmul, zsmul_eq_mul]
    rfl
  | grade1 g =>
    rcases g with p | d
    · simp only [heckeD, evF, FreeAlgebra.lift_ι_apply, Sum.elim_inl]
      refine eqOn_D0 τ₀ (psi F ∘ₗ tOp N p (gT N p)) (LinearMap.mulLeft ℤ (coeff f p) ∘ₗ psi F) ?_
      intro τ
      simp only [LinearMap.comp_apply, LinearMap.mulLeft_apply, map_sub, tOp,
        Finsupp.linearCombination_single, one_smul, psi_pt]
      have hg : (p : ℕ) ∣ N ∨ ((N : ℤ) ∣ (gT N p) 1 0 ∧
          (((gT N p) 1 1 : ℤ) : ZMod N) = ((p : ℕ) : ZMod N)) := by
        by_cases hpN : (p : ℕ) ∣ N
        · exact Or.inl hpN
        · right; simp only [gT, hpN, dite_false]; exact (exists_gamma_prime N p hpN).choose_spec
      have key := hT p (gT N p) hg τ τ₀
      rw [← mul_sub, ← key]
      simp only [tDiv, map_add, map_sum, psi_pt, Finset.sum_sub_distrib]
      split_ifs
      · simp [psi_pt]
      · simp [psi_pt]; ring
    · simp only [heckeD, evF, FreeAlgebra.lift_ι_apply, Sum.elim_inr]
      refine eqOn_D0 τ₀ (psi F ∘ₗ dOp (gD N d)) (LinearMap.mulLeft ℤ (χ (d : ZMod N)) ∘ₗ psi F) ?_
      intro τ
      simp only [LinearMap.comp_apply, LinearMap.mulLeft_apply, map_sub, dOp,
        Finsupp.linearCombination_single, one_smul, psi_pt, dDiv]
      have hg := (exists_gamma_unit N d).choose_spec
      rw [← mul_sub]; exact hDm d (gD N d) hg.1 hg.2 τ τ₀
  | mul a b ha hb =>
    intro D hD
    rw [map_mul, Module.End.mul_apply, ha _ (heckeD_D0 N b hD), hb D hD, map_mul, _root_.mul_assoc]
  | add a b ha hb =>
    intro D hD
    rw [map_add, LinearMap.add_apply, map_add, ha D hD, hb D hD, map_add, add_mul]

/-! ## The two analytic leaves and the kernel inclusion (gap 1) -/

/-- **LEAF candidate (the points `x_τ` exist).** For every model `X` of DS's `X₁(N)_alg` with generators
`(j_X, t_X)` (`IsX1Gen`), every `τ ∈ ℍ` has a complex point `x_τ ∈ X(ℂ)` in the sense of `AtTau` (every
rational function whose meromorphic function `P(j, f₁)/Q(j, f₁)` on `ℍ` has a limit `c` at `τ` is regular at
`x_τ` with value `c`). Consequence of Diamond–Shurman §7.7 (2005 printing pp. 290–291): `X₁(N) =
X₁(N)_alg,ℂ` up to isomorphism over `ℂ`, with function field `ℂ(j, f₁)` (via Thm 7.7.1 and Thm 7.2.5),
`x_τ` the image of `Γ₁(N)τ` under that isomorphism. Not printed form: the passage from points of the Riemann
surface to `ℂ`-points of the `ℚ`-scheme and the limit form of regularity are dictionary steps. -/
def X1TauPoints : Prop :=
  ∀ (N : ℕ), 2 ≤ N → ∀ (X : Over SpecQ) [IsIntegral X.left] (jX tX : X.left.functionField),
    IsCurve X → IsX1Gen N X jX tX → ∀ τ : UpperHalfPlane, ∃ x : CPt X, AtTau N jX tX x τ

/-- **LEAF candidate (Abel's theorem for `f(τ)dτ` on `X₁(N)`).** For `X`, `(j_X, t_X)` as in `X1TauPoints`,
a rational point `P₀`, a Jacobian `(J, aj)` (Albanese property), a weight-2 cusp form `f` on `Γ₁(N)` and a
primitive `F` of `f` on `ℍ`, there is a countable set `Λ ⊂ ℂ` (the periods `∫_γ f(τ)dτ`, `γ ∈ H₁(X₁(N), ℤ)`)
such that every degree-0 divisor `Σ n_τ [x_τ]` whose class `Σ n_τ aj(x_τ)` in `J(ℂ)` is trivial has
`Σ n_τ F(τ) ∈ Λ`. Consequence of Abel's theorem, Diamond–Shurman Thm 6.1.2 (2005 printing p. 214): principal
divisors map to `0` in `Jac(X) = Ω¹_hol(X)^∧/H₁(X, ℤ)` under `Σ n_x ∫_{x₀}^{x}`, applied to the holomorphic
differential `f(τ)dτ` (DS §3.3, weight-2 cusp forms are holomorphic differentials on `X₁(N)`), with
`∫_{x_{τ'}}^{x_τ} f(τ)dτ ≡ F(τ) − F(τ')` mod periods, and the algebraic Jacobian theory (a degree-0 divisor
on `X_ℂ` has trivial class in `J(ℂ)` iff it is principal: Milne, *Jacobian varieties*, 1986, Thm 1.1 and
Prop. 6.1, UNVERIFIED numbers; algebraic = meromorphic functions on the compact Riemann surface, DS §7.2).
Not printed form (a composite of printed theorems through the analytic/algebraic dictionary). -/
def AbelJacobiX1 : Prop :=
  ∀ (N : ℕ), 2 ≤ N → ∀ (X : Over SpecQ) [IsIntegral X.left] (jX tX : X.left.functionField),
    IsCurve X → IsX1Gen N X jX tX →
    ∀ (P₀ : RatPt X) (J : AbVar ℚ) (aj : X ⟶ J.X), IsJacobian X P₀ J aj →
    ∀ (f : CF N 2) (F : UpperHalfPlane → ℂ), IsPrimitive f F →
      ∃ Λ : Set ℂ, Λ.Countable ∧
        ∀ (E : UpperHalfPlane →₀ ℤ) (x : UpperHalfPlane → CPt X), (∀ τ, AtTau N jX tX (x τ) τ) →
          (E.sum fun _ n => n) = 0 → (E.prod fun τ n => ajC aj (x τ) ^ n) = 1 →
          (E.sum fun τ n => (n : ℂ) * F τ) ∈ Λ

theorem real_const_of_countable {u : UpperHalfPlane → ℝ} (hu : Continuous u)
    (hc : (Set.range u).Countable) (a b : UpperHalfPlane) : u a = u b := by
  by_contra hne
  rcases lt_or_gt_of_ne hne with hlt | hlt
  · have := hc.mono ((isPreconnected_range hu).Icc_subset ⟨a, rfl⟩ ⟨b, rfl⟩)
    rw [Cardinal.Real.Icc_countable_iff] at this; linarith
  · have := hc.mono ((isPreconnected_range hu).Icc_subset ⟨b, rfl⟩ ⟨a, rfl⟩)
    rw [Cardinal.Real.Icc_countable_iff] at this; linarith

theorem const_of_countable {g : UpperHalfPlane → ℂ} (hg : Continuous g)
    (hc : (Set.range g).Countable) (a b : UpperHalfPlane) : g a = g b := by
  apply Complex.ext
  · exact real_const_of_countable (u := fun τ => (g τ).re) (Complex.continuous_re.comp hg)
      (by rw [show Set.range (fun τ => (g τ).re) = Complex.re '' Set.range g by ext; simp]
          exact hc.image _) a b
  · exact real_const_of_countable (u := fun τ => (g τ).im) (Complex.continuous_im.comp hg)
      (by rw [show Set.range (fun τ => (g τ).im) = Complex.im '' Set.range g by ext; simp]
          exact hc.image _) a b

theorem continuous_of_isPrimitive {f : CF N 2} {F : UpperHalfPlane → ℂ} (hF : IsPrimitive f F) :
    Continuous F := by
  have : F = (fun z : ℂ => F (UpperHalfPlane.ofComplex z)) ∘ (fun τ : UpperHalfPlane => (τ : ℂ)) := by
    funext τ; simp [UpperHalfPlane.ofComplex_apply]
  rw [continuous_iff_continuousAt]
  intro τ
  rw [this]
  exact (hF τ).continuousAt.comp UpperHalfPlane.continuous_coe.continuousAt

theorem not_const_of_isPrimitive {χ : DirichletCharacter ℂ N} {f : CF N 2}
    (hf : PkgI4.IsNormalizedEigenform f χ) {F : UpperHalfPlane → ℂ} (hF : IsPrimitive f F)
    (hc : ∀ a b, F a = F b) : False := by
  have hz : ∀ τ : UpperHalfPlane, f τ = 0 := by
    intro τ
    have h1 : (fun z : ℂ => F (UpperHalfPlane.ofComplex z)) = fun _ => F τ := by
      funext z; exact hc _ _
    have := hF τ
    rw [h1] at this
    exact this.unique (hasDerivAt_const _ _)
  have h0 : (⇑f : UpperHalfPlane → ℂ) = 0 := funext hz
  have : coeff f 1 = 0 := by
    unfold coeff; rw [h0, UpperHalfPlane.qExpansion_zero]; simp
  rw [hf.2.1] at this
  exact one_ne_zero this

theorem cls_eq_ofMul_prod (aj : X ⟶ J.X) (x : UpperHalfPlane → CPt X) (E : Dv) :
    cls aj x E = Additive.ofMul (E.prod fun τ n => ajC aj (x τ) ^ n) := by
  simp only [cls, Finsupp.linearCombination_apply, Finsupp.sum, Finsupp.prod, ofMul_prod, ofMul_zpow]

theorem deg_eq_sum (E : Dv) : deg E = E.sum fun _ n => n := by
  simp [deg, Finsupp.linearCombination_apply]

theorem psi_eq_sum (F : UpperHalfPlane → ℂ) (E : Dv) :
    psi F E = E.sum fun τ n => (n : ℂ) * F τ := by
  simp [psi, Finsupp.linearCombination_apply, zsmul_eq_mul]

theorem endA_zero (y : Additive (J.Pt ℂ)) : endA (0 : AbVar.End J) y = 0 := by
  rw [show (0 : AbVar.End J) = ((0 : ℤ) : AbVar.End J) by simp, endA_intCast, zero_smul]

/-- **Gap 1 closed modulo the two analytic leaves and the Eichler glue: `ker(heckeJ) ⊆ ker(evF)`.** If an
element `h` of the free algebra on `T_p`, `⟨d⟩` acts as `0` on `J₁(N)` (through any `T_p`, `⟨d⟩` with DS's
double-coset action on the classes of the points `x_τ`), then its eigenvalue `evF(h)` on the newform `f` is
`0`. Proof: by Claims A and B, for `D = [τ] − [τ₀]` the divisor `h̃ D` has trivial class, so by Abel's
theorem `evF(h)(F(τ) − F(τ₀)) = Ψ(h̃ D)` lies in a countable set for every `τ`; a primitive `F` of `f ≠ 0`
is continuous and non-constant on the connected `ℍ`, so its values are uncountable. -/
theorem evF_eq_zero_of_heckeJ_eq_zero (hP : X1TauPoints) (hAJ : AbelJacobiX1) (hEP : EichlerPrimitive)
    (hH : EichlerHecke) (hN : 2 ≤ N) {χ : DirichletCharacter ℂ N} {f : CF N 2}
    (hf : PkgI4.IsNormalizedEigenform f χ) {jX tX : X.left.functionField} (hC : IsCurve X)
    (hG : IsX1Gen N X jX tX) {P₀ : RatPt X} {aj : X ⟶ J.X} (hJ : IsJacobian X P₀ J aj)
    {tp : Nat.Primes → AbVar.End J} {δ : (ZMod N)ˣ → AbVar.End J}
    (htp : ∀ p : Nat.Primes, IsHeckeT N jX tX aj (p : ℕ) (tp p))
    (hδ : ∀ d : (ZMod N)ˣ, IsDiamond N jX tX aj d (δ d)) (h : HeckeFree N)
    (h0 : heckeJ tp δ h = 0) : evF χ f h = 0 := by
  have : NeZero N := ⟨by omega⟩
  choose x hx using hP N hN X jX tX hC hG
  obtain ⟨F, hF⟩ := hEP N f
  obtain ⟨Λ, hΛc, hΛ⟩ := hAJ N hN X jX tX hC hG P₀ J aj hJ f F hF
  by_contra hc
  let τ₀ : UpperHalfPlane := UpperHalfPlane.I
  have hmem : ∀ τ, evF χ f h * (F τ - F τ₀) ∈ Λ := by
    intro τ
    have hD : pt τ - pt τ₀ ∈ D0 := by
      change deg (pt τ - pt τ₀) = 0; simp
    have hE0 : heckeD N h (pt τ - pt τ₀) ∈ D0 := heckeD_D0 N h hD
    have hcls : cls aj x (heckeD N h (pt τ - pt τ₀)) = 0 := by
      rw [cls_heckeD aj x hx htp hδ h _ hD, h0, endA_zero]
    have hdeg : deg (heckeD N h (pt τ - pt τ₀)) = 0 := hE0
    rw [cls_eq_ofMul_prod] at hcls
    rw [deg_eq_sum] at hdeg
    have := hΛ _ x hx hdeg (by simpa using congrArg Additive.toMul hcls)
    rw [← psi_eq_sum, psi_heckeD hN hH hf hF h _ hD] at this
    simpa [psi_pt] using this
  have hrange : Set.range F ⊆ (fun z => (evF χ f h)⁻¹ * z + F τ₀) '' Λ := by
    rintro _ ⟨τ, rfl⟩
    refine ⟨_, hmem τ, ?_⟩
    field_simp
    ring
  exact not_const_of_isPrimitive hf hF
