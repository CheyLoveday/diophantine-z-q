import ZInQKernel.HDecomp.QM.Leaves
import Mathlib.Topology.Compactification.OnePoint.ProjectiveLine
set_option linter.all false
noncomputable section
/-! # shimura-glue: Möbius transformations of maps to `P¹` (the glue `MobiusCompose`, proved)

For `π : X → P¹` given by charts (the kernel's `ToP1`), three constructions:
* `ToP1.translate π b` (`t ↦ t + b`, `b ∈ Γ(X, ⊤)`): the chart `V` is replaced by the union of
  `{f + b invertible} ⊆ U` and `{1 + bg invertible} ⊆ V`, with `1/(t + b)` glued from `(f + b)⁻¹` and
  `g (1 + bg)⁻¹` (`TopCat.Sheaf.objSupIsoProdEqLocus`);
* `ToP1.scale π a` (`t ↦ a t`, `a ∈ Γ(X, ⊤)ˣ`);
* `ToP1.swap π` (`t ↦ 1/t`).
Their values on field points are computed (`val_translate`, `val_scale`, `val_swap`), and `GL₂(ℚ)` is
generated by the corresponding matrices and the scalars, which gives `MobiusCompose`. -/

namespace ShimuraGlue.Mob

open CategoryTheory AlgebraicGeometry Limits Opposite TopologicalSpace
open LeafQM.AV

variable {X : Scheme.{0}}

theorem res_res {U V W : X.Opens} (h1 : V ≤ U) (h2 : W ≤ V) (f : Γ(X, U)) :
    X.presheaf.map (homOfLE h2).op (X.presheaf.map (homOfLE h1).op f) =
      X.presheaf.map (homOfLE (h2.trans h1)).op f := by
  simp only [← CommRingCat.comp_apply, ← Functor.map_comp, ← op_comp, homOfLE_comp]

theorem eval_res' {U U' : X.Opens} (h : U' ≤ U) (x : X) (hx : x ∈ U') (f : Γ(X, U)) :
    X.evaluation U' x hx (X.presheaf.map (homOfLE h).op f) = X.evaluation U x (h hx) f := by
  simp only [Scheme.evaluation, CommRingCat.comp_apply]
  rw [TopCat.Presheaf.germ_res_apply]

/-- A global section, restricted to `U`. -/
def onU (b : Γ(X, ⊤)) (U : X.Opens) : Γ(X, U) := X.presheaf.map (homOfLE le_top).op b

theorem onU_res (b : Γ(X, ⊤)) {U V : X.Opens} (h : V ≤ U) :
    X.presheaf.map (homOfLE h).op (onU b U) = onU b V := by
  rw [onU, res_res]; rfl

theorem eval_onU (b : Γ(X, ⊤)) (U : X.Opens) (x : X) (hx : x ∈ U) :
    X.evaluation U x hx (onU b U) = X.evaluation ⊤ x trivial b := eval_res' _ _ _ _

/-- The inverse relation of a `ToP1`, restricted to any `O ≤ U ⊓ V`. -/
theorem inv_res (π : ToP1 X) {O : X.Opens} (hO : O ≤ π.U ⊓ π.V) :
    X.presheaf.map (homOfLE (hO.trans inf_le_left)).op π.f *
      X.presheaf.map (homOfLE (hO.trans inf_le_right)).op π.g = 1 := by
  have := congrArg (X.presheaf.map (homOfLE hO).op) π.inv
  rw [map_mul, map_one, res_res, res_res] at this
  exact this

/-! ## The translation `t ↦ t + b` -/

section Translate

variable (π : ToP1 X) (b : Γ(X, ⊤))

/-- `f + b` on `U`. -/
def fT : Γ(X, π.U) := π.f + onU b π.U

/-- `1 + b g` on `V`. -/
def hT : Γ(X, π.V) := 1 + onU b π.V * π.g

/-- `{f + b invertible} ⊆ U`. -/
def W₁ : X.Opens := X.basicOpen (fT π b)

/-- `{1 + bg invertible} ⊆ V`. -/
def W₂ : X.Opens := X.basicOpen (hT π b)

theorem W₁_le : W₁ π b ≤ π.U := X.basicOpen_le _
theorem W₂_le : W₂ π b ≤ π.V := X.basicOpen_le _

theorem isUnit₁ : IsUnit (X.presheaf.map (homOfLE (W₁_le π b)).op (fT π b)) :=
  X.toRingedSpace.isUnit_res_basicOpen (fT π b)

theorem isUnit₂ : IsUnit (X.presheaf.map (homOfLE (W₂_le π b)).op (hT π b)) :=
  X.toRingedSpace.isUnit_res_basicOpen (hT π b)

/-- `(f + b)⁻¹` on `W₁`. -/
def s₁ : Γ(X, W₁ π b) := ↑(isUnit₁ π b).unit⁻¹

/-- `g (1 + bg)⁻¹` on `W₂`. -/
def s₂ : Γ(X, W₂ π b) :=
  X.presheaf.map (homOfLE (W₂_le π b)).op π.g * ↑(isUnit₂ π b).unit⁻¹

theorem fT_mul_s₁ : X.presheaf.map (homOfLE (W₁_le π b)).op (fT π b) * s₁ π b = 1 :=
  (isUnit₁ π b).mul_val_inv

theorem hT_mul_inv :
    X.presheaf.map (homOfLE (W₂_le π b)).op (hT π b) * ↑(isUnit₂ π b).unit⁻¹ = 1 :=
  (isUnit₂ π b).mul_val_inv

/-- Restricting a relation `a * s = 1`. -/
theorem res_inv_rel {W O : X.Opens} (h : O ≤ W) {a s : Γ(X, W)} (has : a * s = 1) :
    X.presheaf.map (homOfLE h).op a * X.presheaf.map (homOfLE h).op s = 1 := by
  rw [← map_mul, has, map_one]

theorem uniq_inv {R : Type*} [CommRing R] {u s t : R} (hs : u * s = 1) (ht : u * t = 1) : s = t := by
  calc s = s * (u * t) := by rw [ht, mul_one]
    _ = (u * s) * t := by ring
    _ = t := by rw [hs, one_mul]

theorem W₁₂_le : W₁ π b ⊓ W₂ π b ≤ π.U ⊓ π.V :=
  inf_le_inf (W₁_le π b) (W₂_le π b)

/-- The two local expressions of `1/(t + b)` agree on `W₁ ⊓ W₂`. -/
theorem s_agree :
    X.presheaf.map (homOfLE (inf_le_left : W₁ π b ⊓ W₂ π b ≤ W₁ π b)).op (s₁ π b) =
      X.presheaf.map (homOfLE (inf_le_right : W₁ π b ⊓ W₂ π b ≤ W₂ π b)).op (s₂ π b) := by
  set O := W₁ π b ⊓ W₂ π b
  have hOU : O ≤ π.U := (W₁₂_le π b).trans inf_le_left
  have hOV : O ≤ π.V := (W₁₂_le π b).trans inf_le_right
  set F := X.presheaf.map (homOfLE hOU).op π.f
  set G := X.presheaf.map (homOfLE hOV).op π.g
  set B : Γ(X, O) := onU b O
  have hFG : F * G = 1 := inv_res π (W₁₂_le π b)
  -- `(f + b)|O * s₁|O = 1`
  have h1 := res_inv_rel (inf_le_left : O ≤ W₁ π b) (fT_mul_s₁ π b)
  rw [res_res] at h1
  have e1 : X.presheaf.map (homOfLE ((inf_le_left : O ≤ W₁ π b).trans (W₁_le π b))).op (fT π b) =
      F + B := by
    rw [fT, map_add, onU_res]
  rw [e1] at h1
  -- `(1 + bg)|O * (1 + bg)⁻¹|O = 1`
  have h2 := res_inv_rel (inf_le_right : O ≤ W₂ π b) (hT_mul_inv π b)
  rw [res_res] at h2
  have e2 : X.presheaf.map (homOfLE ((inf_le_right : O ≤ W₂ π b).trans (W₂_le π b))).op (hT π b) =
      1 + B * G := by
    rw [hT, map_add, map_one, map_mul, onU_res]
  rw [e2] at h2
  apply uniq_inv h1
  rw [s₂, map_mul, res_res]
  change (F + B) * (G * _) = 1
  calc (F + B) * (G * X.presheaf.map (homOfLE (inf_le_right : O ≤ W₂ π b)).op
          ↑(isUnit₂ π b).unit⁻¹)
      = (F * G + B * G) * X.presheaf.map (homOfLE (inf_le_right : O ≤ W₂ π b)).op
          ↑(isUnit₂ π b).unit⁻¹ := by ring
    _ = 1 := by rw [hFG]; exact h2

/-- `1/(t + b)` on `W₁ ⊔ W₂`, glued. -/
def gT : Γ(X, W₁ π b ⊔ W₂ π b) :=
  (X.sheaf.objSupIsoProdEqLocus (W₁ π b) (W₂ π b)).inv ⟨(s₁ π b, s₂ π b), s_agree π b⟩

theorem gT_res₁ : X.presheaf.map (homOfLE (le_sup_left : W₁ π b ≤ W₁ π b ⊔ W₂ π b)).op (gT π b) =
    s₁ π b :=
  TopCat.Sheaf.objSupIsoProdEqLocus_inv_fst X.sheaf _ _ _

theorem gT_res₂ : X.presheaf.map (homOfLE (le_sup_right : W₂ π b ≤ W₁ π b ⊔ W₂ π b)).op (gT π b) =
    s₂ π b :=
  TopCat.Sheaf.objSupIsoProdEqLocus_inv_snd X.sheaf _ _ _

theorem eval_fT (x : X) (hx : x ∈ π.U) :
    X.evaluation π.U x hx (fT π b) =
      X.evaluation π.U x hx π.f + X.evaluation ⊤ x trivial b := by
  rw [fT, map_add, eval_onU]

theorem eval_hT (x : X) (hx : x ∈ π.V) :
    X.evaluation π.V x hx (hT π b) =
      1 + X.evaluation ⊤ x trivial b * X.evaluation π.V x hx π.g := by
  rw [hT, map_add, map_one, map_mul, eval_onU]

/-- Pointwise: at `x ∈ U ⊓ V`, `f(x) g(x) = 1`. -/
theorem eval_fg (x : X) (hU : x ∈ π.U) (hV : x ∈ π.V) :
    X.evaluation π.U x hU π.f * X.evaluation π.V x hV π.g = 1 := by
  have := congrArg (X.evaluation (π.U ⊓ π.V) x ⟨hU, hV⟩) π.inv
  rw [map_mul, map_one] at this
  have e1 := eval_res' (inf_le_left : π.U ⊓ π.V ≤ π.U) x ⟨hU, hV⟩ π.f
  have e2 := eval_res' (inf_le_right : π.U ⊓ π.V ≤ π.V) x ⟨hU, hV⟩ π.g
  rw [e1, e2] at this
  exact this

theorem mem_W₁_iff (x : X) (hx : x ∈ π.U) :
    x ∈ W₁ π b ↔ X.evaluation π.U x hx π.f + X.evaluation ⊤ x trivial b ≠ 0 := by
  rw [W₁, ← Scheme.evaluation_ne_zero_iff_mem_basicOpen X x hx, eval_fT]

theorem mem_W₂_iff (x : X) (hx : x ∈ π.V) :
    x ∈ W₂ π b ↔ 1 + X.evaluation ⊤ x trivial b * X.evaluation π.V x hx π.g ≠ 0 := by
  rw [W₂, ← Scheme.evaluation_ne_zero_iff_mem_basicOpen X x hx, eval_hT]

theorem g_eval_eq_zero (x : X) (hV : x ∈ π.V) (hU : x ∉ π.U) :
    X.evaluation π.V x hV π.g = 0 := by
  rw [Scheme.evaluation_eq_zero_iff_notMem_basicOpen, π.basicOpen_g]
  exact fun h => hU h.1

/-- `U ⊓ W₂ ≤ W₁`. -/
theorem U_inf_W₂_le : π.U ⊓ W₂ π b ≤ W₁ π b := by
  intro x hx
  have hU : x ∈ π.U := hx.1
  have h2 : x ∈ W₂ π b := hx.2
  show x ∈ W₁ π b
  have hV := W₂_le π b h2
  rw [mem_W₂_iff π b x hV] at h2
  rw [mem_W₁_iff π b x hU]
  intro h0
  apply h2
  have hfg := eval_fg π x hU hV
  linear_combination (X.evaluation π.V x hV π.g) * h0 - hfg

theorem U_inf_V' : π.U ⊓ (W₁ π b ⊔ W₂ π b) = W₁ π b := by
  apply le_antisymm
  · rw [inf_sup_left]
    exact sup_le inf_le_right (U_inf_W₂_le π b)
  · exact le_inf (W₁_le π b) le_sup_left

/-- **The translate `t ↦ t + b` of `π`.** -/
def ToP1.translate : ToP1 X where
  U := π.U
  V := W₁ π b ⊔ W₂ π b
  cover := by
    apply le_antisymm le_top
    intro x _
    by_cases hU : x ∈ π.U
    · exact Or.inl hU
    · have hV : x ∈ π.V := by
        have : x ∈ π.U ⊔ π.V := by rw [π.cover]; trivial
        exact this.resolve_left hU
      refine Or.inr (Or.inr ?_)
      show x ∈ W₂ π b
      rw [mem_W₂_iff π b x hV, g_eval_eq_zero π x hV hU, mul_zero, add_zero]
      exact one_ne_zero
  f := fT π b
  g := gT π b
  inv := by
    -- check on the cover `W₁`, `U ⊓ W₂` of `U ⊓ V' = W₁`
    have key : X.presheaf.map (homOfLE (inf_le_left : π.U ⊓ (W₁ π b ⊔ W₂ π b) ≤ π.U)).op (fT π b) *
        X.presheaf.map (homOfLE (inf_le_right : π.U ⊓ (W₁ π b ⊔ W₂ π b) ≤ W₁ π b ⊔ W₂ π b)).op
          (gT π b) = 1 := by
      have hW : π.U ⊓ (W₁ π b ⊔ W₂ π b) ≤ W₁ π b := (U_inf_V' π b).le
      have hW' : W₁ π b ≤ π.U ⊓ (W₁ π b ⊔ W₂ π b) := (U_inf_V' π b).ge
      apply X.sheaf.eq_of_locally_eq₂ (homOfLE hW') (homOfLE hW') (by rw [sup_idem]; exact hW)
      all_goals
        change X.presheaf.map _ (_ * _) = X.presheaf.map _ 1
        rw [map_mul, map_one, res_res, res_res]
        rw [show X.presheaf.map (homOfLE (le_trans hW' inf_le_right)).op (gT π b) =
            X.presheaf.map (homOfLE (le_sup_left : W₁ π b ≤ W₁ π b ⊔ W₂ π b)).op (gT π b) from rfl,
          gT_res₁]
        exact fT_mul_s₁ π b
    exact key
  basicOpen_f := (U_inf_V' π b).symm
  basicOpen_g := by
    rw [U_inf_V']
    apply le_antisymm
    · intro x hx
      have hxV : x ∈ W₁ π b ⊔ W₂ π b := X.basicOpen_le _ hx
      show x ∈ W₁ π b
      by_cases h1 : x ∈ W₁ π b
      · exact h1
      · have h2 : x ∈ W₂ π b := (Opens.mem_sup.1 hxV).resolve_left h1
        -- on `W₂`, `g' = g (1 + bg)⁻¹`, nonzero only on `U`
        have hev := (Scheme.evaluation_ne_zero_iff_mem_basicOpen X x hxV (gT π b)).2 hx
        rw [← eval_res' (le_sup_right : W₂ π b ≤ W₁ π b ⊔ W₂ π b) x h2, gT_res₂, s₂, map_mul,
          eval_res'] at hev
        have hV := W₂_le π b h2
        by_cases hU : x ∈ π.U
        · exact U_inf_W₂_le π b ⟨hU, h2⟩
        · rw [g_eval_eq_zero π x hV hU, zero_mul] at hev
          exact absurd rfl hev
    · intro x h1
      have h1 : x ∈ W₁ π b := h1
      show x ∈ X.basicOpen (gT π b)
      have hxV : x ∈ W₁ π b ⊔ W₂ π b := Opens.mem_sup.2 (Or.inl h1)
      rw [← Scheme.evaluation_ne_zero_iff_mem_basicOpen X x hxV,
        ← eval_res' (le_sup_left : W₁ π b ≤ W₁ π b ⊔ W₂ π b) x h1, gT_res₁]
      intro h0
      have := congrArg (X.evaluation (W₁ π b) x h1) (fT_mul_s₁ π b)
      rw [map_mul, map_one, h0, mul_zero] at this
      exact zero_ne_one this

end Translate

/-! ## The scaling `t ↦ a t` and the inversion `t ↦ 1/t` -/

section ScaleSwap

variable (π : ToP1 X)

/-- **The scaling `t ↦ a t`** by a unit `a ∈ Γ(X, ⊤)ˣ`. -/
def ToP1.scale (a : Γ(X, ⊤)ˣ) : ToP1 X where
  U := π.U
  V := π.V
  cover := π.cover
  f := onU (a : Γ(X, ⊤)) π.U * π.f
  g := onU (↑a⁻¹ : Γ(X, ⊤)) π.V * π.g
  inv := by
    rw [map_mul, map_mul, onU_res, onU_res]
    calc onU (a : Γ(X, ⊤)) (π.U ⊓ π.V) * X.presheaf.map (homOfLE inf_le_left).op π.f *
          (onU (↑a⁻¹ : Γ(X, ⊤)) (π.U ⊓ π.V) * X.presheaf.map (homOfLE inf_le_right).op π.g)
        = (onU (a : Γ(X, ⊤)) (π.U ⊓ π.V) * onU (↑a⁻¹ : Γ(X, ⊤)) (π.U ⊓ π.V)) *
          (X.presheaf.map (homOfLE inf_le_left).op π.f *
            X.presheaf.map (homOfLE inf_le_right).op π.g) := by ring
      _ = 1 := by
        rw [π.inv, mul_one, onU, onU, ← map_mul, Units.mul_inv, map_one]
  basicOpen_f := by
    have hu : IsUnit (onU (a : Γ(X, ⊤)) π.U) := a.isUnit.map (X.presheaf.map (homOfLE le_top).op).hom
    rw [Scheme.basicOpen_mul, X.basicOpen_of_isUnit hu, π.basicOpen_f,
      inf_eq_right.2 inf_le_left]
  basicOpen_g := by
    have hu : IsUnit (onU (↑a⁻¹ : Γ(X, ⊤)) π.V) :=
      a⁻¹.isUnit.map (X.presheaf.map (homOfLE le_top).op).hom
    rw [Scheme.basicOpen_mul, X.basicOpen_of_isUnit hu, π.basicOpen_g,
      inf_eq_right.2 inf_le_right]

/-- **The inversion `t ↦ 1/t`**: the two charts exchanged. -/
def ToP1.swap : ToP1 X where
  U := π.V
  V := π.U
  cover := by rw [sup_comm]; exact π.cover
  f := π.g
  g := π.f
  inv := by
    have := π.inv
    have e1 : (π.V ⊓ π.U : X.Opens) = π.U ⊓ π.V := inf_comm _ _
    -- transport along `V ⊓ U = U ⊓ V`
    have key : ∀ (O : X.Opens) (hO : O = π.U ⊓ π.V) (h1 : O ≤ π.V) (h2 : O ≤ π.U),
        X.presheaf.map (homOfLE h1).op π.g * X.presheaf.map (homOfLE h2).op π.f = 1 := by
      intro O hO h1 h2; subst hO; rw [mul_comm]; exact this
    exact key _ e1 _ _
  basicOpen_f := by rw [π.basicOpen_g, inf_comm]
  basicOpen_g := by rw [π.basicOpen_f, inf_comm]

end ScaleSwap

/-! ## Values on field points -/

section Values

variable {K : Type} [Field K] (π : ToP1 X) (y : Spec (CommRingCat.of K) ⟶ X)

/-- The value at `y` of a global section. -/
def gval (b : Γ(X, ⊤)) : K :=
  (Scheme.SpecToEquivOfField K X y).2 (X.evaluation ⊤ (Scheme.SpecToEquivOfField K X y).1 trivial b)

theorem val_translate (b : Γ(X, ⊤)) :
    (ToP1.translate π b).val y = OnePoint.map (fun z => z + gval y b) (π.val y) := by
  by_cases h : (Scheme.SpecToEquivOfField K X y).1 ∈ π.U
  · have h' : (Scheme.SpecToEquivOfField K X y).1 ∈ (ToP1.translate π b).U := h
    unfold ToP1.val
    rw [dif_pos h', dif_pos h, OnePoint.map_some]
    congr 1
    change (Scheme.SpecToEquivOfField K X y).2 (X.evaluation π.U _ h (fT π b)) = _
    rw [eval_fT, map_add]; rfl
  · have h' : (Scheme.SpecToEquivOfField K X y).1 ∉ (ToP1.translate π b).U := h
    unfold ToP1.val
    rw [dif_neg h', dif_neg h]; rfl

theorem val_scale (a : Γ(X, ⊤)ˣ) :
    (ToP1.scale π a).val y = OnePoint.map (fun z => gval y (a : Γ(X, ⊤)) * z) (π.val y) := by
  by_cases h : (Scheme.SpecToEquivOfField K X y).1 ∈ π.U
  · have h' : (Scheme.SpecToEquivOfField K X y).1 ∈ (ToP1.scale π a).U := h
    unfold ToP1.val
    rw [dif_pos h', dif_pos h, OnePoint.map_some]
    congr 1
    change (Scheme.SpecToEquivOfField K X y).2
      (X.evaluation π.U _ h (onU (a : Γ(X, ⊤)) π.U * π.f)) = _
    rw [map_mul, map_mul, eval_onU]; rfl
  · have h' : (Scheme.SpecToEquivOfField K X y).1 ∉ (ToP1.scale π a).U := h
    unfold ToP1.val
    rw [dif_neg h', dif_neg h]; rfl

open Classical in
/-- `t ↦ 1/t` on `P¹(K)`. -/
def invP1 : OnePoint K → OnePoint K
  | OnePoint.infty => OnePoint.some 0
  | OnePoint.some z => if z = 0 then OnePoint.infty else OnePoint.some z⁻¹

theorem val_swap : (ToP1.swap π).val y = invP1 (π.val y) := by
  set p := (Scheme.SpecToEquivOfField K X y).1 with hp
  set ι := (Scheme.SpecToEquivOfField K X y).2 with hι
  by_cases hV : p ∈ π.V <;> by_cases hU : p ∈ π.U
  · have hV' : p ∈ (ToP1.swap π).U := hV
    unfold ToP1.val
    rw [dif_pos hV', dif_pos hU]
    have hfg := congrArg ι (eval_fg π p hU hV)
    rw [map_mul, map_one] at hfg
    have hf0 : ι (X.evaluation π.U p hU π.f) ≠ 0 := left_ne_zero_of_mul_eq_one hfg
    simp only [invP1]
    rw [if_neg hf0]
    congr 1
    change ι (X.evaluation π.V p hV π.g) = _
    exact eq_inv_of_mul_eq_one_left (by rw [mul_comm]; exact hfg)
  · have hV' : p ∈ (ToP1.swap π).U := hV
    unfold ToP1.val
    rw [dif_pos hV', dif_neg hU]
    simp only [invP1]
    congr 1
    change ι (X.evaluation π.V p hV π.g) = 0
    rw [g_eval_eq_zero π p hV hU, map_zero]
  · have hV' : p ∉ (ToP1.swap π).U := hV
    unfold ToP1.val
    rw [dif_neg hV', dif_pos hU]
    have hf : X.evaluation π.U p hU π.f = 0 := by
      rw [Scheme.evaluation_eq_zero_iff_notMem_basicOpen, π.basicOpen_f]
      exact fun h => hV h.2
    simp only [invP1]
    rw [hf, map_zero, if_pos rfl]
  · exfalso
    have : p ∈ π.U ⊔ π.V := by rw [π.cover]; trivial
    exact (Opens.mem_sup.1 this).elim hU hV

end Values

/-! ## `GL₂(ℚ)` -/

open scoped Classical

/-- The constants `ℚ → Γ(X, ⊤)` of a `ℚ`-scheme. -/
def cQ (X : Over (Spec (CommRingCat.of ℚ))) : ℚ →+* Γ(X.left, ⊤) :=
  X.hom.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of ℚ)).inv.hom

theorem gval_cQ (X : Over (Spec (CommRingCat.of ℚ))) {K : Type} [Field K] [CharZero K]
    (y : Spec (CommRingCat.of K) ⟶ X.left) (q : ℚ) : gval y (cQ X q) = (q : K) :=
  eq_ratCast (((Scheme.SpecToEquivOfField K X.left y).2.hom.comp
    (X.left.evaluation ⊤ (Scheme.SpecToEquivOfField K X.left y).1 trivial).hom).comp (cQ X)) q

/-- `g` is realized on every `ToP1` of every `ℚ`-scheme. -/
def Good (g : GL (Fin 2) ℚ) : Prop :=
  ∀ (X : Over (Spec (CommRingCat.of ℚ))) (π : ToP1 X.left),
    ∃ π' : ToP1 X.left, ∀ x : fieldPt Qbar ⟶ X,
      π'.val (K := Qbar) x.left =
        Matrix.GeneralLinearGroup.map (algebraMap ℚ Qbar) g •
          π.val (K := Qbar) x.left

end ShimuraGlue.Mob
