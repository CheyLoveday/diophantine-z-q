theorem Sq0 (u : (Fin 2 → Fin 2) → ℂ) :
    Sq (![0, 0], ![0, 0]) u = u ![0, 0] ^ 2 + u ![0, 1] ^ 2 + u ![1, 0] ^ 2 + u ![1, 1] ^ 2 := by
  rw [Sq, univ_fin2_fin2, Finset.sum_insert (by decide), Finset.sum_insert (by decide),
    Finset.sum_insert (by decide), Finset.sum_singleton]
  simp
  ring

