        "docs/degree8-original/research/accepted-h5/height-alternative/level-source-ledger.json",
        "docs/degree8-original/research/accepted-h5/height-cm/source-application-ledger.json",
        "docs/degree8-original/research/accepted-h5/pan-published/source-application-ledger.json"
      ],
      "qualifications": "Current assembled proof governs. Historical level-source ledger pads C to210^4000; current accepted proof uses210^300. Pan AMS text was unavailable: retained published Calegari formulation plus specified author Pan proof. Yuan uses author-attested English translation of published Chinese paper, not an independently checked Chinese-typesetting comparison."
    },
    {
      "id": "generator_index_height",
      "labels": [
        "prop:generator",
        "eq:o8-indexheight"
      ],
      "statement": "The fixed curve K=Q(sqrt2),d=3-sqrt2,D=d² has2E(K)=ZP_* and h(x(nP_*))>=n²-6.",
      "maps": "Same curve isomorphism, fixed point, nonzero indexed chart points and absolute logarithmic height. No new rank assertion.",
      "documents": [
        "docs/theorem-application-audit/applications.json",
        "docs/theorem-application-audit/sources.json",
        "docs/theorem-application-audit/computations/generator-arithmetic.json"
      ],
      "baseline_applications": [
        "A058",
        "A059",
        "A060"
      ],
      "qualifications": "Inherits exact reviewed generator/descent and height calculations; source rewrite does not re-prove them."
    },
    {
      "id": "formal_group",
      "labels": [
        "subsec:o8-common-J-proof"
      ],
      "statement": "Formal logarithm is normalized by z=-x/y, is a homomorphism and isometry on the stated formal subgroup.",
      "maps": "At selected split good primes p>76176, v_p(p)=1 and D is a unit. Parameter f=1/x has valuation2v_p(z).",
      "documents": [
        "degree8-original/arithmetic/anchor/source-application-ledger.json",
        "docs/theorem-application-audit/applications.json",
        "docs/theorem-application-audit/sources.json"
      ],
      "baseline_applications": [
        "A071"
      ],
      "qualifications": "Silverman2009 formal-group construction retained. The new reciprocal-coordinate series identity and tail proof are explicit local lemmas, not new external results."
    },
    {
      "id": "anchor",
      "labels": [
        "subsec:o8-anchor-proof",
        "subsec:o8-anchor-cutoff",
        "eq:o8-anchor-bound"
      ],
      "statement": "The24-squaring anchor has nonzero indices in2*3^(2^23-1)Z and gives |s|>(20H_*)².",
      "maps": "Literal seven-witness semilocal predicate for Z_(2) intersection Z_(3), curve local computations at2 and3, determinant-one coordinate change.",
      "documents": [
        "degree8-original/arithmetic/anchor/source-application-ledger.json",
        "degree8-original/arithmetic/anchor/reference-anchor-check.json"
      ],
      "qualifications": "Koenigsmann2016 Definition4, Observation5, Proposition6 and Silverman2009 locators remain exactly as ledger. Not an altered chain or a new height cutoff."
    },
    {
      "id": "prime_pattern",
      "labels": [
        "subsec:o8-pattern-proof",
        "eq:o8-contacts"
      ],
      "statement": "The original41 raw contact positions admit the ordinary-prime pattern for the same integral targets obtained using one clearing denominator e.",
      "maps": "Nine targets, including e and the eight coefficients of e*x(Q). Fixed W,c,V0; fixed coefficients/cutoff before growing box; same-prime reduction order gcd4.",
      "documents": [
        "degree8-original/arithmetic/sieve/source-ledger.json",
