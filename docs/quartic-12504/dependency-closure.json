    {
      "id": "five_contact_height",
      "labels": [
        "hyp:o8-height",
        "eq:original-cm-bound"
      ],
      "statement": "For rational a outside {0,1,2401,-343/32}, h(a)<=H_*M5(a)^24, with primes<=76176 exceptional and log2 H_*<4783227.",
      "maps": "The same rational height targets, same normalization of odd projective contacts and original stable Faltings heights as the accepted proof; no new coefficient field or exponent.",
      "documents": [
        "degree8-original/arithmetic/current-proof.json",
        "degree8-original/arithmetic/H5_FINAL_ACCEPTANCE.md",
        "degree8-original/arithmetic/SMALLER_ONLY_ACCEPTANCE.md",
        "docs/degree8-original/research/accepted-h5/height-geometry/source-application-ledger.json",
        "docs/degree8-original/research/accepted-h5/yuan-published/source-application-ledger.json",
        "docs/degree8-original/research/accepted-h5/height-cocycle/source-application-ledger.json",
