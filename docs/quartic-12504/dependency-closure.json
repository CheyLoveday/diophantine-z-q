      ],
      "qualifications": "Do not identify the arithmetic parity theorem with the later algebraic twelve-witness quadratic presentation. The restricted-converse dependency retains its existing manuscript proof status."
    },
    {
      "id": "norm_tests",
      "labels": [],
      "statement": "Binary norm descent with constant all-left leaf and the pole condition implies each rational leaf has its assigned positive integer valuation order.",
      "maps": "N_r(a,b)=a²+rb²; exact current grouping by order1,16,64; all-left constant retained. Negative odd raw valuation excluded before positive-R descent.",
