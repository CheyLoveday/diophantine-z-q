import ZInQKernel.Contrib.CloudB3E2Norm.H20Actual
import ZInQKernel.Contrib.OneProof.RC.Moving.MovingCharacter
import ZInQKernel.Contrib.OneProof.RC.GlueSweep.TateKummer

/-!
# The moving character is trivial at `2N`: from the interface to the genuine decomposition groups

Manuscript `diophantine_zq.tex`, tex 2729 ("The character `Ψ_i` is finite, trivial at `2N`"),
tex 3431 ("At `v ∣ 2N`, `Ψ_i` is trivial") and Proposition `ex:arith-moving-character`,
tex 3500–3506 ("characters `ξ : Gal(H_r/K) → ℤ/2^nℤ` that are … trivial on the local
decomposition groups at `2N`"), with the construction of tex 3507–3702.

The moving character is produced by lane RC4's `moving_character_Psi`. It is a character
`Ψ : P r → A_i^×` of the abstract ring-class group `P r` (standing for `Gal(H_r/K)`) of an interface
`MovingSetting`, and it vanishes on the abstract decomposition groups `decomp r j ⊔ decompBar r j`
of the chosen primes `𝔭_j` over `2N`. The norm-cochain chain asks instead for `PsiTrivialAt2N`:
`Ψ_i : G_{K,S₀} → A_i^×` is trivial on the genuine decomposition groups `G_{K_v}`, `v` above `2N`.

This file isolates exactly what connects the two, as one named statement, and proves the transport.

* `MovingRealization M r P` (GLUE, tex 3565–3595 and 3679–3684): the restriction `G_{K,S₀} → P r`
  (the genuine `Gal(H_r/K)` read in the interface's `P r`), sending each decomposition group
  `G_{K_v}`, `v ∈ P`, into `decomp r j ⊔ decompBar r j` for a chosen prime `𝔭_j` over `2N`. Over
  the genuine ring class field this is the statement that `H_r/K` is unramified at `v ∤ r`, so the
  image of `G_{K_v}` is generated by the Frobenius at `v`, and that `v` is `𝔭_j` or `𝔭̄_j`
  (tex 3528–3531: one chosen prime over each prime dividing `2N`, `K` split at `2N`, tex 2720).
* `movingPsiAt M r Ψ R`: the moving character `Ψ_i = Ψ ∘ res` on `G_{K,S₀}`.
* `psiTrivialAt2N_of_realization` (PROVED): if `Ψ` vanishes on the decomposition groups at `2N`
  (the conclusion of `moving_character_Psi`), then `Ψ_i` is trivial on `G_{K_v}` for `v ∈ P`, and
  `PsiTrivialAt2N` holds for `Δ = im Ψ_i`.
* `exists_psiTrivialAt2N` (PROVED from the interface and `MovingRealization`): for every finite
  avoidance set there is a good `r ∉ S` and a moving character `Ψ_i` of `G_{K,S₀}` with values in
  `A_i^×`, of the form `Ψ ∘ res` with `Ψ` taking the value `1 + t` on an inertia element and on
  every active orientation (all of `moving_character_Psi`), with `PsiTrivialAt2N`.
* `exists_psiTrivialAt2N_ecurve`: the same over the genuine Tate image and Kummer layer of `E_ℓ`
  (`movingSettingEcurveS`, from Serre's print `SerreThm3`, `CMjInteger`, `FrobeniusTrace` and the
  interface fields of `MovingDataK`).
* Non-vacuity of `MovingRealization`: the trivial restriction realizes it at the empty set of
  places, and at any set of places once some chosen prime lies over `2N`.

What remains (named, not proved here): `MovingRealization` itself, together with the
ring-class fields of `MovingSetting` / `MovingDataK` that it presupposes. Constructing them from the
genuine Galois groups (ring class fields `H_r`, `Gal(H_r/K) ≅ Pic(ℤ + r𝒪_K)` by global reciprocity,
inertia and decomposition groups as Artin classes) is a separate development.

Kinds: one GLUE (`MovingRealization`), definitions and PROVED.
-/

noncomputable section

namespace ZInQ.Contrib.CloudB3E1Moving

open NumberField IsDedekindDomain
open ZInQ.Manuscript.RC.SelmerComplex
open ZInQ.Manuscript.RC.Moving
open ZInQ.Contrib.CloudB3E2.NormCochain

attribute [instance] MovingSetting.pGrp

variable {T : TateImage} {n : ℕ} (M : MovingSetting T n) (r : ℕ)
variable {K : Type} [Field K] [NumberField K] {S₀ : Set (HeightOneSpectrum (𝓞 K))}

/-- **GLUE: the moving-character data realized on the genuine Galois group** (tex 3565–3595,
3679–3684, with tex 2720 and 3528–3531). A restriction `res : G_{K,S₀} → P r` (the genuine
`Gal(H_r/K)`, written additively in the interface's `P r`) such that, for every place `v ∈ P` (the
places above `2N`), the decomposition group `G_{K_v}` lands in `decomp r j ⊔ decompBar r j` for some
chosen prime `𝔭_j` over `2N`. Over the genuine ring class field `H_r`: `v ∤ r`, so `H_r/K` is
unramified at `v` and the image of `G_{K_v}` is the decomposition group of `v`, generated by its
Frobenius (`decomp_eq`, [Cox §9.A]); `K` is split at `2N` and `v` is one of the two places `𝔭_j`,
`𝔭̄_j` above the chosen prime. Kind: GLUE (definition of the Prop). -/
structure MovingRealization (P : Set (HeightOneSpectrum (𝓞 K))) where
  /-- the restriction `G_{K,S₀} → Gal(H_r/K)` -/
  res : GKS K S₀ →* Multiplicative (M.P r)
  /-- each decomposition group above `2N` lands in a decomposition group of the interface -/
  decomp_at : ∀ v ∈ P, ∃ j, M.over2N j ∧ ∀ σ : Gloc K v,
    Multiplicative.toAdd (res (locMap K S₀ v σ)) ∈ M.decomp r j ⊔ M.decompBar r j

variable {M r} {i : ℕ}

/-- **The moving character on `G_{K,S₀}`**: `Ψ_i = Ψ ∘ res` with values in `A_i^×`, for a character
`Ψ : P r → A_i^×` of the interface (written additively) and a realization. Kind: definition. -/
def movingPsiAt {P : Set (HeightOneSpectrum (𝓞 K))} (Ψ : M.P r →+ Additive (Acoef i)ˣ)
    (R : MovingRealization M r (K := K) (S₀ := S₀) P) : GKS K S₀ →* (Acoef i)ˣ :=
  (AddMonoidHom.toMultiplicativeLeft Ψ).comp R.res

/-- **The transport** (tex 2729, 3431, 3500–3506): if `Ψ` vanishes on the decomposition groups of
the chosen primes over `2N` (the conclusion of `moving_character_Psi`), then `Ψ_i = Ψ ∘ res` is
trivial on the genuine decomposition groups `G_{K_v}`, `v ∈ P`. Kind: PROVED. -/
theorem movingPsiAt_trivial {P : Set (HeightOneSpectrum (𝓞 K))}
    (Ψ : M.P r →+ Additive (Acoef i)ˣ) (R : MovingRealization M r (K := K) (S₀ := S₀) P)
    (hΨ : ∀ j, M.over2N j → ∀ z ∈ M.decomp r j ⊔ M.decompBar r j, Ψ z = 0) :
    ∀ v ∈ P, ∀ σ : Gloc K v, movingPsiAt Ψ R (locMap K S₀ v σ) = 1 := by
  intro v hv σ
  obtain ⟨j, hj, hdec⟩ := R.decomp_at v hv
  change Additive.toMul (Ψ (Multiplicative.toAdd (R.res (locMap K S₀ v σ)))) = 1
  rw [hΨ j hj _ (hdec σ)]
  rfl

/-- **`PsiTrivialAt2N` for the moving character** (tex 2729, 3431, 3500–3506): E2's ELLIOT input,
for `Δ = im Ψ_i` with `π` the corestriction and `ψ` the inclusion. Kind: PROVED (from the
realization and the interface's `2N` clause). -/
theorem psiTrivialAt2N_of_realization [NeZero i] [TopologicalSpace (Acoef i)] [DiscreteTopology (Acoef i)]
    {P : Set (HeightOneSpectrum (𝓞 K))} (Ψ : M.P r →+ Additive (Acoef i)ˣ)
    (R : MovingRealization M r (K := K) (S₀ := S₀) P)
    (hΨ : ∀ j, M.over2N j → ∀ z ∈ M.decomp r j ⊔ M.decompBar r j, Ψ z = 0) :
    PsiTrivialAt2N i (movingPi i (movingPsiAt Ψ R)) (movingPsi i (movingPsiAt Ψ R)) P :=
  (psiTrivialAt2N_moving_iff (i := i) (Ψ := movingPsiAt Ψ R) P).mpr
    (movingPsiAt_trivial Ψ R hΨ)

variable (M) in
/-- **The moving character `Ψ_i` with `PsiTrivialAt2N`, from the interface** (tex 2720–2735,
3500–3506, 3694–3701). Given a realization at every good prime, for every finite avoidance set
`S` there is a good prime `r ∉ S`, `r ≡ 1 (mod 2^B)`, and `Ψ : P r → A_i^×` with the properties of
`moving_character_Psi` (value `1 + t` on an inertia element and on every active orientation,
vanishing at `2N`), such that `Ψ_i = Ψ ∘ res` satisfies E2's `PsiTrivialAt2N` for `Δ = im Ψ_i`.
Kind: PROVED (from the interface `MovingSetting` and the GLUE `MovingRealization`). -/
theorem exists_psiTrivialAt2N [NeZero i] [TopologicalSpace (Acoef i)] [DiscreteTopology (Acoef i)]
    (hn : 2 * i ≤ n) (P : Set (HeightOneSpectrum (𝓞 K)))
    (R : ∀ r, M.good r → MovingRealization M r (K := K) (S₀ := S₀) P) (B : ℕ) (S : Finset ℕ) :
    ∃ (r : ℕ) (hr : M.good r), r ∉ S ∧ r.Prime ∧ (2 : ℤ) ^ B ∣ (r : ℤ) - 1 ∧
      ∃ Ψ : M.P r →+ Additive (Acoef i)ˣ,
        (∃ z ∈ M.inertia r, ((Additive.toMul (Ψ z) : (Acoef i)ˣ) : Acoef i) = 1 + tA i) ∧
        (∀ j, M.act j → ((Additive.toMul (Ψ (M.q r j)) : (Acoef i)ˣ) : Acoef i) = 1 + tA i) ∧
        PsiTrivialAt2N i (movingPi i (movingPsiAt Ψ (R r hr)))
          (movingPsi i (movingPsiAt Ψ (R r hr))) P := by
  obtain ⟨r, hrS, hrp, hgood, hr1, -, -, Ψ, hin, hact, h2N⟩ := moving_character_Psi i hn M B S
  exact ⟨r, hgood, hrS, hrp, hr1, Ψ, hin, hact,
    psiTrivialAt2N_of_realization Ψ (R r hgood) h2N⟩

open ZInQ.Manuscript.RC.PrintsArith ZInQ.Manuscript.RC.TateWiring
open ZInQ.Manuscript.RC.GlueSweep.Tate in
/-- **The same over the genuine Tate image and Kummer layer of `E_ℓ`** (tex 3500–3702): the
interface is lane RC17/RC27's `movingSettingEcurveS` (from `SerreThm3` (PRINT), `CMjInteger`
(GLUE), `FrobeniusTrace` and the interface fields of `MovingDataK`). Kind: PROVED (from those and
`MovingRealization`). -/
theorem exists_psiTrivialAt2N_ecurve [NeZero i] [TopologicalSpace (Acoef i)] [DiscreteTopology (Acoef i)]
    (hS : SerreThm3) (hcm : CMjInteger) {ℓ : ℕ} (hℓ : 0 < ℓ)
    (hT : FrobeniusTrace (ZInQ.Contrib.CloudB3RC53.Ecurve ℓ))
    (D : MovingDataK (ZInQ.Contrib.CloudB3RC53.Ecurve ℓ) n) (hn : 2 * i ≤ n)
    (P : Set (HeightOneSpectrum (𝓞 K)))
    (R : ∀ r, (movingSettingEcurveS hS hcm hℓ hT D).good r →
      MovingRealization (movingSettingEcurveS hS hcm hℓ hT D) r (K := K) (S₀ := S₀) P)
    (B : ℕ) (S : Finset ℕ) :
    ∃ (r : ℕ) (hr : (movingSettingEcurveS hS hcm hℓ hT D).good r), r ∉ S ∧ r.Prime ∧
      (2 : ℤ) ^ B ∣ (r : ℤ) - 1 ∧
      ∃ Ψ : (movingSettingEcurveS hS hcm hℓ hT D).P r →+ Additive (Acoef i)ˣ,
        PsiTrivialAt2N i (movingPi i (movingPsiAt Ψ (R r hr)))
          (movingPsi i (movingPsiAt Ψ (R r hr))) P := by
  obtain ⟨r, hr, hrS, hrp, hr1, Ψ, -, -, hP⟩ :=
    exists_psiTrivialAt2N (movingSettingEcurveS hS hcm hℓ hT D) hn P R B S
  exact ⟨r, hr, hrS, hrp, hr1, Ψ, hP⟩

/-! ### Non-vacuity of `MovingRealization` -/

variable (M r) in
/-- **Non-vacuity**: the trivial restriction realizes `MovingRealization` at the empty set of
places. Kind: PROVED. -/
def movingRealization_empty : MovingRealization M r (K := K) (S₀ := S₀) ∅ where
  res := 1
  decomp_at v hv := absurd hv (Set.notMem_empty v)

variable (M r) in
/-- **Non-vacuity at any set of places**: if some chosen prime lies over `2N`, the trivial
restriction realizes `MovingRealization` at every set of places (`0` lies in every subgroup).
Kind: PROVED. -/
def movingRealization_trivial (P : Set (HeightOneSpectrum (𝓞 K))) (j₀ : Fin M.s)
    (hj₀ : M.over2N j₀) : MovingRealization M r (K := K) (S₀ := S₀) P where
  res := 1
  decomp_at _ _ := ⟨j₀, hj₀, fun _ => (M.decomp r j₀ ⊔ M.decompBar r j₀).zero_mem⟩

end ZInQ.Contrib.CloudB3E1Moving
