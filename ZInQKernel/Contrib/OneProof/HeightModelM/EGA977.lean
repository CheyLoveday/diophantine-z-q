import Mathlib

/-!
# EGA IV₃ (9.7.7)(ii) over the ring of integers of a number field

The printed leaf of this directory and the glue that turns it into finiteness of the
disconnected fibres.

**Print.** Grothendieck–Dieudonné, *Éléments de géométrie algébrique IV*, troisième partie,
Publ. Math. IHÉS 28 (1966), Théorème (9.7.7), p. 79: "Soit `f : X → S` un morphisme de
présentation finie, et soit `E` l'ensemble des `s ∈ S` pour lesquels `X_s` a l'une des
propriétés suivantes : être : (i) géométriquement irréductible ; (ii) géométriquement connexe ;
(iii) géométriquement réduit ; (iv) géométriquement intègre. Alors `E` est localement
constructible dans `S`."

Definitions used by the print:
* EGA 0_III (9.1.1)–(9.1.2), (9.1.11), Publ. Math. IHÉS 11 (1961), pp. 12–14: a part of `X` is
  constructible if it lies in the smallest set of parts containing the retrocompact open parts
  and stable under finite intersection and complement; `T` is locally constructible if every
  `x ∈ X` has an open neighbourhood `V` with `T ∩ V` constructible in `V`. These are Mathlib's
  `Topology.IsConstructible` (the Boolean subalgebra generated by the retrocompact open sets) and
  `Topology.IsLocallyConstructible`.
* EGA IV (4.5.2), Publ. Math. IHÉS 24 (1965), p. 61: a `k`-prescheme `X` is geometrically
  connected if the number of connected components of `X ⊗_k Ω` is `≤ 1`; by (4.5.1)–(4.5.2) c)
  this holds iff `X ⊗_k K` is connected (or empty) for every extension `K` of `k`
  (`IsGeomConnFibre`).

**Lean form** (`EGAIV_9_7_7_OL`): property (ii) at `S = Spec 𝓞_L`, `L` a number field, for `X`
smooth, quasi-compact and quasi-separated over `S` (smooth implies locally of finite
presentation, so `f` is of finite presentation). A direct instance of the print.

**Glue** (proved here): a locally constructible subset of `Spec 𝓞_L` containing the generic point
has finite complement (`finite_compl_of_isLocallyConstructible`), so a smooth model with
geometrically connected generic fibre has only finitely many disconnected fibres
(`genericConnectedFibresOL_of_ega`).
-/

noncomputable section

open CategoryTheory AlgebraicGeometry Limits Topology
open scoped NumberField

namespace ZInQ.HeightModelM

/-! ## The printed statement -/

/-- **`X_s` is geometrically connected** (EGA IV (4.5.2), with (4.5.1) c)): for every field `K`
and every morphism `Spec K → Spec k(s)` (an extension `K` of `k(s)`), the base change
`X_s ⊗_{k(s)} K` is connected or empty (`n' ≤ 1`). -/
def IsGeomConnFibre {X S : Scheme.{0}} (f : X ⟶ S) (s : S) : Prop :=
  geometrically (fun Z => PreconnectedSpace Z) (f.fiberToSpecResidueField s)

/-- **LEAF: EGA IV₃ (9.7.7)(ii)**, Publ. Math. IHÉS 28 (1966), p. 79, at `S = Spec 𝓞_L` for a
number field `L` and `X` smooth, quasi-compact and quasi-separated over `S`: the set of
`s ∈ S` whose fibre `X_s` is geometrically connected is locally constructible in `S`. -/
def EGAIV_9_7_7_OL : Prop :=
  ∀ (L : Type) [Field L] [NumberField L] (X : Scheme.{0})
    (f : X ⟶ Spec (CommRingCat.of (𝓞 L))) [Smooth f] [QuasiCompact f] [QuasiSeparated f],
    IsLocallyConstructible {s | IsGeomConnFibre f s}

/-! ## Constructible sets of `Spec` of a Dedekind domain -/

section Constructible

variable {X : Type*} [TopologicalSpace X]

/-- In a space with a point `η` lying in every nonempty open set, a constructible set containing
`η` contains an open neighbourhood of `η`, and one not containing `η` misses one. -/
theorem isConstructible_generic {η : X}
    (hη : ∀ U : Set X, IsOpen U → U.Nonempty → η ∈ U) {s : Set X} (hs : IsConstructible s) :
    (η ∈ s → ∃ U, IsOpen U ∧ η ∈ U ∧ U ⊆ s) ∧ (η ∉ s → ∃ U, IsOpen U ∧ η ∈ U ∧ U ⊆ sᶜ) := by
  induction hs using IsConstructible.empty_union_induction with
  | open_retrocompact U hU _ =>
    refine ⟨fun h => ⟨U, hU, h, subset_rfl⟩, fun h => ⟨Set.univ, isOpen_univ, trivial, ?_⟩⟩
    intro x _ hx
    exact h (hη U hU ⟨x, hx⟩)
  | union s _ t _ hs ht =>
    refine ⟨fun h => ?_, fun h => ?_⟩
    · rcases h with h | h
      · obtain ⟨U, hU, hηU, hUs⟩ := hs.1 h
        exact ⟨U, hU, hηU, hUs.trans Set.subset_union_left⟩
      · obtain ⟨U, hU, hηU, hUs⟩ := ht.1 h
        exact ⟨U, hU, hηU, hUs.trans Set.subset_union_right⟩
    · obtain ⟨U, hU, hηU, hUs⟩ := hs.2 (fun h' => h (Or.inl h'))
      obtain ⟨V, hV, hηV, hVt⟩ := ht.2 (fun h' => h (Or.inr h'))
      refine ⟨U ∩ V, hU.inter hV, ⟨hηU, hηV⟩, ?_⟩
      rintro x ⟨hxU, hxV⟩ (hx | hx)
      · exact hUs hxU hx
      · exact hVt hxV hx
  | compl s _ hs =>
    refine ⟨fun h => hs.2 h, fun h => ?_⟩
    obtain ⟨U, hU, hηU, hUs⟩ := hs.1 (not_not.mp h)
    exact ⟨U, hU, hηU, by simpa using hUs⟩

variable {R : Type*} [CommRing R] [IsDomain R]

/-- The generic point `(0)` of `Spec R` lies in every nonempty open set. -/
theorem bot_mem_of_isOpen {U : Set (PrimeSpectrum R)} (hU : IsOpen U) (hne : U.Nonempty) :
    (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum R) ∈ U := by
  obtain ⟨x, hx⟩ := hne
  have hsp : (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum R) ⤳ x :=
    (PrimeSpectrum.le_iff_specializes _ x).mp bot_le
  exact hsp.mem_open hU hx

/-- In `Spec R`, `R` a noetherian domain of dimension `≤ 1`, the complement of an open set
containing the generic point is finite. -/
theorem finite_compl_of_isOpen [IsNoetherianRing R] [Ring.DimensionLEOne R]
    {U : Set (PrimeSpectrum R)} (hU : IsOpen U)
    (hη : (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum R) ∈ U) : Uᶜ.Finite := by
  obtain ⟨I, hI⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal Uᶜ).mp hU.isClosed_compl
  have hI0 : I ≠ ⊥ := by
    rintro rfl
    have : (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum R) ∈ Uᶜ := by
      rw [hI]
      simp
    exact this hη
  have hsub : Uᶜ ⊆ PrimeSpectrum.asIdeal ⁻¹' I.minimalPrimes := by
    intro p hp
    rw [hI] at hp
    have hIp : I ≤ p.asIdeal := (PrimeSpectrum.mem_zeroLocus _ _).mp hp
    have hmax : ∀ q : Ideal R, q.IsPrime → I ≤ q → q.IsMaximal := by
      intro q hq hIq
      have hq0 : q ≠ ⊥ := fun h => hI0 (le_bot_iff.mp (h ▸ hIq))
      exact Ring.DimensionLEOne.maximalOfPrime hq0 hq
    refine ⟨⟨p.isPrime, hIp⟩, fun q hq hqp => ?_⟩
    have := (hmax q hq.1 hq.2).eq_of_le p.isPrime.ne_top hqp
    exact this ▸ le_rfl
  refine Set.Finite.subset (Set.Finite.preimage ?_
    (Ideal.finite_minimalPrimes_of_isNoetherianRing R I)) hsub
  intro a _ b _ h
  exact PrimeSpectrum.ext h

/-- **A locally constructible subset of `Spec R` containing the generic point has finite
complement** (`R` a noetherian domain of dimension `≤ 1`). -/
theorem finite_compl_of_isLocallyConstructible [IsNoetherianRing R] [Ring.DimensionLEOne R]
    {s : Set (PrimeSpectrum R)} (hs : IsLocallyConstructible s)
    (hη : (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum R) ∈ s) : sᶜ.Finite := by
  have hc : IsConstructible s := hs.isConstructible
  obtain ⟨U, hU, hηU, hUs⟩ :=
    (isConstructible_generic (fun U hU hne => bot_mem_of_isOpen hU hne) hc).1 hη
  exact (finite_compl_of_isOpen hU hηU).subset (Set.compl_subset_compl.mpr hUs)

end Constructible

/-! ## Fibres -/

/-- A geometrically connected fibre is connected or empty as a subspace. -/
theorem isPreconnected_of_isGeomConnFibre {X S : Scheme.{0}} (f : X ⟶ S) (s : S)
    (h : IsGeomConnFibre f s) : _root_.IsPreconnected (f ⁻¹' {s}) := by
  have hP : PreconnectedSpace (f.fiber s) :=
    h (K := S.residueField s) (𝟙 _) (𝟙 _) (f.fiberToSpecResidueField s) IsPullback.of_id_fst
  rw [← f.range_fiberι, ← Set.image_univ]
  exact isPreconnected_univ.image _ (f.fiberι s).continuous.continuousOn

/-- Mathlib's `GeometricallyConnected` for the fibre gives `IsGeomConnFibre`. -/
theorem isGeomConnFibre_of_geometricallyConnected {X S : Scheme.{0}} (f : X ⟶ S) (s : S)
    (h : GeometricallyConnected (f.fiberToSpecResidueField s)) : IsGeomConnFibre f s := by
  intro K _ y Z fst snd hpb
  have : ConnectedSpace Z := h.geometrically_connectedSpace y fst snd hpb
  infer_instance

/-! ## The glue -/

/-- **Finitely many disconnected fibres.** For `X` smooth, quasi-compact and quasi-separated
over `Spec 𝓞_L` with geometrically connected generic fibre, only finitely many fibres
`f⁻¹{t}` are disconnected (EGA IV₃ 9.7.7-type constructibility). -/
def GenericConnectedFibresOL : Prop :=
  ∀ (L : Type) [Field L] [NumberField L] (X : Scheme.{0})
    (f : X ⟶ Spec (CommRingCat.of (𝓞 L))) [Smooth f] [QuasiCompact f] [QuasiSeparated f],
    GeometricallyConnected (f.fiberToSpecResidueField ⟨⊥, Ideal.isPrime_bot⟩) →
    {t | ¬ _root_.IsPreconnected (f ⁻¹' {t})}.Finite

/-- **Glue: EGA IV₃ (9.7.7)(ii) gives the finiteness of the disconnected fibres.** -/
theorem genericConnectedFibresOL_of_ega (h : EGAIV_9_7_7_OL) : GenericConnectedFibresOL := by
  intro L _ _ X f _ _ _ hgen
  have hE := h L X f
  have hη : (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum (𝓞 L)) ∈ {s | IsGeomConnFibre f s} :=
    isGeomConnFibre_of_geometricallyConnected f _ hgen
  have hfin := finite_compl_of_isLocallyConstructible (R := 𝓞 L) hE hη
  refine hfin.subset fun t ht hE' => ht ?_
  exact isPreconnected_of_isGeomConnFibre f t hE'

end ZInQ.HeightModelM
