/-!
# gzopt-dict: the Gross–Zagier leaf over the algebraic function field `ℚ(X₀(N)) = ℚ(j, j_N)`

Task gzopt-dict (2026-11-16). Report: `docs/research/gzopt-dict.md`; scratch and log:
`scratch/gzopt-dict/`.

gz-optimal's leaf `GZOptimal.GrossZagierModuliOptCd` reads the modular parametrization
`φ : X₀(N) → E` as two coordinate functions `X, Y : ℍ → ℂ` in the analytically defined field
`{g | IsRatModFnMero N g}`. Gross–Zagier's `φ` is a morphism over `ℚ` of the algebraic curve
`X₀(N)`. This file restates the leaf (`GrossZagierAlgOptAt`) with `φ` given by its pull-back
`φ^* : ℚ(E) →ₐ[ℚ] ℚ(X₀(N))` on function fields, where `ℚ(X₀(N))` is the algebraic function field
`ℚ(j, j_N)`, realized by `q`-expansions at the cusp `∞` inside `ℚ((q))`
(`ModularCurve.modularFunctionField N`, vendored from the FLT project: the subfield of
`LaurentSeries ℚ` generated by the `q`-expansion `jq` of `j` and `jq(q^N)` of `j(Nτ)`).
The complex points of `X₀(N)` enter only through the uniformization `ℍ → X₀(N)(ℂ)`: the
values of `φ` at the Heegner points `τ ∈ ℍ` are read off from the meromorphic functions on `ℍ`
whose `q`-expansions are `φ^*(x)`, `φ^*(y)`.

The bridge (`grossZagierModuliOptAt_of_alg`) proves gz-optimal's analytic leaf from the algebraic
one and the `q`-expansion principle for `Γ₀(N)` (`Gamma0QExpansion`, a printed leaf): the `X, Y`
the consumer supplies have rational `q`-expansions `x, y`; by the principle they lie in `ℚ(j, j_N)`;
the Weierstrass equation and the pole at `∞` transfer from `X, Y` to `x, y` (uniqueness of Taylor
coefficients); and `(x, y)` defines `φ^*` (a nonzero prime of the coordinate ring of `E` would
make `x` algebraic over `ℚ`, impossible for a Laurent series of negative order).

No `sorry`, no `axiom`.
-/

noncomputable section

open UpperHalfPlane HeckeRing.GL2 WeierstrassCurve Filter Topology Polynomial
open scoped WeierstrassCurve.Affine

namespace ZInQ.GZAlg

/-! ## §1. Objects and the leaves -/

/-- `q = e^{2πiτ}`, the local parameter at the cusp `∞` of `X₀(N)` (width `1`). -/
def qPar (τ : ℍ) : ℂ := Complex.exp (2 * Real.pi * Complex.I * τ)

/-- **`x ∈ ℚ((q))` is the `q`-expansion of `X : ℍ → ℂ` at `∞`**: `X(τ) = Σ_{m ∈ ℤ} x_m q^m` for
`Im τ` large. -/
def HasQExp (X : ℍ → ℂ) (x : LaurentSeries ℚ) : Prop :=
  ∃ T : ℝ, ∀ τ : ℍ, T < τ.im → HasSum (fun m : ℤ => (x.coeff m : ℂ) * qPar τ ^ m) (X τ)

/-- **The function field `ℚ(X₀(N)) = ℚ(j, j_N)` of the canonical model of `X₀(N)` over `ℚ`**, embedded
in `ℚ((q))` by `q`-expansion at `∞`: the subfield generated by the `q`-expansions `jq` of
`j = E₄³/Δ` (`ModularCurve.hasSum_jq_qParam`) and `jq(q^N)` of `j(Nτ)`
(`ModularCurve.modularFunctionField`, vendored from the FLT project). The `q`-expansion map is
injective, `j` and `j_N` satisfy the irreducible modular equation `Φ_N(j, j_N) = 0`, so this field
is `Frac(ℚ[X, Y]/(Φ_N))` (Shimura 1971, §6.2 and §6.7; Diamond–Shurman §7.5–7.7; UNVERIFIED
locators). -/
abbrev X0Field (N : ℕ) [NeZero N] : IntermediateField ℚ (LaurentSeries ℚ) :=
  ModularCurve.modularFunctionField N

/-- The function `x` of the affine model of `E`, as an element of the function field `ℚ(E)`. -/
def genX (E : WeierstrassCurve ℚ) : E.toAffine.FunctionField :=
  algebraMap E.toAffine.CoordinateRing E.toAffine.FunctionField
    (Affine.CoordinateRing.mk E.toAffine (C X))

/-- The function `y` of the affine model of `E`, as an element of the function field `ℚ(E)`. -/
def genY (E : WeierstrassCurve ℚ) : E.toAffine.FunctionField :=
  algebraMap E.toAffine.CoordinateRing E.toAffine.FunctionField
    (Affine.CoordinateRing.mk E.toAffine X)

/-- **Leaf Q-EXP (the `q`-expansion principle for `Γ₀(N)` with rational coefficients).** Let `g` be
a meromorphic modular function for `Γ₀(N)` (invariant, meromorphic on `ℍ` and at every cusp:
`GZHeegner.IsRatModFnMero`) whose `q`-expansion `x` at `∞` has rational coefficients. Then `x` lies
in `ℚ(j, j_N)`, i.e. `g ∈ ℚ(j(τ), j(Nτ))`.

Source: Shimura, *Introduction to the arithmetic theory of automorphic functions* (1971),
Prop. 6.9 (the field of `Γ₀(N)`-functions with rational Fourier coefficients is `ℚ(j, j∘N)`) with
Thm. 6.6; Diamond–Shurman, *A first course in modular forms*, §7.5 (`ℂ(X₀(N)) = ℂ(j, j_N)`) and
§7.6–7.7 (the rational structure via `q`-expansions); locators UNVERIFIED (no copy on this host).
The print states the result for `ℚ(X₀(N))` as a subfield of `ℂ(X₀(N))`; the `q`-expansion map is
injective on it, so this is the printed statement read through `q`-expansions. -/
def Gamma0QExpansion : Prop :=
  ∀ (N : ℕ) [NeZero N] (g : ℍ → ℂ), ZInQ.GZHeegner.IsRatModFnMero N g →
    ∀ x : LaurentSeries ℚ, HasQExp g x → x ∈ X0Field N

/-- **The Gross–Zagier formula for the strong Weil parametrization, over the algebraic curve
`X₀(N)` (Gross–Zagier 1986, Thm I.6.3 and Ch. V Thm 2.1; positive constant forgotten).**

* `E/ℚ` has the L-series of the newform `f` of level `N`, trivial character.
* `φ : X₀(N) → E` is a nonconstant morphism over `ℚ` with `φ(∞) = O`, given by its pull-back
  `φ^* : ℚ(E) →ₐ[ℚ] ℚ(X₀(N))` on function fields (a nonconstant morphism of smooth projective curves
  over `ℚ` is the same as a `ℚ`-embedding of function fields; Hartshorne I.6.12, Silverman AEC
  II.2.5, UNVERIFIED numbers), `ℚ(X₀(N)) = ℚ(j, j_N) ⊂ ℚ((q))` (`X0Field`). `φ(∞) = O` says that
  `φ^*(x)` has a pole at the cusp `∞`, whose local parameter is `q`: `ord_q φ^*(x) < 0`.
* `X, Y : ℍ → ℂ` are the meromorphic functions with `q`-expansions `φ^*(x)`, `φ^*(y)` (the
  composite of `φ` with the uniformization `ℍ → X₀(N)(ℂ)`; they are determined by `φ`, up to
  values at poles), and `φ(τ) = modPt E X Y τ ∈ E(ℂ)` is the image of the point `τ` (gz-moduli).
* `φ` is the strong Weil (optimal) parametrization, `IsOptimalParam N f E X Y` (gz-optimal): the
  lift of `φ` to `ℍ → ℂ` is `c φ_f`, `c ∈ ℚ`, and the period lattice of `E` is `c Λ_f`, i.e.
  `φ_* : H₁(X₀(N), ℤ) → H₁(E(ℂ), ℤ)` is onto (connected kernel of `J₀(N) → E`).
* Heegner data, `y ∈ E(K)` with `ι(y) = n · y_K`, `y_K = Σ_x φ(x)`, and the conclusion are those of
  gz-optimal's `GZOptimal.GrossZagierModuliOptAt`.

Then `L'(E/K, 1) = (F G)'(1) = κ · ĥ(y)` for some real `κ > 0`.

Source: B. Gross, D. Zagier, *Heegner points and derivatives of L-series*, Invent. Math. 84
(1986), 225–320, Thm I.6.3 and Ch. V Thm 2.1 (`φ : X₀(N) → E` the strong Weil parametrization,
`φ^*ω = c · 2πi f(τ) dτ`); locators, the constant and the exact hypotheses on `φ` UNVERIFIED (no
copy on this host). Weaker than the print: the constant is replaced by `∃ κ > 0`. -/
def GrossZagierAlgOptAt (E : WeierstrassCurve ℚ) : Prop :=
  ∀ (N : ℕ) [NeZero N] (f : Newform N 2), f.χ = 1 →
    (∀ n : ℕ, n ≠ 0 → ZInQ.GZDecomp.coeff f n = (E.LFunction n : ℂ)) →
    ∀ φ : E.toAffine.FunctionField →ₐ[ℚ] X0Field N,
    ((φ (genX E) : LaurentSeries ℚ)).order < 0 →
    ∀ X Y : ℍ → ℂ, (∀ τ : ℍ, MeromorphicAt (X ∘ ofComplex) (τ : ℂ)) →
    (∀ τ : ℍ, MeromorphicAt (Y ∘ ofComplex) (τ : ℂ)) →
    HasQExp X (φ (genX E) : LaurentSeries ℚ) → HasQExp Y (φ (genY E) : LaurentSeries ℚ) →
    ZInQ.GZOptimal.IsOptimalParam N f E X Y →
    ∀ D β : ℤ, ZInQ.GZDecomp.IsOddImagFundDisc D → D < -4 → ZInQ.GZDecomp.HeegnerHyp N D →
    (4 * N : ℤ) ∣ D - β ^ 2 →
    ∀ (R : Type) [Fintype R] (τ : R → ℍ), ZInQ.GZModuli.IsHeegnerPointReps N D β τ →
    ∀ (K : Type) [Field K] [NumberField K] [DecidableEq K], Module.finrank ℚ K = 2 →
    ∀ δ : K, δ ^ 2 = (D : K) →
    ∀ ι : K →ₐ[ℚ] ℂ, ι δ = Complex.I * (Real.sqrt (-(D : ℝ)) : ℂ) →
    ∀ n : ℤ, n ≠ 0 →
    ∀ y : (E⁄K).Point, Affine.Point.map ι y = n • ∑ r, ZInQ.GZModuli.modPt E X Y (τ r) →
    ∀ F G : ℂ → ℂ, ZInQ.GZDecomp.IsEntireCont (ZInQ.GZDecomp.coeff f) 2 F →
      ZInQ.GZDecomp.IsEntireCont (ZInQ.GZDecomp.twistCoeff f D) 2 G →
      ∃ κ : ℝ, 0 < κ ∧ deriv (fun s => F s * G s) 1 = κ * y.canonicalHeight

/-- `GrossZagierAlgOptAt` for every elliptic curve over `ℚ`. -/
def GrossZagierAlgOpt : Prop :=
  ∀ (E : WeierstrassCurve ℚ) [E.IsElliptic], GrossZagierAlgOptAt E

/-- **The leaf of the `C_d` route, algebraic form**: `GrossZagierAlgOptAt E'` for every short model
`E'` in the isogeny class of `C_d : y² = x³ − d²x` (`aₙ(E') = aₙ(C_d)`), `d ≡ 5 (mod 8)` squarefree.
A restriction of `GrossZagierAlgOpt`. -/
def GrossZagierAlgOptCd : Prop :=
  ∀ d : ℕ, d % 8 = 5 → Squarefree d →
    ∀ (E' : WeierstrassCurve ℚ) [E'.IsElliptic], ZInQ.GZOptimal.IsShortModel E' →
      (∀ n : ℕ, n ≠ 0 → E'.LFunction n = (shortCurve (-(d : ℚ) ^ 2)).LFunction n) →
      GrossZagierAlgOptAt E'

theorem grossZagierAlgOptCd_of (h : GrossZagierAlgOpt) : GrossZagierAlgOptCd :=
  fun _ _ _ E' _ _ _ => h E'

/-! ## §2. Algebra: a pair `(x, y)` in `ℚ(X₀(N))` on `E` with `ord x < 0` defines `φ^*` -/

/-- The Weierstrass equation of `E` for a pair of Laurent series. -/
def WEq (E : WeierstrassCurve ℚ) (x y : LaurentSeries ℚ) : Prop :=
  y ^ 2 + algebraMap ℚ _ E.a₁ * x * y + algebraMap ℚ _ E.a₃ * y =
    x ^ 3 + algebraMap ℚ _ E.a₂ * x ^ 2 + algebraMap ℚ _ E.a₄ * x + algebraMap ℚ _ E.a₆

/-- **A Laurent series of negative order is transcendental over `ℚ`.** -/
theorem aeval_ne_zero_of_order_neg {x : LaurentSeries ℚ} (hx : x.order < 0) {p : ℚ[X]}
    (hp : p ≠ 0) : aeval x p ≠ 0 := by
  have hx0 : x ≠ 0 := by rintro rfl; simp at hx
  have hcst : ∀ c : ℚ, algebraMap ℚ (LaurentSeries ℚ) c = HahnSeries.single 0 c := fun c =>
    (RingHom.congr_fun (Subsingleton.elim (algebraMap ℚ (LaurentSeries ℚ)) HahnSeries.C) c).trans rfl
  set v := HahnSeries.addVal ℤ ℚ
  set z := x⁻¹
  have hz0 : z ≠ 0 := inv_ne_zero hx0
  have hvz : (0 : WithTop ℤ) < v z := by
    have h1 : v x + v z = 0 := by
      rw [← AddValuation.map_mul, mul_inv_cancel₀ hx0, AddValuation.map_one]
    rw [HahnSeries.addVal_apply_of_ne hx0] at h1
    rw [HahnSeries.addVal_apply_of_ne hz0] at h1 ⊢
    have h2 : x.order + z.order = 0 := by exact_mod_cast h1
    exact_mod_cast (show (0 : ℤ) < z.order by omega)
  set n := p.natDegree
  -- `z^n p(x) = c_n + w` with `v w > 0`
  have hsplit : z ^ n * aeval x p = algebraMap ℚ _ (p.coeff n) +
      ∑ i ∈ Finset.range n, algebraMap ℚ _ (p.coeff i) * z ^ (n - i) := by
    rw [aeval_eq_sum_range, Finset.mul_sum, Finset.sum_range_succ, add_comm]
    congr 1
    · rw [Algebra.smul_def, mul_left_comm, ← mul_pow, inv_mul_cancel₀ hx0, one_pow, mul_one]
    · refine Finset.sum_congr rfl fun i hi => ?_
      rw [Finset.mem_range] at hi
      rw [Algebra.smul_def, mul_left_comm]
      congr 1
      rw [show n = (n - i) + i by omega, pow_add, mul_assoc, ← mul_pow, inv_mul_cancel₀ hx0,
        one_pow, mul_one, show n - i + i - i = n - i by omega]
  have hw : (0 : WithTop ℤ) < v (∑ i ∈ Finset.range n, algebraMap ℚ _ (p.coeff i) * z ^ (n - i)) := by
    have : v z ≤ v (∑ i ∈ Finset.range n, algebraMap ℚ _ (p.coeff i) * z ^ (n - i)) := by
      refine AddValuation.map_le_sum v fun i hi => ?_
      rw [Finset.mem_range] at hi
      rw [AddValuation.map_mul, AddValuation.map_pow]
      have hc : 0 ≤ v (algebraMap ℚ (LaurentSeries ℚ) (p.coeff i)) := by
        by_cases hc : p.coeff i = 0
        · rw [hc, map_zero, AddValuation.map_zero]; exact le_top
        · rw [hcst, HahnSeries.addVal_apply_of_ne (by simpa using hc), HahnSeries.order_single hc]
          rfl
      obtain ⟨m, hm⟩ : ∃ m, n - i = m + 1 := ⟨n - i - 1, by omega⟩
      rw [hm, succ_nsmul]
      have : 0 ≤ m • v z := nsmul_nonneg hvz.le m
      calc v z = 0 + (0 + v z) := by simp
        _ ≤ _ := add_le_add hc (add_le_add this le_rfl)
    exact lt_of_lt_of_le hvz this
  intro h0
  have h1 := hsplit
  rw [h0, mul_zero] at h1
  set w := ∑ i ∈ Finset.range n, algebraMap ℚ (LaurentSeries ℚ) (p.coeff i) * z ^ (n - i)
  have hcw : w.coeff 0 = 0 := by
    by_cases hw0 : w = 0
    · simp [hw0]
    · rw [HahnSeries.addVal_apply_of_ne hw0] at hw
      exact HahnSeries.coeff_eq_zero_of_lt_order (by exact_mod_cast hw)
  have h2 := congrArg (fun s : LaurentSeries ℚ => s.coeff 0) h1
  simp only [HahnSeries.coeff_zero, HahnSeries.coeff_add, hcw, add_zero] at h2
  rw [hcst, HahnSeries.coeff_single_same] at h2
  exact (leadingCoeff_ne_zero.2 hp) h2.symm

section Phi

variable {E : WeierstrassCurve ℚ} {K : Type*} [Field K] [Algebra ℚ K]

/-- `(x, y)` satisfies the equation of `E`, in the form `AdjoinRoot.lift` reads. -/
abbrev OnCurve (E : WeierstrassCurve ℚ) (x y : K) : Prop :=
  E.toAffine.polynomial.eval₂ (aeval (R := ℚ) x).toRingHom y = 0

/-- `(x, y)` on `E` defines a `ℚ`-algebra map from the coordinate ring of `E`. -/
def psi0 (x y : K) (h : OnCurve E x y) :
    E.toAffine.CoordinateRing →ₐ[ℚ] K :=
  { AdjoinRoot.lift (aeval (R := ℚ) x).toRingHom y h with
    commutes' := fun c => by
      simp only [RingHom.toMonoidHom_eq_coe, OneHom.toFun_eq_coe, MonoidHom.toOneHom_coe,
        MonoidHom.coe_ofClass]
      rw [IsScalarTower.algebraMap_apply ℚ (Polynomial ℚ) E.toAffine.CoordinateRing,
        AdjoinRoot.algebraMap_eq, AdjoinRoot.lift_of h, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        Polynomial.algebraMap_apply, aeval_C, Algebra.algebraMap_self, RingHom.id_apply] }

theorem psi0_mk (x y : K) (h : OnCurve E x y) (g : ℚ[X][X]) :
    psi0 (E := E) x y h (Affine.CoordinateRing.mk E.toAffine g) =
      g.eval₂ (aeval (R := ℚ) x).toRingHom y :=
  AdjoinRoot.lift_mk h g

theorem psi0_X (x y : K) (h : OnCurve E x y) :
    psi0 (E := E) x y h (Affine.CoordinateRing.mk E.toAffine (C X)) = x := by
  rw [psi0_mk, eval₂_C, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, aeval_X]

theorem psi0_Y (x y : K) (h : OnCurve E x y) :
    psi0 (E := E) x y h (Affine.CoordinateRing.mk E.toAffine X) = y := by
  rw [psi0_mk, eval₂_X]

theorem psi0_algebraMap (x y : K) (h : OnCurve E x y) (p : ℚ[X]) :
    psi0 (E := E) x y h (algebraMap ℚ[X] E.toAffine.CoordinateRing p) = aeval x p := by
  change AdjoinRoot.lift _ _ h (AdjoinRoot.of _ p) = _
  rw [AdjoinRoot.lift_of h]; rfl

/-- **`psi0` is injective if `x` is transcendental**: a nonzero prime of the coordinate ring
(integral over `ℚ[X]`) meets `ℚ[X]` (going up), which would give `p(x) = 0`, `p ≠ 0`. -/
theorem psi0_injective (x y : K) (h : OnCurve E x y) (hx : ∀ p : ℚ[X], p ≠ 0 → aeval x p ≠ 0) :
    Function.Injective (psi0 (E := E) x y h) := by
  rw [injective_iff_map_eq_zero]
  intro a ha
  by_contra ha0
  set P := RingHom.ker (psi0 (E := E) x y h)
  have hP : P ≠ ⊥ := fun hP => ha0 (by
    have : a ∈ P := ha
    rw [hP] at this; exact this)
  have hu : P.under ℚ[X] ≠ ⊥ := fun hu => hP (Ideal.eq_bot_of_under_eq_bot hu)
  obtain ⟨p, hpP, hp0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hu
  have : psi0 (E := E) x y h (algebraMap ℚ[X] E.toAffine.CoordinateRing p) = 0 := hpP
  rw [psi0_algebraMap] at this
  exact hx p hp0 this

/-- **`φ^* : ℚ(E) →ₐ[ℚ] K`** from a pair `(x, y)` on `E` with `x` transcendental. -/
def phiOf (x y : K) (h : OnCurve E x y) (hx : ∀ p : ℚ[X], p ≠ 0 → aeval x p ≠ 0) :
    E.toAffine.FunctionField →ₐ[ℚ] K :=
  IsFractionRing.liftAlgHom (psi0_injective (E := E) x y h hx)

theorem phiOf_genX (x y : K) (h : OnCurve E x y) (hx) : phiOf (E := E) x y h hx (genX E) = x := by
  rw [phiOf, IsFractionRing.liftAlgHom_apply, genX, IsFractionRing.lift_algebraMap]
  exact psi0_X x y h

theorem phiOf_genY (x y : K) (h : OnCurve E x y) (hx) : phiOf (E := E) x y h hx (genY E) = y := by
  rw [phiOf, IsFractionRing.liftAlgHom_apply, genY, IsFractionRing.lift_algebraMap]
  exact psi0_Y x y h

end Phi

/-- The Weierstrass equation for `(x, y) ∈ ℚ(X₀(N))²` in the form `AdjoinRoot.lift` reads. -/
theorem eval₂_polynomial_of_wEq {E : WeierstrassCurve ℚ} {F : IntermediateField ℚ (LaurentSeries ℚ)}
    (x y : F) (h : WEq E x y) : OnCurve E x y := by
  unfold OnCurve
  apply (algebraMap F (LaurentSeries ℚ)).injective
  simp only [Affine.polynomial, eval₂_sub, eval₂_add, eval₂_mul, eval₂_pow, eval₂_C, eval₂_X,
    AlgHom.toRingHom_eq_coe, RingHom.coe_coe, map_add, map_mul, map_pow, map_sub, map_zero,
    aeval_C, aeval_X]
  unfold WEq at h
  have hc : ∀ c : ℚ, ((algebraMap ℚ F c : F) : LaurentSeries ℚ) = algebraMap ℚ _ c := fun c =>
    RingHom.congr_fun (Subsingleton.elim ((F.val : F →+* LaurentSeries ℚ).comp (algebraMap ℚ F))
      (algebraMap ℚ (LaurentSeries ℚ))) c
  simp only [IntermediateField.algebraMap_apply, hc]
  linear_combination h

theorem transcendental_of_order_neg {F : IntermediateField ℚ (LaurentSeries ℚ)} (x : F)
    (hx : (x : LaurentSeries ℚ).order < 0) : ∀ p : ℚ[X], p ≠ 0 → aeval x p ≠ 0 := by
  intro p hp h0
  apply aeval_ne_zero_of_order_neg hx hp
  have h1 := Polynomial.hom_eval₂ p (algebraMap ℚ F) (F.val : F →+* LaurentSeries ℚ) x
  rw [← aeval_def, h0, map_zero, Subsingleton.elim ((F.val : F →+* LaurentSeries ℚ).comp
    (algebraMap ℚ F)) (algebraMap ℚ (LaurentSeries ℚ)), ← aeval_def] at h1
  exact h1.symm

end ZInQ.GZAlg
