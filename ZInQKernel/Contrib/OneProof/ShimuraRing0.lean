import ZInQKernel.Contrib.OneProof.ShimuraHeckeClosed

/-! # Shimura 1973, Theorem 1: printed clauses and quotient construction -/

noncomputable section

namespace ShimuraSteps

open CategoryTheory AlgebraicGeometry
open LeafModCurves PkgI3 PkgI3.AbVar
open PkgI4 (CF coeff IsNewform)
open AfTateLam (IsX1Gen)
open R16Thm1

variable {N : ℕ} {J A : AbVar ℚ} {ξ : ℕ → AbVar.End J} {f : CF N 2}

/-- Changing the dummy value at index zero leaves the Hecke ring unchanged. -/
theorem printRing_update_zero (t : AbVar.End J) :
    printRing (Function.update ξ 0 t) f = printRing ξ f := by
  unfold printRing
  congr 2

/-- If the zero operator is normalized, its pair is already in every subring.
This recovers the all-index closure on the Hecke bridge. -/
theorem printRing_eq_closure_of_zero (h0 : ξ 0 = 0) :
    printRing ξ f = Subring.closure (Set.range fun n : ℕ => (ξ n, ak f n)) := by
  have hz : coeff f 0 = 0 := by
    unfold coeff
    exact CuspFormClass.qExpansion_coeff_zero f one_pos
      (by simp [CongruenceSubgroup.strictPeriods_Gamma1])
  have hpair : (ξ 0, ak f 0) = 0 := Prod.ext h0 (Subtype.ext hz)
  rw [← Nat.range_of_succ (fun n : ℕ => (ξ n, ak f n)), hpair, Set.singleton_union,
    Subring.closure_insert_zero] <;> rfl

/-- The intertwining in clause (ii) extends to the generated subring and
implies the killing half of `PrintQuotient`. -/
theorem kills_print_of_printedClauses {ν : AbVar.Hom J A}
    {θ : coeffField f →+* A.End0} (hc : PrintedClauses ξ f ν θ) :
    Kills (Sat (annihilator (printRing ξ f))) ν := by
  apply (kills_sat_iff _).2
  have hle : printRing ξ f ≤ compatRing ν θ := by
    apply Subring.closure_le.mpr
    rintro _ ⟨n, rfl⟩
    exact hc.2.1 _ (Nat.succ_pos n)
  intro t ht
  have ht' : HeckeCompat ν t (θ 0) := hle ht
  rw [map_zero] at ht'
  obtain ⟨m, e, hm, he, h⟩ := ht'
  have he' : e = 0 := incl_eq_zero (by simpa using he.symm)
  rw [he'] at h
  have hz : m • comp t ν = 0 := h.trans (map_zero (postC ν))
  exact congrArg Hom.hom (hom_nsmul_eq_zero m hm _ hz)

/-- Shimura 1973, Theorem 1 at `Γ₁(N)` (J. Math. Soc. Japan 25 (1973),
523–544, pp. 525–527; manuscript L770–773 and L11053–11057).

* pp. 525–526: the coefficient degree is finite. Clause (i) is surjectivity
  and `KerConnected`; (ii) is rational intertwining at each positive index;
  (iii) is `dim A = [K_f : ℚ]`, with the printed multiplicity `m = 1`
  from q-expansions (p. 527).
* p. 526: among such triples, the abelian variety is unique up to an
  isomorphism over ℚ, with no condition on its composite with `ν`.

This encodes the printed clauses used for the quotient row at level `N ≥ 2`
for a weight-two newform. Clause (iv) and the total Euler identity are omitted. -/
def ShimuraThm1Printed : Prop :=
  ∀ (N : ℕ) (χ : DirichletCharacter ℂ N) (f : CF N 2), 2 ≤ N → IsNewform f χ →
    ∀ (X : Over SpecQ) [IsIntegral X.left] (jX tX : X.left.functionField),
    IsCurve X → IsX1Gen N X jX tX →
    ∀ (P₀ : RatPt X) (J : AbVar ℚ) (aj : X ⟶ J.X), IsJacobian X P₀ J aj →
    ∀ ξ : ℕ → AbVar.End J,
      XiAction (N := N) jX tX aj ξ →
      FiniteDimensional ℚ (coeffField f) ∧
        ∃ (A : AbVar ℚ) (ν : AbVar.Hom J A) (θ : coeffField f →+* A.End0),
          PrintedClauses ξ f ν θ ∧
          ∀ (A' : AbVar ℚ) (ν' : AbVar.Hom J A') (θ' : coeffField f →+* A'.End0),
            PrintedClauses ξ f ν' θ' →
              ∃ ψ : AbVar.Hom A A', IsIso ψ.hom

/-- Proof content of Shimura 1973, p. 526: the quotient of `J` by the subvariety
`C` generated by the annihilator images. Every printed triple presents this
quotient. This is outside the statement of Theorem 1; provenance (c), GLUE.

Shimura constructs one triple, `J/C`. Passing to every printed triple is a
short argument, not a strengthening of his proof: the killing half follows from
clause (ii) (`kills_print_of_printedClauses`); the kernel of any printed `ν'` is
connected by clause (i), contains `C`, and has dimension
`dim J - [K_f : ℚ] = dim C` by clause (iii), so it equals `C` and `ν'` factors
through `J/C` as an isomorphism. -/
def ShimuraQuotientByC : Prop :=
  ∀ (N : ℕ) (χ : DirichletCharacter ℂ N) (f : CF N 2), 2 ≤ N → IsNewform f χ →
    ∀ (X : Over SpecQ) [IsIntegral X.left] (jX tX : X.left.functionField),
    IsCurve X → IsX1Gen N X jX tX →
    ∀ (P₀ : RatPt X) (J : AbVar ℚ) (aj : X ⟶ J.X), IsJacobian X P₀ J aj →
    ∀ ξ : ℕ → AbVar.End J,
      XiAction (N := N) jX tX aj ξ →
      ∀ (A : AbVar ℚ) (ν : AbVar.Hom J A) (θ : coeffField f →+* A.End0),
        PrintedClauses ξ f ν θ → PrintQuotient ξ f ν

/-- Assemble the existing combined input from the printed clauses and the
separate quotient construction. -/
theorem asPrinted_of_split (hP : ShimuraThm1Printed) (hQ : ShimuraQuotientByC) :
    ShimuraThm1AsPrinted := by
  intro N χ f hN hf X _ jX tX hC hX P₀ J aj hJ ξ hξ
  obtain ⟨hK, A, ν, θ, hc, hu⟩ := hP N χ f hN hf X jX tX hC hX P₀ J aj hJ ξ hξ
  exact ⟨hK, A, ν, θ, hc, hQ N χ f hN hf X jX tX hC hX P₀ J aj hJ ξ hξ A ν θ hc, hu⟩

/-- Forget the proof construction in the combined input. -/
theorem printed_of_asPrinted (hP : ShimuraThm1AsPrinted) : ShimuraThm1Printed := by
  intro N χ f hN hf X _ jX tX hC hX P₀ J aj hJ ξ hξ
  obtain ⟨hK, A, ν, θ, hc, _, hu⟩ := hP N χ f hN hf X jX tX hC hX P₀ J aj hJ ξ hξ
  exact ⟨hK, A, ν, θ, hc, hu⟩

/-- The quotient row from the split inputs and the two comparison results. -/
theorem shimuraThm1Af_of_split (hP : ShimuraThm1Printed) (hQ : ShimuraQuotientByC)
    (hH : ShimuraHeckeRelations) (hF : SameDimSurjectiveFinite) : R16Thm1b.ShimuraThm1Af :=
  shimuraThm1Af_of_printed (asPrinted_of_split hP hQ) hH hF

/-- The quotient row from the printed clauses and the p. 526 construction. -/
theorem shimuraThm1Af_of_split_closed (hP : ShimuraThm1Printed) (hQ : ShimuraQuotientByC) :
    R16Thm1b.ShimuraThm1Af :=
  shimuraThm1Af_of_split hP hQ shimuraHeckeRelations sameDimSurjectiveFinite

end ShimuraSteps
