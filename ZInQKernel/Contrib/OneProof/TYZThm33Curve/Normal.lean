import ZInQKernel.Contrib.OneProof.TYZThm33Curve.Charts
import Mathlib.RingTheory.DedekindDomain.Dvr
import Mathlib.RingTheory.DiscreteValuationRing.TFAE
import ZInQKernel.Contrib.TauCeti.AlgebraicGeometry.EllipticCurve.Affine.CoordinateRing

/-!
# h33-d1: the local rings of `ESch E` are valuation rings (`E` elliptic over `ℚ`)

The inverse direction of D1: `ESch E = Proj ℚ[X, Y, Z]/(F_E)` is a normal curve.

* On `D₊(Z)`: `A_(Z) ≅ ℚ[x, y]/(W_E)` is a Dedekind domain (Tau Ceti's
  `isIntegrallyClosed_coordinateRing`), so its localizations at primes are fields or DVRs.
* Off `D₊(Z)` (the point `O = [0 : 1 : 0]`, G4(b)): in the chart `D₊(Y)`, with `u = X/Y`,
  `v = Z/Y`, the prime contains `u, v`, and `v · w = u³` with `w ≡ 1`, so the maximal ideal of the
  local ring is generated by `u`; a noetherian local domain with principal maximal ideal is a
  valuation ring.

`valuationRing_stalk_ESch : ∀ p : ESch E, ValuationRing ((ESch E).presheaf.stalk p)`.
-/

noncomputable section

set_option backward.isDefEq.respectTransparency false

open AlgebraicGeometry CategoryTheory HomogeneousLocalization

namespace ZInQ.H33D1

open ZInQ.GZSch

/-! ## §1. Commutative algebra -/

theorem valuationRing_of_ringEquiv {A B : Type*} [CommRing A] [CommRing B] [IsDomain A]
    [IsDomain B] (e : A ≃+* B) [ValuationRing A] : ValuationRing B := by
  rw [ValuationRing.iff_dvd_total]
  refine ⟨fun a b => ?_⟩
  rcases (ValuationRing.iff_dvd_total.mp (inferInstance : ValuationRing A)).total (e.symm a)
    (e.symm b) with h | h
  · left; simpa using map_dvd e h
  · right; simpa using map_dvd e h

theorem valuationRing_of_isField {A : Type*} [CommRing A] [IsDomain A] (h : IsField A) :
    ValuationRing A := by
  rw [ValuationRing.iff_dvd_total]
  refine ⟨fun a b => ?_⟩
  by_cases ha : a = 0
  · right; rw [ha]; exact dvd_zero b
  · left
    obtain ⟨c, hc⟩ := h.mul_inv_cancel ha
    exact ⟨c * b, by rw [← mul_assoc, hc, one_mul]⟩

/-- **The localization of a Dedekind domain at a prime is a valuation ring.** -/
theorem valuationRing_localization_dedekind {R : Type*} [CommRing R] [IsDedekindDomain R]
    (P : Ideal R) [P.IsPrime] (S : Type*) [CommRing S] [IsDomain S] [Algebra R S]
    [IsLocalization.AtPrime S P] : ValuationRing S := by
  by_cases hP : P = ⊥
  · subst hP
    haveI := IsLocalization.AtPrime.isLocalRing S (⊥ : Ideal R)
    apply valuationRing_of_isField
    rw [IsLocalRing.isField_iff_maximalIdeal_eq,
      ← IsLocalization.AtPrime.map_eq_maximalIdeal (⊥ : Ideal R) S, Ideal.map_bot]
  · haveI := IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain R hP S
    infer_instance

/-- **A noetherian local domain with principal maximal ideal is a valuation ring.** -/
theorem valuationRing_of_maximalIdeal_principal {T : Type*} [CommRing T] [IsDomain T]
    [IsNoetherianRing T] [IsLocalRing T] (h : (IsLocalRing.maximalIdeal T).IsPrincipal) :
    ValuationRing T := by
  rw [ValuationRing.iff_dvd_total]
  refine ⟨fun a b => ?_⟩
  by_cases ha : a = 0
  · right; rw [ha]; exact dvd_zero b
  by_cases hb : b = 0
  · left; rw [hb]; exact dvd_zero a
  obtain ⟨i, hi⟩ := exists_maximalIdeal_pow_eq_of_principal T h (Ideal.span {a})
    (by rwa [Ne, Ideal.span_singleton_eq_bot])
  obtain ⟨j, hj⟩ := exists_maximalIdeal_pow_eq_of_principal T h (Ideal.span {b})
    (by rwa [Ne, Ideal.span_singleton_eq_bot])
  rcases le_total i j with hij | hij
  · left
    have hb' : b ∈ Ideal.span {a} := by
      rw [hi]
      exact Ideal.pow_le_pow_right hij (hj ▸ Ideal.mem_span_singleton_self b)
    exact Ideal.mem_span_singleton.mp hb'
  · right
    have ha' : a ∈ Ideal.span {b} := by
      rw [hj]
      exact Ideal.pow_le_pow_right hij (hi ▸ Ideal.mem_span_singleton_self a)
    exact Ideal.mem_span_singleton.mp ha'

/-! ## §2. Local rings through an open immersion -/

/-- `Localization.AtPrime q ≃ 𝒪_{X, j q}` for an open immersion `j : Spec R ⟶ X`. -/
def locEquivStalk {X : Scheme.{0}} {R : CommRingCat.{0}} (j : Spec R ⟶ X) [IsOpenImmersion j]
    (q : Spec R) : Localization.AtPrime q.asIdeal ≃+* X.presheaf.stalk (j q) :=
  ((StructureSheaf.stalkIso R q).toRingEquiv :
      Localization.AtPrime q.asIdeal ≃+* (Spec R).presheaf.stalk q).trans
    (asIso (j.stalkMap q)).commRingCatIsoToRingEquiv.symm

theorem isDomain_loc_of_chart {X : Scheme.{0}} [IsIntegral X] {R : CommRingCat.{0}}
    (j : Spec R ⟶ X) [IsOpenImmersion j] (q : Spec R) : IsDomain (Localization.AtPrime q.asIdeal) :=
  MulEquiv.isDomain (X.presheaf.stalk (j q)) (locEquivStalk j q).toMulEquiv

theorem valuationRing_of_chart {X : Scheme.{0}} [IsIntegral X] {R : CommRingCat.{0}}
    (j : Spec R ⟶ X) [IsOpenImmersion j] (q : Spec R)
    (h : ∀ [IsDomain (Localization.AtPrime q.asIdeal)], ValuationRing (Localization.AtPrime q.asIdeal)) :
    ValuationRing (X.presheaf.stalk (j q)) := by
  haveI := isDomain_loc_of_chart j q
  haveI := @h _
  exact valuationRing_of_ringEquiv (locEquivStalk j q)

/-! ## §3. The chart `D₊(Z)` -/

variable (E : WeierstrassCurve ℚ)

instance isDedekindDomain_CR [E.IsElliptic] : IsDedekindDomain (CR E) := by
  haveI : IsIntegrallyClosed (CR E) :=
    WeierstrassCurve.Affine.isIntegrallyClosed_coordinateRing E.toAffine
  exact WeierstrassCurve.Affine.isDedekindDomain_coordinateRing_of_isIntegrallyClosed E.toAffine

theorem valuationRing_loc_AZ [E.IsElliptic] (q : Spec (CommRingCat.of (AZ E)))
    [IsDomain (Localization.AtPrime q.asIdeal)] : ValuationRing (Localization.AtPrime q.asIdeal) := by
  set T := Localization.AtPrime q.asIdeal
  set e := azEquiv E
  have hloc : IsLocalization.AtPrime T q.asIdeal := inferInstance
  letI : Algebra (CR E) T := ((algebraMap (AZ E) T).comp e.symm.toRingHom).toAlgebra
  haveI : (q.asIdeal.comap e.symm.toRingHom).IsPrime := Ideal.comap_isPrime _ _
  have hmap : q.asIdeal.primeCompl.map e = (q.asIdeal.comap e.symm.toRingHom).primeCompl := by
    ext x
    simp only [Submonoid.mem_map, Ideal.primeCompl, Submonoid.mem_mk, Subsemigroup.mem_mk,
      Set.mem_compl_iff, SetLike.mem_coe, Ideal.mem_comap]
    constructor
    · rintro ⟨y, hy, rfl⟩
      simpa using hy
    · intro hx
      exact ⟨e.symm x, hx, by simp⟩
  have h2 : IsLocalization.AtPrime T (q.asIdeal.comap e.symm.toRingHom) := by
    have := (IsLocalization.isLocalization_iff_of_base_ringEquiv q.asIdeal.primeCompl T e).mp hloc
    rw [hmap] at this
    exact this
  exact valuationRing_localization_dedekind (q.asIdeal.comap e.symm.toRingHom) T

theorem valuationRing_stalk_chartZ [E.IsElliptic] (q : Spec (CommRingCat.of (AZ E))) :
    ValuationRing ((ESch E).presheaf.stalk (chartZ E q)) := by
  exact valuationRing_of_chart (chartZ E) q (valuationRing_loc_AZ E q)

end ZInQ.H33D1
