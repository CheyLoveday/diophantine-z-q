/-- **From any square root of `c (27X + 16)` in `E` to one with constant prime to `p`** (`p ≥ 5`): the residue
fields over `0` are unramified at `p` (`_root_.SGRDirect.exists_point_zero_unram_r5`) and contain `√c`, so `v_p(c)` is even. -/
theorem _root_.SGRDirect.exists_good_sqrt_r5 (hRR : _root_.LeafQM.AV.R1R2fp_r5) (hT : ObjBridge.TorsionStructure)
    {Y : Over (Spec (CommRingCat.of ℚ))} {Φ : PtEquiv Y} {π : ToP1 Y.left}
    (h1 : R1fpProps Y Φ) (h2 : R2fpProps Y Φ π)
    (E : Type) [Field E] [Algebra (RatFunc ℚ) E] [Algebra ℚ[X] E]
    [IsScalarTower ℚ[X] (RatFunc ℚ) E] (hN : NormalizationModel Y π E)
    (p : ℕ) (hp : p.Prime) (hp5 : 5 ≤ p) (c : ℚ) (hc : c ≠ 0) (s : E)
    (hs : s ^ 2 = algebraMap ℚ[X] E (C c * (C 27 * Polynomial.X + C 16))) :
    ∃ (a : ℤ) (s' : E), ¬ (p : ℤ) ∣ a ∧
