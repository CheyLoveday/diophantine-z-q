/-- **A point over `0` with unramified residue field**, on every triple (from `_root_.LeafQM.AV.R1R2fp_r5` and T5). -/
theorem _root_.SGRDirect.exists_point_zero_unram_r5 (hRR : _root_.LeafQM.AV.R1R2fp_r5) (hT : ObjBridge.TorsionStructure)
    {Y : Over (Spec (CommRingCat.of ℚ))} {Φ : PtEquiv Y} {π : ToP1 Y.left}
    (h1 : R1fpProps Y Φ) (h2 : R2fpProps Y Φ π) :
    ∃ y : fieldPt Qbar ⟶ Y, π.val (K := Qbar) y.left = OnePoint.some 0 ∧
      UnramifiedAbove5 (residueImage (X := Y.left) y.left) := by
