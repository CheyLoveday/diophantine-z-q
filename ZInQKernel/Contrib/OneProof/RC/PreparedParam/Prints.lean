/-- A field-valued point of a scheme over `ℚ`. -/
def FieldPoint {X : Scheme.{0}} (p : X ⟶ Spec (.of ℚ))
    (F : Type) [Field F] [Algebra ℚ F] :=
  {x : Spec (.of F) ⟶ X // x ≫ p = Spec.map (CommRingCat.ofHom (algebraMap ℚ F))}

/-- Change the field of a point by precomposing with the map of spectra. -/
def FieldPoint.map {X : Scheme.{0}} {p : X ⟶ Spec (.of ℚ)}
    {F G : Type} [Field F] [Field G] [Algebra ℚ F] [Algebra ℚ G]
    (ι : F →ₐ[ℚ] G) (x : FieldPoint p F) : FieldPoint p G :=
  ⟨Spec.map (CommRingCat.ofHom ι.toRingHom) ≫ x.val, by
    rw [Category.assoc, x.property, ← Spec.map_comp]
    exact congrArg Spec.map (CommRingCat.hom_ext (Subsingleton.elim _ _))⟩

/-- Apply a morphism over the rational numbers to a field-valued point. -/
def FieldPoint.comp {X Y : Scheme.{0}} {p : X ⟶ Spec (.of ℚ)} {q : Y ⟶ Spec (.of ℚ)}
    {F : Type} [Field F] [Algebra ℚ F]
    (π : X ⟶ Y) (hπ : π ≫ q = p) (x : FieldPoint p F) : FieldPoint q F :=
  ⟨x.val ≫ π, by rw [Category.assoc, hπ, x.property]⟩

/-- Evaluate a section at a field-valued point in its open domain. -/
def FieldPoint.evalSection {X : Scheme.{0}} {p : X ⟶ Spec (.of ℚ)}
    {F : Type} [Field F] [Algebra ℚ F]
    (x : FieldPoint p F) (U : X.Opens) (h : x.val default ∈ U) (r : Γ(X, U)) : F :=
  (Scheme.ΓSpecIso (.of F)).hom (x.val.appLE U ⊤ (by
    intro v _
    show x.val v ∈ U
    rwa [Subsingleton.elim v (default : Spec (.of F))]) r)

/-- The rational model and complex uniformization of `X₀(N)` used in the
manuscript. The field identification uses the rational expansions of `j,j_N`.
The chart is the usual one: the class of `τ` is the torus with lattice
`ℤ + ℤτ` and cyclic subgroup generated by `1/N`. To pin the chart to the
rational model, pullbacks of regular sections are evaluated by the
meromorphic continuation of their rational expansions at infinity. -/
structure X0Model (N : ℕ) [NeZero N] where
  X : Scheme.{0}
  overQ : X ⟶ Spec (.of ℚ)
  [integral : IsIntegral X]
  proper : IsProper overQ
  smooth : Smooth overQ
  functionField : X.functionField ≃+* ModularCurve.modularFunctionField N
  complexPoint : UpperHalfPlane → FieldPoint overQ ℂ
  complexPoint_eq_iff (τ σ : UpperHalfPlane) :
    complexPoint τ = complexPoint σ ↔
      ∃ γ ∈ CongruenceSubgroup.Gamma0 N, γ • τ = σ
  sectionExpansion (U : X.Opens) [Nonempty U] (r : Γ(X, U)) :
    ∃ (g : ℂ → ℂ) (T : ℝ), MeromorphicOn g {z : ℂ | 0 < z.im} ∧
      (∀ τ : UpperHalfPlane, T < τ.im →
        HasSum (fun n : ℤ =>
          (((functionField (X.germToFunctionField U r) : LaurentSeries ℚ).coeff n : ℚ) : ℂ) *
            Complex.exp (2 * Real.pi * Complex.I * (n : ℂ) * (τ : ℂ))) (g τ)) ∧
      ∀ (τ : UpperHalfPlane) (h : (complexPoint τ).val default ∈ U),
        AnalyticAt ℂ g (τ : ℂ) ∧
          (complexPoint τ).evalSection U h r = g τ

/-- **Printed-form leaf, GLUE (unread): field of definition on `X₀(N)`.**
Tex 2915–2919, split case of the CM points used in Cai–Chen–Liu,
*Heegner points on modular curves*, Trans. AMS 370 (2018), §2
(exact field-of-definition passage and its citation UNVERIFIED). Theorem
2.15, p. 3730 is the trace relation cited there. Fallback: Shimura,
*Introduction to the Arithmetic Theory of Automorphic Functions* (1971),
Ch. 6 (theorem and page UNVERIFIED).

In the canonical model, a CM point represented by a primitive Heegner
form of negative discriminant `d` prime to the level is defined over the
ring class field of the order of discriminant `d`. The embedding into `ℂ`
expresses this assertion for the abstract class field used in Lean.
Only the field-of-definition clause is used; no Artin action or trace
formula is assumed here. -/
def CMFieldOfDefinition {N : ℕ} [NeZero N] (X : X0Model N) : Prop :=
  ∀ (K : Type) [Field K] [NumberField K],
    Module.finrank ℚ K = 2 → IsTotallyComplex K →
    ∀ (O : NumberFieldOrder K) (d A B C : ℤ), O.discr = d → d < 0 →
      IsCoprime d (N : ℤ) → IsHeegnerForm N d A B C →
      let H := ringClassField O
      ∃ (ι : H →ₐ[ℚ] ℂ) (x : FieldPoint X.overQ H),
        x.map ι = X.complexPoint (cmPoint A B d)

