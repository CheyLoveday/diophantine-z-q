import Mathlib.NumberTheory.Height.NumberField
import Mathlib.NumberTheory.NumberField.InfinitePlace.Ramification
import Mathlib.RingTheory.Localization.Integer

/-!
# Galois invariance of heights on number fields

Let `K` be a number field and `σ : K ≃ₐ[ℚ] K` a field automorphism. We prove that the
multiplicative height (in the sense of `Mathlib.NumberTheory.Height`) of a tuple of elements
of `K` does not change when `σ` is applied to every entry, and deduce the corresponding
statements for the multiplicative and logarithmic heights of a single element
(`mulHeight_comp_algEquiv`, `mulHeight₁_algEquiv`, `logHeight₁_algEquiv`). As corollaries we
record the logarithmic version for tuples and the versions for arbitrary ring automorphisms
of `K` (which are automatically `ℚ`-linear).

The proof splits the height of a nonzero tuple into its archimedean and nonarchimedean parts
(`NumberField.mulHeight_eq`).
* The archimedean part is invariant because `σ` permutes the infinite places, preserving
  their multiplicities.
* For the nonarchimedean part we first scale the tuple by a nonzero algebraic integer to make
  it integral (the height is invariant under scaling). For an integral tuple the
  nonarchimedean part is the inverse of the absolute norm of the ideal generated by the
  entries (`NumberField.absNorm_mul_finprod_finitePlace_eq_one`), and the absolute norm is
  invariant under the ring automorphism of `𝓞 K` induced by `σ`.
-/

open Height NumberField

namespace ZInQ.Manuscript.RC.Height

section Auxiliary

variable {K : Type*} [Field K] [NumberField K]

/-- The absolute norm of an ideal of `𝓞 K` is invariant under ring automorphisms of `𝓞 K`.
PROVED. -/
lemma absNorm_map_ringEquiv (e : 𝓞 K ≃+* 𝓞 K) (I : Ideal (𝓞 K)) :
    Ideal.absNorm (I.map e) = Ideal.absNorm I := by
  rw [Ideal.absNorm_apply, Ideal.absNorm_apply, Submodule.cardQuot_apply,
    Submodule.cardQuot_apply]
  exact (Nat.card_congr (Ideal.quotientEquiv I (I.map e) e rfl).toEquiv).symm

/-- The archimedean part of the height of a tuple is invariant under field automorphisms.
PROVED. -/
lemma prod_infinitePlace_comp_algEquiv (σ : K ≃ₐ[ℚ] K) {ι : Type*} (x : ι → K) :
    ∏ v : InfinitePlace K, (⨆ i, v (σ (x i))) ^ v.mult =
      ∏ v : InfinitePlace K, (⨆ i, v (x i)) ^ v.mult := by
  have hm (v : InfinitePlace K) : (σ.symm • v).mult = v.mult := by
    rw [InfinitePlace.mult, InfinitePlace.mult, InfinitePlace.isReal_smul_iff]
  refine Fintype.prod_equiv (MulAction.toPerm σ⁻¹) _ _ fun v => ?_
  simp only [MulAction.toPerm_apply, InfinitePlace.smul_apply, AlgEquiv.aut_inv,
    AlgEquiv.symm_symm, hm]

/-- The nonarchimedean part of the height of a nonzero tuple of algebraic integers is invariant
under field automorphisms. PROVED. -/
lemma finprod_finitePlace_comp_algEquiv_of_integral (σ : K ≃ₐ[ℚ] K) {ι : Type*} [Finite ι]
    {y : ι → 𝓞 K} (hy : y ≠ 0) :
    ∏ᶠ v : FinitePlace K, ⨆ i, v (σ (y i : K)) = ∏ᶠ v : FinitePlace K, ⨆ i, v (y i : K) := by
  let e : 𝓞 K ≃+* 𝓞 K := RingOfIntegers.mapRingEquiv σ.toRingEquiv
  have hey : (fun i => e (y i)) ≠ 0 := by
    obtain ⟨i, hi⟩ := Function.ne_iff.mp hy
    exact Function.ne_iff.mpr ⟨i, by simpa using hi⟩
  have h1 := absNorm_mul_finprod_finitePlace_eq_one hy
  have h2 := absNorm_mul_finprod_finitePlace_eq_one hey
  have hspan : Ideal.span (Set.range fun i => e (y i)) = (Ideal.span (Set.range y)).map e := by
    rw [Ideal.map_span, ← Set.range_comp]
    rfl
  rw [hspan, absNorm_map_ringEquiv] at h2
  have hN : ((Ideal.span (Set.range y)).absNorm : ℝ) ≠ 0 := left_ne_zero_of_mul_eq_one h1
  exact mul_left_cancel₀ hN (h2.trans h1.symm)

end Auxiliary

/-- The multiplicative height of a tuple of elements of a number field is invariant under
field automorphisms applied entrywise. PROVED. -/
theorem mulHeight_comp_algEquiv {K : Type*} [Field K] [NumberField K] (σ : K ≃ₐ[ℚ] K)
    {ι : Type*} [Finite ι] (x : ι → K) :
    Height.mulHeight (fun i => σ (x i)) = Height.mulHeight x := by
  rcases eq_or_ne x 0 with rfl | hx
  · simp
  obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples_of_finite (nonZeroDivisors (𝓞 K)) x
  have hb' : ∀ i, ∃ z : 𝓞 K, algebraMap (𝓞 K) K z = (b : 𝓞 K) • x i := fun i => hb i
  choose y hy using hb'
  set c : K := algebraMap (𝓞 K) K b with hc_def
  have hb0 : (b : 𝓞 K) ≠ 0 := nonZeroDivisors.coe_ne_zero b
  have hc : c ≠ 0 := by
    simp [hc_def, hb0]
  have hσc : σ c ≠ 0 := (map_ne_zero σ).mpr hc
  have hy' (i : ι) : (y i : K) = c * x i := by
    rw [RingOfIntegers.coe_eq_algebraMap, hy i, Algebra.smul_def]
  have hcx : c • x = fun i => (y i : K) := by
    ext i
    simp [hy']
  have hσcx : σ c • (fun i => σ (x i)) = fun i => σ (y i : K) := by
    ext i
    simp [hy', map_mul]
  have hyK : (fun i => (y i : K)) ≠ 0 := by
    rw [← hcx]
    exact smul_ne_zero hc hx
  have hσyK : (fun i => σ (y i : K)) ≠ 0 := by
    obtain ⟨i, hi⟩ := Function.ne_iff.mp hyK
    exact Function.ne_iff.mpr ⟨i, by simpa using hi⟩
  have hy0 : y ≠ 0 := by
    obtain ⟨i, hi⟩ := Function.ne_iff.mp hyK
    exact Function.ne_iff.mpr ⟨i, by simpa using hi⟩
  rw [← mulHeight_smul_eq_mulHeight x hc, ← mulHeight_smul_eq_mulHeight _ hσc, hcx, hσcx,
    NumberField.mulHeight_eq hyK, NumberField.mulHeight_eq hσyK,
    prod_infinitePlace_comp_algEquiv σ (fun i => (y i : K)),
    finprod_finitePlace_comp_algEquiv_of_integral σ hy0]

/-- The multiplicative height of an element of a number field is invariant under field
automorphisms. PROVED. -/
theorem mulHeight₁_algEquiv {K : Type*} [Field K] [NumberField K] (σ : K ≃ₐ[ℚ] K) (x : K) :
    Height.mulHeight₁ (σ x) = Height.mulHeight₁ x := by
  rw [mulHeight₁_eq_mulHeight, mulHeight₁_eq_mulHeight, ← mulHeight_comp_algEquiv σ ![x, 1]]
  congr 1
  ext i
  fin_cases i <;> simp

/-- The logarithmic height of an element of a number field is invariant under field
automorphisms. PROVED. -/
theorem logHeight₁_algEquiv {K : Type*} [Field K] [NumberField K] (σ : K ≃ₐ[ℚ] K) (x : K) :
    Height.logHeight₁ (σ x) = Height.logHeight₁ x := by
  rw [logHeight₁_eq_log_mulHeight₁, logHeight₁_eq_log_mulHeight₁, mulHeight₁_algEquiv]

/-! ### Corollaries -/

/-- The logarithmic height of a tuple of elements of a number field is invariant under field
automorphisms applied entrywise. PROVED. -/
theorem logHeight_comp_algEquiv {K : Type*} [Field K] [NumberField K] (σ : K ≃ₐ[ℚ] K)
    {ι : Type*} [Finite ι] (x : ι → K) :
    Height.logHeight (fun i => σ (x i)) = Height.logHeight x := by
  rw [logHeight_eq_log_mulHeight, logHeight_eq_log_mulHeight, mulHeight_comp_algEquiv]

/-- Every ring automorphism of a number field preserves the multiplicative height of tuples.
PROVED. -/
theorem mulHeight_comp_ringEquiv {K : Type*} [Field K] [NumberField K] (σ : K ≃+* K)
    {ι : Type*} [Finite ι] (x : ι → K) :
    Height.mulHeight (fun i => σ (x i)) = Height.mulHeight x :=
  mulHeight_comp_algEquiv σ.toRatAlgEquiv x

/-- Every ring automorphism of a number field preserves the logarithmic height of tuples.
PROVED. -/
theorem logHeight_comp_ringEquiv {K : Type*} [Field K] [NumberField K] (σ : K ≃+* K)
    {ι : Type*} [Finite ι] (x : ι → K) :
    Height.logHeight (fun i => σ (x i)) = Height.logHeight x :=
  logHeight_comp_algEquiv σ.toRatAlgEquiv x

/-- Every ring automorphism of a number field preserves the multiplicative height of elements.
PROVED. -/
theorem mulHeight₁_ringEquiv {K : Type*} [Field K] [NumberField K] (σ : K ≃+* K) (x : K) :
    Height.mulHeight₁ (σ x) = Height.mulHeight₁ x :=
  mulHeight₁_algEquiv σ.toRatAlgEquiv x

/-- Every ring automorphism of a number field preserves the logarithmic height of elements.
PROVED. -/
theorem logHeight₁_ringEquiv {K : Type*} [Field K] [NumberField K] (σ : K ≃+* K) (x : K) :
    Height.logHeight₁ (σ x) = Height.logHeight₁ x :=
  logHeight₁_algEquiv σ.toRatAlgEquiv x

end ZInQ.Manuscript.RC.Height
