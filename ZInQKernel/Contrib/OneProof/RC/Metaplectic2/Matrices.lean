import Mathlib.LinearAlgebra.Matrix.SpecialLinearGroup
import Mathlib.RingTheory.LocalRing.Basic

/-! Integral generators in tex 8944–8946; the local-ring reduction is
on-the-spot (c). These matrix identities do not use a chosen cover. -/

namespace ZInQ.Manuscript.RC.Metaplectic2

open Matrix
open scoped MatrixGroups

variable {A : Type*} [CommRing A]

def upperMatrix (b : A) : SL(2, A) :=
  ⟨!![1, b; 0, 1], by simp [Matrix.det_fin_two_of]⟩

def weylMatrix : SL(2, A) :=
  ⟨!![0, 1; -1, 0], by simp [Matrix.det_fin_two_of]⟩

def diagonalMatrix (t : Aˣ) : SL(2, A) :=
  ⟨!![(t : A), 0; 0, ((t⁻¹ : Aˣ) : A)], by simp [Matrix.det_fin_two_of, ← Units.val_mul]⟩

private def lowerMatrix (b : A) : SL(2, A) :=
  ⟨!![1, 0; b, 1], by simp [Matrix.det_fin_two_of]⟩

private theorem lower_eq (b : A) :
    lowerMatrix b = weylMatrix * upperMatrix (-b) * weylMatrix⁻¹ := by
  have hi : (((weylMatrix : SL(2, A))⁻¹ : SL(2, A)) : Matrix (Fin 2) (Fin 2) A) =
      !![0, -1; 1, 0] := by
    rw [Matrix.SpecialLinearGroup.SL2_inv_expl]
    ext i j
    fin_cases i <;> fin_cases j <;> simp [weylMatrix]
  apply Subtype.ext
  change (lowerMatrix b : Matrix (Fin 2) (Fin 2) A) =
    ((weylMatrix * upperMatrix (-b) * weylMatrix⁻¹ : SL(2, A)) : Matrix (Fin 2) (Fin 2) A)
  rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul, hi]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp only [Matrix.mul_apply, Fin.sum_univ_two] <;>
    simp [lowerMatrix, weylMatrix, upperMatrix]

private theorem of_unit_pivot (g : SL(2, A)) (t : Aˣ) (ht : g 0 0 = ↑t) :
    g = lowerMatrix (g 1 0 * ↑(t⁻¹ : Aˣ)) * diagonalMatrix t *
      upperMatrix ((↑(t⁻¹ : Aˣ) : A) * g 0 1) := by
  have hh : (t : A) * ↑(t⁻¹ : Aˣ) = 1 := by simp [← Units.val_mul]
  have hd := g.property
  rw [Matrix.det_fin_two, ← show (g : Matrix (Fin 2) (Fin 2) A) 0 0 = g 0 0 from rfl,
    ht] at hd
  have he : (↑(t⁻¹ : Aˣ) : A) * (1 + g 0 1 * g 1 0) = g 1 1 := by
    change (t : A) * g 1 1 - g 0 1 * g 1 0 = 1 at hd
    calc
      _ = (↑(t⁻¹ : Aˣ) : A) * ((t : A) * g 1 1) := by rw [← eq_add_of_sub_eq hd]
      _ = _ := by rw [← mul_assoc, mul_comm (↑(t⁻¹ : Aˣ) : A), hh, one_mul]
  have hl : (g 1 0 * ↑(t⁻¹ : Aˣ)) * (t : A) = g 1 0 := by
    rw [mul_assoc, mul_comm (↑(t⁻¹ : Aˣ) : A), hh, mul_one]
  apply Subtype.ext
  change (g : Matrix (Fin 2) (Fin 2) A) =
    ((lowerMatrix (g 1 0 * ↑(t⁻¹ : Aˣ)) * diagonalMatrix t *
      upperMatrix ((↑(t⁻¹ : Aˣ) : A) * g 0 1) : SL(2, A)) : Matrix (Fin 2) (Fin 2) A)
  rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul]
  ext i j
  fin_cases i <;> fin_cases j
  · simpa [lowerMatrix, diagonalMatrix, upperMatrix, Matrix.mul_apply, Fin.sum_univ_two] using ht
  · simp [lowerMatrix, diagonalMatrix, upperMatrix, Matrix.mul_apply, Fin.sum_univ_two,
      ← mul_assoc, hh]
  · simp [lowerMatrix, diagonalMatrix, upperMatrix, Matrix.mul_apply, Fin.sum_univ_two, hl]
  · simp only [lowerMatrix, diagonalMatrix, upperMatrix, Matrix.mul_apply, Fin.sum_univ_two]
    simp [hl]
    rw [← he]
    ring

/-- Every matrix over a commutative local ring is generated by upper
unipotents, unit diagonals and the indicated Weyl matrix. -/
theorem integral_generators [IsLocalRing A] (H : Subgroup (SL(2, A)))
    (hu : ∀ b, upperMatrix b ∈ H) (hd : ∀ t, diagonalMatrix t ∈ H)
    (hw : weylMatrix ∈ H) (g : SL(2, A)) : g ∈ H := by
  have hpivot (g : SL(2, A)) (ht : IsUnit (g 0 0)) : g ∈ H := by
    obtain ⟨t, ht⟩ := ht
    rw [of_unit_pivot g t ht.symm, lower_eq]
    exact H.mul_mem (H.mul_mem (H.mul_mem (H.mul_mem hw (hu _)) (H.inv_mem hw)) (hd _)) (hu _)
  have hdet : g 0 0 * g 1 1 + -(g 0 1 * g 1 0) = 1 := by
    have h := g.property
    rwa [Matrix.det_fin_two, sub_eq_add_neg] at h
  rcases IsLocalRing.isUnit_or_isUnit_of_isUnit_add (hdet ▸ isUnit_one) with h | h
  · exact hpivot g (isUnit_of_mul_isUnit_left h)
  · have hc : IsUnit (g 1 0) := isUnit_of_mul_isUnit_right ((IsUnit.neg_iff _).mp h)
    have hwp : IsUnit ((((weylMatrix * g : SL(2, A)) : Matrix (Fin 2) (Fin 2) A) 0 0)) := by
      rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two]
      simpa [weylMatrix] using hc
    simpa using H.mul_mem (H.inv_mem hw) (hpivot (weylMatrix * g) hwp)


end ZInQ.Manuscript.RC.Metaplectic2
