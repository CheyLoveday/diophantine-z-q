import ZInQKernel.Contrib.OneProof.RC.HCMV21.GeometricTateChain
import ZInQKernel.Contrib.OneProof.RC.HCMV21.QuotientHomLattice

/-! At primes supporting a coprime ideal quotient, the denominator-cleared
right lattice consists of the integral maps with image in the reverse
Tate range. This gives the inverse ideal factor when the local labelled
scalar has the kernel of the geometric quotient. -/

namespace ZInQ.Manuscript.RC.HCMV21

open CategoryTheory PkgI3.AbVar
open scoped CategoryTheory.MonObj

variable {k : Type} [Field k] {A B : PkgI3.AbVar k}
  (p : ℕ) [Fact p.Prime]

private theorem span_levelHom_eq_span_hom_away_level
    (C : Subgroup (A.Pt k)) (D : Subgroup (B.Pt k))
    (N : ℕ) (hC : ∀ P ∈ C, P ^ N = 1) (hN : IsUnit (N : ℤ_[p])) :
    Submodule.span ℤ_[p] (tateHom p A B '' (levelHom C D : Set (Hom A B))) =
      Submodule.span ℤ_[p] (Set.range (tateHom p A B)) := by
  apply le_antisymm (Submodule.span_mono (Set.image_subset_range _ _))
  apply Submodule.span_le.mpr
  rintro _ ⟨f, rfl⟩
  have hf : N • f ∈ levelHom C D := by
    intro P hP
    change P ≫ (f.hom ^ N) ∈ D
    rw [MonObj.comp_pow, ← MonObj.pow_comp, hC P hP, MonObj.one_comp]
    exact D.one_mem
  let L := Submodule.span ℤ_[p] (tateHom p A B '' (levelHom C D : Set (Hom A B)))
  have h : tateHom p A B (N • f) ∈ L := Submodule.subset_span ⟨_, hf, rfl⟩
  rw [map_nsmul, ← Nat.cast_smul_eq_nsmul ℤ_[p]] at h
  have hm : (↑hN.unit⁻¹ : ℤ_[p]) * (N : ℤ_[p]) = 1 :=
    (congrArg ((↑hN.unit⁻¹ : ℤ_[p]) * ·) hN.unit_spec.symm).trans (Units.inv_mul hN.unit)
  change tateHom p A B f ∈ L
  simpa only [smul_smul, hm, one_smul] using L.smul_mem (↑hN.unit⁻¹ : ℤ_[p]) h

/-- In the integral Tate endomorphism coordinates of the source,
composition with the reverse isogeny gives exactly the maps into its
Tate range, at a prime where the level is invertible. -/
theorem mem_span_postcompose_levelHom_iff_range
    (v : Hom B A) (hv : Function.Injective (homT (ℓ := p) v))
    (C : Subgroup (A.Pt k)) (D : Subgroup (B.Pt k))
    (N : ℕ) (hC : ∀ P ∈ C, P ^ N = 1) (hN : IsUnit (N : ℤ_[p]))
    (hfull : Submodule.span ℤ_[p] (Set.range (tateHom p A B)) = ⊤)
    (f : A.T p →ₗ[ℤ_[p]] A.T p) :
    f ∈ Submodule.span ℤ_[p] (((tateHom p A A).comp (postcomposeToEnd v)) ''
        (levelHom C D : Set (Hom A B))) ↔
      LinearMap.range f ≤ LinearMap.range (homT (ℓ := p) v) := by
  let K := LinearMap.compRight ℤ_[p] (M := A.T p) (homT (ℓ := p) v)
  have hcomp (g : Hom A B) : tateHom p A A (postcomposeToEnd v g) = K (tateHom p A B g) := by
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    funext n
    change Additive.ofMul (Additive.toMul (x.1 n) ≫ (g.hom ≫ v.hom)) =
      Additive.ofMul ((Additive.toMul (x.1 n) ≫ g.hom) ≫ v.hom)
    rw [Category.assoc]
  have hset : ((tateHom p A A).comp (postcomposeToEnd v)) '' (levelHom C D : Set (Hom A B)) =
      K '' (tateHom p A B '' (levelHom C D : Set (Hom A B))) := by
    rw [Set.image_image]
    exact congrArg (fun ψ => ψ '' (levelHom C D : Set (Hom A B))) (funext hcomp)
  rw [hset, ← Submodule.map_span, span_levelHom_eq_span_hom_away_level p C D N hC hN,
    hfull, Submodule.map_top]
  constructor
  · rintro ⟨g, rfl⟩
    rintro _ ⟨x, rfl⟩
    exact ⟨g x, rfl⟩
  · intro hf
    let e := LinearEquiv.ofInjective _ hv
    refine ⟨e.symm.toLinearMap.comp (f.codRestrict _ (fun x => hf ⟨x, rfl⟩)), ?_⟩
    apply LinearMap.ext
    intro x
    exact congrArg Subtype.val (e.apply_symm_apply ⟨f x, hf ⟨x, rfl⟩⟩)

/-- A local endomorphism acting as the labelled quotient generator
on the relevant torsion determines the reverse range. Here (\beta)
acts as (m/\alpha), where (m=p^n c) and (c) is a unit. -/
theorem tateRange_reverse_eq_range_of_torsion_kernel
    (u : Hom A B) (v : Hom B A) (m n : ℕ) (c : ℤ_[p]ˣ)
    (hm : (m : ℤ_[p]) = (p : ℤ_[p]) ^ n * c)
    (hu : u.hom ≫ v.hom = ((m : ℤ) : A.End).hom)
    (hv : v.hom ≫ u.hom = ((m : ℤ) : B.End).hom)
    (α β : Module.End ℤ_[p] (A.T p))
    (hα : Function.Injective α) (hαβ : ∀ x, α (β x) = (m : ℤ_[p]) • x)
    (hker : ∀ x : A.T p, (α x).1 n = 0 ↔
      Additive.toMul (x.1 n) ∈ geometricKernel (L := AlgebraicClosure k) u) :
    LinearMap.range (homT (ℓ := p) v) = LinearMap.range β := by
  ext x
  rw [mem_tateRange_reverse_iff u v p m n c hm hu hv x, ← hker,
    PkgI3.Tate.coord_eq_zero_iff]
  constructor
  · rintro ⟨y, hy⟩
    refine ⟨(↑c⁻¹ : ℤ_[p]) • y, hα ?_⟩
    rw [hαβ, hm, mul_smul, smul_smul (↑c : ℤ_[p]), Units.mul_inv, one_smul]
    exact hy.symm
  · rintro ⟨y, rfl⟩
    exact ⟨(c : ℤ_[p]) • y, by rw [hαβ, hm, mul_smul]⟩

/-- The denominator-cleared quotient lattice is the principal module
generated by the action of `m/α`. The hypotheses concerning `α` test
it on the one torsion coordinate of the actual quotient. -/
theorem mem_span_postcompose_levelHom_iff_local_factor
    (u : Hom A B) (v : Hom B A) (m n : ℕ) (c : ℤ_[p]ˣ)
    (hm : (m : ℤ_[p]) = (p : ℤ_[p]) ^ n * c)
    (hu : u.hom ≫ v.hom = ((m : ℤ) : A.End).hom)
    (hv : v.hom ≫ u.hom = ((m : ℤ) : B.End).hom)
    (hTv : Function.Injective (homT (ℓ := p) v))
    (α β : Module.End ℤ_[p] (A.T p))
    (hα : Function.Injective α) (hβ : Function.Injective β)
    (hαβ : ∀ x, α (β x) = (m : ℤ_[p]) • x)
    (hker : ∀ x : A.T p, (α x).1 n = 0 ↔
      Additive.toMul (x.1 n) ∈ geometricKernel (L := AlgebraicClosure k) u)
    (C : Subgroup (A.Pt k)) (D : Subgroup (B.Pt k))
    (N : ℕ) (hC : ∀ P ∈ C, P ^ N = 1) (hN : IsUnit (N : ℤ_[p]))
    (hfull : Submodule.span ℤ_[p] (Set.range (tateHom p A B)) = ⊤)
    (f : Module.End ℤ_[p] (A.T p)) :
    f ∈ Submodule.span ℤ_[p] (((tateHom p A A).comp (postcomposeToEnd v)) ''
      (levelHom C D : Set (Hom A B))) ↔ ∃ g : Module.End ℤ_[p] (A.T p), β * g = f := by
  rw [mem_span_postcompose_levelHom_iff_range p v hTv C D N hC hN hfull f,
    tateRange_reverse_eq_range_of_torsion_kernel p u v m n c hm hu hv α β hα hαβ hker]
  constructor
  · intro hf
    let e := LinearEquiv.ofInjective β hβ
    refine ⟨e.symm.toLinearMap.comp (f.codRestrict _ (fun x => hf ⟨x, rfl⟩)), ?_⟩
    apply LinearMap.ext
    intro x
    exact congrArg Subtype.val (e.apply_symm_apply ⟨f x, hf ⟨x, rfl⟩⟩)
  · rintro ⟨g, rfl⟩ _ ⟨x, rfl⟩
    exact ⟨g x, rfl⟩

end ZInQ.Manuscript.RC.HCMV21
