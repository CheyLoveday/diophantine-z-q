import Mathlib

/-!
# Lane RC20: the localization of a UFD at a principal prime is a DVR

Manuscript (`diophantine_zq.tex`, 11/5 version):
* tex 2747–2748: "Put `Λ = ℤ₂[[t]]` and `𝒪 = \widehat{Λ_{(2)}}`" — the localization `Λ_{(2)}` at the
  height-one prime `(2)`;
* tex 4342–4343: "Put `A = Λ_{(t)}`, with residue field `ℚ₂` and fraction field `F`" and tex 4353 "Over the
  DVR `A`";
* tex 4977–4980: "`R = Λ_𝔭` ... Here `R` is a DVR" for every height-one prime `𝔭 ≠ (2)`.

All three rings are localizations of the UFD `Λ = ℤ₂[[t]]` at a principal prime `(p)` (in a UFD every
height-one prime is principal). This file proves, for an arbitrary domain `R` with well-founded
divisibility (e.g. a UFD) and a prime element `p`:

* `exists_eq_pow_mul_not_dvd` : every nonzero `a ∈ R` is `p^n b` with `p ∤ b`;
* `associated_pow_algebraMap_of_atPrime` : in any localization `L = R_{(p)}`, every nonzero element is
  associated to a power of (the image of) `p`;
* `irreducible_algebraMap_of_atPrime` : the image of `p` is irreducible in `R_{(p)}` (a uniformizer);
* `isDiscreteValuationRing_of_atPrime` : `R_{(p)}` is a discrete valuation ring;
* `maximalIdeal_eq_span_algebraMap_of_atPrime` : its maximal ideal is generated by `p`.

Everything here is `PROVED`.
-/

namespace ZInQ.Manuscript.RC.Rings

section PrincipalPrime

variable {R : Type*} [CommRing R] [IsDomain R] [WfDvdMonoid R]

/-- **Tex 2747–2748, 4342–4343, 4977–4980 (PROVED).** In a domain with well-founded divisibility (e.g. a
UFD such as `Λ = ℤ₂[[t]]`), every nonzero element is `p^n b` with `p ∤ b`, for a prime `p`. -/
theorem exists_eq_pow_mul_not_dvd {p : R} (hp : Prime p) {a : R} (ha : a ≠ 0) :
    ∃ (n : ℕ) (b : R), ¬ p ∣ b ∧ a = p ^ n * b :=
  WfDvdMonoid.max_power_factor ha hp.irreducible

variable {p : R} [hP : (Ideal.span {p}).IsPrime] (L : Type*) [CommRing L] [Algebra R L]
  [IsLocalization.AtPrime L (Ideal.span {p})]

/-- **Tex 2747–2748, 4342–4343, 4977–4980 (PROVED).** In a localization `L = R_{(p)}` at a principal
prime `(p)`, `p ≠ 0`, every nonzero element is associated to a power of the image of `p`: it is
`p^n b / s` with `b, s ∉ (p)`, and `b, s` become units. -/
theorem associated_pow_algebraMap_of_atPrime (hp0 : p ≠ 0) {x : L} (hx : x ≠ 0) :
    ∃ n : ℕ, Associated (algebraMap R L p ^ n) x := by
  have hp : Prime p := (Ideal.span_singleton_prime hp0).mp hP
  obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.surj (Ideal.span {p}).primeCompl x
  dsimp only at hs
  have hsu : IsUnit (algebraMap R L (s : R)) := IsLocalization.map_units L s
  have ha : a ≠ 0 := by
    rintro rfl
    rw [map_zero] at hs
    exact hx (hsu.mul_left_eq_zero.mp hs)
  obtain ⟨n, b, hb, rfl⟩ := exists_eq_pow_mul_not_dvd hp ha
  have hbP : b ∈ (Ideal.span {p}).primeCompl := by
    rw [Ideal.mem_primeCompl_iff, Ideal.mem_span_singleton]
    exact hb
  have hbu : IsUnit (algebraMap R L b) := IsLocalization.map_units L (⟨b, hbP⟩ :
    (Ideal.span {p}).primeCompl)
  have key : algebraMap R L p ^ n * algebraMap R L b = x * algebraMap R L (s : R) := by
    rw [hs, map_mul, map_pow]
  refine ⟨n, (associated_mul_unit_right _ _ hbu).trans ?_⟩
  rw [key]
  exact associated_mul_unit_left _ _ hsu

omit [WfDvdMonoid R] in
/-- **Tex 2747–2748, 4342–4343, 4977–4980 (PROVED).** The image of `p` in `R_{(p)}` is nonzero. -/
theorem algebraMap_ne_zero_of_atPrime (hp0 : p ≠ 0) : algebraMap R L p ≠ 0 := by
  rw [Ne, IsLocalization.to_map_eq_zero_iff L
    (Ideal.primeCompl_le_nonZeroDivisors (Ideal.span {p}))]
  exact hp0

omit [IsDomain R] [WfDvdMonoid R] in
/-- **Tex 2747–2748, 4342–4343, 4977–4980 (PROVED).** The image of `p` in `R_{(p)}` is not a unit. -/
theorem not_isUnit_algebraMap_of_atPrime : ¬ IsUnit (algebraMap R L p) := by
  rw [IsLocalization.AtPrime.isUnit_to_map_iff L (Ideal.span {p}), Ideal.mem_primeCompl_iff, not_not]
  exact Ideal.mem_span_singleton_self p

/-- **Tex 2747–2748, 4342–4343, 4977–4980 (PROVED).** In a domain, a nonzero nonunit `π` such that every
nonzero element is associated to a power of `π` is irreducible. -/
theorem irreducible_of_forall_associated_pow' {S : Type*} [CommRing S] [IsDomain S] {π : S}
    (h0 : π ≠ 0) (hu : ¬ IsUnit π) (h : ∀ x : S, x ≠ 0 → ∃ n : ℕ, Associated (π ^ n) x) :
    Irreducible π := by
  refine ⟨hu, fun a b hab => ?_⟩
  have ha : a ≠ 0 := by rintro rfl; exact h0 (by rw [hab, zero_mul])
  have hb : b ≠ 0 := by rintro rfl; exact h0 (by rw [hab, mul_zero])
  obtain ⟨i, hi⟩ := h a ha
  obtain ⟨j, hj⟩ := h b hb
  have hij : Associated (π ^ (i + j)) (π ^ 1) := by
    have h2 : Associated (π ^ i * π ^ j) (a * b) := hi.mul_mul hj
    rw [← hab, ← pow_add] at h2
    rwa [pow_one]
  have hle : i + j ≤ 1 := (pow_dvd_pow_iff h0 hu).mp hij.dvd
  rcases Nat.eq_zero_or_pos i with rfl | hi0
  · left
    exact hi.isUnit (by rw [pow_zero]; exact isUnit_one)
  · right
    have hj0 : j = 0 := by omega
    subst hj0
    exact hj.isUnit (by rw [pow_zero]; exact isUnit_one)

variable [IsDomain L]

/-- **Tex 2747–2748, 4342–4343, 4977–4980 (PROVED).** The image of `p` is a uniformizer
(an irreducible element) of `R_{(p)}`. -/
theorem irreducible_algebraMap_of_atPrime (hp0 : p ≠ 0) : Irreducible (algebraMap R L p) :=
  irreducible_of_forall_associated_pow' (algebraMap_ne_zero_of_atPrime L hp0)
    (not_isUnit_algebraMap_of_atPrime L) (fun _ hx => associated_pow_algebraMap_of_atPrime L hp0 hx)

/-- **Tex 2747–2748, 4342–4343, 4353, 4977–4980 (PROVED).** The localization of a domain with
well-founded divisibility (a UFD) at a principal prime `(p)`, `p ≠ 0`, is a discrete valuation ring. -/
theorem isDiscreteValuationRing_of_atPrime (hp0 : p ≠ 0) : IsDiscreteValuationRing L :=
  IsDiscreteValuationRing.ofHasUnitMulPowIrreducibleFactorization
    ⟨algebraMap R L p, irreducible_algebraMap_of_atPrime L hp0,
      fun hx => associated_pow_algebraMap_of_atPrime L hp0 hx⟩

/-- **Tex 2747–2748, 4342–4343, 4977–4980 (PROVED).** The maximal ideal of `R_{(p)}` is generated by
the image of `p`. -/
theorem maximalIdeal_eq_span_algebraMap_of_atPrime (hp0 : p ≠ 0) :
    haveI := isDiscreteValuationRing_of_atPrime L hp0
    IsLocalRing.maximalIdeal L = Ideal.span {algebraMap R L p} := by
  have := isDiscreteValuationRing_of_atPrime L hp0
  exact (irreducible_algebraMap_of_atPrime L hp0).maximalIdeal_eq

end PrincipalPrime

end ZInQ.Manuscript.RC.Rings
