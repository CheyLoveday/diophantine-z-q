import ZInQKernel.Contrib.OneProof.RC.ModelGeneric4.Homothety
import ZInQKernel.Contrib.OneProof.RC.ModelGeneric4.CoprimeLift
import ZInQKernel.Contrib.OneProof.RC.ModelGeneric4.LatticeQuotient
import ZInQKernel.Contrib.OneProof.RC.CMField2.CosetLattice

/-! # Every complex cyclic pair class is analytic

Given a class with source invariant `j(τ₀)` (j-surjectivity), represent it on the period curve of
`ℤτ₀ + ℤ` by a subgroup generated by `u((Aτ₀ + B)/N)` with `gcd(A, B, N) = 1`; lift `(A, B)` to the
bottom row of some `γ ∈ SL₂(ℤ)`; the homothety by `cτ₀ + d` identifies the class with the analytic
pair at `γτ₀`. -/

namespace WeierstrassCurve.ModelLevels.ModelGeneric4

open ModelGeneric2 UpperHalfPlane
open WeierstrassCurve.Affine
open ZInQ.Manuscript.RC

set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1000000
set_option synthInstance.maxHeartbeats 400000

/-- Unimodular change of basis: the lattice of τ₀ is the lattice of `γτ₀` scaled by `cτ₀ + d`. -/
theorem isScale_smul (τ₀ : ℍ) (γ : Matrix.SpecialLinearGroup (Fin 2) ℤ) :
    T5Glue.IsScale (PeriodPair.ofTau τ₀) (PeriodPair.ofTau (γ • τ₀))
      ((γ 1 0 : ℂ) * τ₀ + (γ 1 1 : ℂ)) := by
  obtain ⟨p, hp⟩ : ∃ p : ℤ, γ 0 0 = p := ⟨_, rfl⟩
  obtain ⟨q, hq⟩ : ∃ q : ℤ, γ 0 1 = q := ⟨_, rfl⟩
  obtain ⟨c, hc⟩ : ∃ c : ℤ, γ 1 0 = c := ⟨_, rfl⟩
  obtain ⟨d, hd⟩ : ∃ d : ℤ, γ 1 1 = d := ⟨_, rfl⟩
  have hdet : p * d - q * c = 1 := by
    have := γ.2
    rw [Matrix.det_fin_two, hp, hq, hc, hd] at this
    exact this
  have hα : (c : ℂ) * τ₀ + d ≠ 0 := by
    have := UpperHalfPlane.denom_ne_zero (Matrix.SpecialLinearGroup.mapGL ℝ γ) τ₀
    simpa [UpperHalfPlane.denom, hc, hd] using this
  have hτ' : ((γ • τ₀ : ℍ) : ℂ) * ((c : ℂ) * τ₀ + d) = (p : ℂ) * τ₀ + q := by
    rw [UpperHalfPlane.coe_specialLinearGroup_apply]
    simp only [algebraMap_int_eq, eq_intCast, Complex.ofReal_intCast, hp, hq, hc, hd]
    exact div_mul_cancel₀ _ hα
  rw [hc, hd]
  refine ⟨hα, Set.ext fun x => ?_⟩
  rw [SetLike.mem_coe, Set.mem_smul_set, PeriodPair.ofTau_lattice, Submodule.mem_span_pair]
  constructor
  · rintro ⟨m, n, rfl⟩
    refine ⟨((m * d - n * c : ℤ) : ℂ) * (γ • τ₀ : ℍ) + ((n * p - m * q : ℤ) : ℂ), ?_, ?_⟩
    · rw [SetLike.mem_coe, PeriodPair.ofTau_lattice, Submodule.mem_span_pair]
      exact ⟨m * d - n * c, n * p - m * q, by simp⟩
    · simp only [zsmul_eq_mul, smul_eq_mul, mul_one]
      have hdetC : (p : ℂ) * d - q * c = 1 := by exact_mod_cast hdet
      push_cast
      linear_combination (↑m * ↑d - ↑n * ↑c : ℂ) * hτ' + ((m : ℂ) * τ₀ + n) * hdetC
  · rintro ⟨y, hy, rfl⟩
    rw [SetLike.mem_coe, PeriodPair.ofTau_lattice, Submodule.mem_span_pair] at hy
    obtain ⟨m, n, rfl⟩ := hy
    refine ⟨m * p + n * c, m * q + n * d, ?_⟩
    simp only [zsmul_eq_mul, smul_eq_mul, mul_one]
    push_cast
    linear_combination (-(m : ℂ)) * hτ'

end WeierstrassCurve.ModelLevels.ModelGeneric4
