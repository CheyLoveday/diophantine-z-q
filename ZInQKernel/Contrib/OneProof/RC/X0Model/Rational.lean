/-! The algebraic part of the rational model at tex 1781–1786, 2837–2838,
and 2915–2919. Specializing the normalization construction to the
Laurent-series function field is on the spot (provenance (c)). -/

noncomputable section

open AlgebraicGeometry CategoryTheory IntermediateField ModularCurve
open ZInQ.Contrib.CloudW07JacobiansCurves

namespace ZInQ.Manuscript.RC.X0Model

private def ratFuncEquiv {k L : Type} [Field k] [Field L] [Algebra k L]
    (x : L) (hx : Transcendental k x) : RatFunc k ≃+* k⟮x⟯ :=
  (RatFunc.algEquivOfTranscendental x hx).toRingEquiv

private theorem ratFuncEquiv_X {k L : Type} [Field k] [Field L] [Algebra k L]
    (x : L) (hx : Transcendental k x) : (ratFuncEquiv x hx RatFunc.X : L) = x :=
  RatFunc.algEquivOfTranscendental_X x hx

/-- The rational function field in the first j-coordinate. -/
def jCoordinate : RatFunc ℚ ≃+* ℚ⟮jq⟯ :=
  ratFuncEquiv jq transcendental_jq

theorem jCoordinate_X : jCoordinate RatFunc.X = jGen :=
  Subtype.ext (ratFuncEquiv_X jq transcendental_jq)

private theorem extendScalars_pair {k L : Type} [Field k] [Field L] [Algebra k L]
    (x y : L) (h : k⟮x⟯ ≤ IntermediateField.adjoin k {x, y}) :
    extendScalars h = IntermediateField.adjoin k⟮x⟯ {y} := by
  rw [extendScalars_adjoin]
  refine le_antisymm ?_ (adjoin.mono _ _ _ (Set.subset_insert _ _))
  rw [adjoin_le_iff, Set.insert_subset_iff]
  refine ⟨?_, Set.singleton_subset_iff.mpr (subset_adjoin _ _ rfl)⟩
  exact (IntermediateField.adjoin k⟮x⟯ {y}).algebraMap_mem (AdjoinSimple.gen k x)

private theorem finite_pair_over_first {k L : Type} [Field k] [Field L] [Algebra k L]
    (x y : L) (hy : IsIntegral k⟮x⟯ y)
    (h : k⟮x⟯ ≤ IntermediateField.adjoin k {x, y}) :
    (Subfield.inclusion (show k⟮x⟯.toSubfield ≤
      (IntermediateField.adjoin k {x, y}).toSubfield from h)).Finite := by
  have hf : FiniteDimensional k⟮x⟯ (IntermediateField.adjoin k⟮x⟯ {y}) :=
    finiteDimensional_adjoin (fun a ha => (Set.mem_singleton_iff.mp ha) ▸ hy)
  have hf' : FiniteDimensional k⟮x⟯ (extendScalars h) := extendScalars_pair x y h ▸ hf
  exact RingHom.finite_algebraMap.mpr hf'

/-- Over the first j-coordinate the modular field is generated by the second. -/
def secondCoordinate (N : ℕ) [NeZero N] :
    modularFunctionField N ≃+* (↥ℚ⟮jq⟯)⟮jqN N⟯ :=
  (IntermediateField.equivOfEq
    (extendScalars_pair jq (jqN N) (adjoin_jq_le N))).toRingEquiv

theorem integral_jN {N : ℕ} [NeZero N] (P : ModularPolynomialData N) :
    IsIntegral ℚ⟮jq⟯ (jqN N) := by
  refine ⟨P.toAdjoin, P.toAdjoin_monic, ?_⟩
  change Polynomial.eval₂ (algebraMap ℚ⟮jq⟯ (LaurentSeries ℚ)) (jqN N) _ = 0
  rw [ModularPolynomialData.toAdjoin, Polynomial.eval₂_map, algebraMap_comp_evalAtJGen]
  exact P.eval_eq_zero

/-- Put the first j-coordinate at the standard coordinate of the projective line. -/
@[instance_reducible] def jAlgebra (N : ℕ) [NeZero N] :
    Algebra (RatFunc ℚ) (modularFunctionField N) :=
  ((Subfield.inclusion (show ℚ⟮jq⟯.toSubfield ≤ (modularFunctionField N).toSubfield
    from adjoin_jq_le N)).comp
    jCoordinate.toRingHom).toAlgebra

/-- The all-level modular polynomial makes the Laurent-series field finite over
the first j-coordinate. -/
theorem finite_jAlgebra (N : ℕ) [NeZero N] :
    letI := jAlgebra N
    FiniteDimensional (RatFunc ℚ) (modularFunctionField N) := by
  obtain ⟨P⟩ := nonempty_modularPolynomialData N
  let := jAlgebra N
  exact RingHom.finite_algebraMap.mp
    ((finite_pair_over_first jq (jqN N) (integral_jN P) (adjoin_jq_le N)).comp
      (RingHom.Finite.of_surjective _ jCoordinate.surjective))

attribute [local instance] jAlgebra finite_jAlgebra

/-- The normalization of the projective j-line in ℚ(j,j_N). -/
abbrev curve (N : ℕ) [NeZero N] : Scheme.{0} :=
  NormalModel.Xn (modularFunctionField N)

/-- The structure morphism of the normalized j-line. -/
abbrev overQ (N : ℕ) [NeZero N] : curve N ⟶ Spec (.of ℚ) :=
  NormalModel.ν (modularFunctionField N) ≫ projectiveLineToSpec ℚ

theorem integral (N : ℕ) [NeZero N] : IsIntegral (curve N) := inferInstance

theorem proper (N : ℕ) [NeZero N] : IsProper (overQ N) := inferInstance

theorem smooth (N : ℕ) [NeZero N] : Smooth (overQ N) := by
  let F := modularFunctionField N
  have := proper N
  have : SmoothOfRelativeDimension 1 (overQ N) :=
    CurveSplit.normalCurveSmoothQ_of_regularSmooth
      ZInQ.Contrib.OneProof.RegularSmoothPerfect.regularSmoothPerfect_proof
      (Over.mk (overQ N)) (by change LocallyOfFiniteType (overQ N); infer_instance) (integral N)
      (NormalModel.isNormalScheme_Xn F) (NormalModel.topologicalKrullDim_Xn F)
  exact SmoothOfRelativeDimension.smooth 1 (overQ N)

/-- The normalized curve's function field, with its specified Laurent-series realization. -/
def functionField (N : ℕ) [NeZero N] : (curve N).functionField ≃+* modularFunctionField N :=
  NormalModel.functionFieldEquiv (modularFunctionField N)


end ZInQ.Manuscript.RC.X0Model
