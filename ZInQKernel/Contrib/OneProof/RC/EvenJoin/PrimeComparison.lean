import ZInQKernel.Contrib.OneProof.RC.AddressGenuine.Frobenius
import ZInQKernel.HDecomp.Conductor.LadicCond
import Mathlib.NumberTheory.NumberField.Basic
import Mathlib.RingTheory.DedekindDomain.AdicValuation

/-! The localization of the algebraic integers at a prime over a rational
prime, with the Frobenius and inertia comparisons used in tex 9765–9797. -/

noncomputable section

namespace ZInQ.Manuscript.RC.EvenJoin.PrimeComparison

open AddressGenuine PrintsArith NumberField IsDedekindDomain IsLocalRing
open scoped Pointwise

local instance integerFractionField : IsFractionRing Zbar PkgI4.Qbar := by
  let : Algebra.IsAlgebraic ℤ PkgI4.Qbar :=
    ⟨fun x => (IsFractionRing.isAlgebraic_iff ℤ ℚ PkgI4.Qbar).mpr
      (Algebra.IsAlgebraic.isAlgebraic x)⟩
  exact integralClosure.isFractionRing_of_algebraic (A := ℤ) (L := PkgI4.Qbar)
    (fun _ => Int.cast_eq_zero.mp)

variable (Q : Ideal Zbar) [Q.IsPrime]

private abbrev localizedIntegers :=
  Localization.subalgebra.ofField PkgI4.Qbar Q.primeCompl Q.primeCompl_le_nonZeroDivisors

/-- Test the valuation property of the localization in the finite field
generated by the element. The contraction there is nonzero because it
contains the nonzero rational prime. -/
private theorem mem_or_inv_mem (q : ℕ) (hq : q.Prime) (hqQ : (q : Zbar) ∈ Q)
    (x : PkgI4.Qbar) :
    x ∈ localizedIntegers Q ∨ x⁻¹ ∈ localizedIntegers Q := by
  let K : IntermediateField ℚ PkgI4.Qbar := IntermediateField.adjoin ℚ {x}
  let : FiniteDimensional ℚ K :=
    IntermediateField.adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral x)
  let : NumberField K := {}
  let y : K := ⟨x, IntermediateField.mem_adjoin_simple_self ℚ x⟩
  have hy : K.subtype y = x := rfl
  let f : 𝓞 K →+* Zbar := RingOfIntegers.mapRingHom K.subtype
  let P : Ideal (𝓞 K) := Q.comap f
  have hp : (q : 𝓞 K) ∈ P := by
    change f (q : 𝓞 K) ∈ Q
    rwa [map_natCast]
  let w : HeightOneSpectrum (𝓞 K) :=
    ⟨P, Ideal.IsPrime.comap f, fun h =>
      hq.ne_zero (Nat.cast_eq_zero.mp ((Ideal.mem_bot.mp (h ▸ hp))))⟩
  obtain ⟨n, d, h⟩ := w.exists_primeCompl_mul_eq_or_mul_eq y
  have hd : f (d : 𝓞 K) ∉ Q := d.property
  have hd0 : (algebraMap Zbar PkgI4.Qbar (f d)) ≠ 0 :=
    fun e => hd ((IsFractionRing.injective Zbar PkgI4.Qbar) (e.trans (map_zero _).symm) ▸ Q.zero_mem)
  have hn : (algebraMap Zbar PkgI4.Qbar (f n)) =
      K.subtype (algebraMap (𝓞 K) K n) := rfl
  have he : (algebraMap Zbar PkgI4.Qbar (f d)) =
      K.subtype (algebraMap (𝓞 K) K d) := rfl
  rcases h with h | h
  · left
    refine ⟨f n, f d, hd, ?_⟩
    rw [← div_eq_mul_inv, eq_div_iff hd0]
    simpa only [hn, he, map_mul, hy] using congrArg K.subtype h
  · right
    refine ⟨f n, f d, hd, ?_⟩
    rw [← div_eq_mul_inv, eq_div_iff hd0]
    have hx : x * (algebraMap Zbar PkgI4.Qbar (f n)) =
        algebraMap Zbar PkgI4.Qbar (f d) := by
      simpa only [hn, he, map_mul, hy] using congrArg K.subtype h
    have hx0 : x ≠ 0 := fun hz => hd0 (by simpa [hz] using hx.symm)
    rw [← hx, inv_mul_cancel_left₀ hx0]

variable {q : ℕ} (hq : q.Prime) (hqQ : (q : Zbar) ∈ Q)

/-- The localization embedded in the fixed algebraic closure. -/
def atPrime : ValuationSubring PkgI4.Qbar :=
  .ofSubring (localizedIntegers Q).toSubring (mem_or_inv_mem Q q hq hqQ)

instance integerAlgebra : Algebra Zbar (atPrime Q hq hqQ) := (localizedIntegers Q).algebra'

instance isLocalizationAtPrime : IsLocalization Q.primeCompl (atPrime Q hq hqQ) :=
  Localization.subalgebra.isLocalization_ofField _ _ _

local notation "V" => atPrime Q hq hqQ

private theorem nonunits_int (a : Zbar) :
    (algebraMap Zbar PkgI4.Qbar a) ∈ (V).nonunits ↔ a ∈ Q := by
  change ((algebraMap Zbar V a : V) : PkgI4.Qbar) ∈ (V).nonunits ↔ _
  rw [ValuationSubring.coe_mem_nonunits_iff]
  exact IsLocalization.AtPrime.to_map_mem_maximal_iff V Q a

/-- The localization is a place above the original rational prime. -/
theorem liesOver : PkgI4.LiesOver V q := by
  unfold PkgI4.LiesOver
  rw [← map_natCast (algebraMap Zbar PkgI4.Qbar)]
  exact (nonunits_int Q hq hqQ _).mpr hqQ

private theorem stabilizes {σ : GalQ} (hs : ∀ a : Zbar, σ • a ∈ Q ↔ a ∈ Q) :
    σ ∈ (V).decompositionSubgroup ℚ := by
  have preserves {g : GalQ} (hg : ∀ a : Zbar, g • a ∈ Q ↔ a ∈ Q)
      {x : PkgI4.Qbar} (hx : x ∈ V) : g x ∈ V := by
    obtain ⟨a, d, hd, rfl⟩ := hx
    refine ⟨g • a, g • d, fun h => hd ((hg d).mp h), ?_⟩
    rw [map_mul, map_inv₀]
    rfl
  have hs' (a : Zbar) : σ⁻¹ • a ∈ Q ↔ a ∈ Q := by
    simpa only [smul_inv_smul] using (hs (σ⁻¹ • a)).symm
  change σ • V = V
  ext x
  rw [ValuationSubring.mem_pointwise_smul_iff_inv_smul_mem]
  refine ⟨?_, preserves hs'⟩
  intro hx
  have h : σ • (σ⁻¹ • x) ∈ V := preserves hs hx
  simpa only [smul_inv_smul] using h

private theorem residue_action {σ : GalQ} (hs : ∀ a : Zbar, σ • a ∈ Q ↔ a ∈ Q)
    (n : ℕ) (hc : ∀ a : Zbar, σ • a - a ^ n ∈ Q)
    (x : V) :
    residue V ((⟨σ, stabilizes Q hq hqQ hs⟩ : (V).decompositionSubgroup ℚ) • x) =
      (residue V x) ^ n := by
  let g : (V).decompositionSubgroup ℚ := ⟨σ, stabilizes Q hq hqQ hs⟩
  let f : V →* ResidueField V :=
    ((residue V).comp ((MulSemiringAction.toRingAut _ V g).toRingHom)).toMonoidHom
  let k : V →* ResidueField V :=
    { toFun := fun t => (residue V t) ^ n
      map_one' := by rw [map_one, one_pow]
      map_mul' := by intro a b; rw [map_mul, mul_pow] }
  have hfk : f = k := IsLocalization.monoidHom_ext Q.primeCompl (MonoidHom.ext fun a => by
    change residue V (algebraMap Zbar V (σ • a)) = (residue V (algebraMap Zbar V a)) ^ n
    rw [← map_pow, ← map_pow, ← sub_eq_zero, ← map_sub, ← map_sub, residue_eq_zero_iff]
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff V Q _).mpr (hc a))
  exact congrArg (fun j : V →* ResidueField V => j x) hfk

/-- The arithmetic Frobenius congruence on the algebraic integers remains
the arithmetic Frobenius congruence after localization. -/
theorem arithFrob (hQ : Q.IsMaximal) {σ : GalQ} (h : IsArithFrobAt ℤ σ Q) :
    PkgI4.IsArithFrob σ V q := by
  have hs (a : Zbar) : σ • a ∈ Q ↔ a ∈ Q :=
    Iff.of_eq (congrArg (fun J : Ideal Zbar => a ∈ J) h.comap_eq)
  have hc (a : Zbar) : σ • a - a ^ q ∈ Q := by
    have ha := h a
    rwa [card_quot_under_of_isMaximal hQ hq (by exact_mod_cast hqQ)] at ha
  refine ⟨stabilizes Q hq hqQ hs, fun x hx => ?_⟩
  let y : V := ⟨x, hx⟩
  let g : (V).decompositionSubgroup ℚ := ⟨σ, stabilizes Q hq hqQ hs⟩
  have e := residue_action Q hq hqQ hs q hc y
  change ((g • y - y ^ q : V) : PkgI4.Qbar) ∈ (V).nonunits
  rw [ValuationSubring.coe_mem_nonunits_iff, ← residue_eq_zero_iff, map_sub, map_pow, e, sub_self]

/-- Ideal inertia acts trivially on the residue field of the localization. -/
theorem inertia {σ : GalQ} (h : σ ∈ Q.inertia GalQ) :
    ∃ g ∈ (V).inertiaSubgroup ℚ, (g : GalQ) = σ := by
  have hc (a : Zbar) : σ • a - a ∈ Q := Ideal.mem_inertia.mp h a
  have hs (a : Zbar) : σ • a ∈ Q ↔ a ∈ Q := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, ← Ideal.Quotient.eq_zero_iff_mem]
    rw [Ideal.Quotient.eq.mpr (hc a)]
  let g : (V).decompositionSubgroup ℚ := ⟨σ, stabilizes Q hq hqQ hs⟩
  refine ⟨g, ?_, rfl⟩
  rw [ValuationSubring.inertiaSubgroup, MonoidHom.mem_ker]
  apply RingEquiv.ext
  intro z
  obtain ⟨x, rfl⟩ := residue_surjective z
  change g • residue V x = residue V x
  rw [← ResidueField.residue_smul]
  simpa only [pow_one] using residue_action Q hq hqQ hs 1 (by simpa only [pow_one] using hc) x

include hq hqQ in
omit [Q.IsPrime] in
/-- A single place over `q` serves for both comparisons at `Q`. -/
theorem exists_comparison (hQ : Q.IsMaximal) :
    ∃ v : ValuationSubring PkgI4.Qbar, PkgI4.LiesOver v q ∧
      (∀ σ : GalQ, IsArithFrobAt ℤ σ Q → PkgI4.IsArithFrob σ v q) ∧
      ∀ σ : GalQ, σ ∈ Q.inertia GalQ → ∃ g ∈ v.inertiaSubgroup ℚ, (g : GalQ) = σ := by
  let := hQ.isPrime
  exact ⟨atPrime Q hq hqQ, liesOver Q hq hqQ, fun _ => arithFrob Q hq hqQ hQ, fun _ => inertia Q hq hqQ⟩

end ZInQ.Manuscript.RC.EvenJoin.PrimeComparison
