import ZInQKernel.Contrib.OneProof.CMHeight62Full.LocalStructure

/-!
# The local ring at the identity point satisfies the depth-two hypotheses

This is node N6b of the blueprint. Let `R` be a discrete valuation ring with uniformizer `ϖ`,
let `A₀` be a standard smooth `R`-algebra of relative dimension one with a section
`σ : A₀ →ₐ[R] R`, and let `A = (A₀)_𝔭` be the localization at `𝔭 = σ⁻¹(𝔪_R)` (the local ring
at the identity point of the closed fibre). We prove that `A` satisfies the hypotheses of the
depth-two lemmas (node N6a):

* `identityPoint_isNoetherianRing`: `A` is Noetherian (and local);
* `identityPoint_mem_nonZeroDivisors`: the image of `ϖ` is a nonzerodivisor of `A`
  (smooth implies flat);
* `identityPoint_mem_maximalIdeal`: the image of `ϖ` lies in the maximal ideal;
* `identityPoint_quotient_isDomain`, `identityPoint_quotient_isDiscreteValuationRing`:
  `A ⧸ (ϖ)` is a domain and a discrete valuation ring;
* `identityPoint_depthTwo`: all of this together with the parameter `t` of node N5: the
  maximal ideal of `A ⧸ (ϖ)` is generated by the class of `t`, `A ⧸ (ϖ)` has dimension one, and
  `A ⧸ (t) ≃ₐ[R] R` through the localized section.

The algebraic core (`IdentityPointDepth.quotient_isDomain` and
`IdentityPointDepth.quotient_isDiscreteValuationRing`) holds for any
Noetherian local ring `A` of dimension two whose maximal ideal is `(p, t)`: if `t` were
nilpotent modulo `p`, the maximal ideal would be minimal over `(p)`, so of height at most one
by Krull's principal ideal theorem. Otherwise the maximal ideal of `A ⧸ (p)` is principal,
generated by a non-nilpotent element, and the Krull intersection theorem writes every nonzero
element as a unit times a power of the generator.
-/

set_option autoImplicit false

noncomputable section

namespace ZInQ.Contrib.CMHeight62Full

open IsLocalRing

namespace IdentityPointDepth

section Generic

variable {A : Type*} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]

/-- In a Noetherian local ring with principal maximal ideal `(τ)`, every nonzero element is a
power of `τ` times a unit. -/
theorem exists_eq_pow_mul_isUnit_of_maximalIdeal_eq_span {τ : A}
    (hτ : maximalIdeal A = Ideal.span {τ}) {x : A} (hx : x ≠ 0) :
    ∃ (n : ℕ) (u : A), IsUnit u ∧ x = τ ^ n * u := by
  have hinf := Ideal.iInf_pow_eq_bot_of_isLocalRing (maximalIdeal A)
    (IsLocalRing.maximalIdeal.isMaximal A).ne_top
  have hex : ∃ n, x ∉ maximalIdeal A ^ n := by
    by_contra h
    push Not at h
    apply hx
    rw [← Ideal.mem_bot, ← hinf, Ideal.mem_iInf]
    exact h
  classical
  have hN : x ∉ maximalIdeal A ^ Nat.find hex := Nat.find_spec hex
  have hN0 : Nat.find hex ≠ 0 := by
    intro h
    apply hN
    rw [h, pow_zero, Ideal.one_eq_top]
    exact Submodule.mem_top
  obtain ⟨n, hn⟩ := Nat.exists_eq_succ_of_ne_zero hN0
  have hxn : x ∈ maximalIdeal A ^ n := by
    have := Nat.find_min hex (show n < Nat.find hex by omega)
    push Not at this
    exact this
  rw [hτ, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hxn
  obtain ⟨u, hu⟩ := hxn
  refine ⟨n, u, ?_, by rw [← hu, mul_comm]⟩
  by_contra hu'
  have hum : u ∈ maximalIdeal A := (IsLocalRing.mem_maximalIdeal u).2 hu'
  rw [hτ, Ideal.mem_span_singleton'] at hum
  obtain ⟨v, hv⟩ := hum
  apply hN
  rw [hn, hτ, Ideal.span_singleton_pow, Ideal.mem_span_singleton']
  exact ⟨v, by rw [← hu, ← hv, pow_succ]; ring⟩

/-- A Noetherian local ring whose maximal ideal is generated by a non-nilpotent element is a
domain. -/
theorem isDomain_of_maximalIdeal_eq_span {τ : A} (hτ : maximalIdeal A = Ideal.span {τ})
    (hnil : ¬ IsNilpotent τ) : IsDomain A := by
  have : NoZeroDivisors A := ⟨fun {x y} hxy => by
    by_contra h
    push Not at h
    obtain ⟨n, u, hu, rfl⟩ := exists_eq_pow_mul_isUnit_of_maximalIdeal_eq_span hτ h.1
    obtain ⟨m, v, hv, rfl⟩ := exists_eq_pow_mul_isUnit_of_maximalIdeal_eq_span hτ h.2
    apply hnil
    refine ⟨n + m, ?_⟩
    have h0 : τ ^ (n + m) * (u * v) = 0 := by
      rw [← hxy]
      ring
    exact (hu.mul hv).mul_left_eq_zero.1 h0⟩
  exact NoZeroDivisors.to_isDomain A

/-- A Noetherian local domain whose maximal ideal is generated by a nonzero element is a
discrete valuation ring. -/
theorem isDiscreteValuationRing_of_maximalIdeal_eq_span [IsDomain A] {τ : A}
    (hτ : maximalIdeal A = Ideal.span {τ}) (hτ0 : τ ≠ 0) : IsDiscreteValuationRing A := by
  have hnf : ¬ IsField A := by
    rw [IsLocalRing.isField_iff_maximalIdeal_eq, hτ, Ideal.span_singleton_eq_bot]
    exact hτ0
  have hp : (maximalIdeal A).IsPrincipal := ⟨⟨τ, hτ⟩⟩
  exact ((IsDiscreteValuationRing.TFAE A hnf).out 1 5).2 hp

variable {p t : A}

omit [IsNoetherianRing A] in
/-- If `𝔪 = (p, t)`, the maximal ideal of `A ⧸ (p)` is generated by the class of `t`. -/
theorem maximalIdeal_quotient_eq_span (hmax : maximalIdeal A = Ideal.span {p, t})
    [IsLocalRing (A ⧸ Ideal.span {p})] :
    maximalIdeal (A ⧸ Ideal.span {p}) =
      Ideal.span {(Ideal.Quotient.mk (Ideal.span {p}) t)} := by
  set I := Ideal.span {p}
  have hp0 : Ideal.Quotient.mk I p = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.mem_span_singleton_self p)
  have hpm : p ∈ maximalIdeal A := hmax ▸ Ideal.subset_span (by simp)
  have htm : t ∈ maximalIdeal A := hmax ▸ Ideal.subset_span (by simp)
  have hIm : I ≤ maximalIdeal A := Ideal.span_le.2 (Set.singleton_subset_iff.2 hpm)
  have hne : Ideal.span {Ideal.Quotient.mk I t} ≠ ⊤ := by
    rw [Ne, Ideal.eq_top_iff_one, Ideal.mem_span_singleton']
    rintro ⟨y, hy⟩
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [← map_mul, ← map_one (Ideal.Quotient.mk I), Ideal.Quotient.eq] at hy
    have h1 : a * t ∈ maximalIdeal A :=
      Ideal.mul_mem_left _ _ htm
    have h2 : (1 : A) ∈ maximalIdeal A := by
      have := (maximalIdeal A).sub_mem h1 (hIm hy)
      simp at this
    exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top ((Ideal.eq_top_iff_one _).2 h2)
  ext x
  constructor
  · intro hx
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    have ha : a ∈ maximalIdeal A := by
      by_contra ha
      exact (IsLocalRing.mem_maximalIdeal _).1 hx ((IsLocalRing.notMem_maximalIdeal.1 ha).map _)
    rw [hmax, Ideal.mem_span_pair] at ha
    obtain ⟨r, s, hrs⟩ := ha
    refine Ideal.mem_span_singleton'.2 ⟨Ideal.Quotient.mk I s, ?_⟩
    rw [← hrs, map_add, map_mul, map_mul, hp0, mul_zero, zero_add]
  · intro hx
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    exact hne (Ideal.eq_top_of_isUnit_mem _ hx hu)

/-- If `A` has dimension two and `𝔪 = (p, t)`, then `t` is not nilpotent modulo `p`. -/
theorem not_isNilpotent_mk_of_maximalIdeal_eq (hmax : maximalIdeal A = Ideal.span {p, t})
    (hdim : ringKrullDim A = 2) : ¬ IsNilpotent (Ideal.Quotient.mk (Ideal.span {p}) t) := by
  rintro ⟨n, hn⟩
  have hpm : p ∈ maximalIdeal A := hmax ▸ Ideal.subset_span (by simp)
  rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem] at hn
  have hmin : maximalIdeal A ∈ (Ideal.span {p}).minimalPrimes := by
    refine ⟨⟨(IsLocalRing.maximalIdeal.isMaximal A).isPrime,
      Ideal.span_le.2 (Set.singleton_subset_iff.2 hpm)⟩,
      fun q hq _ => ?_⟩
    obtain ⟨hqp, hpq⟩ := hq
    have hpq' : p ∈ q := hpq (Ideal.mem_span_singleton_self p)
    have htq : t ∈ q := hqp.mem_of_pow_mem n (hpq hn)
    rw [hmax, Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
    exact ⟨hpq', htq⟩
  have h1 := Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes (Ideal.span {p}) _ hmin
  have h2 := IsLocalRing.maximalIdeal_height_eq_ringKrullDim (R := A)
  rw [hdim] at h2
  have h3 : (maximalIdeal A).height = 2 := WithBot.coe_injective (h2.trans rfl)
  rw [h3] at h1
  exact absurd h1 (by decide)

/-- **Algebraic core.** A Noetherian local ring of dimension two with `𝔪 = (p, t)`: `A ⧸ (p)`
is a domain. -/
theorem quotient_isDomain (hmax : maximalIdeal A = Ideal.span {p, t})
    (hdim : ringKrullDim A = 2) : IsDomain (A ⧸ Ideal.span {p}) := by
  have hpm : p ∈ maximalIdeal A := hmax ▸ Ideal.subset_span (by simp)
  have : Nontrivial (A ⧸ Ideal.span {p}) := Submodule.Quotient.nontrivial_iff.mpr
    (Ideal.span_singleton_ne_top ((IsLocalRing.mem_maximalIdeal p).1 hpm))
  have : IsLocalRing (A ⧸ Ideal.span {p}) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
  exact isDomain_of_maximalIdeal_eq_span (maximalIdeal_quotient_eq_span hmax)
    (not_isNilpotent_mk_of_maximalIdeal_eq hmax hdim)

/-- **Algebraic core.** A Noetherian local ring of dimension two with `𝔪 = (p, t)`: `A ⧸ (p)`
is a discrete valuation ring. -/
theorem quotient_isDiscreteValuationRing (hmax : maximalIdeal A = Ideal.span {p, t})
    (hdim : ringKrullDim A = 2) [IsDomain (A ⧸ Ideal.span {p})] :
    IsDiscreteValuationRing (A ⧸ Ideal.span {p}) := by
  have : IsLocalRing (A ⧸ Ideal.span {p}) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
  refine isDiscreteValuationRing_of_maximalIdeal_eq_span (maximalIdeal_quotient_eq_span hmax)
    fun h => not_isNilpotent_mk_of_maximalIdeal_eq hmax hdim ?_
  rw [h]
  exact IsNilpotent.zero

theorem quotient_ringKrullDim (hmax : maximalIdeal A = Ideal.span {p, t})
    (hdim : ringKrullDim A = 2) [IsDomain (A ⧸ Ideal.span {p})] :
    ringKrullDim (A ⧸ Ideal.span {p}) = 1 := by
  have := quotient_isDiscreteValuationRing hmax hdim
  exact IsDiscreteValuationRing.ringKrullDim_eq_one _

end Generic

section Helpers

variable {R : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
variable {A₀ : Type*} [CommRing A₀] [Algebra R A₀]
variable (σ : A₀ →ₐ[R] R)

/-- The localized section as an `R`-algebra map. -/
def localSectionAlgHom : Localization.AtPrime (sectionPrime σ) →ₐ[R] R :=
  { localSection σ with
    commutes' := fun r => by
      change localSection σ (algebraMap R _ r) = algebraMap R R r
      rw [IsScalarTower.algebraMap_apply R A₀ (Localization.AtPrime (sectionPrime σ)),
        localSection_algebraMap, σ.commutes] }

theorem localSectionAlgHom_apply (a : Localization.AtPrime (sectionPrime σ)) :
    localSectionAlgHom σ a = localSection σ a :=
  rfl

theorem localSectionAlgHom_surjective : Function.Surjective (localSectionAlgHom σ) :=
  fun r => ⟨algebraMap R _ r, by rw [(localSectionAlgHom σ).commutes r]; rfl⟩

theorem ker_localSectionAlgHom :
    RingHom.ker (localSectionAlgHom σ) = RingHom.ker (localSection σ) := by
  ext a
  simp [RingHom.mem_ker, localSectionAlgHom_apply]

/-- `A ⧸ (t) ≃ₐ[R] R` through the localized section, once its kernel is `(t)`. -/
def quotientSpanEquiv {t : Localization.AtPrime (sectionPrime σ)}
    (hker : RingHom.ker (localSection σ) = Ideal.span {t}) :
    (Localization.AtPrime (sectionPrime σ) ⧸ Ideal.span {t}) ≃ₐ[R] R :=
  (Ideal.quotientEquivAlgOfEq R ((ker_localSectionAlgHom σ).trans hker).symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective (localSectionAlgHom_surjective σ))

theorem quotientSpanEquiv_mk {t : Localization.AtPrime (sectionPrime σ)}
    (hker : RingHom.ker (localSection σ) = Ideal.span {t})
    (a : Localization.AtPrime (sectionPrime σ)) :
    quotientSpanEquiv σ hker (Ideal.Quotient.mk _ a) = localSection σ a :=
  rfl

/-- The local ring at the identity point is flat over `R` when `A₀` is. -/
theorem flat_localization [Module.Flat R A₀] :
    Module.Flat R (Localization.AtPrime (sectionPrime σ)) :=
  inferInstance

/-- `ϖ` stays a nonzerodivisor in the local ring at the identity point (flatness). -/
theorem algebraMap_mem_nonZeroDivisors_of_flat [Module.Flat R A₀] {ϖ : R} (hϖ : ϖ ≠ 0) :
    algebraMap R (Localization.AtPrime (sectionPrime σ)) ϖ ∈
      nonZeroDivisors (Localization.AtPrime (sectionPrime σ)) := by
  have hreg := Module.Flat.isSMulRegular_of_nonZeroDivisors
    (M := Localization.AtPrime (sectionPrime σ)) (mem_nonZeroDivisors_of_ne_zero hϖ)
  have key : ∀ x : Localization.AtPrime (sectionPrime σ),
      algebraMap R _ ϖ * x = 0 → x = 0 := fun x hx =>
    hreg (by
      change ϖ • x = ϖ • 0
      rw [smul_zero, Algebra.smul_def]
      exact hx)
  exact mem_nonZeroDivisors_iff_left.mpr key

omit [IsDomain R] [IsDiscreteValuationRing R] in
theorem flat_of_standardSmooth [Algebra.IsStandardSmoothOfRelativeDimension 1 R A₀] :
    Module.Flat R A₀ := by
  have : Algebra.IsStandardSmooth R A₀ :=
    Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth 1
  exact Algebra.Smooth.flat R A₀

end Helpers

end IdentityPointDepth

open IdentityPointDepth

section IdentityPoint

variable {R : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
variable {A₀ : Type*} [CommRing A₀] [Algebra R A₀]
variable (σ : A₀ →ₐ[R] R)
variable [Algebra.IsStandardSmoothOfRelativeDimension 1 R A₀]

theorem identityPoint_isNoetherianRing :
    IsNoetherianRing (Localization.AtPrime (sectionPrime σ)) := by
  have : Algebra.IsStandardSmooth R A₀ :=
    Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth 1
  have : IsNoetherianRing A₀ := Algebra.FiniteType.isNoetherianRing R A₀
  infer_instance

/-- **N6b, nonzerodivisor.** -/
theorem identityPoint_mem_nonZeroDivisors {ϖ : R} (hϖ : ϖ ≠ 0) :
    algebraMap R (Localization.AtPrime (sectionPrime σ)) ϖ ∈
      nonZeroDivisors (Localization.AtPrime (sectionPrime σ)) :=
  have := flat_of_standardSmooth (R := R) (A₀ := A₀)
  algebraMap_mem_nonZeroDivisors_of_flat σ hϖ

/-- **Node N6b.** The local ring `A` at the identity point satisfies the hypotheses of the
depth-two lemmas, for the parameter `t` of node N5. -/
theorem identityPoint_depthTwo {ϖ : R} (hϖ : Irreducible ϖ) :
    ∃ t : A₀, t ∈ RingHom.ker σ ∧
      IsNoetherianRing (Localization.AtPrime (sectionPrime σ)) ∧
      ringKrullDim (Localization.AtPrime (sectionPrime σ)) = 2 ∧
      maximalIdeal (Localization.AtPrime (sectionPrime σ)) =
        Ideal.span {algebraMap R (Localization.AtPrime (sectionPrime σ)) ϖ,
          algebraMap A₀ (Localization.AtPrime (sectionPrime σ)) t} ∧
      algebraMap R (Localization.AtPrime (sectionPrime σ)) ϖ ∈
        nonZeroDivisors (Localization.AtPrime (sectionPrime σ)) ∧
      algebraMap R (Localization.AtPrime (sectionPrime σ)) ϖ ∈
        maximalIdeal (Localization.AtPrime (sectionPrime σ)) ∧
      algebraMap A₀ (Localization.AtPrime (sectionPrime σ)) t ∈
        maximalIdeal (Localization.AtPrime (sectionPrime σ)) ∧
      (∃ (_ : IsDomain (Localization.AtPrime (sectionPrime σ) ⧸
          Ideal.span {algebraMap R (Localization.AtPrime (sectionPrime σ)) ϖ}))
        (_ : IsDiscreteValuationRing (Localization.AtPrime (sectionPrime σ) ⧸
          Ideal.span {algebraMap R (Localization.AtPrime (sectionPrime σ)) ϖ})),
        maximalIdeal (Localization.AtPrime (sectionPrime σ) ⧸
            Ideal.span {algebraMap R (Localization.AtPrime (sectionPrime σ)) ϖ}) =
          Ideal.span {(Ideal.Quotient.mk
            (Ideal.span {algebraMap R (Localization.AtPrime (sectionPrime σ)) ϖ})
            (algebraMap A₀ (Localization.AtPrime (sectionPrime σ)) t))} ∧
        ringKrullDim (Localization.AtPrime (sectionPrime σ) ⧸
          Ideal.span {algebraMap R (Localization.AtPrime (sectionPrime σ)) ϖ}) = 1) ∧
      RingHom.ker (localSection σ) =
        Ideal.span {algebraMap A₀ (Localization.AtPrime (sectionPrime σ)) t} ∧
      ∃ e : (Localization.AtPrime (sectionPrime σ) ⧸
          Ideal.span {algebraMap A₀ (Localization.AtPrime (sectionPrime σ)) t}) ≃ₐ[R] R,
        ∀ a, e (Ideal.Quotient.mk _ a) = localSection σ a := by
  have hnoeth := identityPoint_isNoetherianRing (R := R) σ
  obtain ⟨t, ht, -, hdim, hmax, hker, -⟩ := localStructure_of_standardSmooth σ hϖ
  have hdom := quotient_isDomain hmax hdim
  have hdvr := quotient_isDiscreteValuationRing hmax hdim
  exact ⟨t, ht, hnoeth, hdim, hmax, identityPoint_mem_nonZeroDivisors σ hϖ.ne_zero,
    hmax ▸ Ideal.subset_span (by simp), hmax ▸ Ideal.subset_span (by simp),
    ⟨hdom, hdvr, maximalIdeal_quotient_eq_span hmax, quotient_ringKrullDim hmax hdim⟩,
    hker, quotientSpanEquiv σ hker, quotientSpanEquiv_mk σ hker⟩

/-- **N6b, `ϖ ∈ 𝔪`.** -/
theorem identityPoint_mem_maximalIdeal {ϖ : R} (hϖ : Irreducible ϖ) :
    algebraMap R (Localization.AtPrime (sectionPrime σ)) ϖ ∈
      maximalIdeal (Localization.AtPrime (sectionPrime σ)) := by
  have := identityPoint_isNoetherianRing (R := R) σ
  obtain ⟨t, -, -, -, -, -, hm, -⟩ := identityPoint_depthTwo σ hϖ
  exact hm

/-- **N6b, special fibre is a domain.** -/
theorem identityPoint_quotient_isDomain {ϖ : R} (hϖ : Irreducible ϖ) :
    IsDomain (Localization.AtPrime (sectionPrime σ) ⧸
      Ideal.span {algebraMap R (Localization.AtPrime (sectionPrime σ)) ϖ}) := by
  obtain ⟨t, -, -, -, -, -, -, -, ⟨hdom, -⟩, -⟩ := identityPoint_depthTwo σ hϖ
  exact hdom

/-- **N6b, special fibre is a discrete valuation ring.** -/
theorem identityPoint_quotient_isDiscreteValuationRing {ϖ : R} (hϖ : Irreducible ϖ)
    [IsDomain (Localization.AtPrime (sectionPrime σ) ⧸
      Ideal.span {algebraMap R (Localization.AtPrime (sectionPrime σ)) ϖ})] :
    IsDiscreteValuationRing (Localization.AtPrime (sectionPrime σ) ⧸
      Ideal.span {algebraMap R (Localization.AtPrime (sectionPrime σ)) ϖ}) := by
  have := identityPoint_isNoetherianRing (R := R) σ
  obtain ⟨t, -, -, hdim, hmax, -⟩ := identityPoint_depthTwo σ hϖ
  exact quotient_isDiscreteValuationRing hmax hdim

/-- **N6b, in the form consumed by node N6a.** Every statement proved for a Noetherian local
ring `A` and an element `π` under the depth-two hypotheses (`π` a nonzerodivisor in the maximal
ideal, `A ⧸ (π)` a domain and a discrete valuation ring) holds for the local ring at the
identity point and the image of `ϖ`. -/
theorem identityPoint_of_depthTwo {ϖ : R} (hϖ : Irreducible ϖ) (P : ∀ (A : Type _), A → Prop)
    (hP : ∀ (A : Type _) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (π : A),
      π ∈ nonZeroDivisors A → π ∈ maximalIdeal A →
      ∀ [IsDomain (A ⧸ Ideal.span {π})] [IsDiscreteValuationRing (A ⧸ Ideal.span {π})],
        P A π) :
    P (Localization.AtPrime (sectionPrime σ))
      (algebraMap R (Localization.AtPrime (sectionPrime σ)) ϖ) := by
  have := identityPoint_isNoetherianRing (R := R) σ
  have := identityPoint_quotient_isDomain σ hϖ
  have := identityPoint_quotient_isDiscreteValuationRing σ hϖ
  exact hP _ _ (identityPoint_mem_nonZeroDivisors σ hϖ.ne_zero)
    (identityPoint_mem_maximalIdeal σ hϖ)

end IdentityPoint

end ZInQ.Contrib.CMHeight62Full
