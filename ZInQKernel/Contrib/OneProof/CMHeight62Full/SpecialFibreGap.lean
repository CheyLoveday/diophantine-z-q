/-!
# The geometric special fibre: transcendence degree, gap and no simple pole (node L5)

Let `G` be a proper group scheme over `S = Spec R₀`, `s` a closed point with `R = 𝒪_{S,s}` a
discrete valuation ring with uniformizer `ϖ` and residue field `k`, and `A` the local ring of `G`
at `e(s)` (`e` the unit section), given as a localization of a standard smooth chart through a
ring isomorphism `φ` compatible with the structure maps. Let `w` be the special-fibre valuation of
`Ω = Frac A` and `κ_w = Frac(A/ϖA)` its residue field (the function field of the component of the
special fibre through `e(s)`).

**B1 on `κ_w`.**
* `trdegLeOne_specialFibreValuation`: `κ_w/k` has transcendence degree at most one, transported
  from `SpecialFibreFunctionField.trdegLeOne_specialFibre` along `κ_w ≅ Frac(A/ϖA)`
  (`trdegLeOne_of_algEquiv`).

**The geometric point.** Let `kb` be an algebraic closure of `k`, `g : Spec kb → S` through `s`,
and `X = G ×_S Spec kb` the geometric special fibre.
* `exists_componentPoint`: there is `y ∈ X` with `closure {y}` an irreducible component,
  `y ⤳ unitPoint X`, and `κ(y) ≅ M` as `kb`-algebras, `M` a compositum of `κ_w` and `kb`
  (`exists_compositum`). The point is the image of `Spec M → X` built from `Spec M → Spec A` and
  `Spec M → Spec kb`. That it specializes to the unit uses that `X → G` is integral, hence closed
  (`g` is integral), and that the fibre of `X → G` over `e(s)` is the single point `unitPoint X`
  (`eq_unitPoint_of_fst_eq`). That it is a generic point of a component uses that its generizations
  lie over the generic point of the special fibre through `e(s)` (the kernel of `A → κ_w` is the
  minimal prime `ϖA` over `s`), and incomparability for the integral `X → G`
  (`eq_of_specializes_of_isIntegralHom`, `closure_mem_irreducibleComponents`).
* The algebra `κ_w → κ(y)` is `κ_w → M ≅ κ(y)`, with the scalar towers over `k` through `kb`, and
  `hgen : κ(y) = kb(κ_w)` holds since `M` is generated by `κ_w` over `kb`.

**B3 wiring.**
* `exists_translationData`: from `exists_noFixedPlace_baseChange_of_component` (the translation
  of the proper group `X` by a `kb`-point fixing `y`; properness is used there, through the
  valuative criteria and the Jacobson property), `polePart_gap_of_baseChange` gives `hgap` and
  `not_hasSimplePoleOnlyAt_of_baseChange` gives `hnsp`, for every degree-one place of `κ_w/k`.
* `specialFibreGap`: B1 and B3 together.
* `exists_localModel_generic_algebraMap`: N5-bridge (`exists_localModel_generic`) with the
  compatibility of `φ` with the structure maps from `R₀`, the hypothesis `hφ` above.
* `exists_specialFibreGap`: everything for a smooth proper group scheme, from the N5-bridge chart.

Only Mathlib and earlier files of this directory are used.
-/

set_option autoImplicit false

noncomputable section

namespace ZInQ.Contrib.CMHeight62Full

namespace SpecialFibreGap

open IsLocalRing

section Trdeg

/-- `TrdegLeOne` is invariant under isomorphisms of `k`-algebras. -/
theorem trdegLeOne_of_algEquiv {k K K' : Type*} [Field k] [Field K] [Field K'] [Algebra k K]
    [Algebra k K'] (e : K ≃ₐ[k] K') (h : TrdegLeOne k K) : TrdegLeOne k K' := by
  intro x' hx'
  have hx : Transcendental k (e.symm x') := fun ha => hx' (by
    simpa using ha.algHom (e : K →ₐ[k] K'))
  have := h _ hx
  have hmap : (Algebra.adjoin k {e.symm x'}).map (e : K →ₐ[k] K') = Algebra.adjoin k {x'} := by
    rw [AlgHom.map_adjoin, Set.image_singleton]
    simp
  let f : Algebra.adjoin k {x'} →+* Algebra.adjoin k {e.symm x'} :=
    (((e.subalgebraMap (Algebra.adjoin k {e.symm x'})).toRingEquiv.symm).toRingHom).comp
      ((Subalgebra.equivOfEq _ _ hmap).toRingEquiv.symm.toRingHom)
  refine Algebra.IsAlgebraic.of_ringHom_of_comp_eq f (e.symm : K' →+* K) ?_ e.symm.injective ?_
  · exact (((Subalgebra.equivOfEq _ _ hmap).toRingEquiv.symm).trans
      (e.subalgebraMap (Algebra.adjoin k {e.symm x'})).toRingEquiv.symm).surjective
  · ext a
    obtain ⟨b, hb⟩ : ∃ b, (Subalgebra.equivOfEq _ _ hmap) b = a :=
      (Subalgebra.equivOfEq _ _ hmap).surjective a
    subst hb
    obtain ⟨c, rfl⟩ := (e.subalgebraMap (Algebra.adjoin k {e.symm x'})).surjective b
    simp only [f]
    simp
    exact (e.subalgebraMap (Algebra.adjoin k {e.symm x'})).symm_apply_apply c

end Trdeg

section B1

open SpecialFibreValuation

/-- **B1 on `κ_w`.** The residue field `κ_w = Frac(A/ϖA)` of the special-fibre valuation has
transcendence degree at most one over the residue field of `R`, for the `ResidueField R`-algebra
structure of `residueHom`. Here `A` is a localization of a standard smooth `R`-algebra `A₀` of
relative dimension one (in the assembly, `A₀` localized at the point of its section `σ`, with
`M = (sectionPrime σ).primeCompl`). -/
theorem trdegLeOne_specialFibreValuation {R : Type*} [CommRing R] [IsDomain R]
    [IsDiscreteValuationRing R] {A₀ : Type*} [CommRing A₀] [Algebra R A₀]
    [Algebra.IsStandardSmoothOfRelativeDimension 1 R A₀] {A : Type*} [CommRing A]
    [IsNoetherianRing A] [IsDomain A] [Algebra A₀ A] [Algebra R A] [IsScalarTower R A₀ A]
    [FaithfulSMul R A] (M : Submonoid A₀) [IsLocalization M A]
    (Ω : Type*) [Field Ω] [Algebra A Ω] [IsFractionRing A Ω] [Algebra R Ω] [IsScalarTower R A Ω]
    {ϖ : R} (hϖ : Irreducible ϖ) [IsDomain (A ⧸ Ideal.span {algebraMap R A ϖ})] :
    letI := (residueHom (specialFibreValuation A Ω hϖ)
      (specialFibreValuation_algebraMap_base_le_one hϖ)
      (specialFibreValuation_algebraMap_base_lt_one hϖ)).toAlgebra
    TrdegLeOne (ResidueField R) (ResidueField (specialFibreValuation A Ω hϖ).valuationSubring) := by
  let B := A ⧸ Ideal.span {algebraMap R A ϖ}
  let K := ResidueField (specialFibreValuation A Ω hϖ).valuationSubring
  let ρ : ResidueField R →+* K := residueHom (specialFibreValuation A Ω hϖ)
      (specialFibreValuation_algebraMap_base_le_one hϖ)
      (specialFibreValuation_algebraMap_base_lt_one hϖ)
  let algK : Algebra (ResidueField R) K := ρ.toAlgebra
  let algB : Algebra B K := (specialFibreResidueMap A Ω hϖ).toAlgebra
  have : IsFractionRing B K := isFractionRing_specialFibreResidueMap hϖ
  let e : FractionRing B ≃ₐ[B] K := IsLocalization.algEquiv (nonZeroDivisors B) _ _
  let : Algebra (ResidueField R) (FractionRing B) := (e.symm.toRingHom.comp ρ).toAlgebra
  have : IsScalarTower R (ResidueField R) (FractionRing B) := by
    refine IsScalarTower.of_algebraMap_eq fun r => ?_
    show algebraMap R (FractionRing B) r = e.symm (ρ (algebraMap R (ResidueField R) r))
    have h1 : ρ (algebraMap R (ResidueField R) r) =
        algebraMap B K (Ideal.Quotient.mk _ (algebraMap R A r)) :=
      residueHom_residue_eq hϖ r
    rw [h1, AlgEquiv.commutes, IsScalarTower.algebraMap_apply R B (FractionRing B)]
    rfl
  have htr := SpecialFibreFunctionField.trdegLeOne_quotient_localization (R := R) (A₀ := A₀)
    (A := A) M (Ideal.span {algebraMap R A ϖ})
  let e' : FractionRing B ≃ₐ[ResidueField R] K :=
    AlgEquiv.ofRingEquiv (f := e.toRingEquiv) fun c => by
      show e (e.symm (ρ c)) = ρ c
      exact e.apply_symm_apply _
  exact trdegLeOne_of_algEquiv e' htr

end B1

section Topology

/-- In a quasi-sober space, the closure of a point without proper generizations is an irreducible
component. -/
theorem closure_mem_irreducibleComponents {X : Type*} [TopologicalSpace X] [QuasiSober X] {z : X}
    (h : ∀ z', z' ⤳ z → z' = z) : closure {z} ∈ irreducibleComponents X := by
  refine ⟨isIrreducible_singleton.closure, fun T hT hsub => ?_⟩
  have hg := hT.isGenericPoint_genericPoint_closure
  have hz : hT.genericPoint ⤳ z := by
    rw [specializes_iff_mem_closure, hg.def]
    exact subset_closure (hsub (subset_closure rfl))
  rw [← h _ hz, hg.def]
  exact subset_closure

end Topology

section Integral

open AlgebraicGeometry CategoryTheory

/-- **Incomparability.** An integral morphism has no proper specializations inside a fibre. -/
theorem eq_of_specializes_of_isIntegralHom {X Y : Scheme} (f : X ⟶ Y) [IsIntegralHom f]
    {a b : X} (hab : a ⤳ b) (hf : f a = f b) : a = b := by
  obtain ⟨V, hV, hbV, -⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    Y.isBasis_affineOpens (show f b ∈ (⊤ : Y.Opens) from trivial)
  have hU : IsAffineOpen (f ⁻¹ᵁ V) := IsAffineHom.isAffine_preimage V hV
  have hb : b ∈ f ⁻¹ᵁ V := hbV
  have ha : a ∈ f ⁻¹ᵁ V := hab.mem_open (f ⁻¹ᵁ V).isOpen hb
  have hemb := hU.isOpenImmersion_fromSpec.base_open.isInducing
  have hle : hU.primeIdealOf ⟨a, ha⟩ ≤ hU.primeIdealOf ⟨b, hb⟩ := by
    have hspec : hU.primeIdealOf ⟨a, ha⟩ ⤳ hU.primeIdealOf ⟨b, hb⟩ := by
      apply hemb.specializes_iff.mp
      change hU.fromSpec _ ⤳ hU.fromSpec _
      rw [hU.fromSpec_primeIdealOf, hU.fromSpec_primeIdealOf]
      exact hab
    exact (PrimeSpectrum.le_iff_specializes _ _).mpr hspec
  have hca := IsAffineOpen.comap_primeIdealOf_appLE V hV (f ⁻¹ᵁ V) hU le_rfl ha
  have hcb := IsAffineOpen.comap_primeIdealOf_appLE V hV (f ⁻¹ᵁ V) hU le_rfl hb
  have hint : (f.appLE V (f ⁻¹ᵁ V) le_rfl).hom.IsIntegral := by
    rw [← Scheme.Hom.app_eq_appLE]
    exact IsIntegralHom.isIntegral_app f V hV
  let := (f.appLE V (f ⁻¹ᵁ V) le_rfl).hom.toAlgebra
  have : Algebra.IsIntegral Γ(Y, V) Γ(X, f ⁻¹ᵁ V) := ⟨hint⟩
  have heq : hU.primeIdealOf ⟨a, ha⟩ = hU.primeIdealOf ⟨b, hb⟩ := by
    by_contra hne
    have hlt : (hU.primeIdealOf ⟨a, ha⟩).asIdeal < (hU.primeIdealOf ⟨b, hb⟩).asIdeal :=
      lt_of_le_of_ne hle fun h => hne (PrimeSpectrum.ext h)
    have h2 := Ideal.IsIntegral.under_lt_under (R := Γ(Y, V)) hlt
    have e : Ideal.under Γ(Y, V) (hU.primeIdealOf ⟨a, ha⟩).asIdeal =
        Ideal.under Γ(Y, V) (hU.primeIdealOf ⟨b, hb⟩).asIdeal := by
      change (PrimeSpectrum.comap (f.appLE V (f ⁻¹ᵁ V) le_rfl).hom
          (hU.primeIdealOf ⟨a, ha⟩)).asIdeal =
        (PrimeSpectrum.comap (f.appLE V (f ⁻¹ᵁ V) le_rfl).hom (hU.primeIdealOf ⟨b, hb⟩)).asIdeal
      rw [hca, hcb]
      exact congrArg (fun x => (hV.primeIdealOf x).asIdeal) (Subtype.ext hf)
    exact h2.ne e
  have := congrArg hU.fromSpec heq
  rwa [hU.fromSpec_primeIdealOf, hU.fromSpec_primeIdealOf] at this

end Integral

section UnitFibre

open AlgebraicGeometry CategoryTheory Limits MonoidalCategory CartesianMonoidalCategory MonObj
open TranslationNoFixedPlace

variable {R₀ : Type} [CommRing R₀] (G : Over (Spec (CommRingCat.of R₀))) [GrpObj G]
  {kb : Type} [Field kb] (g : Spec (CommRingCat.of kb) ⟶ Spec (CommRingCat.of R₀))

/-- The unit of the base change `G ×_S Spec kb` followed by the projection to `G` is `g ≫ e`. -/
theorem one_left_fst :
    letI : GrpObj ((Over.pullback g).obj G) := Functor.grpObjObj
    (η[(Over.pullback g).obj G] : 𝟙_ _ ⟶ (Over.pullback g).obj G).left ≫
      pullback.fst G.hom g = g ≫ (η[G] : 𝟙_ _ ⟶ G).left := by
  let : GrpObj ((Over.pullback g).obj G) := Functor.grpObjObj
  change (Functor.LaxMonoidal.ε (Over.pullback g) ≫ (Over.pullback g).map η[G]).left ≫ _ = _
  rw [Over.comp_left, Category.assoc]
  simp

/-- The unit of the fibre `G ×_S Spec kb` lies over the unit `e(g(pt))` of `G`. -/
theorem fst_unitPoint :
    letI : GrpObj ((Over.pullback g).obj G) := Functor.grpObjObj
    pullback.fst G.hom g (unitPoint ((Over.pullback g).obj G)) =
      (η[G] : 𝟙_ _ ⟶ G).left (g (IsLocalRing.closedPoint kb)) := by
  let : GrpObj ((Over.pullback g).obj G) := Functor.grpObjObj
  have h := congrArg (fun φ : Spec (CommRingCat.of kb) ⟶ G.left => φ (IsLocalRing.closedPoint kb))
    (one_left_fst G g)
  exact h

/-- The fibre of `G ×_S Spec kb → G` over the unit `e(g(pt))` is the single point
`unitPoint`: it is the base change `S ×_S Spec kb = Spec kb` of the unit section. -/
theorem eq_unitPoint_of_fst_eq {u : ((Over.pullback g).obj G).left}
    (hu : pullback.fst G.hom g u = (η[G] : 𝟙_ _ ⟶ G).left (g (IsLocalRing.closedPoint kb))) :
    letI : GrpObj ((Over.pullback g).obj G) := Functor.grpObjObj
    u = unitPoint ((Over.pullback g).obj G) := by
  let : GrpObj ((Over.pullback g).obj G) := Functor.grpObjObj
  let e : Spec (CommRingCat.of R₀) ⟶ G.left := (η[G] : 𝟙_ _ ⟶ G).left
  have he : e ≫ G.hom = 𝟙 _ := Over.w (η[G] : 𝟙_ _ ⟶ G)
  have : IsIso (e ≫ G.hom) := by rw [he]; infer_instance
  let φ : pullback e (pullback.fst G.hom g) ⟶ Spec (CommRingCat.of kb) :=
    (pullbackRightPullbackFstIso G.hom g e).hom ≫ pullback.snd (e ≫ G.hom) g
  have : IsIso φ := inferInstance
  have hsub : ∀ p q : ↥(pullback e (pullback.fst G.hom g) : Scheme), p = q := by
    intro p q
    apply φ.homeomorph.injective
    have : Subsingleton (PrimeSpectrum kb) := inferInstance
    exact Subsingleton.elim (α := PrimeSpectrum kb) _ _
  obtain ⟨p, -, hp⟩ := Scheme.Pullback.exists_preimage_pullback (f := e)
    (g := pullback.fst G.hom g) (g (IsLocalRing.closedPoint kb)) u hu.symm
  obtain ⟨q, -, hq⟩ := Scheme.Pullback.exists_preimage_pullback (f := e)
    (g := pullback.fst G.hom g) (g (IsLocalRing.closedPoint kb))
    (unitPoint ((Over.pullback g).obj G)) (fst_unitPoint G g).symm
  rw [← hp, ← hq, hsub p q]

end UnitFibre

section Core

open AlgebraicGeometry CategoryTheory Limits MonoidalCategory CartesianMonoidalCategory MonObj
open TranslationNoFixedPlace

variable {R₀ : Type} [CommRing R₀] (G : Over (Spec (CommRingCat.of R₀)))

/-- The structure map `R₀ = Γ(S) → Γ(G) → 𝒪_{G,x}`. -/
def stalkStructMap (x : G.left) : R₀ →+* G.left.presheaf.stalk x :=
  ((Scheme.ΓSpecIso (CommRingCat.of R₀)).inv ≫ G.hom.appTop ≫
    G.left.presheaf.germ ⊤ x trivial).hom

/-- `Spec 𝒪_{G,x} → G → S` is `Spec` of the structure map. -/
theorem fromSpecStalk_comp_hom (x : G.left) :
    G.left.fromSpecStalk x ≫ G.hom = Spec.map (CommRingCat.ofHom (stalkStructMap G x)) := by
  rw [← Scheme.SpecMap_stalkMap_fromSpecStalk, Spec.fromSpecStalk_eq, ← Spec.map_comp]
  congr 1
  have h := Scheme.Hom.germ_stalkMap G.hom ⊤ x trivial
  rw [Category.assoc]
  erw [h]
  rfl

/-- The image in `S` of a point of `Spec 𝒪_{G,x}` is its preimage under the structure map. -/
theorem fromSpecStalk_apply_comp_hom (x : G.left) (p : Spec (G.left.presheaf.stalk x)) :
    G.hom (G.left.fromSpecStalk x p) = PrimeSpectrum.comap (stalkStructMap G x) p := by
  rw [← Scheme.Hom.comp_apply, fromSpecStalk_comp_hom]
  rfl

/-- `Spec.map` on points is `PrimeSpectrum.comap`. -/
theorem spec_map_apply {A B : Type} [CommRing A] [CommRing B] (f : A →+* B)
    (p : Spec (CommRingCat.of B)) :
    Spec.map (CommRingCat.ofHom f) p = PrimeSpectrum.comap f p := rfl

/-- `Spec 𝒪_{X,x} → X` is a monomorphism (it is a preimmersion). -/
instance mono_fromSpecStalk {X : Scheme} (x : X) : Mono (X.fromSpecStalk x) := by
  obtain ⟨V, hV, hxV, -⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    X.isBasis_affineOpens (show x ∈ (⊤ : X.Opens) from trivial)
  have := IsAffineOpen.fromSpecStalk_isPreimmersion hV x hxV
  have h := IsAffineOpen.fromSpecStalk_eq_fromSpecStalk (U := V) hV hxV
  rw [h] at this
  infer_instance

/-- `Spec 𝒪_{X,x} → X` is a topological embedding. -/
theorem isEmbedding_fromSpecStalk {X : Scheme} (x : X) :
    Topology.IsEmbedding (X.fromSpecStalk x) := by
  obtain ⟨V, hV, hxV, -⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    X.isBasis_affineOpens (show x ∈ (⊤ : X.Opens) from trivial)
  have := IsAffineOpen.fromSpecStalk_isPreimmersion hV x hxV
  have h := IsAffineOpen.fromSpecStalk_eq_fromSpecStalk (U := V) hV hxV
  rw [h] at this
  exact IsPreimmersion.isEmbedding _

variable [GrpObj G] {kb : Type} [Field kb] (ρ0 : R₀ →+* kb)

/-- **The geometric core.** Let `G/S` be a group scheme over `S = Spec R₀`, `ρ0 : R₀ → kb` an
integral map to a field (a geometric point `g = Spec ρ0` of `S` over the closed point `s`), and
`ψ : 𝒪_{G,e(s)} → K` a map onto the generators of a field `K` whose kernel is minimal among the
primes over `s` (the generic point of the special fibre through `e(s)`). Let `M` be a field over
`kb` generated by `K` through `α : K → M`, compatibly with `ρ0`. Then the fibre
`X = G ×_S Spec kb` has a point `z`, the generic point of an irreducible component through the
unit, whose residue field is `M` as a `kb`-algebra. -/
theorem exists_componentPoint (hρ0 : ρ0.IsIntegral) (s : Spec (CommRingCat.of R₀))
    (hs : Spec.map (CommRingCat.ofHom ρ0) (IsLocalRing.closedPoint kb) = s)
    {K M : Type} [Field K] [Field M] [Algebra kb M]
    (ψ : G.left.presheaf.stalk ((η[G] : 𝟙_ _ ⟶ G).left s) →+* K) (α : K →+* M)
    (hψ : ∀ y : K, ∃ a b, ψ b ≠ 0 ∧ y = ψ a / ψ b)
    (hmin : ∀ P : Ideal (G.left.presheaf.stalk ((η[G] : 𝟙_ _ ⟶ G).left s)), P.IsPrime →
      P ≤ RingHom.ker ψ → (∀ r ∈ s.asIdeal, stalkStructMap G _ r ∈ P) → P = RingHom.ker ψ)
    (hcompat : ∀ r, α (ψ (stalkStructMap G _ r)) = algebraMap kb M (ρ0 r))
    (hM : IntermediateField.adjoin kb (Set.range α) = ⊤) :
    letI : GrpObj ((Over.pullback (Spec.map (CommRingCat.ofHom ρ0))).obj G) :=
      Functor.grpObjObj
    ∃ (z : ((Over.pullback (Spec.map (CommRingCat.ofHom ρ0))).obj G).left)
      (_ : ((Over.pullback (Spec.map (CommRingCat.ofHom ρ0))).obj G).left.residueField z ≃ₐ[kb] M),
      closure {z} ∈ irreducibleComponents
        ((Over.pullback (Spec.map (CommRingCat.ofHom ρ0))).obj G).left ∧
      z ⤳ unitPoint ((Over.pullback (Spec.map (CommRingCat.ofHom ρ0))).obj G) := by
  let g : Spec (CommRingCat.of kb) ⟶ Spec (CommRingCat.of R₀) := Spec.map (CommRingCat.ofHom ρ0)
  let X := (Over.pullback g).obj G
  let : GrpObj X := Functor.grpObjObj
  let e : Spec (CommRingCat.of R₀) ⟶ G.left := (η[G] : 𝟙_ _ ⟶ G).left
  let xs : G.left := e s
  let θ : G.left.presheaf.stalk xs →+* M := α.comp ψ
  let jG : Spec (CommRingCat.of M) ⟶ G.left :=
    Spec.map (CommRingCat.ofHom θ) ≫ G.left.fromSpecStalk xs
  let jK : Spec (CommRingCat.of M) ⟶ Spec (CommRingCat.of kb) :=
    Spec.map (CommRingCat.ofHom (algebraMap kb M))
  have cond : jG ≫ G.hom = jK ≫ g := by
    simp only [jG, jK, g, Category.assoc, fromSpecStalk_comp_hom, ← Spec.map_comp]
    congr 1
    ext r
    exact hcompat r
  let j : Spec (CommRingCat.of M) ⟶ X.left := pullback.lift jG jK cond
  have hjfst : j ≫ pullback.fst G.hom g = jG := pullback.lift_fst _ _ _
  have hjsnd : j ≫ X.hom = jK := pullback.lift_snd _ _ _
  let E := Scheme.SpecToEquivOfField M X.left
  let z : X.left := (E j).1
  let ι0 : X.left.residueField z ⟶ CommRingCat.of M := (E j).2
  have hj : j = Spec.map ι0 ≫ X.left.fromSpecResidueField z :=
    (E.symm_apply_apply j).symm.trans (Scheme.SpecToEquivOfField_symm_apply _ _ _)
  have hz : z = j (IsLocalRing.closedPoint M) := Scheme.SpecToEquivOfField_apply_fst _ _ _
  -- `ι0` is a map of `kb`-algebras
  have hkb : ∀ c : kb, ι0.hom (algebraMap kb (X.left.residueField z) c) = algebraMap kb M c := by
    have h1 : Spec.map (CommRingCat.ofHom (algebraMap kb (X.left.residueField z)) ≫ ι0) = jK := by
      rw [Spec.map_comp, ← fromSpecResidueField_hom X z, ← Category.assoc, ← hj, hjsnd]
    have h2 := Spec.map_injective (h1.trans rfl : _ = Spec.map
      (CommRingCat.ofHom (algebraMap kb M)))
    intro c
    exact congrArg (fun φ => φ.hom c) h2
  -- the point `x = fst z` of `G` and the factorisation of `θ` through `κ(z)`
  have hxj : pullback.fst G.hom g z = jG (IsLocalRing.closedPoint M) := by
    rw [hz, ← hjfst]
    rfl
  have hxs : pullback.fst G.hom g z ⤳ xs := by
    have : pullback.fst G.hom g z ∈ Set.range (G.left.fromSpecStalk xs) := ⟨_, hxj.symm⟩
    rwa [Scheme.range_fromSpecStalk] at this
  have hθ : ∀ a, θ a = ι0.hom (X.left.residue z ((pullback.fst G.hom g).stalkMap z
      (G.left.presheaf.stalkSpecializes hxs a))) := by
    have h1 : jG = Spec.map (G.left.presheaf.stalkSpecializes hxs ≫
        (pullback.fst G.hom g).stalkMap z ≫ X.left.residue z ≫ ι0) ≫
          G.left.fromSpecStalk xs := by
      rw [← hjfst, hj]
      simp only [Spec.map_comp, Category.assoc, Scheme.fromSpecResidueField]
      rw [Scheme.SpecMap_stalkSpecializes_fromSpecStalk, Scheme.SpecMap_stalkMap_fromSpecStalk]
      rfl
    have h2 := Spec.map_injective ((cancel_mono (G.left.fromSpecStalk xs)).mp h1)
    intro a
    exact congrArg (fun φ => φ.hom a) h2
  -- `ι0` is onto: its image contains `kb` and `α(K)`
  let ι0' : X.left.residueField z →ₐ[kb] M :=
    { toRingHom := ι0.hom
      commutes' := hkb }
  have hsurj : Function.Surjective ι0' := by
    have hle : IntermediateField.adjoin kb (Set.range α) ≤ ι0'.fieldRange := by
      rw [IntermediateField.adjoin_le_iff]
      rintro _ ⟨y, rfl⟩
      obtain ⟨a, b, -, rfl⟩ := hψ y
      have hmem : ∀ c, α (ψ c) ∈ ι0'.fieldRange := fun c =>
        (AlgHom.mem_fieldRange).mpr ⟨_, (hθ c).symm⟩
      rw [map_div₀]
      exact div_mem (hmem a) (hmem b)
    rw [hM] at hle
    intro y
    exact (AlgHom.mem_fieldRange).mp (hle (IntermediateField.mem_top (x := y)))
  let ιz : X.left.residueField z ≃ₐ[kb] M :=
    AlgEquiv.ofBijective ι0' ⟨ι0'.toRingHom.injective, hsurj⟩
  have hIG : IsIntegralHom g := IsIntegralHom.SpecMap_iff.mpr hρ0
  -- the point `p0` of `Spec 𝒪_{G,e(s)}` under `fst z`, with prime `ker ψ`
  let p0 : Spec (G.left.presheaf.stalk xs) := Spec.map (CommRingCat.ofHom θ)
    (IsLocalRing.closedPoint M)
  have hp0 : G.left.fromSpecStalk xs p0 = pullback.fst G.hom g z := hxj.symm
  have hker : p0.asIdeal = RingHom.ker ψ := by
    ext a
    change θ a ∈ IsLocalRing.maximalIdeal M ↔ _
    rw [IsLocalRing.maximalIdeal_eq_bot, Ideal.mem_bot, RingHom.mem_ker]
    exact map_eq_zero_iff α α.injective
  refine ⟨z, ιz, closure_mem_irreducibleComponents fun z' hz' => ?_, ?_⟩
  · apply eq_of_specializes_of_isIntegralHom (pullback.fst G.hom g) hz'
    have h1 : pullback.fst G.hom g z' ⤳ pullback.fst G.hom g z :=
      hz'.map (pullback.fst G.hom g).continuous
    obtain ⟨p', hp'⟩ : pullback.fst G.hom g z' ∈ Set.range (G.left.fromSpecStalk xs) := by
      rw [Scheme.range_fromSpecStalk]
      exact h1.trans hxs
    have hle : p'.asIdeal ≤ p0.asIdeal := by
      have : p' ⤳ p0 := by
        apply (isEmbedding_fromSpecStalk xs).isInducing.specializes_iff.mp
        rw [hp', hp0]
        exact h1
      exact (PrimeSpectrum.le_iff_specializes _ _).mpr this
    have hgz' : G.hom (pullback.fst G.hom g z') = s := by
      rw [← Scheme.Hom.comp_apply, pullback.condition, Scheme.Hom.comp_apply,
        Subsingleton.elim (α := PrimeSpectrum kb) (pullback.snd G.hom g z')
          (IsLocalRing.closedPoint kb)]
      exact hs
    have hover : ∀ r ∈ s.asIdeal, stalkStructMap G _ r ∈ p'.asIdeal := by
      intro r hr
      rw [← hp', fromSpecStalk_apply_comp_hom] at hgz'
      rw [← hgz'] at hr
      exact hr
    have hP := hmin p'.asIdeal p'.isPrime (hle.trans hker.le) hover
    rw [← hp', ← hp0, PrimeSpectrum.ext (hP.trans hker.symm)]
  · have hxs' : pullback.fst G.hom g z ⤳ e (g (IsLocalRing.closedPoint kb)) := by
      have : g (IsLocalRing.closedPoint kb) = s := hs
      rw [this]
      exact hxs
    obtain ⟨u, hzu, hu⟩ := (pullback.fst G.hom g).isClosedMap.specializingMap hxs'
    rw [← eq_unitPoint_of_fst_eq G g hu]
    exact hzu

end Core

section LocalModel

open AlgebraicGeometry CategoryTheory TopologicalSpace

attribute [local instance] chartBaseAlgebra

variable {R : Type} [CommRing R] {X : Scheme.{0}} (f : X ⟶ Spec (CommRingCat.of R))
  (e : Spec (CommRingCat.of R) ⟶ X)

/-- `exists_localModel_of_smooth` with one more output: the chart isomorphism `φ` is compatible
with the structure maps from `R`, i.e. `φ (r) = f^♯(r)` at `e(s)` for `r ∈ R`. -/
theorem exists_localModel_of_smooth_algebraMap [IsDomain R] [Smooth f] (he : e ≫ f = 𝟙 _)
    (s : Spec (CommRingCat.of R))
    [IsDiscreteValuationRing (Localization.AtPrime s.asIdeal)] :
    ∃ (n : ℕ) (A₀ : Type) (_ : CommRing A₀) (_ : Algebra (Localization.AtPrime s.asIdeal) A₀),
      Algebra.IsStandardSmoothOfRelativeDimension n (Localization.AtPrime s.asIdeal) A₀ ∧
      ∃ σ : A₀ →ₐ[Localization.AtPrime s.asIdeal] Localization.AtPrime s.asIdeal,
      ∃ (φ : Localization.AtPrime (sectionPrime σ) ≃+* X.presheaf.stalk (e s))
        (φη : Localization.AtPrime (RingHom.ker σ) ≃+*
          X.presheaf.stalk (e (genericPoint (Spec (CommRingCat.of R))))),
        (∀ a, (e.stalkMap s).hom (φ a) = specStalkEquiv s (localSection σ a)) ∧
        (∀ (h : e (genericPoint (Spec (CommRingCat.of R))) ⤳ e s) (x : A₀),
          (X.presheaf.stalkSpecializes h).hom (φ (algebraMap A₀ _ x)) =
            φη (algebraMap A₀ _ x)) ∧
        ∀ r : R, φ (algebraMap (Localization.AtPrime s.asIdeal) _
          (algebraMap R (Localization.AtPrime s.asIdeal) r)) =
            ((Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ f.appTop ≫
              X.presheaf.germ ⊤ (e s) trivial).hom r := by
  obtain ⟨U, hU, V, hV, hxV, hVU, hss⟩ := Smooth.exists_isStandardSmooth f (e s)
  have hsU : s ∈ U := by
    have h := hVU hxV
    have hfe : f (e s) = s := by rw [← Scheme.Hom.comp_apply, he]; rfl
    rw [Scheme.Hom.mem_preimage, hfe] at h
    exact h
  let RU := Γ(Spec (CommRingCat.of R), U)
  let A := Γ(X, V)
  let _ : Algebra RU A := (f.appLE U V hVU).hom.toAlgebra
  have hstd : Algebra.IsStandardSmooth RU A := hss.toAlgebra
  obtain ⟨ι, κ, _, _, ⟨P⟩⟩ := hstd.out
  have hn : Algebra.IsStandardSmoothOfRelativeDimension P.dimension RU A :=
    ⟨⟨ι, κ, ‹_›, ‹_›, P, rfl⟩⟩
  let Rs := Localization.AtPrime s.asIdeal
  obtain ⟨ψ, hψ⟩ : ∃ ψ, ψ = specStalkEquiv s := ⟨_, rfl⟩
  let _ : Algebra RU Rs := (ψ.symm.toRingHom.comp
    ((Spec (CommRingCat.of R)).presheaf.germ U s hsU).hom).toAlgebra
  let q := (hU.primeIdealOf ⟨s, hsU⟩).asIdeal
  let _ : Algebra RU ((Spec (CommRingCat.of R)).presheaf.stalk s) :=
    ((Spec (CommRingCat.of R)).presheaf.germ U s hsU).hom.toAlgebra
  have hq : IsLocalization.AtPrime Rs q := by
    have : IsLocalization.AtPrime ((Spec (CommRingCat.of R)).presheaf.stalk s) q :=
      hU.isLocalization_stalk ⟨s, hsU⟩
    exact IsLocalization.isLocalization_of_algEquiv _
      (AlgEquiv.ofRingEquiv (f := ψ.symm) (fun _ => rfl))
  have hsV : s ∈ e ⁻¹ᵁ V := hxV
  let g : A →ₐ[RU] Rs :=
    { toRingHom := ψ.symm.toRingHom.comp
        (((Spec (CommRingCat.of R)).presheaf.germ (e ⁻¹ᵁ V) s hsV).hom.comp (e.app V).hom)
      commutes' := fun r => by
        have h1 := congrArg (fun φ => φ.hom r)
          (Scheme.Hom.appLE_comp_appLE e f U V (e ⁻¹ᵁ V) hVU le_rfl)
        simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h1
        rw [← Scheme.Hom.app_eq_appLE] at h1
        change ψ.symm (((Spec (CommRingCat.of R)).presheaf.germ (e ⁻¹ᵁ V) s hsV).hom
          ((e.app V).hom ((f.appLE U V hVU).hom r))) =
            ψ.symm (((Spec (CommRingCat.of R)).presheaf.germ U s hsU).hom r)
        rw [h1]
        exact congrArg ψ.symm (germ_appLE_of_eq_id _ he _ _ _ _ _ _ _) }
  let p := (hV.primeIdealOf ⟨e s, hxV⟩).asIdeal
  let _ : Algebra A (X.presheaf.stalk (e s)) := (X.presheaf.germ V (e s) hxV).hom.toAlgebra
  have hp : IsLocalization.AtPrime (X.presheaf.stalk (e s)) p :=
    hV.isLocalization_stalk ⟨e s, hxV⟩
  have hτ : ∀ a : A, (e.stalkMap s).hom (algebraMap A (X.presheaf.stalk (e s)) a) =
      (ψ : Rs →+* _) (g a) := by
    intro a
    change (e.stalkMap s).hom ((X.presheaf.germ V (e s) hxV).hom a) =
      ψ (ψ.symm (((Spec (CommRingCat.of R)).presheaf.germ (e ⁻¹ᵁ V) s hsV).hom
        ((e.app V).hom a)))
    rw [RingEquiv.apply_symm_apply]
    exact Scheme.Hom.germ_stalkMap_apply e V s hxV a
  obtain ⟨φ, hφ, hφA⟩ := exists_localizationEquiv (e.stalkMap s).hom (ψ : Rs →+* _) g hτ q p
  let η := genericPoint (Spec (CommRingCat.of R))
  have hηV : η ∈ e ⁻¹ᵁ V := (genericPoint_specializes s).mem_open (e ⁻¹ᵁ V).isOpen hsV
  have hξV : e η ∈ V := hηV
  let p' := (hV.primeIdealOf ⟨e η, hξV⟩).asIdeal
  let _ : Algebra A (X.presheaf.stalk (e η)) := (X.presheaf.germ V (e η) hξV).hom.toAlgebra
  have hp' : IsLocalization.AtPrime (X.presheaf.stalk (e η)) p' :=
    hV.isLocalization_stalk ⟨e η, hξV⟩
  have hO : IsField ((Spec (CommRingCat.of R)).presheaf.stalk η) :=
    Field.toIsField (Spec (CommRingCat.of R)).functionField
  have hg : ∀ a, g a = 0 ↔
      (e.stalkMap η).hom (algebraMap A (X.presheaf.stalk (e η)) a) = 0 := by
    intro a
    change ψ.symm (((Spec (CommRingCat.of R)).presheaf.germ (e ⁻¹ᵁ V) s hsV).hom
        ((e.app V).hom a)) = 0 ↔ (e.stalkMap η).hom ((X.presheaf.germ V (e η) hξV).hom a) = 0
    rw [Scheme.Hom.germ_stalkMap_apply e V η hξV a, map_eq_zero_iff _ ψ.symm.injective,
      map_eq_zero_iff _ (germ_injective_of_isIntegral _ s hsV),
      map_eq_zero_iff _ (germ_injective_of_isIntegral _ η hηV)]
  have hc := comap_ker_chartSection p' hO (e.stalkMap η).hom g hg
  obtain ⟨φη, hφηA⟩ := exists_localizationEquiv_of_comap
    (T := X.presheaf.stalk (e η)) q p' _ hc
  have hspec : ∀ (h : e η ⤳ e s) (x : chartBase RU Rs A),
      (X.presheaf.stalkSpecializes h).hom (φ (algebraMap (chartBase RU Rs A) _ x)) =
        φη (algebraMap (chartBase RU Rs A) _ x) := by
    intro h x
    have := chartBase_isLocalization (A := A) (Rs := Rs) q
    have hext : (X.presheaf.stalkSpecializes h).hom.comp ((φ : _ →+* _).comp
        (algebraMap (chartBase RU Rs A) (Localization.AtPrime (sectionPrime (chartSection g))))) =
        (φη : _ →+* _).comp (algebraMap (chartBase RU Rs A)
          (Localization.AtPrime (RingHom.ker (chartSection g)))) := by
      refine IsLocalization.ringHom_ext (Algebra.algebraMapSubmonoid A q.primeCompl)
        (RingHom.ext fun a => ?_)
      simp only [RingHom.comp_apply, RingHom.coe_coe]
      rw [hφA, hφηA]
      exact TopCat.Presheaf.germ_stalkSpecializes_apply _ _ _ _
    exact RingHom.congr_fun hext x
  have hR : ∀ r : R, φ (algebraMap Rs _ (algebraMap R Rs r)) =
      ((Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ f.appTop ≫
        X.presheaf.germ ⊤ (e s) trivial).hom r := by
    intro r
    let r' : Γ(Spec (CommRingCat.of R), ⊤) := (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom r
    let rU : RU := ((Spec (CommRingCat.of R)).presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom r'
    have h1 : algebraMap R Rs r = algebraMap RU Rs rU := by
      change _ = ψ.symm (((Spec (CommRingCat.of R)).presheaf.germ U s hsU).hom rU)
      rw [TopCat.Presheaf.germ_res_apply]
      apply ψ.injective
      rw [ψ.apply_symm_apply, hψ]
      exact congrArg (fun φ => φ.hom r) (Spec.algebraMap_stalkIso_inv s)
    have h2 : algebraMap Rs (Localization.AtPrime (sectionPrime (chartSection g)))
        (algebraMap RU Rs rU) = algebraMap (chartBase RU Rs A) _
          (algebraMap A (chartBase RU Rs A) (algebraMap RU A rU)) := by
      rw [IsScalarTower.algebraMap_apply Rs (chartBase RU Rs A)
        (Localization.AtPrime (sectionPrime (chartSection g)))]
      congr 1
      rw [Algebra.TensorProduct.right_algebraMap_apply]
      change (algebraMap RU Rs rU) ⊗ₜ[RU] (1 : A) = _
      rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]
    rw [h1, h2, hφA]
    change (X.presheaf.germ V (e s) hxV).hom ((f.appLE U V hVU).hom rU) = _
    have h3 := congrArg (fun φ => φ.hom r')
      (Scheme.Hom.map_appLE f hVU (homOfLE (le_top : U ≤ ⊤)).op)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h3
    change (X.presheaf.germ V (e s) hxV).hom ((f.appLE U V hVU).hom rU) = _ at *
    rw [h3, Scheme.Hom.appLE]
    simp only [CommRingCat.hom_comp, RingHom.comp_apply]
    rw [TopCat.Presheaf.germ_res_apply]
    rfl
  subst hψ
  exact ⟨P.dimension, chartBase RU Rs A, inferInstance, inferInstance,
    Algebra.IsStandardSmoothOfRelativeDimension.baseChange _ _, chartSection g, φ, φη, hφ,
    hspec, hR⟩

/-- **N5-bridge with the structure maps.** `exists_localModel_generic` together with the
compatibility of `φ` with the maps from `R`: the input `hφ` of `exists_translationData` and
`specialFibreGap` (for a group model: `R = 𝓞_L`, `f = 𝒢.G.hom`, `e = 𝒢.unitSection`, and the
right-hand side is `stalkStructMap 𝒢.G _ r`). -/
theorem exists_localModel_generic_algebraMap [IsDomain R] [Smooth f] (he : e ≫ f = 𝟙 _)
    (s : Spec (CommRingCat.of R))
    [IsDiscreteValuationRing (Localization.AtPrime s.asIdeal)]
    [IsDomain (X.presheaf.stalk (e (genericPoint (Spec (CommRingCat.of R)))))]
    [IsDiscreteValuationRing (X.presheaf.stalk (e (genericPoint (Spec (CommRingCat.of R)))))] :
    ∃ (A₀ : Type) (_ : CommRing A₀) (_ : Algebra (Localization.AtPrime s.asIdeal) A₀),
      Algebra.IsStandardSmoothOfRelativeDimension 1 (Localization.AtPrime s.asIdeal) A₀ ∧
      ∃ (σ : A₀ →ₐ[Localization.AtPrime s.asIdeal] Localization.AtPrime s.asIdeal)
        (φ : Localization.AtPrime (sectionPrime σ) ≃+* X.presheaf.stalk (e s))
        (φη : Localization.AtPrime (RingHom.ker σ) ≃+*
          X.presheaf.stalk (e (genericPoint (Spec (CommRingCat.of R))))),
        (∀ a, (e.stalkMap s).hom (φ a) = specStalkEquiv s (localSection σ a)) ∧
        (∀ (h : e (genericPoint (Spec (CommRingCat.of R))) ⤳ e s) (x : A₀),
          (X.presheaf.stalkSpecializes h).hom (φ (algebraMap A₀ _ x)) =
            φη (algebraMap A₀ _ x)) ∧
        ∀ r : R, φ (algebraMap (Localization.AtPrime s.asIdeal) _
          (algebraMap R (Localization.AtPrime s.asIdeal) r)) =
            ((Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ f.appTop ≫
              X.presheaf.germ ⊤ (e s) trivial).hom r := by
  obtain ⟨n, A₀, _, _, hn, σ, φ, φη, hφ, hsp, hR⟩ := exists_localModel_of_smooth_algebraMap f e he s
  obtain rfl := eq_one_of_genericSection_equiv σ n φη
  exact ⟨A₀, inferInstance, inferInstance, hn, σ, φ, φη, hφ, hsp, hR⟩

end LocalModel

section Compositum

/-- A compositum of `K` and an algebraic extension `kb` of `k`, over `k`: a field `M` over `kb`
with a field map `α : K → M` compatible on `k`, generated over `kb` by `α(K)`. -/
theorem exists_compositum {k K kb : Type} [Field k] [Field K] [Field kb] [Algebra k K]
    [Algebra k kb] [Algebra.IsAlgebraic k kb] :
    ∃ (M : Type) (_ : Field M) (_ : Algebra kb M) (α : K →+* M),
      (∀ c : k, α (algebraMap k K c) = algebraMap kb M (algebraMap k kb c)) ∧
        IntermediateField.adjoin kb (Set.range α) = ⊤ := by
  let lf : kb →ₐ[k] AlgebraicClosure K := IsAlgClosed.lift
  let : Algebra kb (AlgebraicClosure K) := lf.toRingHom.toAlgebra
  let M : IntermediateField kb (AlgebraicClosure K) :=
    IntermediateField.adjoin kb (Set.range (algebraMap K (AlgebraicClosure K)))
  let α : K →+* M := (algebraMap K (AlgebraicClosure K)).codRestrict M.toSubalgebra
    fun y => IntermediateField.subset_adjoin _ _ ⟨y, rfl⟩
  refine ⟨M, inferInstance, inferInstance, α, fun c => Subtype.ext ?_, ?_⟩
  · change algebraMap K (AlgebraicClosure K) (algebraMap k K c) = lf (algebraMap k kb c)
    rw [lf.commutes, IsScalarTower.algebraMap_apply k K (AlgebraicClosure K)]
  · apply IntermediateField.map_injective M.val
    rw [IntermediateField.adjoin_map, ← AlgHom.fieldRange_eq_map, IntermediateField.fieldRange_val]
    congr 1
    ext y
    constructor
    · rintro ⟨_, ⟨x, rfl⟩, rfl⟩
      exact ⟨x, rfl⟩
    · rintro ⟨x, rfl⟩
      exact ⟨α x, ⟨x, rfl⟩, rfl⟩

end Compositum

section Assembly

open AlgebraicGeometry CategoryTheory Limits MonoidalCategory CartesianMonoidalCategory MonObj
open TranslationNoFixedPlace SpecialFibreValuation

variable {R₀ : Type} [CommRing R₀] (s : Spec (CommRingCat.of R₀))

/-- `R₀ → κ(s)` is onto at a closed point. -/
theorem residue_comp_algebraMap_surjective [s.asIdeal.IsMaximal] :
    Function.Surjective ((residue (Localization.AtPrime s.asIdeal)).comp
      (algebraMap R₀ (Localization.AtPrime s.asIdeal))) := by
  intro y
  obtain ⟨q, rfl⟩ := (Ideal.bijective_algebraMap_quotient_residueField s.asIdeal).2 y
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective q
  exact ⟨r, rfl⟩

/-- A map `κ(s) → kb` defines a geometric point of `S` over `s`. -/
theorem spec_map_closedPoint {kb : Type} [Field kb]
    (j : ResidueField (Localization.AtPrime s.asIdeal) →+* kb) :
    Spec.map (CommRingCat.ofHom ((j.comp (residue (Localization.AtPrime s.asIdeal))).comp
      (algebraMap R₀ (Localization.AtPrime s.asIdeal)))) (IsLocalRing.closedPoint kb) = s := by
  apply PrimeSpectrum.ext
  ext r
  change j (residue _ (algebraMap R₀ (Localization.AtPrime s.asIdeal) r)) ∈
    IsLocalRing.maximalIdeal kb ↔ r ∈ s.asIdeal
  rw [IsLocalRing.maximalIdeal_eq_bot, Ideal.mem_bot, map_eq_zero_iff j j.injective,
    residue_eq_zero_iff]
  exact IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime s.asIdeal) s.asIdeal r

/-- **L5, the B3 wiring.** Let `G` be a proper group scheme over `S = Spec R₀`, `s` a closed point
with `R = 𝒪_{S,s}` a discrete valuation ring with uniformizer `ϖ`, and `A` an `R`-algebra with a
ring isomorphism `φ : A ≅ 𝒪_{G,e(s)}` compatible with the structure maps from `R₀`
(`hφ`; `A/ϖA` a domain). Let `w` be the special-fibre valuation on `Ω = Frac A`, `κ_w` its residue
field and `k` the residue field of `R`. If `κ_w/k` has transcendence degree at most one, then for
every degree-one place `P` of `κ_w/k` and uniformizer `π` at `P`:
* (`hgap`) every element of `L(1·P)` is a constant;
* (`hnsp`) no `f ∈ κ_w` has polar divisor exactly `1·P`.

Proof: with `kb` an algebraic closure of `k` and `g : Spec kb → S` through `s`, the point `y` of
the geometric special fibre `G ×_S Spec kb` given by `exists_componentPoint` (the generic point of
the component through the unit lying over the generic point of the special fibre through `e(s)`)
has residue field generated over `kb` by `κ_w`; the translation of
`exists_noFixedPlace_of_component`
gives the automorphism of `κ(y)` that fixes no degree-one place. -/
theorem exists_translationData (G : Over (Spec (CommRingCat.of R₀))) [GrpObj G] [IsProper G.hom]
    [s.asIdeal.IsMaximal] [IsDomain (Localization.AtPrime s.asIdeal)]
    [IsDiscreteValuationRing (Localization.AtPrime s.asIdeal)]
    {A : Type} [CommRing A] [IsNoetherianRing A] [IsDomain A]
    [Algebra (Localization.AtPrime s.asIdeal) A] [FaithfulSMul (Localization.AtPrime s.asIdeal) A]
    (Ω : Type) [Field Ω] [Algebra A Ω] [IsFractionRing A Ω]
    [Algebra (Localization.AtPrime s.asIdeal) Ω]
    [IsScalarTower (Localization.AtPrime s.asIdeal) A Ω]
    {ϖ : Localization.AtPrime s.asIdeal} (hϖ : Irreducible ϖ)
    [IsDomain (A ⧸ Ideal.span {algebraMap (Localization.AtPrime s.asIdeal) A ϖ})]
    (φ : A ≃+* G.left.presheaf.stalk ((η[G] : 𝟙_ _ ⟶ G).left s))
    (hφ : ∀ r : R₀, φ (algebraMap (Localization.AtPrime s.asIdeal) A
      (algebraMap R₀ (Localization.AtPrime s.asIdeal) r)) = stalkStructMap G _ r) :
    letI := (residueHom (specialFibreValuation A Ω hϖ)
      (specialFibreValuation_algebraMap_base_le_one hϖ)
      (specialFibreValuation_algebraMap_base_lt_one hϖ)).toAlgebra
    TrdegLeOne (ResidueField (Localization.AtPrime s.asIdeal))
        (ResidueField (specialFibreValuation A Ω hϖ).valuationSubring) →
      (∀ P : ValuationSubring (ResidueField (specialFibreValuation A Ω hϖ).valuationSubring),
        IsDegreeOnePlace (ResidueField (Localization.AtPrime s.asIdeal)) P →
        ∀ π, IsUniformizerAt P π →
          ∀ h ∈ polePart (ResidueField (Localization.AtPrime s.asIdeal)) P π 1,
            ∃ c : ResidueField (Localization.AtPrime s.asIdeal), h = algebraMap _ _ c) ∧
      ∀ P : ValuationSubring (ResidueField (specialFibreValuation A Ω hϖ).valuationSubring),
        IsDegreeOnePlace (ResidueField (Localization.AtPrime s.asIdeal)) P →
        ∀ f, ¬ HasSimplePoleOnlyAt (ResidueField (Localization.AtPrime s.asIdeal)) P f := by
  intro htr
  let R := Localization.AtPrime s.asIdeal
  let k := ResidueField R
  let K := ResidueField (specialFibreValuation A Ω hϖ).valuationSubring
  let : Algebra k K := (residueHom (specialFibreValuation A Ω hϖ)
      (specialFibreValuation_algebraMap_base_le_one hϖ)
      (specialFibreValuation_algebraMap_base_lt_one hϖ)).toAlgebra
  let kb := AlgebraicClosure k
  obtain ⟨M, _, _, α, hαk, hM⟩ := exists_compositum (k := k) (K := K) (kb := kb)
  let ρ0 : R₀ →+* kb := ((algebraMap k kb).comp (residue R)).comp (algebraMap R₀ R)
  have hρ0 : ρ0.IsIntegral :=
    RingHom.IsIntegral.trans _ (algebraMap k kb)
      (RingHom.isIntegral_of_surjective _ (residue_comp_algebraMap_surjective s))
      fun x => Algebra.IsIntegral.isIntegral x
  have hs := spec_map_closedPoint s (algebraMap k kb)
  let ψA : A →+* K := (specialFibreResidueMap A Ω hϖ).comp (Ideal.Quotient.mk _)
  have hψA : ∀ a, ψA a = 0 ↔ a ∈ Ideal.span {algebraMap R A ϖ} := fun a => by
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    exact map_eq_zero_iff (specialFibreResidueMap A Ω hϖ)
      (specialFibreResidueMap_injective (A := A) (Ω := Ω) hϖ) (x := Ideal.Quotient.mk _ a)
  let ψ : G.left.presheaf.stalk ((η[G] : 𝟙_ _ ⟶ G).left s) →+* K := ψA.comp φ.symm.toRingHom
  have hψ : ∀ y : K, ∃ a b, ψ b ≠ 0 ∧ y = ψ a / ψ b := by
    intro y
    obtain ⟨a, b, hb, h⟩ := exists_mul_specialFibreResidueMap_eq hϖ y
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective b
    refine ⟨φ a, φ b, ?_, ?_⟩
    · change ψA (φ.symm (φ b)) ≠ 0
      rwa [φ.symm_apply_apply]
    · change y = ψA (φ.symm (φ a)) / ψA (φ.symm (φ b))
      rw [φ.symm_apply_apply, φ.symm_apply_apply]
      exact (eq_div_iff hb).mpr h
  have hmin : ∀ P : Ideal (G.left.presheaf.stalk ((η[G] : 𝟙_ _ ⟶ G).left s)), P.IsPrime →
      P ≤ RingHom.ker ψ → (∀ r ∈ s.asIdeal, stalkStructMap G _ r ∈ P) →
        P = RingHom.ker ψ := by
    intro P hP hle hover
    refine le_antisymm hle ?_
    have hϖP : φ (algebraMap R A ϖ) ∈ P := by
      obtain ⟨⟨r, u⟩, hru⟩ := IsLocalization.mk'_surjective s.asIdeal.primeCompl ϖ
      have h1 : ϖ * algebraMap R₀ R u = algebraMap R₀ R r := by
        rw [← hru]
        exact IsLocalization.mk'_spec R r u
      have hr : r ∈ s.asIdeal := by
        refine (IsLocalization.AtPrime.to_map_mem_maximal_iff R s.asIdeal r).mp ?_
        rw [← h1]
        exact Ideal.mul_mem_right _ _ ((mem_maximalIdeal _).mpr hϖ.not_isUnit)
      have h2 := hover r hr
      rw [← hφ r, ← h1, map_mul, map_mul] at h2
      have hu : IsUnit (φ (algebraMap R A (algebraMap R₀ R u))) :=
        ((IsLocalization.map_units R u).map _).map _
      exact (hP.mem_or_mem h2).resolve_right fun h => hP.ne_top (Ideal.eq_top_of_isUnit_mem _ h hu)
    intro x hx
    have hx' : φ.symm x ∈ Ideal.span {algebraMap R A ϖ} := (hψA _).mp hx
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hx'
    have : x = φ c * φ (algebraMap R A ϖ) := by
      rw [← map_mul, hc, φ.apply_symm_apply]
    rw [this]
    exact P.mul_mem_left _ hϖP
  have hcompat : ∀ r, α (ψ (stalkStructMap G _ r)) = algebraMap kb M (ρ0 r) := by
    intro r
    change α (ψA (φ.symm (stalkStructMap G _ r))) =
      algebraMap kb M (algebraMap k kb (residue R (algebraMap R₀ R r)))
    rw [← hφ r, φ.symm_apply_apply, ← hαk]
    congr 1
    exact (residueHom_residue_eq (A := A) (Ω := Ω) hϖ _).symm
  obtain ⟨z, ιz, hcomp, he⟩ := exists_componentPoint G ρ0 hρ0 s hs ψ α hψ hmin hcompat hM
  let g : Spec (CommRingCat.of kb) ⟶ Spec (CommRingCat.of R₀) := Spec.map (CommRingCat.ofHom ρ0)
  let X := (Over.pullback g).obj G
  let : GrpObj X := Functor.grpObjObj
  have : IsProper X.hom := by
    simp only [X, Over.pullback_obj_hom]
    infer_instance
  let : Algebra K (X.left.residueField z) := (ιz.symm.toRingHom.comp α).toAlgebra
  let : Algebra k (X.left.residueField z) :=
    ((algebraMap kb (X.left.residueField z)).comp (algebraMap k kb)).toAlgebra
  have : IsScalarTower k kb (X.left.residueField z) := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : IsScalarTower k K (X.left.residueField z) := IsScalarTower.of_algebraMap_eq fun c => by
    change algebraMap kb (X.left.residueField z) (algebraMap k kb c) =
      ιz.symm (α (algebraMap k K c))
    rw [hαk, AlgEquiv.commutes]
  have hgen : IntermediateField.adjoin kb
      (Set.range (algebraMap K (X.left.residueField z))) = ⊤ := by
    have h := IntermediateField.adjoin_map kb (Set.range α)
      (ιz.symm : M →ₐ[kb] X.left.residueField z)
    rw [hM, ← Set.range_comp] at h
    rw [eq_top_iff]
    intro y _
    have hy : y ∈ IntermediateField.map (ιz.symm : M →ₐ[kb] X.left.residueField z) ⊤ :=
      ⟨ιz y, trivial, ιz.symm_apply_apply y⟩
    rw [h] at hy
    exact hy
  refine ⟨fun P hP π hπ => ?_, fun P hP f => ?_⟩
  · obtain ⟨σ, hσ⟩ := exists_noFixedPlace_baseChange_of_component G g z hcomp he
      (not_isClosed_of_isDegreeOnePlace (X := X) (y := z) hP)
    exact polePart_gap_of_baseChange hgen htr hP σ hσ hπ
  · obtain ⟨σ, hσ⟩ := exists_noFixedPlace_baseChange_of_component G g z hcomp he
      (not_isClosed_of_isDegreeOnePlace (X := X) (y := z) hP)
    exact not_hasSimplePoleOnlyAt_of_baseChange hgen htr hP σ hσ f

/-- **L5, assembled (B1 transfer and B3 wiring).** In the setting of `exists_translationData`,
with `A` a localization of a standard smooth `R`-algebra `A₀` of relative dimension one (in the
assembly `A₀` is the chart of `exists_localModel_generic`, `M = (sectionPrime σ).primeCompl`):
`κ_w/k` has transcendence degree at most one (`htr`), every element of `L(1·P)` is constant
(`hgap`), and no function has polar divisor exactly `1·P` (`hnsp`), for every degree-one place
`P` of `κ_w/k`. -/
theorem specialFibreGap (G : Over (Spec (CommRingCat.of R₀))) [GrpObj G] [IsProper G.hom]
    [s.asIdeal.IsMaximal] [IsDomain (Localization.AtPrime s.asIdeal)]
    [IsDiscreteValuationRing (Localization.AtPrime s.asIdeal)]
    {A₀ : Type} [CommRing A₀] [Algebra (Localization.AtPrime s.asIdeal) A₀]
    [Algebra.IsStandardSmoothOfRelativeDimension 1 (Localization.AtPrime s.asIdeal) A₀]
    {A : Type} [CommRing A] [IsNoetherianRing A] [IsDomain A] [Algebra A₀ A]
    [Algebra (Localization.AtPrime s.asIdeal) A]
    [IsScalarTower (Localization.AtPrime s.asIdeal) A₀ A]
    [FaithfulSMul (Localization.AtPrime s.asIdeal) A] (M : Submonoid A₀) [IsLocalization M A]
    (Ω : Type) [Field Ω] [Algebra A Ω] [IsFractionRing A Ω]
    [Algebra (Localization.AtPrime s.asIdeal) Ω]
    [IsScalarTower (Localization.AtPrime s.asIdeal) A Ω]
    {ϖ : Localization.AtPrime s.asIdeal} (hϖ : Irreducible ϖ)
    [IsDomain (A ⧸ Ideal.span {algebraMap (Localization.AtPrime s.asIdeal) A ϖ})]
    (φ : A ≃+* G.left.presheaf.stalk ((η[G] : 𝟙_ _ ⟶ G).left s))
    (hφ : ∀ r : R₀, φ (algebraMap (Localization.AtPrime s.asIdeal) A
      (algebraMap R₀ (Localization.AtPrime s.asIdeal) r)) = stalkStructMap G _ r) :
    letI := (residueHom (specialFibreValuation A Ω hϖ)
      (specialFibreValuation_algebraMap_base_le_one hϖ)
      (specialFibreValuation_algebraMap_base_lt_one hϖ)).toAlgebra
    TrdegLeOne (ResidueField (Localization.AtPrime s.asIdeal))
        (ResidueField (specialFibreValuation A Ω hϖ).valuationSubring) ∧
      (∀ P : ValuationSubring (ResidueField (specialFibreValuation A Ω hϖ).valuationSubring),
        IsDegreeOnePlace (ResidueField (Localization.AtPrime s.asIdeal)) P →
        ∀ π, IsUniformizerAt P π →
          ∀ h ∈ polePart (ResidueField (Localization.AtPrime s.asIdeal)) P π 1,
            ∃ c : ResidueField (Localization.AtPrime s.asIdeal), h = algebraMap _ _ c) ∧
      ∀ P : ValuationSubring (ResidueField (specialFibreValuation A Ω hϖ).valuationSubring),
        IsDegreeOnePlace (ResidueField (Localization.AtPrime s.asIdeal)) P →
        ∀ f, ¬ HasSimplePoleOnlyAt (ResidueField (Localization.AtPrime s.asIdeal)) P f := by
  have htr := trdegLeOne_specialFibreValuation (A₀ := A₀) (A := A) M Ω hϖ
  exact ⟨htr, exists_translationData s G Ω hϖ φ hφ htr⟩

/-- **L5 for a smooth proper group scheme.** For `G` smooth and proper over `S = Spec R₀` (`R₀` a
domain), a closed point `s` with `R = 𝒪_{S,s}` a discrete valuation ring, and the local ring at
`e(η)` a discrete valuation ring: the chart `A₀`, `σ`, `φ`, `φη` of N5-bridge exists, and for
`A = A₀` localized at the section prime, `Ω = Frac A` and every uniformizer `ϖ` with `A/ϖA` a domain
(and `A` Noetherian, a domain, with `R → A` injective), `κ_w` satisfies `htr`, `hgap` and `hnsp`. -/
theorem exists_specialFibreGap (G : Over (Spec (CommRingCat.of R₀))) [GrpObj G] [IsProper G.hom]
    [Smooth G.hom] [IsDomain R₀] [s.asIdeal.IsMaximal]
    [IsDiscreteValuationRing (Localization.AtPrime s.asIdeal)]
    [IsDomain (G.left.presheaf.stalk
      ((η[G] : 𝟙_ _ ⟶ G).left (genericPoint (Spec (CommRingCat.of R₀)))))]
    [IsDiscreteValuationRing (G.left.presheaf.stalk
      ((η[G] : 𝟙_ _ ⟶ G).left (genericPoint (Spec (CommRingCat.of R₀)))))] :
    ∃ (A₀ : Type) (_ : CommRing A₀) (_ : Algebra (Localization.AtPrime s.asIdeal) A₀),
      Algebra.IsStandardSmoothOfRelativeDimension 1 (Localization.AtPrime s.asIdeal) A₀ ∧
      ∃ (σ : A₀ →ₐ[Localization.AtPrime s.asIdeal] Localization.AtPrime s.asIdeal)
        (φ : Localization.AtPrime (sectionPrime σ) ≃+*
          G.left.presheaf.stalk ((η[G] : 𝟙_ _ ⟶ G).left s))
        (φη : Localization.AtPrime (RingHom.ker σ) ≃+* G.left.presheaf.stalk
          ((η[G] : 𝟙_ _ ⟶ G).left (genericPoint (Spec (CommRingCat.of R₀))))),
        (∀ a, ((η[G] : 𝟙_ _ ⟶ G).left.stalkMap s).hom (φ a) =
          specStalkEquiv s (localSection σ a)) ∧
        (∀ (h : (η[G] : 𝟙_ _ ⟶ G).left (genericPoint (Spec (CommRingCat.of R₀))) ⤳
            (η[G] : 𝟙_ _ ⟶ G).left s) (x : A₀),
          (G.left.presheaf.stalkSpecializes h).hom (φ (algebraMap A₀ _ x)) =
            φη (algebraMap A₀ _ x)) ∧
        (∀ r : R₀, φ (algebraMap (Localization.AtPrime s.asIdeal) _
          (algebraMap R₀ (Localization.AtPrime s.asIdeal) r)) = stalkStructMap G _ r) ∧
        ∀ [IsNoetherianRing (Localization.AtPrime (sectionPrime σ))]
          [IsDomain (Localization.AtPrime (sectionPrime σ))]
          [FaithfulSMul (Localization.AtPrime s.asIdeal) (Localization.AtPrime (sectionPrime σ))]
          {ϖ : Localization.AtPrime s.asIdeal} (hϖ : Irreducible ϖ)
          [IsDomain (Localization.AtPrime (sectionPrime σ) ⧸ Ideal.span
            {algebraMap (Localization.AtPrime s.asIdeal)
              (Localization.AtPrime (sectionPrime σ)) ϖ})],
          letI := (residueHom (specialFibreValuation (Localization.AtPrime (sectionPrime σ))
            (FractionRing (Localization.AtPrime (sectionPrime σ))) hϖ)
            (specialFibreValuation_algebraMap_base_le_one hϖ)
            (specialFibreValuation_algebraMap_base_lt_one hϖ)).toAlgebra
          TrdegLeOne (ResidueField (Localization.AtPrime s.asIdeal))
              (ResidueField (specialFibreValuation (Localization.AtPrime (sectionPrime σ))
                (FractionRing (Localization.AtPrime (sectionPrime σ))) hϖ).valuationSubring) ∧
            (∀ P : ValuationSubring (ResidueField (specialFibreValuation
                (Localization.AtPrime (sectionPrime σ))
                (FractionRing (Localization.AtPrime (sectionPrime σ))) hϖ).valuationSubring),
              IsDegreeOnePlace (ResidueField (Localization.AtPrime s.asIdeal)) P →
              ∀ π, IsUniformizerAt P π →
                ∀ h ∈ polePart (ResidueField (Localization.AtPrime s.asIdeal)) P π 1,
                  ∃ c : ResidueField (Localization.AtPrime s.asIdeal), h = algebraMap _ _ c) ∧
            ∀ P : ValuationSubring (ResidueField (specialFibreValuation
                (Localization.AtPrime (sectionPrime σ))
                (FractionRing (Localization.AtPrime (sectionPrime σ))) hϖ).valuationSubring),
              IsDegreeOnePlace (ResidueField (Localization.AtPrime s.asIdeal)) P →
              ∀ f, ¬ HasSimplePoleOnlyAt (ResidueField (Localization.AtPrime s.asIdeal)) P f := by
  have he : (η[G] : 𝟙_ _ ⟶ G).left ≫ G.hom = 𝟙 _ := Over.w (η[G] : 𝟙_ _ ⟶ G)
  have key := exists_localModel_generic_algebraMap (R := R₀) (X := G.left) G.hom
    (η[G] : 𝟙_ _ ⟶ G).left he s
  obtain ⟨A₀, _, _, hn, σ, φ, φη, hφ, hsp, hR⟩ := key
  have hR' : ∀ r : R₀, φ (algebraMap (Localization.AtPrime s.asIdeal) _
      (algebraMap R₀ (Localization.AtPrime s.asIdeal) r)) = stalkStructMap G _ r := hR
  refine ⟨A₀, inferInstance, inferInstance, hn, σ, φ, φη, hφ, hsp, hR', ?_⟩
  intro _ _ _ ϖ hϖ _
  exact specialFibreGap (A₀ := A₀) (A := Localization.AtPrime (sectionPrime σ)) s G
    (sectionPrime σ).primeCompl (FractionRing (Localization.AtPrime (sectionPrime σ))) hϖ φ hR'

end Assembly

end SpecialFibreGap

