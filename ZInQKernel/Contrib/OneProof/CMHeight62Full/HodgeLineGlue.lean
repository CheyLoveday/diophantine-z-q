import ZInQKernel.HDecomp.Faltings.Models
import ZInQKernel.Contrib.OneProof.CMHeight62Full.LocalStructureScheme
import ZInQKernel.Contrib.OneProof.CMHeight62Full.TreeStatements

/-!
# cmHeight62 (finite place): the Hodge-line glue

Let `𝒢` be a smooth group model of `E_L` over `𝓞_L`, with unit section `e`, generic unit `ξ`,
`B = 𝒪_{𝒢,ξ}` and `ω_{A_L} = 𝔪_ξ/𝔪_ξ²` (`GroupModel.cotangent`). At a point `s` of
`Spec 𝓞_L`, suppose the kernel of the stalk map `e*_s : 𝒪_{𝒢,e(s)} → 𝒪_{S,s}` is principal,
generated by `τ` (node N5: `ker = (t)`, transported by the chart isomorphism of node
N5-bridge). Let `tS ∈ 𝔪_ξ` be the image of `τ` under specialization and `θ = 𝒢.wedge ![tS]`.
We prove:

* `detLattice_one_le_line`: every element of the Hodge lattice `⋀¹ω_𝒢` is `r • θ` with
  `v(r) ≤ 1`, where `v` is the place of `s`. This is the hypothesis `hM` of
  `localModel_of_comparison` and of `abs_norm_le_of_comparisons`.
* `wedge_ne_zero`: `θ ≠ 0` as soon as `tS ∉ 𝔪_ξ²`.
* `exists_wedge_eq_smul_of_isUnit`: for a unit multiple `u · τ` (node N12-alg:
  `t₀ = ε · t`), the wedge of its image is `r • θ` with `v(r) = 1`; so the line of `t₀` carries
  the lattice as well (`detLattice_one_le_line_of_isUnit`).
* `hodgeLine_of_localModel`: the same in the shape of node N5-bridge (a chart `A₀`, a section
  `σ`, the isomorphism `φ` of the local ring at the section prime with `𝒪_{𝒢,e(s)}`), and
  `localModel_of_localModel`, which feeds it into `localModel_of_comparison`.
* `hodgeLine_of_localModel_generic`: with the generic-point isomorphism `φη` of node N5-bridge
  and the cotangent basis of node N5, `tS ∉ 𝔪_ξ²` is proved, so `θ ≠ 0` needs no hypothesis.
* `exists_hodgeLine`: if `𝒪_{𝒢,ξ}` is a discrete valuation ring, then at every finite place
  `v` there is `θ ≠ 0` on whose line `𝒪_v · θ` the Hodge lattice lies (nodes N5-bridge and N5
  are applied inside).

**How the coefficients arise.** `B`-scalars act on `𝔪_ξ/𝔪_ξ²` through the residue field. For a
germ `β` specialized from `𝒪_{𝒢,e(s)}`, its residue at `ξ` is read off through `e*_ξ`, which
kills exactly `𝔪_ξ`. Naturality of stalk maps under specialization moves this to the stalk of
`Spec 𝓞_L` at `s`, where `e*_s(b) · d = n` with `d ∉ s` (a localization of `𝓞_L`). Hence
`d • (β • x) = n • x` in `ω_{A_L}`, and in `L ⊗[𝓞_L] ⋀¹ω_{A_L}` this is
`1 ⊗ (β • x) = (n / d) • (1 ⊗ x)`, with `v(n / d) ≤ 1`.
-/

set_option autoImplicit false

noncomputable section

namespace ZInQ.Contrib.CMHeight62Full

open NumberField IsDedekindDomain AlgebraicGeometry CategoryTheory IsLocalRing
open ZInQ.DefFaltings ExteriorAlgebra
open scoped TensorProduct

/-! ## 1. Lines in `L ⊗[𝓞_L] ⋀¹ M` -/

section Line

variable {L : Type} [Field L] [NumberField L]

/-- The elements `r • θ` with `v(r) ≤ 1`: an `𝓞_L`-submodule. -/
def lineSubmodule (v : HeightOneSpectrum (𝓞 L)) {V : Type*} [AddCommGroup V] [Module L V]
    [Module (𝓞 L) V] [IsScalarTower (𝓞 L) L V] (θ : V) : Submodule (𝓞 L) V where
  carrier := {y | ∃ r : L, v.valuation L r ≤ 1 ∧ y = r • θ}
  zero_mem' := ⟨0, by simp, by simp⟩
  add_mem' := by
    rintro _ _ ⟨r, hr, rfl⟩ ⟨r', hr', rfl⟩
    exact ⟨r + r', Valuation.map_add_le _ hr hr', (add_smul _ _ _).symm⟩
  smul_mem' := by
    rintro a _ ⟨r, hr, rfl⟩
    refine ⟨algebraMap (𝓞 L) L a * r, ?_, ?_⟩
    · rw [map_mul, HeightOneSpectrum.valuation_of_algebraMap]
      exact mul_le_one' (v.intValuation_le_one a) hr
    · rw [mul_smul, algebraMap_smul]

theorem mem_lineSubmodule_iff (v : HeightOneSpectrum (𝓞 L)) {V : Type*} [AddCommGroup V]
    [Module L V] [Module (𝓞 L) V] [IsScalarTower (𝓞 L) L V] (θ y : V) :
    y ∈ lineSubmodule v θ ↔ ∃ r : L, v.valuation L r ≤ 1 ∧ y = r • θ := Iff.rfl

theorem valuation_div_le_one (v : HeightOneSpectrum (𝓞 L)) (n : 𝓞 L) {d : 𝓞 L}
    (hd : d ∉ v.asIdeal) : v.valuation L (algebraMap (𝓞 L) L n / algebraMap (𝓞 L) L d) ≤ 1 := by
  rw [map_div₀, HeightOneSpectrum.valuation_of_algebraMap,
    HeightOneSpectrum.valuation_of_algebraMap, HeightOneSpectrum.intValuation_eq_one_iff.2 hd,
    div_one]
  exact v.intValuation_le_one n

theorem valuation_div_eq_one (v : HeightOneSpectrum (𝓞 L)) {n d : 𝓞 L} (hn : n ∉ v.asIdeal)
    (hd : d ∉ v.asIdeal) : v.valuation L (algebraMap (𝓞 L) L n / algebraMap (𝓞 L) L d) = 1 := by
  rw [map_div₀, HeightOneSpectrum.valuation_of_algebraMap,
    HeightOneSpectrum.valuation_of_algebraMap, HeightOneSpectrum.intValuation_eq_one_iff.2 hd,
    HeightOneSpectrum.intValuation_eq_one_iff.2 hn, div_one]

variable {M : Type*} [AddCommGroup M] [Module (𝓞 L) M]

/-- `m ↦ m` into `⋀¹ M`, as a linear map. -/
def wedgeOne : M →ₗ[𝓞 L] exteriorPower (𝓞 L) 1 M where
  toFun m := exteriorPower.ιMulti (𝓞 L) 1 ![m]
  map_add' m m' := by
    apply Subtype.ext
    simp [exteriorPower.ιMulti_apply_coe, ExteriorAlgebra.ιMulti_apply]
  map_smul' a m := by
    apply Subtype.ext
    simp [exteriorPower.ιMulti_apply_coe, ExteriorAlgebra.ιMulti_apply]

omit [NumberField L] in
theorem wedgeOne_coe (m : M) :
    ((wedgeOne m : exteriorPower (𝓞 L) 1 M) : ExteriorAlgebra (𝓞 L) M) =
      ExteriorAlgebra.ι (𝓞 L) m := by
  simp [wedgeOne, exteriorPower.ιMulti_apply_coe, ExteriorAlgebra.ιMulti_apply]

omit [NumberField L] in
theorem wedgeOne_injective : Function.Injective (wedgeOne (L := L) (M := M)) := by
  intro m m' h
  have h' := congrArg
    (fun z : exteriorPower (𝓞 L) 1 M => ExteriorAlgebra.ιInv (z : ExteriorAlgebra (𝓞 L) M)) h
  simp only [wedgeOne_coe] at h'
  rwa [ExteriorAlgebra.ι_leftInverse, ExteriorAlgebra.ι_leftInverse] at h'

variable (L) in
/-- `m ↦ 1 ⊗ m` into `L ⊗[𝓞_L] ⋀¹ M`. -/
def toHodgeOne : M →ₗ[𝓞 L] L ⊗[𝓞 L] exteriorPower (𝓞 L) 1 M :=
  (TensorProduct.mk (𝓞 L) L (exteriorPower (𝓞 L) 1 M) 1).comp wedgeOne

omit [NumberField L] in
theorem toHodgeOne_apply (m : M) :
    toHodgeOne L m = (1 : L) ⊗ₜ[𝓞 L] exteriorPower.ιMulti (𝓞 L) 1 ![m] := rfl

/-- `d • m = n • x` with `d ∉ v` gives `1 ⊗ m = (n / d) • (1 ⊗ x)`. -/
theorem toHodgeOne_eq_div_smul (v : HeightOneSpectrum (𝓞 L)) {n d : 𝓞 L} (hd : d ∉ v.asIdeal)
    {m x : M} (h : d • m = n • x) :
    toHodgeOne L m = (algebraMap (𝓞 L) L n / algebraMap (𝓞 L) L d) • toHodgeOne L x := by
  have hd0 : algebraMap (𝓞 L) L d ≠ 0 := by
    intro h0
    apply hd
    have : d = 0 := IsFractionRing.injective (𝓞 L) L (by rw [h0, map_zero])
    rw [this]
    exact zero_mem _
  have key : algebraMap (𝓞 L) L d • toHodgeOne L m = algebraMap (𝓞 L) L n • toHodgeOne L x := by
    rw [algebraMap_smul, algebraMap_smul, ← map_smul, ← map_smul, h]
  calc toHodgeOne L m
      = (algebraMap (𝓞 L) L d)⁻¹ • (algebraMap (𝓞 L) L d • toHodgeOne L m) := by
        rw [smul_smul, inv_mul_cancel₀ hd0, one_smul]
    _ = _ := by rw [key, smul_smul, div_eq_inv_mul]

/-- `1 ⊗ x = 0` forces `c • x = 0` for some nonzero `c` (`L ⊗ -` is a localization). -/
theorem exists_smul_eq_zero_of_toHodgeOne {x : M} (hx : toHodgeOne L x = 0) :
    ∃ c ∈ nonZeroDivisors (𝓞 L), c • x = 0 := by
  have hl : IsLocalizedModule (nonZeroDivisors (𝓞 L))
      (TensorProduct.mk (𝓞 L) L (exteriorPower (𝓞 L) 1 M) 1) :=
    (isLocalizedModule_iff_isBaseChange _ L _).2 (TensorProduct.isBaseChange _ _ _)
  have h0 : TensorProduct.mk (𝓞 L) L (exteriorPower (𝓞 L) 1 M) 1 (wedgeOne x) =
      TensorProduct.mk (𝓞 L) L (exteriorPower (𝓞 L) 1 M) 1 0 := by
    rw [map_zero]
    exact hx
  obtain ⟨c, hc⟩ := IsLocalizedModule.exists_of_eq (S := nonZeroDivisors (𝓞 L)) h0
  refine ⟨c, c.2, wedgeOne_injective (L := L) ?_⟩
  rw [map_smul, map_zero]
  rw [smul_zero] at hc
  exact hc

/-- In a torsion-free `M`, `x ≠ 0` gives `1 ⊗ x ≠ 0`. -/
theorem toHodgeOne_ne_zero (htf : ∀ a : 𝓞 L, a ≠ 0 → ∀ y : M, a • y = 0 → y = 0) {x : M}
    (hx : x ≠ 0) : toHodgeOne L x ≠ 0 := by
  intro h
  obtain ⟨c, hc, hcx⟩ := exists_smul_eq_zero_of_toHodgeOne h
  exact hx (htf c (nonZeroDivisors.ne_zero hc) x hcx)

end Line

/-! ## 2. Residues at the generic unit -/

section GroupModelGlue

variable {K : Type} [Field K] {E : PkgI3.AbVar K} {L : Type} [Field L] [NumberField L]
  [Algebra K L] (𝒢 : GroupModel E L)

theorem unitSection_comp : 𝒢.unitSection ≫ 𝒢.G.hom = 𝟙 _ :=
  Over.w (MonObj.one (X := 𝒢.G))

/-- The stalk map `e*_ξ : 𝒪_{𝒢,ξ} → 𝒪_{S,η}` at the generic point. -/
def resGen : 𝒢.genStalk →+* (Spec (CommRingCat.of (𝓞 L))).presheaf.stalk (genericPt L) :=
  (𝒢.unitSection.stalkMap (genericPt L)).hom

theorem mem_maximalIdeal_of_resGen_eq_zero {x : 𝒢.genStalk} (h : resGen 𝒢 x = 0) :
    x ∈ maximalIdeal 𝒢.genStalk := by
  rw [mem_maximalIdeal, mem_nonunits_iff]
  intro hu
  have := hu.map (resGen 𝒢)
  rw [h] at this
  exact not_isUnit_zero this

theorem resGen_structMap (r : 𝓞 L) :
    resGen 𝒢 (𝒢.structMap r) = (Spec (CommRingCat.of (𝓞 L))).presheaf.germ ⊤ (genericPt L)
      trivial ((Scheme.ΓSpecIso (CommRingCat.of (𝓞 L))).inv r) := by
  have he : ∀ z, Scheme.Hom.appTop 𝒢.unitSection (Scheme.Hom.appTop 𝒢.G.hom z) = z := by
    intro z
    rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, unitSection_comp,
      Scheme.Hom.id_appTop]
    rfl
  refine (Scheme.Hom.germ_stalkMap_apply 𝒢.unitSection ⊤ (genericPt L) trivial
    (Scheme.Hom.appTop 𝒢.G.hom ((Scheme.ΓSpecIso (CommRingCat.of (𝓞 L))).inv r))).trans ?_
  exact congrArg _ (he _)

omit [NumberField L] in
theorem isUnit_germ_iff (x : Spec (CommRingCat.of (𝓞 L))) (r : 𝓞 L) :
    IsUnit ((Spec (CommRingCat.of (𝓞 L))).presheaf.germ ⊤ x trivial
      ((Scheme.ΓSpecIso (CommRingCat.of (𝓞 L))).inv r)) ↔ r ∉ x.asIdeal := by
  refine (Scheme.mem_basicOpen (Spec (CommRingCat.of (𝓞 L)))
    ((Scheme.ΓSpecIso (CommRingCat.of (𝓞 L))).inv r) x trivial).symm.trans ?_
  rw [basicOpen_eq_of_affine]
  exact PrimeSpectrum.mem_basicOpen _ _

/-- Nonzero elements of `𝓞_L` are units of `𝒪_{𝒢,ξ}`. -/
theorem isUnit_structMap {a : 𝓞 L} (ha : a ≠ 0) : IsUnit (𝒢.structMap a) := by
  have : IsLocalHom (resGen 𝒢) :=
    (inferInstance : IsLocalHom (Scheme.Hom.stalkMap 𝒢.unitSection (genericPt L)).hom)
  refine isUnit_of_map_unit (resGen 𝒢) _ ?_
  rw [resGen_structMap, isUnit_germ_iff]
  exact ha

/-- `ω_{A_L}` is a torsion-free `𝓞_L`-module. -/
theorem cotangent_torsionFree (a : 𝓞 L) (ha : a ≠ 0) (y : 𝒢.cotangent) (h : a • y = 0) :
    y = 0 := by
  obtain ⟨u, hu⟩ := isUnit_structMap 𝒢 ha
  have h' : (u : 𝒢.genStalk) • y = 0 := by
    rw [hu]
    exact h
  calc y = (u⁻¹ : 𝒢.genStalkˣ).val • ((u : 𝒢.genStalk) • y) := by
        rw [smul_smul, Units.inv_mul, one_smul]
    _ = 0 := by rw [h', smul_zero]

/-- `genericPt ⤳ s` in `Spec 𝓞_L`. -/
theorem genericPt_specializes (s : Spec (CommRingCat.of (𝓞 L))) : genericPt L ⤳ s :=
  (PrimeSpectrum.le_iff_specializes (genericPt L) s).mp bot_le

theorem resGen_stalkSpecializes (s : Spec (CommRingCat.of (𝓞 L)))
    (b : 𝒢.G.left.presheaf.stalk (𝒢.unitSection s)) :
    resGen 𝒢 (𝒢.G.left.presheaf.stalkSpecializes (𝒢.specializes_genericUnit s) b) =
      (Spec (CommRingCat.of (𝓞 L))).presheaf.stalkSpecializes (genericPt_specializes s)
        ((𝒢.unitSection.stalkMap s).hom b) :=
  Scheme.Hom.stalkSpecializes_stalkMap_apply 𝒢.unitSection _ _ _ b

omit [NumberField L] in
/-- Every element of the stalk of `Spec 𝓞_L` at `s` is a fraction `n / d` with `d ∉ s`. -/
theorem exists_mul_germ_eq (s : Spec (CommRingCat.of (𝓞 L)))
    (c : (Spec (CommRingCat.of (𝓞 L))).presheaf.stalk s) :
    ∃ n d : 𝓞 L, d ∉ s.asIdeal ∧
      c * (Spec (CommRingCat.of (𝓞 L))).presheaf.germ ⊤ s trivial
        ((Scheme.ΓSpecIso (CommRingCat.of (𝓞 L))).inv d) =
      (Spec (CommRingCat.of (𝓞 L))).presheaf.germ ⊤ s trivial
        ((Scheme.ΓSpecIso (CommRingCat.of (𝓞 L))).inv n) := by
  have hU := isAffineOpen_top (Spec (CommRingCat.of (𝓞 L)))
  let _ : Algebra Γ(Spec (CommRingCat.of (𝓞 L)), ⊤)
      ((Spec (CommRingCat.of (𝓞 L))).presheaf.stalk s) :=
    ((Spec (CommRingCat.of (𝓞 L))).presheaf.germ ⊤ s trivial).hom.toAlgebra
  have := hU.isLocalization_stalk ⟨s, trivial⟩
  obtain ⟨⟨y, z⟩, hyz⟩ := IsLocalization.surj (hU.primeIdealOf ⟨s, trivial⟩).asIdeal.primeCompl c
  have hz : IsUnit (algebraMap Γ(Spec (CommRingCat.of (𝓞 L)), ⊤)
      ((Spec (CommRingCat.of (𝓞 L))).presheaf.stalk s) z) := IsLocalization.map_units _ z
  have hinv : ∀ w : Γ(Spec (CommRingCat.of (𝓞 L)), ⊤),
      (Scheme.ΓSpecIso (CommRingCat.of (𝓞 L))).inv
        ((Scheme.ΓSpecIso (CommRingCat.of (𝓞 L))).hom w) = w := fun w =>
    Iso.hom_inv_id_apply _ w
  refine ⟨(Scheme.ΓSpecIso (CommRingCat.of (𝓞 L))).hom y,
    (Scheme.ΓSpecIso (CommRingCat.of (𝓞 L))).hom (z : Γ(Spec (CommRingCat.of (𝓞 L)), ⊤)),
    ?_, ?_⟩
  · rw [← isUnit_germ_iff, hinv]
    exact hz
  · rw [hinv, hinv]
    exact hyz

omit [NumberField L] in
/-- The image of a unit of the stalk at `s` is `n / d` with `n, d ∉ s`. -/
theorem notMem_of_mul_germ_eq {s : Spec (CommRingCat.of (𝓞 L))}
    {c : (Spec (CommRingCat.of (𝓞 L))).presheaf.stalk s} (hc : IsUnit c) {n d : 𝓞 L}
    (hd : d ∉ s.asIdeal)
    (h : c * (Spec (CommRingCat.of (𝓞 L))).presheaf.germ ⊤ s trivial
        ((Scheme.ΓSpecIso (CommRingCat.of (𝓞 L))).inv d) =
      (Spec (CommRingCat.of (𝓞 L))).presheaf.germ ⊤ s trivial
        ((Scheme.ΓSpecIso (CommRingCat.of (𝓞 L))).inv n)) : n ∉ s.asIdeal := by
  rw [← isUnit_germ_iff, ← h]
  exact hc.mul ((isUnit_germ_iff s d).2 hd)

/-! ## 3. Scalars on `ω_{A_L}` -/

theorem dCls_mul (b : 𝒢.genStalk) (f : maximalIdeal 𝒢.genStalk)
    (h : b * (f : 𝒢.genStalk) ∈ maximalIdeal 𝒢.genStalk) :
    𝒢.dCls ⟨b * f, h⟩ = b • 𝒢.dCls f :=
  (maximalIdeal 𝒢.genStalk).toCotangent.map_smul b f

theorem dCls_eq_zero_iff (f : maximalIdeal 𝒢.genStalk) :
    𝒢.dCls f = 0 ↔ (f : 𝒢.genStalk) ∈ maximalIdeal 𝒢.genStalk ^ 2 :=
  Ideal.toCotangent_eq_zero _ f

theorem smul_cotangent_eq_zero {m : 𝒢.genStalk} (hm : m ∈ maximalIdeal 𝒢.genStalk)
    (x : 𝒢.cotangent) : m • x = 0 := by
  obtain ⟨f, rfl⟩ : ∃ f, 𝒢.dCls f = x := (maximalIdeal 𝒢.genStalk).toCotangent_surjective x
  have hmf : m * (f : 𝒢.genStalk) ∈ maximalIdeal 𝒢.genStalk := Ideal.mul_mem_left _ _ f.2
  rw [← dCls_mul 𝒢 m f hmf, dCls_eq_zero_iff, pow_two]
  exact Ideal.mul_mem_mul hm f.2

theorem smul_cotangent_def (a : 𝓞 L) (x : 𝒢.cotangent) : a • x = 𝒢.structMap a • x := rfl

/-- **The residue of a specialized germ.** If `f = spec(b) · tS` in `𝒪_{𝒢,ξ}`, then
`d • df = n • dtS` for some `n, d ∈ 𝓞_L` with `d ∉ s`, and `n ∉ s` when `b` is a unit. -/
theorem exists_smul_dCls_eq (s : Spec (CommRingCat.of (𝓞 L)))
    (b : 𝒢.G.left.presheaf.stalk (𝒢.unitSection s)) (tS f : maximalIdeal 𝒢.genStalk)
    (hf : (f : 𝒢.genStalk) =
      𝒢.G.left.presheaf.stalkSpecializes (𝒢.specializes_genericUnit s) b * tS) :
    ∃ n d : 𝓞 L, d ∉ s.asIdeal ∧ (IsUnit b → n ∉ s.asIdeal) ∧
      d • 𝒢.dCls f = n • 𝒢.dCls tS := by
  set β := 𝒢.G.left.presheaf.stalkSpecializes (𝒢.specializes_genericUnit s) b
  obtain ⟨n, d, hd, hc⟩ := exists_mul_germ_eq s ((𝒢.unitSection.stalkMap s).hom b)
  refine ⟨n, d, hd, fun hb => notMem_of_mul_germ_eq (hb.map _) hd hc, ?_⟩
  have hf' : f = ⟨β * tS, hf ▸ f.2⟩ := Subtype.ext hf
  have hres : 𝒢.structMap d * β - 𝒢.structMap n ∈ maximalIdeal 𝒢.genStalk := by
    apply mem_maximalIdeal_of_resGen_eq_zero
    rw [map_sub, map_mul, resGen_structMap, resGen_structMap, resGen_stalkSpecializes]
    have hc' := congrArg
      ((Spec (CommRingCat.of (𝓞 L))).presheaf.stalkSpecializes (genericPt_specializes s)) hc
    have h1 : ∀ r : 𝓞 L,
        (Spec (CommRingCat.of (𝓞 L))).presheaf.stalkSpecializes (genericPt_specializes s)
          ((Spec (CommRingCat.of (𝓞 L))).presheaf.germ ⊤ s trivial
            ((Scheme.ΓSpecIso (CommRingCat.of (𝓞 L))).inv r)) =
        (Spec (CommRingCat.of (𝓞 L))).presheaf.germ ⊤ (genericPt L) trivial
          ((Scheme.ΓSpecIso (CommRingCat.of (𝓞 L))).inv r) := fun r =>
      TopCat.Presheaf.germ_stalkSpecializes_apply _ _ _ _
    rw [map_mul, h1, h1] at hc'
    rw [mul_comm, hc', sub_self]
  rw [hf', dCls_mul, smul_cotangent_def, smul_cotangent_def, smul_smul]
  have hsplit : 𝒢.structMap d * β =
      𝒢.structMap n + (𝒢.structMap d * β - 𝒢.structMap n) := by ring
  rw [hsplit, add_smul, smul_cotangent_eq_zero 𝒢 hres, add_zero]

/-! ## 4. The Hodge line -/

theorem wedge_eq_toHodgeOne (f : maximalIdeal 𝒢.genStalk) :
    𝒢.wedge ![f] = toHodgeOne L (𝒢.dCls f) := by
  rw [toHodgeOne_apply]
  unfold GroupModel.wedge
  congr 2
  funext i
  fin_cases i
  rfl

/-- `θ = 1 ⊗ dtS ≠ 0` when `tS ∉ 𝔪_ξ²`. -/
theorem wedge_ne_zero {f : maximalIdeal 𝒢.genStalk}
    (hf : (f : 𝒢.genStalk) ∉ maximalIdeal 𝒢.genStalk ^ 2) : 𝒢.wedge ![f] ≠ 0 := by
  rw [wedge_eq_toHodgeOne]
  refine toHodgeOne_ne_zero (cotangent_torsionFree 𝒢) ?_
  intro h
  exact hf ((dCls_eq_zero_iff 𝒢 f).1 h)

/-- **The local lattice lies on the line of the kernel generator.** If
`ker e*_s = (τ)` and `tS` is the specialization of `τ`, every element of `(ω_𝒢)_s` maps
into the line `{r • θ : v(r) ≤ 1}`, `θ = 𝒢.wedge ![tS]`. -/
theorem omegaAt_le_comap_line (s : Spec (CommRingCat.of (𝓞 L)))
    (v : HeightOneSpectrum (𝓞 L)) (hs : s.asIdeal = v.asIdeal)
    (τ : 𝒢.G.left.presheaf.stalk (𝒢.unitSection s))
    (hker : RingHom.ker (𝒢.unitSection.stalkMap s).hom = Ideal.span {τ})
    (tS : maximalIdeal 𝒢.genStalk)
    (htS : (tS : 𝒢.genStalk) =
      𝒢.G.left.presheaf.stalkSpecializes (𝒢.specializes_genericUnit s) τ) :
    𝒢.omegaAt s ≤ (lineSubmodule v (𝒢.wedge ![tS])).comap (toHodgeOne L) := by
  refine Submodule.span_le.2 ?_
  rintro _ ⟨g, hg, hgm, rfl⟩
  rw [hker] at hg
  obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.1 hg
  obtain ⟨n, d, hd, -, hnd⟩ := exists_smul_dCls_eq 𝒢 s b tS ⟨_, hgm⟩
    ((map_mul _ b τ).trans (by rw [htS]))
  rw [hs] at hd
  refine ⟨_, valuation_div_le_one v n hd, ?_⟩
  rw [toHodgeOne_eq_div_smul v hd hnd, wedge_eq_toHodgeOne]

/-- **The Hodge lattice lies on the line `𝒪_v · θ`** (the hypothesis `hM` of
`localModel_of_comparison`). -/
theorem detLattice_one_le_line (s : Spec (CommRingCat.of (𝓞 L)))
    (v : HeightOneSpectrum (𝓞 L)) (hs : s.asIdeal = v.asIdeal)
    (τ : 𝒢.G.left.presheaf.stalk (𝒢.unitSection s))
    (hker : RingHom.ker (𝒢.unitSection.stalkMap s).hom = Ideal.span {τ})
    (tS : maximalIdeal 𝒢.genStalk)
    (htS : (tS : 𝒢.genStalk) =
      𝒢.G.left.presheaf.stalkSpecializes (𝒢.specializes_genericUnit s) τ) :
    ∀ m ∈ 𝒢.detLattice 1, ∃ r : L, v.valuation L r ≤ 1 ∧ m = r • 𝒢.wedge ![tS] := by
  intro m hm
  refine (mem_lineSubmodule_iff v _ m).1 ?_
  refine Submodule.span_le.2 ?_ hm
  rintro _ ⟨w, rfl⟩
  have hw : (w 0 : 𝒢.cotangent) ∈ 𝒢.omegaAt s := iInf_le (fun s => 𝒢.omegaAt s) s (w 0).2
  have h := omegaAt_le_comap_line 𝒢 s v hs τ hker tS htS hw
  have heq : (1 : L) ⊗ₜ[𝓞 L] exteriorPower.ιMulti (𝓞 L) 1 (fun i => (w i : 𝒢.cotangent)) =
      toHodgeOne L (w 0 : 𝒢.cotangent) := by
    rw [toHodgeOne_apply]
    congr 2
    funext i
    fin_cases i
    rfl
  rw [SetLike.mem_coe]
  beta_reduce
  rw [heq]
  exact h

/-- **A unit multiple of the kernel generator** (node N12-alg: `t₀ = ε · t`). The wedge of
the image of `u · τ` is `r • θ` with `v(r) = 1`. -/
theorem exists_wedge_eq_smul_of_isUnit (s : Spec (CommRingCat.of (𝓞 L)))
    (v : HeightOneSpectrum (𝓞 L)) (hs : s.asIdeal = v.asIdeal)
    (τ u : 𝒢.G.left.presheaf.stalk (𝒢.unitSection s)) (hu : IsUnit u)
    (tS t₀ : maximalIdeal 𝒢.genStalk)
    (htS : (tS : 𝒢.genStalk) =
      𝒢.G.left.presheaf.stalkSpecializes (𝒢.specializes_genericUnit s) τ)
    (ht₀ : (t₀ : 𝒢.genStalk) =
      𝒢.G.left.presheaf.stalkSpecializes (𝒢.specializes_genericUnit s) (u * τ)) :
    ∃ r : L, v.valuation L r = 1 ∧ 𝒢.wedge ![t₀] = r • 𝒢.wedge ![tS] := by
  obtain ⟨n, d, hd, hn, hnd⟩ := exists_smul_dCls_eq 𝒢 s u tS t₀ (by rw [ht₀, map_mul, htS])
  have hn' := hn hu
  rw [hs] at hd hn'
  refine ⟨_, valuation_div_eq_one v hn' hd, ?_⟩
  rw [wedge_eq_toHodgeOne, wedge_eq_toHodgeOne, toHodgeOne_eq_div_smul v hd hnd]

/-- The line of `t₀ = u · τ` carries the Hodge lattice too. -/
theorem detLattice_one_le_line_of_isUnit (s : Spec (CommRingCat.of (𝓞 L)))
    (v : HeightOneSpectrum (𝓞 L)) (hs : s.asIdeal = v.asIdeal)
    (τ u : 𝒢.G.left.presheaf.stalk (𝒢.unitSection s)) (hu : IsUnit u)
    (hker : RingHom.ker (𝒢.unitSection.stalkMap s).hom = Ideal.span {τ})
    (tS t₀ : maximalIdeal 𝒢.genStalk)
    (htS : (tS : 𝒢.genStalk) =
      𝒢.G.left.presheaf.stalkSpecializes (𝒢.specializes_genericUnit s) τ)
    (ht₀ : (t₀ : 𝒢.genStalk) =
      𝒢.G.left.presheaf.stalkSpecializes (𝒢.specializes_genericUnit s) (u * τ)) :
    ∀ m ∈ 𝒢.detLattice 1, ∃ r : L, v.valuation L r ≤ 1 ∧ m = r • 𝒢.wedge ![t₀] := by
  obtain ⟨c, hc, hθ⟩ := exists_wedge_eq_smul_of_isUnit 𝒢 s v hs τ u hu tS t₀ htS ht₀
  have hc0 : c ≠ 0 := by
    rintro rfl
    rw [map_zero] at hc
    exact zero_ne_one hc
  intro m hm
  obtain ⟨r, hr, rfl⟩ := detLattice_one_le_line 𝒢 s v hs τ hker tS htS m hm
  refine ⟨r * c⁻¹, ?_, ?_⟩
  · rw [map_mul, map_inv₀, hc, inv_one, mul_one]
    exact hr
  · rw [hθ, smul_smul, mul_assoc, inv_mul_cancel₀ hc0, mul_one]

/-! ## 5. The shape of node N5-bridge -/

/-- Through the chart isomorphism `φ` of node N5-bridge, `ker (localSection σ) = (t)` (node N5)
becomes `ker e*_s = (φ t)`. -/
theorem ker_stalkMap_eq_span (s : Spec (CommRingCat.of (𝓞 L)))
    [IsDiscreteValuationRing (Localization.AtPrime s.asIdeal)]
    {A₀ : Type} [CommRing A₀] [Algebra (Localization.AtPrime s.asIdeal) A₀]
    (σ : A₀ →ₐ[Localization.AtPrime s.asIdeal] Localization.AtPrime s.asIdeal)
    (φ : Localization.AtPrime (sectionPrime σ) ≃+*
      𝒢.G.left.presheaf.stalk (𝒢.unitSection s))
    (hφ : ∀ a, (𝒢.unitSection.stalkMap s).hom (φ a) = specStalkEquiv s (localSection σ a))
    {t : A₀}
    (hker : RingHom.ker (localSection σ) =
      Ideal.span {algebraMap A₀ (Localization.AtPrime (sectionPrime σ)) t}) :
    RingHom.ker (𝒢.unitSection.stalkMap s).hom =
      Ideal.span {φ (algebraMap A₀ (Localization.AtPrime (sectionPrime σ)) t)} := by
  ext x
  obtain ⟨a, rfl⟩ := φ.surjective x
  rw [RingHom.mem_ker, hφ, map_eq_zero_iff _ (specStalkEquiv s).injective, ← RingHom.mem_ker,
    hker, Ideal.mem_span_singleton', Ideal.mem_span_singleton']
  constructor
  · rintro ⟨c, hc⟩
    exact ⟨φ c, by rw [← map_mul, hc]⟩
  · rintro ⟨c, hc⟩
    refine ⟨φ.symm c, φ.injective ?_⟩
    rw [map_mul, RingEquiv.apply_symm_apply, hc]

/-- **Node N13, the line (`n13Line`), in the shape of node N5-bridge.** With the chart `A₀`,
the section `σ`, the isomorphism `φ` and the parameter `t` of node N5
(`ker (localSection σ) = (t)`), let `tS` be the specialization of `φ t` to `𝒪_{𝒢,ξ}` and
`θ = 𝒢.wedge ![tS]`. If `tS ∉ 𝔪_ξ²`, then `θ ≠ 0` and the Hodge lattice is `𝒪_v · θ`-valued. -/
theorem hodgeLine_of_localModel (s : Spec (CommRingCat.of (𝓞 L)))
    (v : HeightOneSpectrum (𝓞 L)) (hs : s.asIdeal = v.asIdeal)
    [IsDiscreteValuationRing (Localization.AtPrime s.asIdeal)]
    {A₀ : Type} [CommRing A₀] [Algebra (Localization.AtPrime s.asIdeal) A₀]
    (σ : A₀ →ₐ[Localization.AtPrime s.asIdeal] Localization.AtPrime s.asIdeal)
    (φ : Localization.AtPrime (sectionPrime σ) ≃+*
      𝒢.G.left.presheaf.stalk (𝒢.unitSection s))
    (hφ : ∀ a, (𝒢.unitSection.stalkMap s).hom (φ a) = specStalkEquiv s (localSection σ a))
    {t : A₀}
    (hker : RingHom.ker (localSection σ) =
      Ideal.span {algebraMap A₀ (Localization.AtPrime (sectionPrime σ)) t})
    (tS : maximalIdeal 𝒢.genStalk)
    (htS : (tS : 𝒢.genStalk) = 𝒢.G.left.presheaf.stalkSpecializes
      (𝒢.specializes_genericUnit s) (φ (algebraMap A₀ _ t)))
    (hsq : (tS : 𝒢.genStalk) ∉ maximalIdeal 𝒢.genStalk ^ 2) :
    𝒢.wedge ![tS] ≠ 0 ∧
      ∀ m ∈ 𝒢.detLattice 1, ∃ r : L, v.valuation L r ≤ 1 ∧ m = r • 𝒢.wedge ![tS] :=
  ⟨wedge_ne_zero 𝒢 hsq, detLattice_one_le_line 𝒢 s v hs _
    (ker_stalkMap_eq_span 𝒢 s σ φ hφ hker) tS htS⟩

/-- **The local model at `v`** (`localModel_of_comparison` with the line of
`hodgeLine_of_localModel`): from `C⁻¹ • W_L = W₀`, `v(Δ_{W₀}) = 1` and `η = b • θ` with
`v(b) = v(u_C)`, the local model in the shape of `abs_norm_algebraMap_le_of_models`. -/
theorem localModel_of_localModel (s : Spec (CommRingCat.of (𝓞 L)))
    (v : HeightOneSpectrum (𝓞 L)) (hs : s.asIdeal = v.asIdeal)
    [IsDiscreteValuationRing (Localization.AtPrime s.asIdeal)]
    {A₀ : Type} [CommRing A₀] [Algebra (Localization.AtPrime s.asIdeal) A₀]
    (σ : A₀ →ₐ[Localization.AtPrime s.asIdeal] Localization.AtPrime s.asIdeal)
    (φ : Localization.AtPrime (sectionPrime σ) ≃+*
      𝒢.G.left.presheaf.stalk (𝒢.unitSection s))
    (hφ : ∀ a, (𝒢.unitSection.stalkMap s).hom (φ a) = specStalkEquiv s (localSection σ a))
    {t : A₀}
    (hker : RingHom.ker (localSection σ) =
      Ideal.span {algebraMap A₀ (Localization.AtPrime (sectionPrime σ)) t})
    (tS : maximalIdeal 𝒢.genStalk)
    (htS : (tS : 𝒢.genStalk) = 𝒢.G.left.presheaf.stalkSpecializes
      (𝒢.specializes_genericUnit s) (φ (algebraMap A₀ _ t)))
    (hsq : (tS : 𝒢.genStalk) ∉ maximalIdeal 𝒢.genStalk ^ 2)
    (W : WeierstrassCurve K) (W₀ : WeierstrassCurve L) (hW₀ : v.valuation L W₀.Δ = 1)
    (C : WeierstrassCurve.VariableChange L) (hC : C⁻¹ • W.map (algebraMap K L) = W₀)
    {η : 𝒢.hodgeSpace 1} {b : L} (hη : η = b • 𝒢.wedge ![tS])
    (hb : v.valuation L (C.u : L) = v.valuation L b) :
    ∃ C' : WeierstrassCurve.VariableChange L,
      v.valuation L (C' • W.map (algebraMap K L)).Δ = 1 ∧
        ∀ a : L, a • η ∈ 𝒢.detLattice 1 → v.valuation L (a * ↑C'.u⁻¹) ≤ 1 := by
  obtain ⟨hθ, hM⟩ := hodgeLine_of_localModel 𝒢 s v hs σ φ hφ hker tS htS hsq
  exact localModel_of_comparison v W W₀ hW₀ C hC (𝒢.detLattice 1) hθ hM hη hb

/-- The specialization of an element of `ker e*_s` lies in `𝔪_ξ`. -/
theorem stalkSpecializes_mem_maximalIdeal (s : Spec (CommRingCat.of (𝓞 L)))
    {f : 𝒢.G.left.presheaf.stalk (𝒢.unitSection s)}
    (hf : f ∈ RingHom.ker (𝒢.unitSection.stalkMap s).hom) :
    𝒢.G.left.presheaf.stalkSpecializes (𝒢.specializes_genericUnit s) f ∈
      maximalIdeal 𝒢.genStalk := by
  apply mem_maximalIdeal_of_resGen_eq_zero
  rw [resGen_stalkSpecializes, RingHom.mem_ker.1 hf, map_zero]

end GroupModelGlue

/-! ## 6. The parameter is not in `𝔪_ξ²` -/

section GenericCotangent

/-- A ring isomorphism of local rings preserves `x ∉ 𝔪²`. -/
theorem ringEquiv_notMem_maximalIdeal_sq {A B : Type*} [CommRing A] [CommRing B]
    [IsLocalRing A] [IsLocalRing B] (e : A ≃+* B) {x : A} (hx : x ∉ maximalIdeal A ^ 2) :
    e x ∉ maximalIdeal B ^ 2 := by
  intro h
  apply hx
  have hle : (maximalIdeal B).map (e.symm : B →+* A) ≤ maximalIdeal A := by
    rw [Ideal.map_le_iff_le_comap]
    intro y hy
    rw [Ideal.mem_comap, mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    apply (mem_maximalIdeal y).1 hy
    simpa using hu.map (e : A →+* B)
  have h2 := Ideal.mem_map_of_mem (e.symm : B →+* A) h
  rw [Ideal.map_pow, pow_two] at h2
  have h3 := Ideal.mul_mono hle hle h2
  rw [← pow_two] at h3
  simpa using h3

variable {Rs : Type*} [CommRing Rs] [IsDomain Rs] {A₀ : Type*} [CommRing A₀] [Algebra Rs A₀]

/-- If the class of `t` is a basis of `ker σ / (ker σ)²` over `Rs` (node N5), then `t` is not in
`𝔪²` in the local ring at `ker σ` (the generic point of the section). -/
theorem algebraMap_notMem_maximalIdeal_sq (σ : A₀ →ₐ[Rs] Rs) {t : A₀}
    (ht : t ∈ RingHom.ker σ) (B : Module.Basis (Fin 1) Rs (RingHom.ker σ).Cotangent)
    (hB : ∀ i, B i = (RingHom.ker σ).toCotangent ⟨t, ht⟩) :
    algebraMap A₀ (Localization.AtPrime (RingHom.ker σ)) t ∉
      maximalIdeal (Localization.AtPrime (RingHom.ker σ)) ^ 2 := by
  intro hmem
  rw [← Localization.AtPrime.map_eq_maximalIdeal, ← Ideal.map_pow,
    IsLocalization.mem_map_algebraMap_iff (RingHom.ker σ).primeCompl] at hmem
  obtain ⟨⟨⟨y, hy⟩, ⟨u, hu⟩⟩, h⟩ := hmem
  rw [← map_mul] at h
  obtain ⟨⟨c, hc⟩, hc'⟩ := (IsLocalization.eq_iff_exists (RingHom.ker σ).primeCompl _).1 h
  have hc'' : c * (t * u) = c * y := hc'
  have hw : c * u ∈ (RingHom.ker σ).primeCompl := mul_mem hc hu
  have hwt : c * u * t ∈ RingHom.ker σ ^ 2 := by
    have : c * u * t = c * y := by rw [← hc'']; ring
    rw [this]
    exact Ideal.mul_mem_left _ _ hy
  set X := (RingHom.ker σ).toCotangent ⟨t, ht⟩
  have e1 : (c * u) • X = 0 := by
    rw [← map_smul]
    exact (Ideal.toCotangent_eq_zero _ _).2 hwt
  have hk : c * u - algebraMap Rs A₀ (σ (c * u)) ∈ RingHom.ker σ := by
    rw [RingHom.mem_ker]
    simp
  have e2 : (c * u - algebraMap Rs A₀ (σ (c * u))) • X = 0 := by
    rw [← map_smul]
    refine (Ideal.toCotangent_eq_zero _ _).2 ?_
    rw [pow_two]
    exact Ideal.mul_mem_mul hk ht
  have key : algebraMap Rs A₀ (σ (c * u)) • X = 0 := by
    rw [show algebraMap Rs A₀ (σ (c * u)) =
      c * u - (c * u - algebraMap Rs A₀ (σ (c * u))) by ring, sub_smul, e1, e2, sub_zero]
  rw [algebraMap_smul, ← hB 0] at key
  have := Module.Free.of_basis B
  rcases smul_eq_zero.1 key with h0 | h0
  · exact Ideal.mem_primeCompl_iff.1 hw (RingHom.mem_ker.2 h0)
  · exact B.ne_zero 0 h0

end GenericCotangent

/-! ## 7. The line from the smooth model -/

section GroupModelLine

variable {K : Type} [Field K] {E : PkgI3.AbVar K} {L : Type} [Field L] [NumberField L]
  [Algebra K L] (𝒢 : GroupModel E L)

/-- **Node N5-bridge at the generic unit.** The chart of `exists_localModel_generic` for the unit
section of `𝒢`, with the stalk at the generic point of the section identified with
`𝒪_{𝒢,ξ}` (`genericPoint = genericPt`). -/
theorem exists_localModel_genericUnit (s : Spec (CommRingCat.of (𝓞 L)))
    [IsDiscreteValuationRing (Localization.AtPrime s.asIdeal)]
    [IsDomain 𝒢.genStalk] [IsDiscreteValuationRing 𝒢.genStalk] :
    ∃ (A₀ : Type) (_ : CommRing A₀) (_ : Algebra (Localization.AtPrime s.asIdeal) A₀),
      Algebra.IsStandardSmoothOfRelativeDimension 1 (Localization.AtPrime s.asIdeal) A₀ ∧
      ∃ (σ : A₀ →ₐ[Localization.AtPrime s.asIdeal] Localization.AtPrime s.asIdeal)
        (φ : Localization.AtPrime (sectionPrime σ) ≃+*
          𝒢.G.left.presheaf.stalk (𝒢.unitSection s))
        (φη : Localization.AtPrime (RingHom.ker σ) ≃+* 𝒢.genStalk),
        (∀ a, (𝒢.unitSection.stalkMap s).hom (φ a) = specStalkEquiv s (localSection σ a)) ∧
        ∀ x : A₀, 𝒢.G.left.presheaf.stalkSpecializes (𝒢.specializes_genericUnit s)
          (φ (algebraMap A₀ _ x)) = φη (algebraMap A₀ _ x) := by
  have key : ∀ (η : Spec (CommRingCat.of (𝓞 L))),
      genericPoint (Spec (CommRingCat.of (𝓞 L))) = η →
      ∀ (_ : IsDomain (𝒢.G.left.presheaf.stalk (𝒢.unitSection η)))
        (_ : IsDiscreteValuationRing (𝒢.G.left.presheaf.stalk (𝒢.unitSection η))),
      ∃ (A₀ : Type) (_ : CommRing A₀) (_ : Algebra (Localization.AtPrime s.asIdeal) A₀),
        Algebra.IsStandardSmoothOfRelativeDimension 1 (Localization.AtPrime s.asIdeal) A₀ ∧
        ∃ (σ : A₀ →ₐ[Localization.AtPrime s.asIdeal] Localization.AtPrime s.asIdeal)
          (φ : Localization.AtPrime (sectionPrime σ) ≃+*
            𝒢.G.left.presheaf.stalk (𝒢.unitSection s))
          (φη : Localization.AtPrime (RingHom.ker σ) ≃+*
            𝒢.G.left.presheaf.stalk (𝒢.unitSection η)),
          (∀ a, (𝒢.unitSection.stalkMap s).hom (φ a) =
            specStalkEquiv s (localSection σ a)) ∧
          ∀ (h : 𝒢.unitSection η ⤳ 𝒢.unitSection s) (x : A₀),
            𝒢.G.left.presheaf.stalkSpecializes h (φ (algebraMap A₀ _ x)) =
              φη (algebraMap A₀ _ x) := by
    intro η hη _ _
    subst hη
    exact exists_localModel_generic 𝒢.G.hom 𝒢.unitSection (unitSection_comp 𝒢) s
  obtain ⟨A₀, _, _, hstd, σ, φ, φη, hφ, hsp⟩ := key (genericPt L)
    (genericPoint_eq_bot_of_affine _) ‹IsDomain 𝒢.genStalk› ‹IsDiscreteValuationRing 𝒢.genStalk›
  exact ⟨A₀, _, _, hstd, σ, φ, φη, hφ, fun x => hsp _ x⟩

/-- **Node N13, the line, from the data of nodes N5 and N5-bridge.** With the chart `A₀`, the
section `σ`, the isomorphisms `φ` (closed point of the section) and `φη` (generic point of the
section, `≅ 𝒪_{𝒢,ξ}`), and the parameter `t` of node N5 (`ker (localSection σ) = (t)`, the class
of `t` a basis of `ker σ / (ker σ)²`): `tS`, the specialization of `φ t`, lies in `𝔪_ξ \ 𝔪_ξ²`,
`θ = 𝒢.wedge ![tS] ≠ 0`, and the Hodge lattice is `𝒪_v · θ`-valued. -/
theorem hodgeLine_of_localModel_generic (s : Spec (CommRingCat.of (𝓞 L)))
    (v : HeightOneSpectrum (𝓞 L)) (hs : s.asIdeal = v.asIdeal)
    [IsDiscreteValuationRing (Localization.AtPrime s.asIdeal)]
    {A₀ : Type} [CommRing A₀] [Algebra (Localization.AtPrime s.asIdeal) A₀]
    (σ : A₀ →ₐ[Localization.AtPrime s.asIdeal] Localization.AtPrime s.asIdeal)
    (φ : Localization.AtPrime (sectionPrime σ) ≃+*
      𝒢.G.left.presheaf.stalk (𝒢.unitSection s))
    (φη : Localization.AtPrime (RingHom.ker σ) ≃+* 𝒢.genStalk)
    (hφ : ∀ a, (𝒢.unitSection.stalkMap s).hom (φ a) = specStalkEquiv s (localSection σ a))
    (hsp : ∀ x : A₀, 𝒢.G.left.presheaf.stalkSpecializes (𝒢.specializes_genericUnit s)
      (φ (algebraMap A₀ _ x)) = φη (algebraMap A₀ _ x))
    {t : A₀} (ht : t ∈ RingHom.ker σ)
    (hker : RingHom.ker (localSection σ) =
      Ideal.span {algebraMap A₀ (Localization.AtPrime (sectionPrime σ)) t})
    (B : Module.Basis (Fin 1) (Localization.AtPrime s.asIdeal) (RingHom.ker σ).Cotangent)
    (hB : ∀ i, B i = (RingHom.ker σ).toCotangent ⟨t, ht⟩) :
    ∃ tS : maximalIdeal 𝒢.genStalk, (tS : 𝒢.genStalk) =
        𝒢.G.left.presheaf.stalkSpecializes (𝒢.specializes_genericUnit s)
          (φ (algebraMap A₀ _ t)) ∧
      (tS : 𝒢.genStalk) ∉ maximalIdeal 𝒢.genStalk ^ 2 ∧ 𝒢.wedge ![tS] ≠ 0 ∧
      ∀ m ∈ 𝒢.detLattice 1, ∃ r : L, v.valuation L r ≤ 1 ∧ m = r • 𝒢.wedge ![tS] := by
  have hkerS := ker_stalkMap_eq_span 𝒢 s σ φ hφ hker
  have hmem := stalkSpecializes_mem_maximalIdeal 𝒢 s
    (f := φ (algebraMap A₀ (Localization.AtPrime (sectionPrime σ)) t))
    (by rw [hkerS]; exact Ideal.mem_span_singleton_self _)
  have hsq : 𝒢.G.left.presheaf.stalkSpecializes (𝒢.specializes_genericUnit s)
      (φ (algebraMap A₀ (Localization.AtPrime (sectionPrime σ)) t)) ∉
        maximalIdeal 𝒢.genStalk ^ 2 := by
    rw [hsp]
    exact ringEquiv_notMem_maximalIdeal_sq φη (algebraMap_notMem_maximalIdeal_sq σ ht B hB)
  exact ⟨⟨_, hmem⟩, rfl, hsq, wedge_ne_zero 𝒢 hsq,
    detLattice_one_le_line 𝒢 s v hs _ hkerS _ rfl⟩

/-- **Node N13, the line, at every finite place.** If `𝒪_{𝒢,ξ}` is a discrete valuation ring
(the local ring of the elliptic curve `E_L` at its origin), then for every finite place `v` the
Hodge lattice lies on a line `𝒪_v · θ` with `θ ≠ 0`: nodes N5-bridge and N5 supply the chart and
the parameter, and `θ` is the wedge of the specialized parameter. -/
theorem exists_hodgeLine [IsDomain 𝒢.genStalk] [IsDiscreteValuationRing 𝒢.genStalk]
    (v : HeightOneSpectrum (𝓞 L)) :
    ∃ θ : 𝒢.hodgeSpace 1, θ ≠ 0 ∧
      ∀ m ∈ 𝒢.detLattice 1, ∃ r : L, v.valuation L r ≤ 1 ∧ m = r • θ := by
  let s : Spec (CommRingCat.of (𝓞 L)) := (⟨v.asIdeal, v.isPrime⟩ : PrimeSpectrum (𝓞 L))
  have hs : s.asIdeal = v.asIdeal := rfl
  have : IsDiscreteValuationRing (Localization.AtPrime s.asIdeal) :=
    IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain (𝓞 L) v.ne_bot _
  obtain ⟨A₀, _, _, _, σ, φ, φη, hφ, hsp⟩ := exists_localModel_genericUnit 𝒢 s
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible (Localization.AtPrime s.asIdeal)
  obtain ⟨t, ht, -, -, -, hker, B, hB⟩ := localStructure_of_standardSmooth σ hϖ
  obtain ⟨tS, -, -, hθ, hM⟩ :=
    hodgeLine_of_localModel_generic 𝒢 s v hs σ φ φη hφ hsp ht hker B hB
  exact ⟨_, hθ, hM⟩

end GroupModelLine

end ZInQ.Contrib.CMHeight62Full
