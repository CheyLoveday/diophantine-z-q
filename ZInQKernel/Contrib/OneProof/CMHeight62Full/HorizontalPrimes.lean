import Mathlib
import ZInQKernel.Contrib.OneProof.CMHeight62Full.LocalStructureScheme

/-!
# Localizations of the local ring at the identity point

Let `R` be a discrete valuation ring, `A₀` an `R`-algebra with a section `σ : A₀ →ₐ[R] R`, and
`A := Localization.AtPrime (sectionPrime σ)` the local ring at the closed point of the section.
Suppose `t : A₀` generates the kernel of the localized section `localSection σ : A → R`.

* `localizationAtSectionKer_equiv` (part (a)): localizing `A` at the prime `(t)` gives the local
  ring `Localization.AtPrime (ker σ)` of `A₀` at the generic point of the section, as an
  `A₀`-algebra.
* `maximalIdeal_localization_span_sectionParam` and `maximalIdeal_localizationAtSectionKer`
  (part (c)): the maximal ideal of either ring is generated by `t`;
  `maximalIdeal_eq_span_of_ringEquiv` transports this along a ring isomorphism.
* `isDiscreteValuationRing_localization_horizontal` (part (b)): if `R` has characteristic zero,
  `B` is standard smooth of relative dimension one over `R` and `C` is a localization of `B`
  that is a domain, then the localization of `C` at a height-one prime not containing the
  uniformizer is a discrete valuation ring.

For (b), the residue field `κ` of `T := C_𝔮` is a field extension of `Frac R` that is
essentially of finite type, hence formally smooth (`Frac R` is perfect in characteristic zero).
So `κ` is formally smooth over `R`, and the conormal map `𝔪/𝔪² → κ ⊗ Ω[T⁄R]` is injective. As
`Ω[T⁄R]` is free of rank one, `dim 𝔪/𝔪² ≤ 1`. The ring `T` is a Noetherian local domain of
dimension one, so it is a discrete valuation ring.
-/

set_option autoImplicit false

noncomputable section

namespace ZInQ.Contrib.CMHeight62Full

open IsLocalRing

section SectionKer

variable {R : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
variable {A₀ : Type*} [CommRing A₀] [Algebra R A₀] (σ : A₀ →ₐ[R] R) {t : A₀}

/-- The kernel of the localized section pulls back to the kernel of the section. -/
theorem comap_ker_localSection :
    (RingHom.ker (localSection σ)).comap
        (algebraMap A₀ (Localization.AtPrime (sectionPrime σ))) = RingHom.ker σ := by
  ext a
  simp [RingHom.mem_ker, localSection_algebraMap]

variable (hker : RingHom.ker (localSection σ) =
  Ideal.span {algebraMap A₀ (Localization.AtPrime (sectionPrime σ)) t})
include hker

/-- The ideal `(t)` of `A` is prime (it is the kernel of the localized section). -/
theorem isPrime_span_sectionParam :
    (Ideal.span {algebraMap A₀ (Localization.AtPrime (sectionPrime σ)) t}).IsPrime :=
  hker ▸ RingHom.ker_isPrime (localSection σ)

/-- The prime `(t)` of `A` pulls back to `ker σ`. -/
theorem comap_span_sectionParam :
    (Ideal.span {algebraMap A₀ (Localization.AtPrime (sectionPrime σ)) t}).comap
        (algebraMap A₀ (Localization.AtPrime (sectionPrime σ))) = RingHom.ker σ := by
  rw [← hker, comap_ker_localSection]

/-- The localization of `A` at `(t)` is a localization of `A₀` at `ker σ`. -/
theorem isLocalization_localization_span_sectionParam :
    haveI := isPrime_span_sectionParam σ hker
    IsLocalization (RingHom.ker σ).primeCompl
      (Localization.AtPrime
        (Ideal.span {algebraMap A₀ (Localization.AtPrime (sectionPrime σ)) t})) := by
  have := isPrime_span_sectionParam σ hker
  have h := IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
    (sectionPrime σ).primeCompl
    (Localization.AtPrime
      (Ideal.span {algebraMap A₀ (Localization.AtPrime (sectionPrime σ)) t}))
    (Ideal.span {algebraMap A₀ (Localization.AtPrime (sectionPrime σ)) t})
  have hM : (Ideal.comap (algebraMap A₀ (Localization.AtPrime (sectionPrime σ)))
      (Ideal.span {algebraMap A₀ (Localization.AtPrime (sectionPrime σ)) t})).primeCompl =
      (RingHom.ker σ).primeCompl := by
    ext x
    simp only [Ideal.mem_primeCompl_iff, comap_span_sectionParam σ hker]
  exact hM ▸ h

/-- **L2 (a).** Localizing `A` at `(t)` gives the local ring of `A₀` at the generic point of the
section, as an `A₀`-algebra. -/
theorem localizationAtSectionKer_equiv :
    haveI := isPrime_span_sectionParam σ hker
    ∃ e : Localization.AtPrime (RingHom.ker σ) ≃ₐ[A₀]
      Localization.AtPrime
        (Ideal.span {algebraMap A₀ (Localization.AtPrime (sectionPrime σ)) t}),
      ∀ a : A₀, e (algebraMap A₀ _ a) = algebraMap A₀ _ a := by
  have := isPrime_span_sectionParam σ hker
  have := isLocalization_localization_span_sectionParam σ hker
  exact ⟨IsLocalization.algEquiv (RingHom.ker σ).primeCompl _ _, fun a => AlgEquiv.commutes _ a⟩

/-- **L2 (c)**, at `A_(t)`: its maximal ideal is generated by `t`. -/
theorem maximalIdeal_localization_span_sectionParam :
    haveI := isPrime_span_sectionParam σ hker
    maximalIdeal (Localization.AtPrime
        (Ideal.span {algebraMap A₀ (Localization.AtPrime (sectionPrime σ)) t})) =
      Ideal.span {algebraMap A₀ (Localization.AtPrime
        (Ideal.span {algebraMap A₀ (Localization.AtPrime (sectionPrime σ)) t})) t} := by
  have := isPrime_span_sectionParam σ hker
  rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_span, Set.image_singleton,
    ← IsScalarTower.algebraMap_apply]

/-- **L2 (c)**, at the generic point of the section: the maximal ideal of
`Localization.AtPrime (ker σ)` is generated by `t`. -/
theorem maximalIdeal_localizationAtSectionKer :
    maximalIdeal (Localization.AtPrime (RingHom.ker σ)) =
      Ideal.span {algebraMap A₀ (Localization.AtPrime (RingHom.ker σ)) t} := by
  have := isPrime_span_sectionParam σ hker
  obtain ⟨e, -⟩ := localizationAtSectionKer_equiv σ hker
  have hmax : (Ideal.map e.symm (maximalIdeal (Localization.AtPrime
      (Ideal.span {algebraMap A₀ (Localization.AtPrime (sectionPrime σ)) t})))).IsMaximal :=
    Ideal.map_isMaximal_of_equiv e.symm
  rw [← IsLocalRing.eq_maximalIdeal hmax, maximalIdeal_localization_span_sectionParam σ hker,
    Ideal.map_span, Set.image_singleton, AlgEquiv.commutes]

/-- **L2 (c)**, transported along a ring isomorphism (for instance onto a stalk). -/
theorem maximalIdeal_eq_span_of_ringEquiv {D : Type*} [CommRing D] [IsLocalRing D]
    (φη : Localization.AtPrime (RingHom.ker σ) ≃+* D) :
    maximalIdeal D = Ideal.span {φη (algebraMap A₀ _ t)} := by
  have hmax : (Ideal.map φη (maximalIdeal (Localization.AtPrime (RingHom.ker σ)))).IsMaximal :=
    Ideal.map_isMaximal_of_equiv φη
  rw [← IsLocalRing.eq_maximalIdeal hmax, maximalIdeal_localizationAtSectionKer σ hker,
    Ideal.map_span, Set.image_singleton]

end SectionKer

section Cotangent

variable {K₀ : Type*} [CommRing K₀] {T : Type*} [CommRing T] [IsLocalRing T] [Algebra K₀ T]

/-- For a formally smooth local `K₀`-algebra `T` whose residue field is formally smooth over
`K₀`, the cotangent space `𝔪/𝔪²` has dimension at most the rank of `Ω[T⁄K₀]`. -/
theorem finrank_cotangentSpace_le_of_basis [Algebra.FormallySmooth K₀ T]
    [Algebra.FormallySmooth K₀ (ResidueField T)] {n : ℕ}
    (b : Module.Basis (Fin n) T Ω[T⁄K₀]) :
    Module.finrank (ResidueField T) (CotangentSpace T) ≤ n := by
  have hsurj : Function.Surjective (algebraMap T (ResidueField T)) :=
    Ideal.Quotient.mk_surjective
  have hinj : Function.Injective
      (KaehlerDifferential.kerCotangentToTensor K₀ T (ResidueField T)) :=
    (Algebra.FormallySmooth.kerCotangentToTensor_injective_iff hsurj).2 inferInstance
  have hker : RingHom.ker (algebraMap T (ResidueField T)) = maximalIdeal T := Ideal.mk_ker
  have hex : ∀ I : Ideal T, I = RingHom.ker (algebraMap T (ResidueField T)) →
      ∃ f : I.Cotangent →ₗ[T] TensorProduct T (ResidueField T) Ω[T⁄K₀],
        Function.Injective f := by
    rintro I rfl
    exact ⟨_, hinj⟩
  obtain ⟨f, hf⟩ := hex (maximalIdeal T) hker.symm
  let f' : CotangentSpace T →ₗ[T] TensorProduct T (ResidueField T) Ω[T⁄K₀] := f
  have : Module.Free T Ω[T⁄K₀] := Module.Free.of_basis b
  have : Module.Finite T Ω[T⁄K₀] := Module.Finite.of_basis b
  have hle := LinearMap.finrank_le_finrank_of_injective
    (f := f'.extendScalarsOfSurjective hsurj) hf
  rwa [Module.finrank_baseChange, Module.finrank_eq_card_basis b, Fintype.card_fin] at hle

end Cotangent

section Horizontal

variable {R : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
variable {ϖ : R} (hϖ : Irreducible ϖ) {B : Type*} [CommRing B] [Algebra R B]
variable (M : Submonoid B) {C : Type*} [CommRing C] [IsDomain C] [Algebra B C]
  [IsLocalization M C] [Algebra R C] [IsScalarTower R B C] (𝔮 : Ideal C) [𝔮.IsPrime]

omit [IsDomain C] in
include hϖ in
/-- Away from the uniformizer, `R` embeds in the residue field of `C_𝔮`. -/
theorem residue_algebraMap_ne_zero_of_not_mem (hϖ𝔮 : algebraMap R C ϖ ∉ 𝔮) {r : R}
    (hr : r ≠ 0) : algebraMap R (ResidueField (Localization.AtPrime 𝔮)) r ≠ 0 := by
  obtain ⟨n, u, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hr hϖ
  have hϖ' : algebraMap R (ResidueField (Localization.AtPrime 𝔮)) ϖ ≠ 0 := by
    rw [IsScalarTower.algebraMap_apply R (Localization.AtPrime 𝔮) (ResidueField _),
      IsScalarTower.algebraMap_apply R C (Localization.AtPrime 𝔮), ResidueField.algebraMap_eq,
      Ne, residue_eq_zero_iff, IsLocalization.AtPrime.to_map_mem_maximal_iff _ 𝔮]
    exact hϖ𝔮
  rw [map_mul, map_pow]
  exact mul_ne_zero (u.isUnit.map _).ne_zero (pow_ne_zero _ hϖ')

variable [CharZero R] [Algebra.IsStandardSmoothOfRelativeDimension 1 R B]

include hϖ M in
/-- **L2 (b).** Horizontal height-one localizations of a localization of a standard smooth
algebra of relative dimension one over a discrete valuation ring of characteristic zero are
discrete valuation rings. -/
theorem isDiscreteValuationRing_localization_horizontal (h1 : 𝔮.height = 1)
    (hϖ𝔮 : algebraMap R C ϖ ∉ 𝔮) : IsDiscreteValuationRing (Localization.AtPrime 𝔮) := by
  have : Algebra.IsStandardSmooth R B :=
    Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth 1
  have : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing R B
  have : IsNoetherianRing C := IsLocalization.isNoetherianRing M C inferInstance
  have : IsNoetherianRing (Localization.AtPrime 𝔮) :=
    IsLocalization.isNoetherianRing 𝔮.primeCompl _ inferInstance
  have hTB : IsLocalization.AtPrime (Localization.AtPrime 𝔮) (𝔮.comap (algebraMap B C)) :=
    IsLocalization.isLocalization_isLocalization_atPrime_isLocalization M
      (Localization.AtPrime 𝔮) 𝔮
  have : IsScalarTower R B (Localization.AtPrime 𝔮) := IsScalarTower.of_algebraMap_eq fun r => by
    rw [IsScalarTower.algebraMap_apply R C (Localization.AtPrime 𝔮),
      IsScalarTower.algebraMap_apply R B C, ← IsScalarTower.algebraMap_apply B C]
  -- formal smoothness and the differentials of `T = C_𝔮`
  have : Algebra.FormallySmooth B (Localization.AtPrime 𝔮) :=
    Algebra.FormallySmooth.of_isLocalization (𝔮.comap (algebraMap B C)).primeCompl
  have : Algebra.FormallySmooth R (Localization.AtPrime 𝔮) :=
    Algebra.FormallySmooth.comp R B (Localization.AtPrime 𝔮)
  have : Nontrivial B := (algebraMap B C).domain_nontrivial
  have hrk := Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential
    (R := R) (S := B) 1
  have : Module.Finite B Ω[B⁄R] := Module.rank_lt_aleph0_iff.1 (by
    rw [hrk]
    exact Cardinal.natCast_lt_aleph0)
  let b := Module.finBasisOfFinrankEq B Ω[B⁄R] (Module.finrank_eq_of_rank_eq hrk)
  have := KaehlerDifferential.isLocalizedModule_map R B (Localization.AtPrime 𝔮)
    (𝔮.comap (algebraMap B C)).primeCompl
  let b' := Module.Basis.ofIsLocalizedModule (Localization.AtPrime 𝔮)
    (𝔮.comap (algebraMap B C)).primeCompl
    (KaehlerDifferential.map R R B (Localization.AtPrime 𝔮)) b
  -- the residue field is formally smooth over `R`
  have hinjR : Function.Injective
      (algebraMap R (ResidueField (Localization.AtPrime 𝔮))) := by
    rw [injective_iff_map_eq_zero]
    intro r hr
    by_contra h
    exact residue_algebraMap_ne_zero_of_not_mem hϖ 𝔮 hϖ𝔮 h hr
  have : FaithfulSMul R (ResidueField (Localization.AtPrime 𝔮)) :=
    (faithfulSMul_iff_algebraMap_injective R _).2 hinjR
  let : Algebra (FractionRing R) (ResidueField (Localization.AtPrime 𝔮)) :=
    FractionRing.liftAlgebra R _
  have : CharZero (FractionRing R) :=
    charZero_of_injective_algebraMap (IsFractionRing.injective R (FractionRing R))
  have : PerfectField (FractionRing R) := PerfectField.ofCharZero
  have : Algebra.EssFiniteType R B := Algebra.EssFiniteType.of_finiteType R B
  have : Algebra.EssFiniteType B (Localization.AtPrime 𝔮) :=
    Algebra.EssFiniteType.of_isLocalization _ (𝔮.comap (algebraMap B C)).primeCompl
  have : Algebra.EssFiniteType R (Localization.AtPrime 𝔮) :=
    Algebra.EssFiniteType.comp R B (Localization.AtPrime 𝔮)
  have : Algebra.EssFiniteType R (ResidueField (Localization.AtPrime 𝔮)) :=
    Algebra.EssFiniteType.of_surjective
      (IsScalarTower.toAlgHom R (Localization.AtPrime 𝔮) (ResidueField _))
      residue_surjective
  have : Algebra.EssFiniteType (FractionRing R) (ResidueField (Localization.AtPrime 𝔮)) :=
    Algebra.EssFiniteType.of_comp R (FractionRing R) _
  have : Algebra.FormallySmooth (FractionRing R) (ResidueField (Localization.AtPrime 𝔮)) :=
    Algebra.FormallySmooth.of_perfectField
  have : Algebra.FormallySmooth R (FractionRing R) :=
    Algebra.FormallySmooth.of_isLocalization (nonZeroDivisors R)
  have : Algebra.FormallySmooth R (ResidueField (Localization.AtPrime 𝔮)) :=
    Algebra.FormallySmooth.comp R (FractionRing R) _
  -- the cotangent bound and the dimension
  have hle := finrank_cotangentSpace_le_of_basis b'
  have hnf : ¬ IsField (Localization.AtPrime 𝔮) := by
    intro hF
    have hd := IsLocalization.AtPrime.ringKrullDim_eq_height 𝔮 (Localization.AtPrime 𝔮)
    let := hF.toField
    rw [h1, ringKrullDim_eq_zero_of_field] at hd
    exact absurd hd (by decide)
  exact ((IsDiscreteValuationRing.TFAE _ hnf).out 1 5).2
    (finrank_cotangentSpace_le_one_iff.1 hle)

end Horizontal

section SectionLocal

variable {R : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] [CharZero R]
variable {ϖ : R} (hϖ : Irreducible ϖ) {A₀ : Type*} [CommRing A₀] [Algebra R A₀]
  [Algebra.IsStandardSmoothOfRelativeDimension 1 R A₀] (σ : A₀ →ₐ[R] R)

include hϖ in
/-- **L2 (b)** at the identity point: horizontal height-one localizations of the local ring
`A = Localization.AtPrime (sectionPrime σ)` are discrete valuation rings. This is the form used
for the hypothesis `hhorDVR` (where also `t ∉ 𝔮`, which is not needed). -/
theorem isDiscreteValuationRing_localization_horizontal_sectionLocal
    [IsDomain (Localization.AtPrime (sectionPrime σ))]
    (𝔮 : Ideal (Localization.AtPrime (sectionPrime σ))) [𝔮.IsPrime] (h1 : 𝔮.height = 1)
    (hϖ𝔮 : algebraMap R (Localization.AtPrime (sectionPrime σ)) ϖ ∉ 𝔮) :
    IsDiscreteValuationRing (Localization.AtPrime 𝔮) :=
  isDiscreteValuationRing_localization_horizontal hϖ (sectionPrime σ).primeCompl 𝔮 h1 hϖ𝔮

end SectionLocal

end ZInQ.Contrib.CMHeight62Full
