import ZInQKernel.Contrib.OneProof.BergerComparison.FrobeniusGenerator

/-! The kernel of the restricted evaluation at ξ/p is generated by ξ − pX. -/

noncomputable section

namespace ZInQ.Manuscript.BergerComparison

open HDec.PkgI4 BergerBst FontaineSt PowerSeries Ideal
open PanBergerSplit (Ainf AinfP)
open ZInQ.Contrib.G9.BdrKer.Cp

variable (p : ℕ) [hp : Fact p.Prime]

set_option maxHeartbeats 350000

/-- Evaluation before taking the image subring. -/
def maximalEval : (Ainf p)⟦X⟧ →+* BDeRhamPlus 𝓞_ℂ_[p] p :=
  (evalB p (omegaP_mem p)).comp (PowerSeries.map (algebraMap (Ainf p) (AinfP p)))

private abbrev loc := algebraMap (Ainf p) (AinfP p)
private abbrev toPlus := algebraMap (AinfP p) (AdicCompletion (Ith p) (AinfP p))

private theorem maximalEval_C (a : Ainf p) :
    maximalEval p (C a) = toPlus p (loc p a) := by
  change psEval (Ith p) (omegaP_mem p) (PowerSeries.map (loc p) (C a)) =
    toPlus p (loc p a)
  rw [PowerSeries.map_C]
  exact psEval_C (Ith p) (omegaP_mem p) (loc p a)

private theorem maximalEval_X :
    maximalEval p X = toPlus p (omegaP p) := by
  change psEval (Ith p) (omegaP_mem p) (PowerSeries.map (loc p) X) = _
  rw [PowerSeries.map_X]
  apply AdicCompletion.ext_evalₐ
  intro n
  rw [evalₐ_psEval, ← Polynomial.coe_X, mk_eval_trunc _ (omegaP_mem p), Polynomial.eval_X]
  simp

private theorem p_mul_omega : (p : AinfP p) * omegaP p = loc p (xi p) := by
  rw [omegaP, mul_left_comm, natCast_mul_qp p p hp.out.ne_zero, mul_one]
  rfl

private theorem maximalEval_X_ne_zero : maximalEval p X ≠ 0 := by
  rw [maximalEval_X]
  intro h
  change toPlus p (omegaP p) = (0 : AdicCompletion (Ith p) (AinfP p)) at h
  have hh := congrArg (AdicCompletion.evalₐ (Ith p) 2) h
  rw [AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of] at hh
  rw [map_zero, Ideal.Quotient.eq_zero_iff_mem] at hh
  have hl : loc p (xi p) ∈ Ith p ^ 2 := p_mul_omega p ▸ Ideal.mul_mem_left _ _ hh
  rw [Ith, ker_fontaineThetaInvertP_Cp, Ideal.span_singleton_pow] at hl
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton.mp (mem_xi_pow_of_algebraMap p 2 (xi p) hl)
  have hunit : xi p * a = 1 := by
    apply mul_left_cancel₀ (xi_ne_zero p)
    rw [pow_two] at ha
    rw [← mul_assoc, ← ha, mul_one]
  have h := congrArg (WittVector.fontaineTheta 𝓞_ℂ_[p] p) hunit
  rw [map_mul, theta_xi' p, zero_mul, map_one] at h
  exact zero_ne_one h

/-- The defining linear relation of maximal evaluation. -/
def maximalRelation : (Ainf p)⟦X⟧ := C (xi p) - X * C (p : Ainf p)

theorem maximalEval_relation : maximalEval p (maximalRelation p) = 0 := by
  rw [maximalRelation, map_sub, map_mul, maximalEval_C, maximalEval_X, maximalEval_C]
  change toPlus p (loc p (xi p)) - toPlus p (omegaP p) * toPlus p (loc p (p : Ainf p)) =
    (0 : AdicCompletion (Ith p) (AinfP p))
  rw [← map_mul (toPlus p), map_natCast, mul_comm (omegaP p), p_mul_omega, sub_self]

private theorem constant_dvd_of_eval_zero {f : (Ainf p)⟦X⟧}
    (hf : maximalEval p f = 0) : xi p ∣ PowerSeries.constantCoeff f := by
  have h := congrArg (AdicCompletion.evalₐ (Ith p) 1) hf
  change AdicCompletion.evalₐ (Ith p) 1
      (psEval (Ith p) (omegaP_mem p) (PowerSeries.map (loc p) f)) =
      AdicCompletion.evalₐ (Ith p) 1 (0 : AdicCompletion (Ith p) (AinfP p)) at h
  rw [evalₐ_psEval, map_zero, Ideal.Quotient.eq_zero_iff_mem, pow_one] at h
  have he : (trunc 1 (PowerSeries.map (loc p) f)).eval (omegaP p) =
      loc p (PowerSeries.constantCoeff f) := by
    simp [Polynomial.eval, PowerSeries.coeff_zero_eq_constantCoeff_apply]
  rw [he, Ith, ker_fontaineThetaInvertP_Cp] at h
  have hs := mem_xi_pow_of_algebraMap p 1 _ (by simpa only [pow_one, xi'] using h)
  rwa [pow_one, Ideal.mem_span_singleton] at hs

private abbrev Vanishing := {f : (Ainf p)⟦X⟧ // maximalEval p f = 0}

private def quotientConst (f : Vanishing p) : Ainf p :=
  Classical.choose (constant_dvd_of_eval_zero p f.property)

private theorem quotientConst_spec (f : Vanishing p) :
    PowerSeries.constantCoeff f.val = xi p * quotientConst p f :=
  Classical.choose_spec (constant_dvd_of_eval_zero p f.property)

/-- Subtract the constant term using the relation, then divide by X. -/
private def next (f : Vanishing p) : Vanishing p := by
  let s : (Ainf p)⟦X⟧ := mk (fun n => coeff (n + 1) f.val) + C ((p : Ainf p) * quotientConst p f)
  have he : f.val = X * s + maximalRelation p * C (quotientConst p f) := by
    dsimp only [s]
    rw [maximalRelation, mul_add, sub_mul, mul_assoc, ← map_mul, ← map_mul,
      ← quotientConst_spec]
    calc
      f.val = _ := eq_X_mul_shift_add_const f.val
      _ = _ := by ring
  refine ⟨s, ?_⟩
  have h := congrArg (maximalEval p) he
  rw [f.property, map_add, map_mul, map_mul, maximalEval_relation, zero_mul, add_zero] at h
  have hlog := congrArg (toBdR p) h.symm
  rw [map_mul, map_zero, mul_eq_zero] at hlog
  exact toBdR_injective p ((hlog.resolve_left (fun hh =>
    maximalEval_X_ne_zero p (toBdR_injective p (hh.trans (map_zero _).symm)))).trans
    (map_zero _).symm)

private theorem next_coeff_succ (f : Vanishing p) (n : ℕ) :
    coeff (n + 1) (next p f).val = coeff (n + 2) f.val := by
  change PowerSeries.coeff (n + 1) (mk (fun j => coeff (j + 1) f.val) + C _) = _
  simp only [map_add, PowerSeries.coeff_mk, PowerSeries.coeff_C, Nat.succ_ne_zero, ite_false, add_zero]

private theorem next_const (f : Vanishing p) :
    PowerSeries.constantCoeff (next p f).val =
      coeff 1 f.val + (p : Ainf p) * quotientConst p f := by
  change PowerSeries.constantCoeff (mk (fun j => coeff (j + 1) f.val) + C _) = _
  rw [map_add, PowerSeries.constantCoeff_mk, PowerSeries.constantCoeff_C]

/-- Multiplication by ξ does not create divisibility by a power of p. -/
theorem pow_p_dvd_of_dvd_xi_mul (k : ℕ) (a : Ainf p) (h : (p : Ainf p)^k ∣ xi p * a) :
    (p : Ainf p)^k ∣ a := by
  induction k generalizing a with
  | zero => simp
  | succ k ih =>
    have hh : (p : Ainf p) ∣ xi p * a :=
      (dvd_pow_self _ (Nat.succ_ne_zero k)).trans h
    rw [← Ideal.mem_span_singleton, ← WittVector.ker_constantCoeff, RingHom.mem_ker, map_mul] at hh
    have hx : WittVector.constantCoeff (xi p) = -(pFlat p) := by
      rw [xi, map_sub, map_natCast, CharP.cast_eq_zero, zero_sub]
      simp
    have hn : pFlat p ≠ 0 := by
      intro hz
      have he := untilt_pFlat p
      rw [← WittVector.fontaineTheta_teichmuller, hz, WittVector.teichmuller_zero, map_zero] at he
      exact p_ne_zero p he.symm
    have ha := (mul_eq_zero.mp hh).resolve_left (hx ▸ neg_ne_zero.mpr hn)
    have ha' : (p : Ainf p) ∣ a := by
      rw [← Ideal.mem_span_singleton, ← WittVector.ker_constantCoeff, RingHom.mem_ker]
      exact ha
    obtain ⟨b, rfl⟩ := ha'
    rw [pow_succ, mul_comm ((p : Ainf p)^k), mul_left_comm] at h
    rw [pow_succ, mul_comm ((p : Ainf p)^k)]
    exact mul_dvd_mul_left _ (ih b ((mul_dvd_mul_iff_left (witt_p_ne_zero p)).mp h))

private def quotientSeq (f : Vanishing p) (n : ℕ) : Ainf p :=
  quotientConst p ((next p)^[n] f)

private theorem iter_coeff_succ (f : Vanishing p) (n k : ℕ) :
    coeff (k + 1) (((next p)^[n]) f).val = coeff (k + 1 + n) f.val := by
  induction n generalizing k with
  | zero => rfl
  | succ n ih =>
    rw [Function.iterate_succ_apply', next_coeff_succ]
    simpa only [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using ih (k + 1)

private theorem quotientSeq_step (f : Vanishing p) (n : ℕ) :
    xi p * quotientSeq p f (n + 1) = coeff (n + 1) f.val + (p : Ainf p) * quotientSeq p f n := by
  rw [quotientSeq, ← quotientConst_spec, Function.iterate_succ_apply', next_const, iter_coeff_succ]
  simp [quotientSeq, Nat.add_comm]

private theorem quotientSeq_restricted (f : Vanishing p) (hf : f.val ∈ restricted p) :
    PAdicNull p (quotientSeq p f) := by
  intro k
  induction k with
  | zero => exact ⟨0, fun n _ => by simp⟩
  | succ k ih =>
    obtain ⟨N, hN⟩ := ih
    obtain ⟨M, hM⟩ := hf (k + 1)
    refine ⟨max N M + 1, fun n hn => ?_⟩
    obtain ⟨n, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : n ≠ 0)
    apply pow_p_dvd_of_dvd_xi_mul p
    rw [quotientSeq_step]
    refine dvd_add (hM _ (by omega)) ?_
    rw [pow_succ, mul_comm ((p : Ainf p)^k)]
    exact mul_dvd_mul_left _ (hN _ (by omega))

/-- The entire vanishing restricted series can be divided by the relation;
the quotient is restricted because ξ is regular modulo every power of p. -/
theorem maximalEval_zero_iff {f : (Ainf p)⟦X⟧} (hf : f ∈ restricted p) :
    maximalEval p f = 0 ↔ ∃ g ∈ restricted p, f = maximalRelation p * g := by
  constructor
  · intro h
    let v : Vanishing p := ⟨f, h⟩
    let g := PowerSeries.mk (quotientSeq p v)
    refine ⟨g, ?_, ?_⟩
    · intro k
      obtain ⟨N, hN⟩ := quotientSeq_restricted p v hf k
      exact ⟨N, fun n hn => by simpa [g] using hN n hn⟩
    · apply PowerSeries.ext
      intro n
      cases n with
      | zero =>
        simp only [maximalRelation, sub_mul, PowerSeries.coeff_zero_eq_constantCoeff_apply, map_sub,
          map_mul, map_mul, map_mul, PowerSeries.constantCoeff_C, PowerSeries.constantCoeff_X,
          zero_mul, zero_mul, sub_zero]
        change PowerSeries.constantCoeff f = xi p * quotientSeq p v 0
        exact quotientConst_spec p v
      | succ n =>
        rw [maximalRelation, sub_mul, map_sub, PowerSeries.coeff_C_mul,
          mul_assoc, PowerSeries.coeff_succ_X_mul, PowerSeries.coeff_C_mul]
        simp only [g, PowerSeries.coeff_mk]
        have e := quotientSeq_step p v n
        change xi p * quotientSeq p v (n + 1) = coeff (n + 1) f + _ at e
        rw [e, add_sub_cancel_right]
  · rintro ⟨g, _, rfl⟩
    rw [map_mul, maximalEval_relation, zero_mul]

end ZInQ.Manuscript.BergerComparison
