import ZInQKernel.Hypotheses.PoleManuscript
import Mathlib.FieldTheory.AbsoluteGaloisGroup
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.Topology.Algebra.MulAction
import Mathlib.Algebra.Module.LinearMap.Defs
import Mathlib.RepresentationTheory.Continuous.TopRep

/-!
# Geometric Galois coefficients for the manuscript elliptic curve

The curve is the existing `ZInQ.Manuscript.curve ell`, with equation
`y^2 = x (x - ell) (x + 3 ell)`. All geometric points and torsion coefficients
below use its actual affine-point group over `AlgebraicClosure ℚ`.

The Galois action is induced by the actual field-map homomorphism on points.
Its joint continuity is proved from the finite field generated by an affine
point's two algebraic coordinates and the Krull open fixing subgroup. Neither
continuity nor openness of stabilizers is a caller hypothesis.

The finite coefficient groups are the kernels of multiplication by `2^a`;
the two-primary group is their directed union inside the same point group.
Their actions, inclusions, doubling transitions and discrete integer-linear
representations are induced from that group. No higher-torsion basis,
cardinality, trivial Tate action, Selmer predicate, rank statement or point
supply is asserted. The elliptic interpretation retains `ell ≠ 0`.
-/

set_option autoImplicit false

open scoped Classical

noncomputable section

namespace ZInQ.Contrib.OneProof.ManuscriptPole.GaloisCoefficients

open scoped Topology
open CategoryTheory

/-- The one algebraic closure used by every coefficient group in this file. -/
abbrev Qbar := AlgebraicClosure ℚ

/-- The absolute Galois group with Mathlib's actual Krull topology. -/
abbrev GaloisGroup := Field.absoluteGaloisGroup ℚ

/-- The actual nonsingular geometric point group, including the point at infinity. -/
def GeometricPoints (ell : ℚ) : Type :=
  ((ZInQ.Manuscript.curve ell).baseChange Qbar).toAffine.Point

/-- This type is definitionally the original curve's base-change point type. -/
theorem geometricPoints_eq (ell : ℚ) :
    GeometricPoints ell = ((ZInQ.Manuscript.curve ell).baseChange Qbar).toAffine.Point := rfl

instance geometricPointsAddCommGroup (ell : ℚ) : AddCommGroup (GeometricPoints ell) :=
  inferInstanceAs
    (AddCommGroup ((ZInQ.Manuscript.curve ell).baseChange Qbar).toAffine.Point)

/-- Geometric points have the discrete coefficient topology, not the field topology. -/
instance geometricPointsTopology (ell : ℚ) : TopologicalSpace (GeometricPoints ell) := ⊥

instance geometricPointsDiscrete (ell : ℚ) : DiscreteTopology (GeometricPoints ell) := ⟨rfl⟩

instance geometricPointsTopologicalAddGroup (ell : ℚ) :
    IsTopologicalAddGroup (GeometricPoints ell) := inferInstance

instance geometricPointsContinuousIntSMul (ell : ℚ) :
    ContinuousSMul ℤ (GeometricPoints ell) := ⟨continuous_of_discreteTopology⟩

/-- The nonzero-parameter guard really gives the existing curve's elliptic condition. -/
theorem manuscriptCurve_isElliptic {ell : ℚ} (hell : ell ≠ 0) :
    (ZInQ.Manuscript.curve ell).IsElliptic := by
  refine ⟨isUnit_iff_ne_zero.mpr ?_⟩
  rw [ZInQ.Manuscript.curve_Δ]
  exact mul_ne_zero (by norm_num) (pow_ne_zero 6 hell)

/-- Apply a rational-field automorphism of the algebraic closure to actual point coordinates. -/
def geometricPointMap (ell : ℚ) (sigma : GaloisGroup) :
    GeometricPoints ell →+ GeometricPoints ell :=
  WeierstrassCurve.Affine.Point.map
    (W' := (ZInQ.Manuscript.curve ell).toAffine) sigma.toAlgHom

@[simp] theorem geometricPointMap_zero (ell : ℚ) (sigma : GaloisGroup) :
    geometricPointMap ell sigma 0 = 0 := map_zero _

@[simp] theorem geometricPointMap_one (ell : ℚ) (P : GeometricPoints ell) :
    geometricPointMap ell 1 P = P := by
  cases P <;> rfl

/-- The group product is composition in the same order as the actual point maps. -/
theorem geometricPointMap_mul (ell : ℚ) (sigma tau : GaloisGroup)
    (P : GeometricPoints ell) :
    geometricPointMap ell (sigma * tau) P =
      geometricPointMap ell sigma (geometricPointMap ell tau P) := by
  change WeierstrassCurve.Affine.Point.map (sigma.toAlgHom.comp tau.toAlgHom) P =
    WeierstrassCurve.Affine.Point.map sigma.toAlgHom
      (WeierstrassCurve.Affine.Point.map tau.toAlgHom P)
  exact (WeierstrassCurve.Affine.Point.map_map
    (W' := (ZInQ.Manuscript.curve ell).toAffine)
    (f := tau.toAlgHom) (g := sigma.toAlgHom) P).symm

/-- The genuine additive Galois action on the geometric point group. -/
instance geometricPointsGaloisAction (ell : ℚ) :
    DistribMulAction GaloisGroup (GeometricPoints ell) where
  smul sigma P := geometricPointMap ell sigma P
  one_smul := geometricPointMap_one ell
  mul_smul := geometricPointMap_mul ell
  smul_zero sigma := (geometricPointMap ell sigma).map_zero
  smul_add sigma P Q := (geometricPointMap ell sigma).map_add P Q

@[simp] theorem geometric_galois_smul (ell : ℚ) (sigma : GaloisGroup)
    (P : GeometricPoints ell) : sigma • P = geometricPointMap ell sigma P := rfl

/-- The inverse is the actual inverse automorphism, not a chosen coefficient inverse. -/
theorem geometricPointMap_inv (ell : ℚ) (sigma : GaloisGroup)
    (P : GeometricPoints ell) :
    geometricPointMap ell sigma⁻¹ (geometricPointMap ell sigma P) = P := by
  rw [← geometricPointMap_mul, inv_mul_cancel, geometricPointMap_one]

theorem geometricPointMap_inv_right (ell : ℚ) (sigma : GaloisGroup)
    (P : GeometricPoints ell) :
    geometricPointMap ell sigma (geometricPointMap ell sigma⁻¹ P) = P := by
  rw [← geometricPointMap_mul, mul_inv_cancel, geometricPointMap_one]

/-- The stabilizer of each actual point is open, derived from its algebraic coordinates. -/
theorem geometricPoint_stabilizer_isOpen (ell : ℚ) (P : GeometricPoints ell) :
    IsOpen (MulAction.stabilizer GaloisGroup P : Set GaloisGroup) := by
  change IsOpen (MulAction.stabilizer
    (α := GeometricPoints ell) GaloisGroup P : Set GaloisGroup)
  cases P with
  | zero =>
      change IsOpen {sigma : GaloisGroup |
        WeierstrassCurve.Affine.Point.map
          (R := ℚ) (S := ℚ) (F := Qbar) (K := Qbar)
          (W' := (ZInQ.Manuscript.curve ell).toAffine) sigma.toAlgHom
          (0 : ((ZInQ.Manuscript.curve ell).toAffine.baseChange Qbar).Point) = 0}
      have hzero :
          ({sigma : GaloisGroup |
            WeierstrassCurve.Affine.Point.map
              (R := ℚ) (S := ℚ) (F := Qbar) (K := Qbar)
              (W' := (ZInQ.Manuscript.curve ell).toAffine) sigma.toAlgHom
              (0 : ((ZInQ.Manuscript.curve ell).toAffine.baseChange Qbar).Point) = 0} :
            Set GaloisGroup) = Set.univ := by
        ext sigma
        change (0 : ((ZInQ.Manuscript.curve ell).toAffine.baseChange Qbar).Point) = 0 ↔ True
        exact ⟨fun _ => trivial, fun _ => rfl⟩
      rw [hzero]
      exact isOpen_univ
  | some x y hxy =>
      change IsOpen {sigma : GaloisGroup |
        WeierstrassCurve.Affine.Point.map
          (R := ℚ) (S := ℚ) (F := Qbar) (K := Qbar)
          (W' := (ZInQ.Manuscript.curve ell).toAffine) sigma.toAlgHom
          (WeierstrassCurve.Affine.Point.some x y hxy) =
        WeierstrassCurve.Affine.Point.some x y hxy}
      let E : IntermediateField ℚ Qbar := IntermediateField.adjoin ℚ ({x, y} : Set Qbar)
      letI : FiniteDimensional ℚ E :=
        IntermediateField.finiteDimensional_adjoin_pair
          (Algebra.IsAlgebraic.isAlgebraic x).isIntegral
          (Algebra.IsAlgebraic.isAlgebraic y).isIntegral
      have hpt : ∀ tau : Qbar ≃ₐ[ℚ] Qbar,
          WeierstrassCurve.Affine.Point.map
            (R := ℚ) (S := ℚ) (F := Qbar) (K := Qbar)
            (W' := (ZInQ.Manuscript.curve ell).toAffine) tau.toAlgHom
            (WeierstrassCurve.Affine.Point.some x y hxy) =
          WeierstrassCurve.Affine.Point.some x y hxy ↔ tau ∈ E.fixingSubgroup := by
        intro tau
        rw [WeierstrassCurve.Affine.Point.map_some,
          WeierstrassCurve.Affine.Point.some.injEq,
          IntermediateField.mem_fixingSubgroup_iff]
        simpa [E, AlgEquiv.smul_def] using
          (IntermediateField.forall_mem_adjoin_smul_eq_self_iff
            ℚ (M := Qbar ≃ₐ[ℚ] Qbar) (S := ({x, y} : Set Qbar)) tau).symm
      have hstab :
          ({sigma : GaloisGroup |
            WeierstrassCurve.Affine.Point.map
              (R := ℚ) (S := ℚ) (F := Qbar) (K := Qbar)
              (W' := (ZInQ.Manuscript.curve ell).toAffine) sigma.toAlgHom
              (WeierstrassCurve.Affine.Point.some x y hxy) =
            WeierstrassCurve.Affine.Point.some x y hxy} : Set GaloisGroup) =
            (E.fixingSubgroup : Set (Qbar ≃ₐ[ℚ] Qbar)) :=
        Set.ext fun sigma => hpt sigma
      rw [hstab]
      exact IntermediateField.fixingSubgroup_isOpen E

/-- Joint continuity in the Galois variable and the discrete geometric point variable. -/
instance geometricPointsContinuousGaloisSMul (ell : ℚ) :
    ContinuousSMul GaloisGroup (GeometricPoints ell) :=
  (continuousSMul_iff_stabilizer_isOpen
    (M := GaloisGroup) (X := GeometricPoints ell)).mpr
      (geometricPoint_stabilizer_isOpen ell)

/-- Rational base-change points are fixed; the self-`ℚ` presentation is explicit. -/
theorem galois_fixes_rational_baseChange (ell : ℚ) (sigma : GaloisGroup)
    (P : ((ZInQ.Manuscript.curve ell).toAffine.baseChange ℚ).Point) :
    geometricPointMap ell sigma
        (WeierstrassCurve.Affine.Point.baseChange
          (W' := (ZInQ.Manuscript.curve ell).toAffine) ℚ Qbar P) =
      WeierstrassCurve.Affine.Point.baseChange
        (W' := (ZInQ.Manuscript.curve ell).toAffine) ℚ Qbar P := by
  change WeierstrassCurve.Affine.Point.map
      (R := ℚ) (S := ℚ) (F := Qbar) (K := Qbar)
      (W' := (ZInQ.Manuscript.curve ell).toAffine) sigma.toAlgHom
      (WeierstrassCurve.Affine.Point.baseChange
        (W' := (ZInQ.Manuscript.curve ell).toAffine) ℚ Qbar P) =
    WeierstrassCurve.Affine.Point.baseChange
      (W' := (ZInQ.Manuscript.curve ell).toAffine) ℚ Qbar P
  exact WeierstrassCurve.Affine.Point.map_baseChange
    (R := ℚ) (W' := (ZInQ.Manuscript.curve ell).toAffine)
    (F := ℚ) (K := Qbar) (L := Qbar) sigma.toAlgHom P

/-- The actual finite coefficient subgroup `E[2^a]`; at `a = 0` the multiplier is one. -/
def twoPowerTorsion (ell : ℚ) (a : ℕ) : AddSubgroup (GeometricPoints ell) :=
  (nsmulAddMonoidHom (α := GeometricPoints ell) ((2 : ℕ) ^ a)).ker

@[simp] theorem mem_twoPowerTorsion (ell : ℚ) (a : ℕ) (P : GeometricPoints ell) :
    P ∈ twoPowerTorsion ell a ↔ (2 : ℕ) ^ a • P = 0 := Iff.rfl

@[simp] theorem twoPowerTorsion_zero (ell : ℚ) : twoPowerTorsion ell 0 = ⊥ := by
  ext P
  simp only [mem_twoPowerTorsion, pow_zero, one_nsmul, AddSubgroup.mem_bot]

/-- The integer-module carrier of the same kernel, with the canonical integer action. -/
abbrev twoPowerTorsionModule (ell : ℚ) (a : ℕ) : Submodule ℤ (GeometricPoints ell) :=
  (twoPowerTorsion ell a).toIntSubmodule

/-- Galois stability follows from the actual additive point map commuting with multiplication. -/
theorem twoPowerTorsion_galois_stable (ell : ℚ) (a : ℕ) (sigma : GaloisGroup)
    {P : GeometricPoints ell} (hP : P ∈ twoPowerTorsion ell a) :
    sigma • P ∈ twoPowerTorsion ell a := by
  change (2 : ℕ) ^ a • P = 0 at hP
  change (2 : ℕ) ^ a • geometricPointMap ell sigma P = 0
  rw [← map_nsmul, hP, map_zero]

/-- The geometric kernels increase with the exponent, by actual multiplication identities. -/
theorem twoPowerTorsion_mono (ell : ℚ) {a b : ℕ} (hab : a ≤ b) :
    twoPowerTorsion ell a ≤ twoPowerTorsion ell b := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hab
  intro P hP
  change (2 : ℕ) ^ a • P = 0 at hP
  change (2 : ℕ) ^ (a + k) • P = 0
  rw [pow_add, Nat.mul_comm, mul_smul, hP, nsmul_zero]

theorem twoPowerTorsion_directed (ell : ℚ) :
    Directed (· ≤ ·) (twoPowerTorsion ell) := by
  intro a b
  exact ⟨max a b, twoPowerTorsion_mono ell (le_max_left a b),
    twoPowerTorsion_mono ell (le_max_right a b)⟩

instance twoPowerTorsionGaloisAction (ell : ℚ) (a : ℕ) :
    DistribMulAction GaloisGroup (twoPowerTorsion ell a) where
  smul sigma P := ⟨sigma • (P : GeometricPoints ell),
    twoPowerTorsion_galois_stable ell a sigma P.property⟩
  one_smul P := Subtype.ext (one_smul GaloisGroup (P : GeometricPoints ell))
  mul_smul sigma tau P :=
    Subtype.ext (mul_smul sigma tau (P : GeometricPoints ell))
  smul_zero sigma := Subtype.ext (smul_zero sigma)
  smul_add sigma P Q :=
    Subtype.ext (smul_add sigma (P : GeometricPoints ell) (Q : GeometricPoints ell))

@[simp] theorem twoPowerTorsion_smul_coe (ell : ℚ) (a : ℕ) (sigma : GaloisGroup)
    (P : twoPowerTorsion ell a) :
    ((sigma • P : twoPowerTorsion ell a) : GeometricPoints ell) =
      sigma • (P : GeometricPoints ell) := rfl

instance twoPowerTorsionContinuousGaloisSMul (ell : ℚ) (a : ℕ) :
    ContinuousSMul GaloisGroup (twoPowerTorsion ell a) := by
  apply (continuousSMul_iff_stabilizer_isOpen
    (M := GaloisGroup) (X := twoPowerTorsion ell a)).mpr
  intro P
  have hstab : MulAction.stabilizer GaloisGroup P =
      MulAction.stabilizer GaloisGroup (P : GeometricPoints ell) := by
    ext sigma
    simp only [MulAction.mem_stabilizer_iff, Subtype.ext_iff, twoPowerTorsion_smul_coe]
  rw [hstab]
  exact geometricPoint_stabilizer_isOpen ell (P : GeometricPoints ell)

/-- Inclusion of actual kernels; the geometric point is unchanged. -/
def twoPowerInclusion (ell : ℚ) {a b : ℕ} (hab : a ≤ b) :
    twoPowerTorsion ell a →+ twoPowerTorsion ell b where
  toFun P := ⟨P, twoPowerTorsion_mono ell hab P.property⟩
  map_zero' := rfl
  map_add' _ _ := rfl

@[simp] theorem twoPowerInclusion_coe (ell : ℚ) {a b : ℕ} (hab : a ≤ b)
    (P : twoPowerTorsion ell a) :
    (twoPowerInclusion ell hab P : GeometricPoints ell) = P := rfl

theorem twoPowerInclusion_injective (ell : ℚ) {a b : ℕ} (hab : a ≤ b) :
    Function.Injective (twoPowerInclusion ell hab) := by
  intro P Q h
  exact Subtype.ext (congrArg (fun R : twoPowerTorsion ell b =>
    (R : GeometricPoints ell)) h)

@[simp] theorem twoPowerInclusion_refl (ell : ℚ) (a : ℕ)
    (P : twoPowerTorsion ell a) : twoPowerInclusion ell (le_refl a) P = P := rfl

theorem twoPowerInclusion_trans (ell : ℚ) {a b c : ℕ} (hab : a ≤ b) (hbc : b ≤ c)
    (P : twoPowerTorsion ell a) :
    twoPowerInclusion ell hbc (twoPowerInclusion ell hab P) =
      twoPowerInclusion ell (hab.trans hbc) P := rfl

theorem twoPowerInclusion_galois (ell : ℚ) {a b : ℕ} (hab : a ≤ b)
    (sigma : GaloisGroup) (P : twoPowerTorsion ell a) :
    twoPowerInclusion ell hab (sigma • P) = sigma • twoPowerInclusion ell hab P := rfl

/-- The actual `[2]` transition `E[2^(a+1)] → E[2^a]`, not a coordinate projection. -/
def twoPowerTransition (ell : ℚ) (a : ℕ) :
    twoPowerTorsion ell (a + 1) →+ twoPowerTorsion ell a where
  toFun P := ⟨(2 : ℕ) • (P : GeometricPoints ell), by
    change (2 : ℕ) ^ a • ((2 : ℕ) • (P : GeometricPoints ell)) = 0
    rw [← mul_smul, ← pow_succ]
    exact P.property⟩
  map_zero' := by apply Subtype.ext; exact nsmul_zero 2
  map_add' P Q := by
    apply Subtype.ext
    exact nsmul_add (P : GeometricPoints ell) (Q : GeometricPoints ell) 2

@[simp] theorem twoPowerTransition_coe (ell : ℚ) (a : ℕ)
    (P : twoPowerTorsion ell (a + 1)) :
    (twoPowerTransition ell a P : GeometricPoints ell) =
      (2 : ℕ) • (P : GeometricPoints ell) := rfl

theorem twoPowerTransition_galois (ell : ℚ) (a : ℕ) (sigma : GaloisGroup)
    (P : twoPowerTorsion ell (a + 1)) :
    twoPowerTransition ell a (sigma • P) = sigma • twoPowerTransition ell a P := by
  apply Subtype.ext
  change (2 : ℕ) • geometricPointMap ell sigma (P : GeometricPoints ell) =
    geometricPointMap ell sigma ((2 : ℕ) • (P : GeometricPoints ell))
  exact (map_nsmul (geometricPointMap ell sigma) _ _).symm

/-- Inclusions and the actual doubling transition commute on their geometric points. -/
theorem twoPowerTransition_inclusion (ell : ℚ) {a b : ℕ} (hab : a ≤ b)
    (P : twoPowerTorsion ell (a + 1)) :
    twoPowerInclusion ell hab (twoPowerTransition ell a P) =
      twoPowerTransition ell b
        (twoPowerInclusion ell (Nat.add_le_add_right hab 1) P) := rfl

theorem twoPowerInclusion_transition (ell : ℚ) (a : ℕ)
    (P : twoPowerTorsion ell (a + 1)) :
    twoPowerInclusion ell (Nat.le_succ a) (twoPowerTransition ell a P) =
      (2 : ℕ) • P := by
  apply Subtype.ext
  rfl

/-- The actual directed union `E[2^∞]` inside the same geometric point group. -/
def twoPrimaryTorsion (ell : ℚ) : AddSubgroup (GeometricPoints ell) where
  carrier := {P | ∃ a : ℕ, P ∈ twoPowerTorsion ell a}
  zero_mem' := ⟨0, (twoPowerTorsion ell 0).zero_mem⟩
  add_mem' := by
    rintro P Q ⟨a, ha⟩ ⟨b, hb⟩
    exact ⟨max a b, (twoPowerTorsion ell (max a b)).add_mem
      (twoPowerTorsion_mono ell (le_max_left a b) ha)
      (twoPowerTorsion_mono ell (le_max_right a b) hb)⟩
  neg_mem' := by
    rintro P ⟨a, ha⟩
    exact ⟨a, (twoPowerTorsion ell a).neg_mem ha⟩

@[simp] theorem mem_twoPrimaryTorsion (ell : ℚ) (P : GeometricPoints ell) :
    P ∈ twoPrimaryTorsion ell ↔ ∃ a : ℕ, (2 : ℕ) ^ a • P = 0 := Iff.rfl

abbrev twoPrimaryTorsionModule (ell : ℚ) : Submodule ℤ (GeometricPoints ell) :=
  (twoPrimaryTorsion ell).toIntSubmodule

theorem twoPrimaryTorsion_galois_stable (ell : ℚ) (sigma : GaloisGroup)
    {P : GeometricPoints ell} (hP : P ∈ twoPrimaryTorsion ell) :
    sigma • P ∈ twoPrimaryTorsion ell := by
  obtain ⟨a, ha⟩ := hP
  exact ⟨a, twoPowerTorsion_galois_stable ell a sigma ha⟩

instance twoPrimaryTorsionGaloisAction (ell : ℚ) :
    DistribMulAction GaloisGroup (twoPrimaryTorsion ell) where
  smul sigma P := ⟨sigma • (P : GeometricPoints ell),
    twoPrimaryTorsion_galois_stable ell sigma P.property⟩
  one_smul P := Subtype.ext (one_smul GaloisGroup (P : GeometricPoints ell))
  mul_smul sigma tau P := Subtype.ext (mul_smul sigma tau (P : GeometricPoints ell))
  smul_zero sigma := Subtype.ext (smul_zero sigma)
  smul_add sigma P Q :=
    Subtype.ext (smul_add sigma (P : GeometricPoints ell) (Q : GeometricPoints ell))

@[simp] theorem twoPrimaryTorsion_smul_coe (ell : ℚ) (sigma : GaloisGroup)
    (P : twoPrimaryTorsion ell) :
    ((sigma • P : twoPrimaryTorsion ell) : GeometricPoints ell) =
      sigma • (P : GeometricPoints ell) := rfl

instance twoPrimaryTorsionContinuousGaloisSMul (ell : ℚ) :
    ContinuousSMul GaloisGroup (twoPrimaryTorsion ell) := by
  apply (continuousSMul_iff_stabilizer_isOpen
    (M := GaloisGroup) (X := twoPrimaryTorsion ell)).mpr
  intro P
  have hstab : MulAction.stabilizer GaloisGroup P =
      MulAction.stabilizer GaloisGroup (P : GeometricPoints ell) := by
    ext sigma
    simp only [MulAction.mem_stabilizer_iff, Subtype.ext_iff, twoPrimaryTorsion_smul_coe]
  rw [hstab]
  exact geometricPoint_stabilizer_isOpen ell (P : GeometricPoints ell)

/-- The inclusion of a finite coefficient level into the actual directed union. -/
def twoPowerToPrimary (ell : ℚ) (a : ℕ) :
    twoPowerTorsion ell a →+ twoPrimaryTorsion ell where
  toFun P := ⟨P, a, P.property⟩
  map_zero' := rfl
  map_add' _ _ := rfl

@[simp] theorem twoPowerToPrimary_coe (ell : ℚ) (a : ℕ) (P : twoPowerTorsion ell a) :
    (twoPowerToPrimary ell a P : GeometricPoints ell) = P := rfl

theorem twoPowerToPrimary_injective (ell : ℚ) (a : ℕ) :
    Function.Injective (twoPowerToPrimary ell a) := by
  intro P Q h
  exact Subtype.ext (congrArg (fun R : twoPrimaryTorsion ell =>
    (R : GeometricPoints ell)) h)

theorem twoPowerToPrimary_inclusion (ell : ℚ) {a b : ℕ} (hab : a ≤ b)
    (P : twoPowerTorsion ell a) :
    twoPowerToPrimary ell b (twoPowerInclusion ell hab P) = twoPowerToPrimary ell a P := rfl

theorem twoPowerToPrimary_galois (ell : ℚ) (a : ℕ) (sigma : GaloisGroup)
    (P : twoPowerTorsion ell a) :
    twoPowerToPrimary ell a (sigma • P) = sigma • twoPowerToPrimary ell a P := rfl

/-- Doubling on the two-primary coefficient group is its actual additive doubling map. -/
def twoPrimaryDoubling (ell : ℚ) : twoPrimaryTorsion ell →+ twoPrimaryTorsion ell :=
  nsmulAddMonoidHom 2

theorem twoPrimaryDoubling_galois (ell : ℚ) (sigma : GaloisGroup)
    (P : twoPrimaryTorsion ell) :
    twoPrimaryDoubling ell (sigma • P) = sigma • twoPrimaryDoubling ell P := by
  apply Subtype.ext
  change (2 : ℕ) • geometricPointMap ell sigma (P : GeometricPoints ell) =
    geometricPointMap ell sigma ((2 : ℕ) • (P : GeometricPoints ell))
  exact (map_nsmul (geometricPointMap ell sigma) _ _).symm

theorem twoPowerToPrimary_transition (ell : ℚ) (a : ℕ)
    (P : twoPowerTorsion ell (a + 1)) :
    twoPowerToPrimary ell a (twoPowerTransition ell a P) =
      twoPrimaryDoubling ell (twoPowerToPrimary ell (a + 1) P) := by
  apply Subtype.ext
  rfl

/-- The actual finite coefficient subgroup included in the same geometric point group. -/
def twoPowerToGeometric (ell : ℚ) (a : ℕ) :
    twoPowerTorsion ell a →+ GeometricPoints ell where
  toFun P := P
  map_zero' := rfl
  map_add' _ _ := rfl

theorem twoPowerToGeometric_injective (ell : ℚ) (a : ℕ) :
    Function.Injective (twoPowerToGeometric ell a) := fun _ _ h => Subtype.ext h

theorem twoPowerToGeometric_galois (ell : ℚ) (a : ℕ) (sigma : GaloisGroup)
    (P : twoPowerTorsion ell a) :
    twoPowerToGeometric ell a (sigma • P) = sigma • twoPowerToGeometric ell a P := rfl

/-- The actual union included in the same geometric point group. -/
def twoPrimaryToGeometric (ell : ℚ) : twoPrimaryTorsion ell →+ GeometricPoints ell where
  toFun P := P
  map_zero' := rfl
  map_add' _ _ := rfl

theorem twoPrimaryToGeometric_injective (ell : ℚ) :
    Function.Injective (twoPrimaryToGeometric ell) := fun _ _ h => Subtype.ext h

theorem twoPrimaryToGeometric_galois (ell : ℚ) (sigma : GaloisGroup)
    (P : twoPrimaryTorsion ell) :
    twoPrimaryToGeometric ell (sigma • P) = sigma • twoPrimaryToGeometric ell P := rfl

instance twoPowerTorsionContinuousIntSMul (ell : ℚ) (a : ℕ) :
    ContinuousSMul ℤ (twoPowerTorsion ell a) := ⟨continuous_of_discreteTopology⟩

instance twoPrimaryTorsionContinuousIntSMul (ell : ℚ) :
    ContinuousSMul ℤ (twoPrimaryTorsion ell) := ⟨continuous_of_discreteTopology⟩

/-- A discrete additive homomorphism, with its canonical integer-linear structure. -/
private def continuousIntMap {V W : Type*} [AddCommGroup V] [AddCommGroup W]
    [TopologicalSpace V] [TopologicalSpace W] [DiscreteTopology V] (f : V →+ W) :
    V →L[ℤ] W where
  __ := f.toIntLinearMap
  cont := continuous_of_discreteTopology

private def actionAddHom (V : Type*) [AddCommGroup V]
    [DistribMulAction GaloisGroup V] (sigma : GaloisGroup) : V →+ V where
  toFun P := sigma • P
  map_zero' := smul_zero sigma
  map_add' := smul_add sigma

/-- Packaging the actual discrete additive action as integer-linear continuous operators. -/
private def discreteActionRepresentation (V : Type*) [AddCommGroup V]
    [TopologicalSpace V] [DiscreteTopology V] [DistribMulAction GaloisGroup V] :
    ContRepresentation ℤ GaloisGroup V where
  toMonoidHom.toFun sigma := continuousIntMap (actionAddHom V sigma)
  toMonoidHom.map_one' := by ext P; exact one_smul GaloisGroup P
  toMonoidHom.map_mul' sigma tau := by ext P; exact mul_smul sigma tau P

/-- Geometric elliptic coefficients; the guard is only the actual nonzero curve parameter. -/
def geometricTopRep (ell : ℚ) (hell : ell ≠ 0) : TopRep ℤ GaloisGroup := by
  letI : (ZInQ.Manuscript.curve ell).IsElliptic := manuscriptCurve_isElliptic hell
  exact TopRep.of (discreteActionRepresentation (GeometricPoints ell))

/-- Actual finite torsion coefficients, not an assumed rank-two representation. -/
def twoPowerTopRep (ell : ℚ) (hell : ell ≠ 0) (a : ℕ) : TopRep ℤ GaloisGroup := by
  letI : (ZInQ.Manuscript.curve ell).IsElliptic := manuscriptCurve_isElliptic hell
  exact TopRep.of (discreteActionRepresentation (twoPowerTorsion ell a))

/-- The actual discrete two-primary union as integer-linear Galois coefficients. -/
def twoPrimaryTopRep (ell : ℚ) (hell : ell ≠ 0) : TopRep ℤ GaloisGroup := by
  letI : (ZInQ.Manuscript.curve ell).IsElliptic := manuscriptCurve_isElliptic hell
  exact TopRep.of (discreteActionRepresentation (twoPrimaryTorsion ell))

@[simp] theorem geometricTopRep_carrier (ell : ℚ) (hell : ell ≠ 0) :
    (geometricTopRep ell hell).V = GeometricPoints ell := rfl

@[simp] theorem twoPowerTopRep_carrier (ell : ℚ) (hell : ell ≠ 0) (a : ℕ) :
    (twoPowerTopRep ell hell a).V = twoPowerTorsion ell a := rfl

@[simp] theorem twoPrimaryTopRep_carrier (ell : ℚ) (hell : ell ≠ 0) :
    (twoPrimaryTopRep ell hell).V = twoPrimaryTorsion ell := rfl

/-- The packaged geometric operator is still the actual point-map operator. -/
@[simp] theorem geometricTopRep_operator (ell : ℚ) (hell : ell ≠ 0)
    (sigma : GaloisGroup) (P : GeometricPoints ell) :
    (geometricTopRep ell hell).ρ sigma P = geometricPointMap ell sigma P := rfl

@[simp] theorem twoPowerTopRep_operator_coe (ell : ℚ) (hell : ell ≠ 0) (a : ℕ)
    (sigma : GaloisGroup) (P : twoPowerTorsion ell a) :
    ((fun Q : twoPowerTorsion ell a => (Q : GeometricPoints ell))
      ((twoPowerTopRep ell hell a).ρ sigma P)) =
      geometricPointMap ell sigma (P : GeometricPoints ell) := rfl

@[simp] theorem twoPrimaryTopRep_operator_coe (ell : ℚ) (hell : ell ≠ 0)
    (sigma : GaloisGroup) (P : twoPrimaryTorsion ell) :
    ((fun Q : twoPrimaryTorsion ell => (Q : GeometricPoints ell))
      ((twoPrimaryTopRep ell hell).ρ sigma P)) =
      geometricPointMap ell sigma (P : GeometricPoints ell) := rfl

/-- Finite-level inclusions are actual continuous equivariant coefficient morphisms. -/
def twoPowerInclusionHom (ell : ℚ) (hell : ell ≠ 0) {a b : ℕ} (hab : a ≤ b) :
    twoPowerTopRep ell hell a ⟶ twoPowerTopRep ell hell b :=
  TopRep.ofHom
    { __ := continuousIntMap (twoPowerInclusion ell hab)
      isIntertwining' sigma := by
        ext P
        exact congrArg (fun Q : twoPowerTorsion ell b => (Q : GeometricPoints ell))
          (twoPowerInclusion_galois ell hab sigma P) }

/-- The actual doubling transitions are continuous equivariant coefficient morphisms. -/
def twoPowerTransitionHom (ell : ℚ) (hell : ell ≠ 0) (a : ℕ) :
    twoPowerTopRep ell hell (a + 1) ⟶ twoPowerTopRep ell hell a :=
  TopRep.ofHom
    { __ := continuousIntMap (twoPowerTransition ell a)
      isIntertwining' sigma := by
        ext P
        exact congrArg (fun Q : twoPowerTorsion ell a => (Q : GeometricPoints ell))
          (twoPowerTransition_galois ell a sigma P) }

/-- Each finite-level inclusion into the union is an actual coefficient morphism. -/
def twoPowerToPrimaryHom (ell : ℚ) (hell : ell ≠ 0) (a : ℕ) :
    twoPowerTopRep ell hell a ⟶ twoPrimaryTopRep ell hell :=
  TopRep.ofHom
    { __ := continuousIntMap (twoPowerToPrimary ell a)
      isIntertwining' sigma := by
        ext P
        exact congrArg (fun Q : twoPrimaryTorsion ell => (Q : GeometricPoints ell))
          (twoPowerToPrimary_galois ell a sigma P) }

/-- The finite-kernel inclusion into geometric coefficients is an actual coefficient morphism. -/
def twoPowerToGeometricHom (ell : ℚ) (hell : ell ≠ 0) (a : ℕ) :
    twoPowerTopRep ell hell a ⟶ geometricTopRep ell hell :=
  TopRep.ofHom
    { __ := continuousIntMap (twoPowerToGeometric ell a)
      isIntertwining' sigma := by
        ext P
        exact twoPowerToGeometric_galois ell a sigma P }

/-- The union inclusion into geometric coefficients is an actual coefficient morphism. -/
def twoPrimaryToGeometricHom (ell : ℚ) (hell : ell ≠ 0) :
    twoPrimaryTopRep ell hell ⟶ geometricTopRep ell hell :=
  TopRep.ofHom
    { __ := continuousIntMap (twoPrimaryToGeometric ell)
      isIntertwining' sigma := by
        ext P
        exact twoPrimaryToGeometric_galois ell sigma P }

/-- Actual geometric multiplication, without a surjectivity or cardinality assertion. -/
def geometricMultiplicationHom (ell : ℚ) (hell : ell ≠ 0) (n : ℕ) :
    geometricTopRep ell hell ⟶ geometricTopRep ell hell :=
  TopRep.ofHom
    { __ := continuousIntMap (nsmulAddMonoidHom (α := GeometricPoints ell) n)
      isIntertwining' sigma := by
        ext P
        change n • geometricPointMap ell sigma P = geometricPointMap ell sigma (n • P)
        exact (map_nsmul (geometricPointMap ell sigma) _ _).symm }

/-- Doubling on the union is an actual continuous equivariant coefficient morphism. -/
def twoPrimaryDoublingHom (ell : ℚ) (hell : ell ≠ 0) :
    twoPrimaryTopRep ell hell ⟶ twoPrimaryTopRep ell hell :=
  TopRep.ofHom
    { __ := continuousIntMap (twoPrimaryDoubling ell)
      isIntertwining' sigma := by
        ext P
        exact congrArg (fun Q : twoPrimaryTorsion ell => (Q : GeometricPoints ell))
          (twoPrimaryDoubling_galois ell sigma P) }

/-!
`TopRep` stores continuous individual operators, not joint continuity in the
Galois variable. The following interfaces retain the proved joint continuity
and open stabilizers for the literal packaged operators. No Galois action
instance on an arbitrary `TopRep` carrier is assumed.
-/

/-- The packaged geometric coefficient operator is jointly continuous. -/
theorem geometricTopRep_continuous_action (ell : ℚ) (hell : ell ≠ 0) :
    Continuous fun p : GaloisGroup × (geometricTopRep ell hell).V =>
      ((geometricTopRep ell hell).ρ p.1) p.2 := by
  change Continuous fun p : GaloisGroup × GeometricPoints ell => p.1 • p.2
  exact continuous_smul

/-- The packaged finite torsion coefficient operator is jointly continuous. -/
theorem twoPowerTopRep_continuous_action (ell : ℚ) (hell : ell ≠ 0) (a : ℕ) :
    Continuous fun p : GaloisGroup × (twoPowerTopRep ell hell a).V =>
      ((twoPowerTopRep ell hell a).ρ p.1) p.2 := by
  change Continuous fun p : GaloisGroup × twoPowerTorsion ell a => p.1 • p.2
  exact continuous_smul

/-- The packaged two-primary union coefficient operator is jointly continuous. -/
theorem twoPrimaryTopRep_continuous_action (ell : ℚ) (hell : ell ≠ 0) :
    Continuous fun p : GaloisGroup × (twoPrimaryTopRep ell hell).V =>
      ((twoPrimaryTopRep ell hell).ρ p.1) p.2 := by
  change Continuous fun p : GaloisGroup × twoPrimaryTorsion ell => p.1 • p.2
  exact continuous_smul

/-- Stabilizers of the literal packaged geometric coefficient operators are open. -/
theorem geometricTopRep_operator_stabilizer_isOpen (ell : ℚ) (hell : ell ≠ 0)
    (P : (geometricTopRep ell hell).V) :
    IsOpen {sigma : GaloisGroup | ((geometricTopRep ell hell).ρ sigma) P = P} := by
  exact geometricPoint_stabilizer_isOpen ell P

/-- Stabilizers of the literal packaged finite torsion operators are open. -/
theorem twoPowerTopRep_operator_stabilizer_isOpen (ell : ℚ) (hell : ell ≠ 0) (a : ℕ)
    (P : (twoPowerTopRep ell hell a).V) :
    IsOpen {sigma : GaloisGroup | ((twoPowerTopRep ell hell a).ρ sigma) P = P} := by
  exact stabilizer_isOpen GaloisGroup (X := twoPowerTorsion ell a) P

/-- Stabilizers of the literal packaged two-primary union operators are open. -/
theorem twoPrimaryTopRep_operator_stabilizer_isOpen (ell : ℚ) (hell : ell ≠ 0)
    (P : (twoPrimaryTopRep ell hell).V) :
    IsOpen {sigma : GaloisGroup | ((twoPrimaryTopRep ell hell).ρ sigma) P = P} := by
  exact stabilizer_isOpen GaloisGroup (X := twoPrimaryTorsion ell) P

end ZInQ.Contrib.OneProof.ManuscriptPole.GaloisCoefficients
