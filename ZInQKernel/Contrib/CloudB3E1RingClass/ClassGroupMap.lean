import ZInQKernel.Contrib.CloudB3E1RingClass.Decomposition

/-!
# Stage 4 of the ring-class realization: the map `Gal(H_f/K) → Cl(K)` and the classes of primes

Manuscript `diophantine_zq.tex`, tex 3566–3576 (the map `π : Pic(ℤ + r𝒪_K) → Cl(K)` and
`π(q_j) = [𝔭_j]`, [Cox, Prop. 7.22]).

* `classOfIdeal J`: the ideal class in `Cl(K)` of an ideal `J` of `𝒪_K` prime to the conductor
  (its ray class with the modulus forgotten, `rayClassToClassGroup`).
* `picToClassGroup O : Pic O →* Cl(K)`: extension of invertible ideals from the order to `𝒪_K`,
  built as the descent of `Cl_𝔣 → Cl(K)` through the surjection `Cl_𝔣 → Pic O`. An ideal generated
  by an element of `O` is principal in `𝒪_K` (`picToClassGroup_picClass`: the Picard class of
  `J ∩ O` maps to the class of `J`).
* `galToClassGroup f S hS : Gal(H_f/K) →* Cl(K)` through `Pic(ℤ + f𝒪_K) ≃ Gal(H_f/K)`.
  `galToClassGroup_artinClass`: the Artin class of `J` maps to the class of `J` (the interface's
  `π_q`).
* `galToClassGroup_surjective`.

Kinds: definitions and PROVED.
-/

noncomputable section

namespace ZInQ.Contrib.CloudB3E1RingClass

open NumberField IsDedekindDomain
open scoped nonZeroDivisors
open TauCeti TauCeti.GlobalNumberFields TauCeti.GlobalNumberFields.NumberFieldOrder
  TauCeti.ClassFieldTheory

variable {K : Type} [Field K] [NumberField K]

/-- **The ideal class of an ideal prime to a modulus**: its ray class with the modulus forgotten.
Kind: definition. -/
def classOfIdeal {m : Modulus K} (J : integralIdealsPrimeTo m) : ClassGroup (𝓞 K) :=
  rayClassToClassGroup m (idealClass m J)

/-- An ideal generated by a single element has trivial class. Kind: PROVED. -/
theorem classOfIdeal_eq_one_of_eq_span {m : Modulus K} (J : integralIdealsPrimeTo m) (β : 𝓞 K)
    (hJ : (J : Ideal (𝓞 K)) = Ideal.span {β}) : classOfIdeal J = 1 := by
  rw [classOfIdeal, idealClass_apply, rayClassToClassGroup_rayClassMk, ClassGroup.mk_eq_one_iff,
    NumberFieldArithmetic.coe_integralIdealsAwayHom]
  change ((((J : Ideal (𝓞 K)) : FractionalIdeal (𝓞 K)⁰ K)) : Submodule (𝓞 K) K).IsPrincipal
  rw [hJ, FractionalIdeal.coeIdeal_span_singleton, FractionalIdeal.coe_spanSingleton]
  exact ⟨⟨_, rfl⟩⟩

variable (O : NumberFieldOrder K)

theorem ker_rayClassToPic_le :
    O.rayClassToPic.ker ≤ (rayClassToClassGroup O.conductorModulus).ker := by
  intro c hc
  obtain ⟨J, rfl, β, -, hJ⟩ := O.mem_ker_rayClassToPic.mp hc
  exact classOfIdeal_eq_one_of_eq_span J β hJ

/-- **`Pic O → Cl(K)`**, extension of ideals from `O` to `𝒪_K`. Kind: definition. -/
def picToClassGroup : Pic O →* ClassGroup (𝓞 K) :=
  O.rayClassToPic.liftOfSurjective O.rayClassToPic_surjective
    ⟨rayClassToClassGroup O.conductorModulus, ker_rayClassToPic_le O⟩

/-- The Picard class of `J ∩ O` maps to the class of `J`. Kind: PROVED. -/
theorem picToClassGroup_picClass (J : integralIdealsPrimeTo O.conductorModulus) :
    picToClassGroup O (O.picClass J) = classOfIdeal J := by
  rw [← rayClassToPic_idealClass]
  exact MonoidHom.liftOfRightInverse_comp_apply _ _ _ ⟨_, ker_rayClassToPic_le O⟩ _

theorem picToClassGroup_surjective : Function.Surjective (picToClassGroup O) := by
  intro c
  obtain ⟨x, rfl⟩ := rayClassToClassGroup_surjective O.conductorModulus c
  exact ⟨O.rayClassToPic x,
    MonoidHom.liftOfRightInverse_comp_apply _ _ _ ⟨_, ker_rayClassToPic_le O⟩ _⟩

variable (f : ℕ) (hf : f ≠ 0) (S : Set (HeightOneSpectrum (𝓞 K)))
  (hS : ∀ v : HeightOneSpectrum (𝓞 K), (f : 𝓞 K) ∈ v.asIdeal → v ∈ S)

/-- **`π : Gal(H_f/K) → Cl(K)`** (tex 3566–3575) through `Pic(ℤ + f𝒪_K) ≃ Gal(H_f/K)`.
Kind: definition. -/
def galToClassGroup : ringClassGal f hf S hS →* ClassGroup (𝓞 K) :=
  (picToClassGroup (ringClassOrder (K := K) f hf)).comp
    (ringClassPicEquiv f hf S hS).symm.toMonoidHom

/-- **`π(Art(J)) = [J]`** (tex 3575–3576, the interface's `π_q`). Kind: PROVED. -/
theorem galToClassGroup_artinClass
    (J : integralIdealsPrimeTo (ringClassOrder (K := K) f hf).conductorModulus) :
    galToClassGroup f hf S hS (artinClass f hf S hS J) = classOfIdeal J := by
  rw [galToClassGroup, artinClass, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
    MulEquiv.symm_apply_apply, picToClassGroup_picClass]

theorem galToClassGroup_surjective : Function.Surjective (galToClassGroup f hf S hS) := by
  intro c
  obtain ⟨x, rfl⟩ := picToClassGroup_surjective (ringClassOrder (K := K) f hf) c
  exact ⟨ringClassPicEquiv f hf S hS x, by
    rw [galToClassGroup, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
      MulEquiv.symm_apply_apply]⟩

end ZInQ.Contrib.CloudB3E1RingClass
