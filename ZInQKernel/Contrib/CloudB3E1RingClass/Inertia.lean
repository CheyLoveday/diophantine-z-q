import ZInQKernel.Contrib.CloudB3E1RingClass.InertiaSplit

/-!
# The inertia group of the ring class field `H_r` at a split prime `r`

Manuscript `diophantine_zq.tex`, tex 3679–3681: "the inertia group of `H_r/K` at `r` is the image
of `(𝒪_K/r)^×`, i.e. the kernel of `Gal(H_r/K) → Cl(K)`".

Let `K` be a quadratic field, `r` a rational prime with `r𝒪_K = 𝔯 𝔯'`, `𝔯 ≠ 𝔯'`, and `S` a set of
places containing the primes over `r`. For `v ∈ {𝔯, 𝔯'}` (equivalently, any place over `r`):

* **`inertiaGal_eq_ker_galToClassGroup`** (PROVED): the genuine inertia group `inertiaGal r S v`
  (the image of the local inertia group at `v` in `Gal(H_r/K)`) is the kernel of
  `galToClassGroup : Gal(H_r/K) → Cl(K)`.
* **`inertiaGal_eq_range_galResidue`** (PROVED): equivalently, it is the image of the residue units
  `(𝒪_K/𝔣)^×` (`galResidue`), `𝔣` the conductor of `ℤ + r𝒪_K`.
* `inertiaGal_eq_ker_galToClassGroup_of_mem` (PROVED): the same for every place containing `r`.

Proof outline.
* `inertiaGal_eq_map_unitArtin` (`InertiaLocal.lean`): by local class field theory the local Artin
  map sends `𝒪_v^×` onto the image of inertia in `G_{K_v}^ab`; by local–global compatibility and
  `ringClassArtinEquiv_ringClassIdeleQuotient`, the inertia group is the image of the local units
  `u ∈ 𝒪_v^×` under `u ↦ Art([u at v])`.
* `inertiaGal_le_ker_galToClassGroup`: a local unit idele has trivial ideal class.
* `ker_galToClassGroup_le_inertiaGal` (`InertiaSplit.lean`): the kernel is the image of the residue
  units, i.e. of principal ray classes `[(x)]`, `x` prime to `r`. As an idele class, `[(x)]` is
  `(x⁻¹ at 𝔯, x⁻¹ at 𝔯')`. The unit at `𝔯'` moves to `𝔯`: approximate it by an integer `c` modulo
  `𝔯'` (residue degree one); the principal ideal `(c)` is generated by an element of `ℤ + r𝒪_K`,
  so `[c at 𝔯] [c at 𝔯'] = 1` in `Pic(ℤ + r𝒪_K)`. This is the manuscript's
  `(a, 1) ≡ (1, a⁻¹)` modulo the diagonal.

No hypothesis on the units of `𝒪_K` is needed.

Kinds: PROVED.
-/

noncomputable section

open NumberField IsDedekindDomain
open TauCeti TauCeti.GlobalNumberFields TauCeti.GlobalNumberFields.NumberFieldOrder
  TauCeti.ClassFieldTheory
open ZInQ.Manuscript.RC.SelmerComplex

namespace ZInQ.Contrib.CloudB3E1RingClass

variable {K : Type} [Field K] [NumberField K]

/-- **The inertia group of `H_r/K` at a split prime is the kernel of `Gal(H_r/K) → Cl(K)`**
(tex 3679–3681). For `K` quadratic, `r` prime with `r𝒪_K = 𝔯 𝔯'`, `𝔯 ≠ 𝔯'`, `S` containing the
primes over `r`, and `v ∈ {𝔯, 𝔯'}`. Kind: PROVED. -/
theorem inertiaGal_eq_ker_galToClassGroup (hK : Module.finrank ℚ K = 2) {r : ℕ} (hr : r.Prime)
    {𝔯 𝔯' : HeightOneSpectrum (𝓞 K)} (hne : 𝔯 ≠ 𝔯')
    (hsplit : Ideal.span {(r : 𝓞 K)} = 𝔯.asIdeal * 𝔯'.asIdeal)
    (S : Set (HeightOneSpectrum (𝓞 K)))
    (hS : ∀ v : HeightOneSpectrum (𝓞 K), (r : 𝓞 K) ∈ v.asIdeal → v ∈ S)
    {v : HeightOneSpectrum (𝓞 K)} (hv : v = 𝔯 ∨ v = 𝔯') :
    inertiaGal r hr.ne_zero S hS v = (galToClassGroup r hr.ne_zero S hS).ker := by
  refine le_antisymm (inertiaGal_le_ker_galToClassGroup r hr.ne_zero S hS v) ?_
  rcases hv with rfl | rfl
  · exact ker_galToClassGroup_le_inertiaGal hr hsplit hne hK S hS
  · exact ker_galToClassGroup_le_inertiaGal hr (𝔯 := v) (𝔯' := 𝔯)
      (by rw [hsplit, mul_comm]) hne.symm hK S hS

/-- **The inertia group at a split prime is the image of the residue units** (tex 3679–3681):
`inertiaGal r S v = galResidue((𝒪_K/𝔣)^×)`, `𝔣` the conductor of `ℤ + r𝒪_K`. Kind: PROVED. -/
theorem inertiaGal_eq_range_galResidue (hK : Module.finrank ℚ K = 2) {r : ℕ} (hr : r.Prime)
    {𝔯 𝔯' : HeightOneSpectrum (𝓞 K)} (hne : 𝔯 ≠ 𝔯')
    (hsplit : Ideal.span {(r : 𝓞 K)} = 𝔯.asIdeal * 𝔯'.asIdeal)
    (S : Set (HeightOneSpectrum (𝓞 K)))
    (hS : ∀ v : HeightOneSpectrum (𝓞 K), (r : 𝓞 K) ∈ v.asIdeal → v ∈ S)
    {v : HeightOneSpectrum (𝓞 K)} (hv : v = 𝔯 ∨ v = 𝔯') :
    inertiaGal r hr.ne_zero S hS v = (galResidue r hr.ne_zero S hS).range := by
  rw [inertiaGal_eq_ker_galToClassGroup hK hr hne hsplit S hS hv, ker_galToClassGroup]

/-- **The inertia group at any place over a split prime `r` is the kernel of
`Gal(H_r/K) → Cl(K)`** (tex 3679–3681). Kind: PROVED. -/
theorem inertiaGal_eq_ker_galToClassGroup_of_mem (hK : Module.finrank ℚ K = 2) {r : ℕ}
    (hr : r.Prime) {𝔯 𝔯' : HeightOneSpectrum (𝓞 K)} (hne : 𝔯 ≠ 𝔯')
    (hsplit : Ideal.span {(r : 𝓞 K)} = 𝔯.asIdeal * 𝔯'.asIdeal)
    (S : Set (HeightOneSpectrum (𝓞 K)))
    (hS : ∀ v : HeightOneSpectrum (𝓞 K), (r : 𝓞 K) ∈ v.asIdeal → v ∈ S)
    {v : HeightOneSpectrum (𝓞 K)} (hv : (r : 𝓞 K) ∈ v.asIdeal) :
    inertiaGal r hr.ne_zero S hS v = (galToClassGroup r hr.ne_zero S hS).ker :=
  inertiaGal_eq_ker_galToClassGroup hK hr hne hsplit S hS (eq_or_eq_of_natCast_mem hsplit v hv)

end ZInQ.Contrib.CloudB3E1RingClass
