import ZInQKernel.Contrib.CloudB3RC53.RankCounts.Genus.Setup

/-!
# Genus bound: the statements of the stages of Elliot's argument (tex 4494–4517)

For an imaginary quadratic field `K` with conjugation `σ = conjAut hK2`, acting on ideals of `𝒪_K`
by Mathlib's pointwise action of `Gal(K/ℚ)`:

* `PrimeTrichotomy`: each nonzero prime `P` of `𝒪_K` over the rational prime `p` is split
  (`σP ≠ P`, `P·σP = (p)`), inert (`σP = P = (p)`) or ramified (`σP = P`, `P² = (p)`);
* `MulConjRational`: for every nonzero ideal `I`, `I·σ(I)` is generated by a positive integer
  (so conjugation acts by inversion on the class group, tex 4497–4498);
* `InvariantRep`: every class of order dividing two is the class of a `σ`-invariant ideal
  (tex 4498–4504: `σa = (α)a`, `N α = 1`, Hilbert 90);
* `Ambiguous`: a `σ`-invariant nonzero ideal is an integer times a product of distinct ramified
  primes (tex 4504–4506);
* `RamRelation`: some nonempty product of distinct ramified primes is principal (the principal
  ideal of `√d`, tex 4507–4509).

`RamPrime K hK2 P` says `P` is a ramified prime: `P` prime, `σP = P`, `P² = (p)` for a rational
prime `p`. Kinds: definitions only.
-/

noncomputable section

open NumberField Pointwise
open scoped nonZeroDivisors

namespace ZInQ.Contrib.CloudB3RC53.RankCounts.Genus

variable (K : Type) [Field K] [NumberField K] (hK2 : Module.finrank ℚ K = 2)

/-- `P` is a ramified prime of `𝒪_K`: `P` prime, `σP = P` and `P² = (p)` for a rational prime `p`. -/
def RamPrime (P : Ideal (𝓞 K)) : Prop :=
  P.IsPrime ∧ conjAut hK2 • P = P ∧ ∃ p : ℕ, p.Prime ∧ P ^ 2 = Ideal.span {((p : ℤ) : 𝓞 K)}

/-- Split / inert / ramified (tex 4504–4506, 4516–4517). -/
def PrimeTrichotomy : Prop :=
  ∀ P : Ideal (𝓞 K), P.IsPrime → P ≠ ⊥ → ∃ p : ℕ, p.Prime ∧
    ((conjAut hK2 • P ≠ P ∧ P * conjAut hK2 • P = Ideal.span {((p : ℤ) : 𝓞 K)}) ∨
     (conjAut hK2 • P = P ∧ P = Ideal.span {((p : ℤ) : 𝓞 K)}) ∨
     (conjAut hK2 • P = P ∧ P ^ 2 = Ideal.span {((p : ℤ) : 𝓞 K)}))

/-- `I·σ(I) = (n)` with `n` a positive integer (tex 4497–4498: conjugation acts by inversion on
the class group). -/
def MulConjRational : Prop :=
  ∀ I : Ideal (𝓞 K), I ≠ ⊥ → ∃ n : ℕ, n ≠ 0 ∧ I * conjAut hK2 • I = Ideal.span {((n : ℤ) : 𝓞 K)}

/-- Every class of order dividing two is the class of a `σ`-invariant ideal (tex 4498–4504). -/
def InvariantRep : Prop :=
  ∀ c : ClassGroup (𝓞 K), c ^ 2 = 1 →
    ∃ (J : Ideal (𝓞 K)) (hJ : J ∈ (Ideal (𝓞 K))⁰), conjAut hK2 • J = J ∧ ClassGroup.mk0 ⟨J, hJ⟩ = c

/-- `σ`-invariant ideals are an integer times a product of distinct ramified primes
(tex 4504–4506). -/
def Ambiguous : Prop :=
  ∀ J : Ideal (𝓞 K), J ≠ ⊥ → conjAut hK2 • J = J →
    ∃ (n : ℕ) (R : Finset (Ideal (𝓞 K))), n ≠ 0 ∧ (∀ P ∈ R, RamPrime K hK2 P) ∧
      J = Ideal.span {((n : ℤ) : 𝓞 K)} * ∏ P ∈ R, P

/-- A nonempty product of distinct ramified primes is principal (tex 4507–4509). -/
def RamRelation : Prop :=
  ∃ (R : Finset (Ideal (𝓞 K))), R.Nonempty ∧ (∀ P ∈ R, RamPrime K hK2 P) ∧
    ∃ x : 𝓞 K, x ≠ 0 ∧ ∏ P ∈ R, P = Ideal.span {x}

end ZInQ.Contrib.CloudB3RC53.RankCounts.Genus
