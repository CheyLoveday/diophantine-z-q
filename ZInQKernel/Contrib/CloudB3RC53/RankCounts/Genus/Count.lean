import ZInQKernel.Contrib.CloudB3RC53.RankCounts.Genus.Statements
import ZInQKernel.Contrib.CloudB3RC53.RankCounts.QuadraticPlaces
import ZInQKernel.Contrib.TauCeti.Algebra.Group.ElementaryTwoQuotient.Basic
import ZInQKernel.Contrib.TauCeti.RingTheory.DedekindDomain.SInteger.ClassGroup
/-!
# Genus bound, stages 8–9 and assembly (tex 4494–4517)

Elliot's class-group inequality of (5.1b): for an imaginary quadratic field `K` with `r` ramified
rational primes, `dim_{𝔽₂} Cl(𝒪_{K,S_T})[2] ≤ r − 1`.

* Ramified primes `P` (`P² = (p)`) lie over rational primes ramified in `K` and are determined by
  them (`RamPrime.isRamifiedPrime`, `RamPrime.eq_of_sq_eq`), so `ramFin` has at most `r` elements.
* Stage 8 (`twoRank_add_one_le`, tex 4506–4509): every class of order dividing two is a product
  of ramified classes ("modulo rational principal ideals such ideals are generated by the ramified
  prime ideals. Their classes have exponent two"), one of which is a product of the others (the
  relation, "a nonempty relation among them"); hence the span has dimension at most `r − 1`.
* Stage 9 (`twoRank_integer_le`, tex 4515–4516): the `S`-class group is a quotient, so its 2-rank
  does not increase.
* `genus_bound_of`: the assembled bound from the stage statements.

The 2-rank is Tau Ceti's `twoRank` (`dim_{𝔽₂} G/G²`), equal to `dim_{𝔽₂} G[2]` for finite `G`
(`card_elementaryTwoQuotient_eq_card_twoTorsion`). Kinds: PROVED.
-/

open NumberField Pointwise
open scoped nonZeroDivisors
noncomputable section
namespace ZInQ.Contrib.CloudB3RC53.RankCounts.Genus
variable {K : Type} [Field K] [NumberField K] {hK2 : Module.finrank ℚ K = 2}

theorem RamPrime.ne_bot {P : Ideal (𝓞 K)} (h : RamPrime K hK2 P) : P ≠ ⊥ := by
  obtain ⟨-, -, p, hp, hP2⟩ := h
  rintro rfl
  have : Ideal.span {((p : ℤ) : 𝓞 K)} = ⊥ := by rw [← hP2]; simp
  rw [Ideal.span_singleton_eq_bot] at this
  have : ((p : ℤ) : 𝓞 K) ≠ 0 := by exact_mod_cast hp.ne_zero
  contradiction

theorem RamPrime.mem_primesAbove {P : Ideal (𝓞 K)} (h : RamPrime K hK2 P) {p : ℕ} (hp : p.Prime)
    (hP2 : P ^ 2 = Ideal.span {((p : ℤ) : 𝓞 K)}) : P ∈ primesAbove K p := by
  have hPp : P.IsPrime := h.1
  refine ⟨hPp, ?_⟩
  have hmem : ((p : ℤ) : 𝓞 K) ∈ P := by
    have : ((p : ℤ) : 𝓞 K) ∈ P ^ 2 := by rw [hP2]; exact Ideal.mem_span_singleton_self _
    exact Ideal.pow_le_self two_ne_zero this
  exact (Ideal.liesOver_span_iff hPp.ne_top (Nat.prime_iff_prime_int.mp hp)).mpr (by simpa using hmem)

theorem RamPrime.isRamifiedPrime {P : Ideal (𝓞 K)} (h : RamPrime K hK2 P) {p : ℕ} (hp : p.Prime)
    (hP2 : P ^ 2 = Ideal.span {((p : ℤ) : 𝓞 K)}) : IsRamifiedPrime K p := by
  have hmem := h.mem_primesAbove hp hP2
  refine ⟨P, hmem, ?_⟩
  have : P.IsPrime := h.1
  have : P.LiesOver (Ideal.span {(p : ℤ)}) := hmem.2
  have hmap : (Ideal.span {(p : ℤ)}).map (algebraMap ℤ (𝓞 K)) = P ^ 2 := by
    rw [Ideal.map_span, Set.image_singleton, hP2]; rfl
  have hne : (Ideal.span {(p : ℤ)}).map (algebraMap ℤ (𝓞 K)) ≠ ⊥ := by
    rw [hmap]; exact pow_ne_zero _ h.ne_bot
  rw [← Ideal.ramificationIdx'_eq_ramificationIdx' (p := Ideal.span {(p : ℤ)}) (q := P) hne]
  have hP3 : ¬ P ^ 2 ≤ P ^ 3 := by
    intro hle
    have hdvd : P ^ 3 ∣ P ^ 2 := Ideal.dvd_iff_le.mpr hle
    have := (pow_dvd_pow_iff (Ideal.prime_of_isPrime h.ne_bot h.1).ne_zero
      (Ideal.prime_of_isPrime h.ne_bot h.1).not_isUnit).mp hdvd
    omega
  rw [Ideal.ramificationIdx'_spec (n := 2) (by rw [hmap]) (by rw [hmap]; exact hP3)]

section Involutions
variable {G : Type*} [CommGroup G] [DecidableEq G]

theorem prod_mul_prod_of_sq {A : Finset G} (hA : ∀ a ∈ A, a ^ 2 = 1) (B C : Finset G)
    (hB : B ⊆ A) (_hC : C ⊆ A) :
    (∏ b ∈ B, b) * ∏ c ∈ C, c = ∏ d ∈ (B ∪ C) \ (B ∩ C), d := by
  have hsq : (∏ d ∈ B ∩ C, d) * ∏ d ∈ B ∩ C, d = 1 := by
    rw [← Finset.prod_mul_distrib]
    refine Finset.prod_eq_one fun d hd => ?_
    rw [← pow_two]; exact hA d (hB (Finset.mem_inter.mp hd).1)
  have h1 := Finset.prod_union_inter (s₁ := B) (s₂ := C) (f := fun d => d)
  have h2 := Finset.prod_sdiff (s₁ := B ∩ C) (s₂ := B ∪ C) (f := fun d => d)
    Finset.inter_subset_union
  apply mul_right_cancel (b := ∏ d ∈ B ∩ C, d)
  rw [h2, ← h1, mul_assoc, hsq, mul_one]

/-- A subgroup generated by `n` commuting involutions has at most `2ⁿ` elements: every element
is a product over a subset. -/
theorem mem_closure_iff_prod {A : Finset G} (hA : ∀ a ∈ A, a ^ 2 = 1) {g : G}
    (hg : g ∈ Subgroup.closure (A : Set G)) : ∃ B ⊆ A, g = ∏ b ∈ B, b := by
  induction hg using Subgroup.closure_induction with
  | mem x hx => exact ⟨{x}, by simpa using hx, by simp⟩
  | one => exact ⟨∅, Finset.empty_subset _, by simp⟩
  | mul x y _ _ hx hy =>
    obtain ⟨B, hB, rfl⟩ := hx
    obtain ⟨C, hC, rfl⟩ := hy
    refine ⟨(B ∪ C) \ (B ∩ C), ?_, prod_mul_prod_of_sq hA B C hB hC⟩
    intro d hd
    rcases Finset.mem_union.mp (Finset.mem_sdiff.mp hd).1 with h | h
    · exact hB h
    · exact hC h
  | inv x _ hx =>
    obtain ⟨B, hB, rfl⟩ := hx
    refine ⟨B, hB, ?_⟩
    rw [← Finset.prod_inv_distrib]
    refine Finset.prod_congr rfl fun d hd => ?_
    have := hA d (hB hd)
    rw [inv_eq_iff_mul_eq_one, ← pow_two, this]

end Involutions

section ClassCount
variable (K) (hK2)

/-- The class of a nonzero ideal (junk value `1` at `⊥`). -/
def cls (I : Ideal (𝓞 K)) : ClassGroup (𝓞 K) :=
  if h : I = ⊥ then 1 else ClassGroup.mk0 ⟨I, mem_nonZeroDivisors_of_ne_zero h⟩

variable {K}

theorem cls_of_ne_bot {I : Ideal (𝓞 K)} (h : I ≠ ⊥) :
    cls K I = ClassGroup.mk0 ⟨I, mem_nonZeroDivisors_of_ne_zero h⟩ := by simp [cls, h]

theorem cls_mul {I J : Ideal (𝓞 K)} (hI : I ≠ ⊥) (hJ : J ≠ ⊥) :
    cls K (I * J) = cls K I * cls K J := by
  rw [cls_of_ne_bot (mul_ne_zero hI hJ), cls_of_ne_bot hI, cls_of_ne_bot hJ, ← map_mul]
  rfl

theorem cls_span {x : 𝓞 K} (hx : x ≠ 0) : cls K (Ideal.span {x}) = 1 := by
  have h : Ideal.span {x} ≠ ⊥ := by simpa using hx
  rw [cls_of_ne_bot h, ClassGroup.mk0_eq_one_iff]
  exact ⟨⟨x, rfl⟩⟩

theorem cls_prod (R : Finset (Ideal (𝓞 K))) (hR : ∀ P ∈ R, P ≠ ⊥) :
    cls K (∏ P ∈ R, P) = ∏ P ∈ R, cls K P := by
  classical
  induction R using Finset.induction_on with
  | empty =>
    rw [Finset.prod_empty, Finset.prod_empty, Ideal.one_eq_top,
      cls_of_ne_bot (by simp), ClassGroup.mk0_eq_one_iff]
    exact ⟨⟨1, by simp⟩⟩
  | insert a R ha ih =>
    rw [Finset.prod_insert ha, Finset.prod_insert ha,
      cls_mul (hR a (Finset.mem_insert_self a R))
        (Finset.prod_ne_zero_iff.mpr fun P hP => hR P (Finset.mem_insert_of_mem hP)),
      ih fun P hP => hR P (Finset.mem_insert_of_mem hP)]

theorem RamPrime.cls_sq {P : Ideal (𝓞 K)} (h : RamPrime K hK2 P) : cls K P ^ 2 = 1 := by
  have h0 := h.ne_bot
  obtain ⟨-, -, p, hp, hP2⟩ := h
  rw [pow_two, ← cls_mul h0 h0, ← pow_two, hP2]
  exact cls_span (by exact_mod_cast hp.ne_zero)

/-- **Stage 8 (tex 4506–4509): the 2-rank of `Cl(𝒪_K)` is less than the number of ramified
primes.** From the invariant representatives, the ambiguous-ideal decomposition and the relation:
every class of order dividing two is a product of classes of ramified primes, one of which
(`P₀`, from the relation) is a product of the others; a group generated by `n` commuting
involutions has at most `2ⁿ` elements, and `|Cl/Cl²| = |Cl[2]|`. PROVED. -/
theorem twoRank_add_one_le (hInv : InvariantRep K hK2) (hAmb : Ambiguous K hK2)
    (hRel : RamRelation K hK2) (RamFin : Finset (Ideal (𝓞 K)))
    (hRF : ∀ P, RamPrime K hK2 P → P ∈ RamFin) (hRF' : ∀ P ∈ RamFin, RamPrime K hK2 P) :
    TauCeti.twoRank (ClassGroup (𝓞 K)) + 1 ≤ RamFin.card := by
  classical
  obtain ⟨R0, ⟨P0, hP0⟩, hR0, x, hx, hprod⟩ := hRel
  have hP0F : P0 ∈ RamFin := hRF P0 (hR0 P0 hP0)
  set A : Finset (ClassGroup (𝓞 K)) := (RamFin.erase P0).image (cls K) with hA
  have hAsq : ∀ a ∈ A, a ^ 2 = 1 := by
    intro a ha
    obtain ⟨P, hP, rfl⟩ := Finset.mem_image.mp ha
    exact (hRF' P (Finset.mem_of_mem_erase hP)).cls_sq
  -- every ramified class lies in the closure of `A`
  have hram : ∀ P ∈ RamFin, cls K P ∈ Subgroup.closure (A : Set (ClassGroup (𝓞 K))) := by
    intro P hP
    by_cases hPP : P = P0
    · subst hPP
      -- `[P₀] = ∏_{R₀ ∖ P₀} [P]`
      have hrel : ∏ Q ∈ R0, cls K Q = 1 := by
        rw [← cls_prod R0 (fun Q hQ => (hR0 Q hQ).ne_bot), hprod, cls_span hx]
      rw [← Finset.mul_prod_erase R0 _ hP0] at hrel
      have hP : cls K P = ∏ Q ∈ R0.erase P, cls K Q := by
        have h2 := (hR0 P hP0).cls_sq
        have hinvP : (cls K P)⁻¹ = cls K P := inv_eq_of_mul_eq_one_right (by rw [← pow_two, h2])
        rw [eq_inv_of_mul_eq_one_right hrel, hinvP]
      rw [hP]
      refine Subgroup.prod_mem _ fun Q hQ => Subgroup.subset_closure ?_
      exact Finset.mem_image.mpr ⟨Q, Finset.mem_erase.mpr ⟨Finset.ne_of_mem_erase hQ,
        hRF Q (hR0 Q (Finset.mem_of_mem_erase hQ))⟩, rfl⟩
    · exact Subgroup.subset_closure (Finset.mem_image.mpr ⟨P, Finset.mem_erase.mpr ⟨hPP, hP⟩, rfl⟩)
  -- every class of order dividing two lies in the closure of `A`
  have htors : ∀ c : ClassGroup (𝓞 K), c ^ 2 = 1 →
      c ∈ Subgroup.closure (A : Set (ClassGroup (𝓞 K))) := by
    intro c hc
    obtain ⟨J, hJ, hσ, rfl⟩ := hInv c hc
    have hJ0 : J ≠ ⊥ := nonZeroDivisors.coe_ne_zero ⟨J, hJ⟩
    obtain ⟨n, R, hn, hR, hJeq⟩ := hAmb J hJ0 hσ
    have hRne : ∀ P ∈ R, P ≠ ⊥ := fun P hP => (hR P hP).ne_bot
    have hspan : Ideal.span {((n : ℤ) : 𝓞 K)} ≠ ⊥ := by
      simpa using (show ((n : ℤ) : 𝓞 K) ≠ 0 by exact_mod_cast hn)
    have : ClassGroup.mk0 ⟨J, hJ⟩ = ∏ P ∈ R, cls K P := by
      rw [← cls_of_ne_bot hJ0, hJeq, cls_mul hspan (Finset.prod_ne_zero_iff.mpr hRne),
        cls_span (by exact_mod_cast hn), one_mul, cls_prod R hRne]
    rw [this]
    exact Subgroup.prod_mem _ fun P hP => hram P (hRF P (hR P hP))
  -- counting
  set X : Finset (ClassGroup (𝓞 K)) := A.powerset.image fun B => ∏ b ∈ B, b
  have hX : ∀ c : ClassGroup (𝓞 K), c ^ 2 = 1 → c ∈ X := by
    intro c hc
    obtain ⟨B, hB, hcB⟩ := mem_closure_iff_prod hAsq (htors c hc)
    exact Finset.mem_image.mpr ⟨B, Finset.mem_powerset.mpr hB, hcB.symm⟩
  have hcardT : Nat.card {g : ClassGroup (𝓞 K) // g ^ 2 = 1} ≤ 2 ^ A.card := by
    calc Nat.card {g : ClassGroup (𝓞 K) // g ^ 2 = 1} ≤ Nat.card X :=
          Nat.card_le_card_of_injective (fun g => ⟨g.1, hX g.1 g.2⟩) fun a b h => by
            simpa [Subtype.ext_iff] using h
      _ = X.card := Nat.card_eq_finsetCard X
      _ ≤ A.powerset.card := Finset.card_image_le
      _ = 2 ^ A.card := Finset.card_powerset A
  have hAcard : A.card ≤ RamFin.card - 1 := by
    calc A.card ≤ (RamFin.erase P0).card := Finset.card_image_le
      _ = RamFin.card - 1 := Finset.card_erase_of_mem hP0F
  have hE := TauCeti.card_elementaryTwoQuotient_eq_card_twoTorsion (G := ClassGroup (𝓞 K))
  have hE2 := TauCeti.card_elementaryTwoQuotient_eq_two_pow_twoRank (G := ClassGroup (𝓞 K))
  have hpow : 2 ^ TauCeti.twoRank (ClassGroup (𝓞 K)) ≤ 2 ^ (RamFin.card - 1) := by
    rw [← hE2, hE]
    exact hcardT.trans (Nat.pow_le_pow_right (by norm_num) hAcard)
  have := (Nat.pow_le_pow_iff_right (by norm_num : 1 < 2)).mp hpow
  have hpos : 1 ≤ RamFin.card := Finset.card_pos.mpr ⟨P0, hP0F⟩
  omega

end ClassCount

section Assembly
variable (K) (hK2)

/-- **Stage 9 (tex 4515–4516): the 2-rank of an `S`-class group is at most that of `Cl(𝒪_K)`**
("an `S`-class group is a quotient of the ordinary class group, and the two-rank of a quotient of
a finite abelian group cannot increase"). PROVED (Tau Ceti's extension of classes is surjective). -/
theorem twoRank_integer_le (S : Set (IsDedekindDomain.HeightOneSpectrum (𝓞 K))) :
    TauCeti.twoRank (ClassGroup (S.integer K)) ≤ TauCeti.twoRank (ClassGroup (𝓞 K)) :=
  TauCeti.twoRank_le_twoRank_of_surjective _ (IsDedekindDomain.integer_extendedHom_surjective K S)

theorem RamPrime.eq_of_sq_eq {P Q : Ideal (𝓞 K)} (hP : RamPrime K hK2 P) (hQ : RamPrime K hK2 Q)
    (h : P ^ 2 = Q ^ 2) : P = Q := by
  have hPp := Ideal.prime_of_isPrime hP.ne_bot hP.1
  have hdvd : P ∣ Q := hPp.dvd_of_dvd_pow (show P ∣ Q ^ 2 from h ▸ dvd_pow_self P two_ne_zero)
  have hQmax : Q.IsMaximal := hQ.1.isMaximal hQ.ne_bot
  exact (hQmax.eq_of_le hP.1.ne_top (Ideal.le_of_dvd hdvd)).symm

open Classical in
/-- The finite set of ramified primes of `𝒪_K` above the ramified rational primes. -/
def ramFin (k : ℤ) : Finset (Ideal (𝓞 K)) :=
  ((ramifiedPrimes K k).biUnion fun p => (primesAbove_finite (K := K) p).toFinset).filter
    (RamPrime K hK2)

theorem mem_ramFin {k : ℤ} {α : 𝓞 K} (hα : IsQuadraticRadicand K k α) {P : Ideal (𝓞 K)}
    (hP : RamPrime K hK2 P) : P ∈ ramFin K hK2 k := by
  classical
  obtain ⟨-, -, p, hp, hP2⟩ := id hP
  refine Finset.mem_filter.mpr ⟨Finset.mem_biUnion.mpr ⟨p, ?_, ?_⟩, hP⟩
  · exact (ramifiedPrimesSpec_proof K k α hα p).mpr (hP.isRamifiedPrime hp hP2)
  · exact (primesAbove_finite p).mem_toFinset.mpr (hP.mem_primesAbove hp hP2)

theorem card_ramFin_le (k : ℤ) {α : 𝓞 K} (hα : IsQuadraticRadicand K k α) :
    (ramFin K hK2 k).card ≤ (ramifiedPrimes K k).card := by
  classical
  let f : Ideal (𝓞 K) → ℕ := fun P => if h : RamPrime K hK2 P then h.2.2.choose else 0
  have hf : ∀ P (h : RamPrime K hK2 P), f P = h.2.2.choose := fun P h => by simp [f, h]
  refine Finset.card_le_card_of_injOn f (fun P hP => ?_) (fun P hP Q hQ hPQ => ?_)
  · have h := (Finset.mem_filter.mp hP).2
    rw [hf P h]
    exact (ramifiedPrimesSpec_proof K k α hα _).mpr
      (h.isRamifiedPrime h.2.2.choose_spec.1 h.2.2.choose_spec.2)
  · have hP' := (Finset.mem_filter.mp (Finset.mem_coe.mp hP)).2
    have hQ' := (Finset.mem_filter.mp (Finset.mem_coe.mp hQ)).2
    rw [hf P hP', hf Q hQ'] at hPQ
    refine RamPrime.eq_of_sq_eq K hK2 hP' hQ' ?_
    rw [hP'.2.2.choose_spec.2, hQ'.2.2.choose_spec.2, hPQ]

open Classical in
/-- **Elliot's genus bound, assembled** (tex 4494–4517): for an imaginary quadratic field
`K = ℚ(√k)` and any set `S` of primes, `dim_{𝔽₂} Cl(𝒪_{K,S})[2] ≤ r − 1` with `r` the number of
rational primes ramified in `K`; the 2-rank is Tau Ceti's `twoRank` (`dim Cl/Cl²`, equal to
`dim Cl[2]` for the finite class group). From the stage statements. PROVED. -/
theorem genus_bound_of (hInv : InvariantRep K hK2) (hAmb : Ambiguous K hK2)
    (hRel : RamRelation K hK2) {k : ℤ} {α : 𝓞 K} (hα : IsQuadraticRadicand K k α)
    (S : Set (IsDedekindDomain.HeightOneSpectrum (𝓞 K))) :
    TauCeti.twoRank (ClassGroup (S.integer K)) + 1 ≤ (ramifiedPrimes K k).card :=
  ((Nat.add_le_add_right (twoRank_integer_le K S) 1).trans
    (twoRank_add_one_le hK2 hInv hAmb hRel (ramFin K hK2 k) (fun _ hP => mem_ramFin K hK2 hα hP)
      (fun _ hP => (Finset.mem_filter.mp hP).2))).trans (card_ramFin_le K hK2 k hα)

end Assembly
end ZInQ.Contrib.CloudB3RC53.RankCounts.Genus
