import ZInQKernel.Contrib.CloudB3RC53.RankCounts.Genus.Statements

/-!
# Genus bound, stage 1: split, inert and ramified primes; conjugation inverts ideal classes

Manuscript `diophantine_zq.tex`, proof of Lemma `ex:limits-residual-bound`, tex 4494–4517. For a
quadratic field `K` with conjugation `σ`:

* `primeTrichotomy_proof : PrimeTrichotomy K hK2`: every nonzero prime `P` of `𝒪_K` over the
  rational prime `p` is split (`σP ≠ P`, `P·σP = (p)`), inert (`σP = P = (p)`) or ramified
  (`σP = P`, `P² = (p)`). Proof by ideal norms: `N(p𝒪_K) = p²`, `N(P) = p^f`, an inclusion of
  ideals of equal norm is an equality, and the primes over `p` are `P` and `σP` (transitivity of the
  Galois action, Mathlib).
* `mulConjRational_proof : MulConjRational K hK2`: `I·σ(I)` is generated by a positive integer
  for every nonzero ideal `I` (by unique factorization, from the trichotomy); this is the
  statement that conjugation acts by inversion on the ideal class group (tex 4497–4498).

Kinds: PROVED.
-/

noncomputable section

open NumberField Pointwise

namespace ZInQ.Contrib.CloudB3RC53.RankCounts.Genus

variable {K : Type} [Field K] [NumberField K]

/-- `N(n𝒪_K) = n²` for a quadratic field. -/
theorem absNorm_span_natCast (hK2 : Module.finrank ℚ K = 2) (n : ℕ) :
    Ideal.absNorm (Ideal.span {((n : ℤ) : 𝓞 K)}) = n ^ 2 := by
  rw [Ideal.absNorm_span_singleton]
  have : ((n : ℤ) : 𝓞 K) = algebraMap ℤ (𝓞 K) n := (algebraMap_int_eq (𝓞 K) ▸ rfl)
  rw [this, Algebra.norm_algebraMap, RingOfIntegers.rank, hK2]
  simp [Int.natAbs_pow]

theorem nat_eq_one_of_mul_eq_self {a b : ℕ} (ha : 0 < a) (h : a * b = a) : b = 1 :=
  Nat.eq_of_mul_eq_mul_left ha (by rw [mul_one]; exact h)

/-- An inclusion of nonzero ideals of equal norm is an equality. -/
theorem eq_of_le_of_absNorm_eq {I J : Ideal (𝓞 K)} (h : I ≤ J) (hI : I ≠ ⊥)
    (hn : Ideal.absNorm I = Ideal.absNorm J) : I = J := by
  obtain ⟨Q, hQ⟩ := Ideal.dvd_iff_le.mpr h
  have hI0 : Ideal.absNorm I ≠ 0 := by rwa [Ne, Ideal.absNorm_eq_zero_iff]
  have hmul : Ideal.absNorm I = Ideal.absNorm J * Ideal.absNorm Q := by rw [hQ, map_mul]
  have hQ1 : Ideal.absNorm Q = 1 := by
    rw [hn] at hmul hI0
    exact nat_eq_one_of_mul_eq_self (Nat.pos_of_ne_zero hI0) hmul.symm
  rw [Ideal.absNorm_eq_one_iff] at hQ1
  rw [hQ, hQ1, Ideal.mul_top]

/-- A nonzero prime of `𝒪_K` contains a rational prime. -/
theorem exists_prime_mem (P : Ideal (𝓞 K)) [P.IsPrime] (hP : P ≠ ⊥) :
    ∃ n : ℕ, n.Prime ∧ ((n : ℤ) : 𝓞 K) ∈ P := by
  have hmax : P.IsMaximal := Ideal.IsPrime.isMaximal inferInstance hP
  obtain ⟨p, hp⟩ := IsPrincipalIdealRing.principal (P.under ℤ)
  have hp' : P.under ℤ = Ideal.span {p} := hp
  have hp0 : p ≠ 0 := by
    rintro rfl
    have hb : P.under ℤ = ⊥ := by rw [hp']; simp
    exact Ideal.IsMaximal.ne_bot_of_isIntegral_int P (Ideal.eq_bot_of_under_eq_bot hb)
  have hpr : Prime p := by
    rw [← Ideal.span_singleton_prime hp0, ← hp']; infer_instance
  refine ⟨p.natAbs, Int.prime_iff_natAbs_prime.mp hpr, ?_⟩
  have hmem : p ∈ P.under ℤ := by rw [hp']; exact Ideal.mem_span_singleton_self p
  have hmem' : (p : 𝓞 K) ∈ P := by simpa [Ideal.under, Ideal.mem_comap] using hmem
  rcases Int.natAbs_eq p with h | h
  · rw [← h]; exact hmem'
  · have : ((p.natAbs : ℤ) : 𝓞 K) = -(p : 𝓞 K) := by
      rw [show (p.natAbs : ℤ) = -p by omega]; push_cast; ring
    rw [this]; exact P.neg_mem hmem'

omit [NumberField K] in
/-- A prime of `𝒪_K` containing the rational prime `n` lies over `n`. -/
theorem liesOver_of_mem (Q : Ideal (𝓞 K)) [Q.IsPrime] {n : ℕ} (hn : n.Prime)
    (h : ((n : ℤ) : 𝓞 K) ∈ Q) : Q.LiesOver (Ideal.span {(n : ℤ)}) :=
  (Ideal.liesOver_span_iff Ideal.IsPrime.ne_top' (Nat.prime_iff_prime_int.mp hn)).mpr
    (by simpa using h)

/-- The norm of a nonzero prime over `n` is a positive power of `n`. -/
theorem absNorm_prime_eq_pow (Q : Ideal (𝓞 K)) [Q.IsPrime] {n : ℕ} (hn : n.Prime)
    (h : ((n : ℤ) : 𝓞 K) ∈ Q) : ∃ f, 1 ≤ f ∧ Ideal.absNorm Q = n ^ f := by
  have := liesOver_of_mem Q hn h
  refine ⟨Q.inertiaDeg ℤ, Ideal.inertiaDeg_pos Q ℤ, ?_⟩
  rw [← Ideal.natAbs_pow_inertiaDeg (n : ℤ) Q]
  simp

/-- `σ` fixes the rational integers. -/
theorem conjAut_smul_intCast (hK2 : Module.finrank ℚ K = 2) (z : ℤ) :
    conjAut hK2 • (z : 𝓞 K) = (z : 𝓞 K) := by
  rw [show (z : 𝓞 K) = algebraMap ℤ (𝓞 K) z from (algebraMap_int_eq (𝓞 K) ▸ rfl)]
  exact smul_algebraMap _ _

/-- Two nonzero primes of `𝒪_K` containing the same rational prime are equal or conjugate. -/
theorem eq_or_eq_conj (hK2 : Module.finrank ℚ K = 2) (P Q : Ideal (𝓞 K)) [P.IsPrime] [Q.IsPrime]
    {n : ℕ} (hn : n.Prime) (hP : ((n : ℤ) : 𝓞 K) ∈ P) (hQ : ((n : ℤ) : 𝓞 K) ∈ Q) :
    Q = P ∨ Q = conjAut hK2 • P := by
  have := isGalois_of_finrank_two hK2
  have := IsGaloisGroup.of_isFractionRing Gal(K/ℚ) ℤ (𝓞 K) ℚ K
  have := liesOver_of_mem P hn hP
  have := liesOver_of_mem Q hn hQ
  obtain ⟨g, hg⟩ := Ideal.exists_smul_eq_of_isGaloisGroup (Ideal.span {(n : ℤ)}) P Q Gal(K/ℚ)
  rcases eq_one_or_eq_conjAut hK2 g with rfl | rfl
  · left; rw [← hg, one_smul]
  · right; exact hg.symm

/-- The ramified case: `σP = P` and `N(P) = p` give `P² = (p)`. -/
theorem sq_eq_of_ramified (hK2 : Module.finrank ℚ K = 2) (P : Ideal (𝓞 K)) [P.IsPrime]
    {n : ℕ} (hn : n.Prime) (hnP : ((n : ℤ) : 𝓞 K) ∈ P) (hs : conjAut hK2 • P = P)
    (hfP : Ideal.absNorm P = n) : P ^ 2 = Ideal.span {((n : ℤ) : 𝓞 K)} := by
  have hI0P : Ideal.span {((n : ℤ) : 𝓞 K)} ≤ P := (Ideal.span_singleton_le_iff_mem _).mpr hnP
  obtain ⟨Q, hQ⟩ := Ideal.dvd_iff_le.mpr hI0P
  have hQn : Ideal.absNorm Q = n := by
    have h1 := congrArg Ideal.absNorm hQ
    rw [map_mul, absNorm_span_natCast hK2, hfP, sq] at h1
    exact (Nat.eq_of_mul_eq_mul_left hn.pos h1).symm
  have hQtop : Q ≠ ⊤ := by
    intro h; rw [h, Ideal.absNorm_top] at hQn; exact hn.one_lt.ne hQn
  obtain ⟨M, hM, hQM⟩ := Ideal.exists_le_maximal Q hQtop
  have hmem : ((n : ℤ) : 𝓞 K) ∈ P * Q := by
    rw [← hQ]; exact Ideal.mem_span_singleton_self _
  have hQmem : ((n : ℤ) : 𝓞 K) ∈ Q := Ideal.mul_le_left (I := Q) (J := P) (by rwa [mul_comm] at hmem)
  have hnM : ((n : ℤ) : 𝓞 K) ∈ M := hQM hQmem
  have hMP : M = P := by
    have := hM.isPrime
    rcases eq_or_eq_conj hK2 P M hn hnP hnM with h | h
    · exact h
    · rw [h, hs]
  have hQP : Q ≤ P := by rw [← hMP]; exact hQM
  obtain ⟨Q2, hQ2⟩ := Ideal.dvd_iff_le.mpr hQP
  have hQ2n : Ideal.absNorm Q2 = 1 := by
    have h1 := congrArg Ideal.absNorm hQ2
    rw [map_mul, hQn, hfP] at h1
    exact nat_eq_one_of_mul_eq_self hn.pos h1.symm
  rw [Ideal.absNorm_eq_one_iff] at hQ2n
  rw [hQ2, hQ2n, Ideal.mul_top] at hQ
  rw [hQ, sq]

/-- The split case: `σP ≠ P` gives `P·σP = (p)`. -/
theorem mul_conj_eq_of_split (hK2 : Module.finrank ℚ K = 2) (P : Ideal (𝓞 K)) [hPp : P.IsPrime]
    (hP : P ≠ ⊥) {n : ℕ} (hn : n.Prime) (hnP : ((n : ℤ) : 𝓞 K) ∈ P)
    (hs : conjAut hK2 • P ≠ P) :
    P * conjAut hK2 • P = Ideal.span {((n : ℤ) : 𝓞 K)} := by
  have hI0ne : Ideal.span {((n : ℤ) : 𝓞 K)} ≠ ⊥ := by
    rw [Ne, Ideal.span_singleton_eq_bot]; exact_mod_cast hn.ne_zero
  have hσP : (conjAut hK2 • P).IsPrime := Ideal.IsPrime.smul (conjAut hK2)
  have hnσP : ((n : ℤ) : 𝓞 K) ∈ conjAut hK2 • P := by
    have h1 := Ideal.smul_mem_pointwise_smul (conjAut hK2) _ P hnP
    rwa [conjAut_smul_intCast] at h1
  have hPmax : P.IsMaximal := Ideal.IsPrime.isMaximal hPp hP
  have hσPne : conjAut hK2 • P ≠ ⊥ := by
    intro h
    apply hP
    have h1 := congrArg (fun J => conjAut hK2 • J) h
    simpa [← mul_smul, conjAut_mul_self, smul_bot] using h1
  have hσPmax : (conjAut hK2 • P).IsMaximal := Ideal.IsPrime.isMaximal hσP hσPne
  have hcop : P ⊔ conjAut hK2 • P = ⊤ := Ideal.IsMaximal.coprime_of_ne hPmax hσPmax (Ne.symm hs)
  have hle : Ideal.span {((n : ℤ) : 𝓞 K)} ≤ P * conjAut hK2 • P := by
    rw [Ideal.mul_eq_inf_of_coprime hcop]
    exact le_inf ((Ideal.span_singleton_le_iff_mem _).mpr hnP)
      ((Ideal.span_singleton_le_iff_mem _).mpr hnσP)
  obtain ⟨f, hf1, hfP⟩ := absNorm_prime_eq_pow P hn hnP
  obtain ⟨g, hg1, hgP⟩ := absNorm_prime_eq_pow (conjAut hK2 • P) hn hnσP
  have hnorm : Ideal.absNorm (P * conjAut hK2 • P) = n ^ (f + g) := by
    rw [map_mul, hfP, hgP, pow_add]
  have hfg : f + g ≤ 2 := by
    have h1 := Ideal.absNorm_dvd_absNorm_of_le hle
    rw [hnorm, absNorm_span_natCast hK2] at h1
    exact (Nat.pow_dvd_pow_iff_le_right hn.one_lt).mp h1
  exact (eq_of_le_of_absNorm_eq hle hI0ne
    (by rw [absNorm_span_natCast hK2, hnorm]; congr 1; omega)).symm

/-- **Split / inert / ramified** (tex 4504–4506, 4516–4517). PROVED. -/
theorem primeTrichotomy_proof (hK2 : Module.finrank ℚ K = 2) : PrimeTrichotomy K hK2 := by
  intro P hPp hP
  obtain ⟨n, hn, hnP⟩ := exists_prime_mem P hP
  refine ⟨n, hn, ?_⟩
  by_cases hs : conjAut hK2 • P = P
  · right
    obtain ⟨f, hf1, hfP⟩ := absNorm_prime_eq_pow P hn hnP
    have hI0P : Ideal.span {((n : ℤ) : 𝓞 K)} ≤ P := (Ideal.span_singleton_le_iff_mem _).mpr hnP
    have hfle : f ≤ 2 := by
      have h1 := Ideal.absNorm_dvd_absNorm_of_le hI0P
      rw [hfP, absNorm_span_natCast hK2] at h1
      exact (Nat.pow_dvd_pow_iff_le_right hn.one_lt).mp h1
    rcases (show f = 1 ∨ f = 2 by omega) with rfl | rfl
    · exact Or.inr ⟨hs, sq_eq_of_ramified hK2 P hn hnP hs (by rw [hfP, pow_one])⟩
    · have hI0ne : Ideal.span {((n : ℤ) : 𝓞 K)} ≠ ⊥ := by
        rw [Ne, Ideal.span_singleton_eq_bot]; exact_mod_cast hn.ne_zero
      exact Or.inl ⟨hs, (eq_of_le_of_absNorm_eq hI0P hI0ne
        (by rw [absNorm_span_natCast hK2, hfP])).symm⟩
  · exact Or.inl ⟨hs, mul_conj_eq_of_split hK2 P hP hn hnP hs⟩

/-- **`I·σ(I) = (n)` with `n` a positive integer** (tex 4497–4498). PROVED. -/
theorem mulConjRational_proof (hK2 : Module.finrank ℚ K = 2) : MulConjRational K hK2 := by
  classical
  intro I
  induction I using UniqueFactorizationMonoid.induction_on_prime with
  | h₁ => intro h; exact absurd rfl h
  | h₂ x hx =>
    intro _
    rw [Ideal.isUnit_iff] at hx
    refine ⟨1, one_ne_zero, ?_⟩
    rw [hx, ← Ideal.one_eq_top, smul_one, one_mul]
    simp
  | h₃ a P ha hP ih =>
    intro _
    obtain ⟨m, hm, hma⟩ := ih ha
    have hPp : P.IsPrime := Ideal.isPrime_of_prime hP
    have hPne : P ≠ ⊥ := hP.ne_zero
    obtain ⟨n, hn, h⟩ := primeTrichotomy_proof hK2 P hPp hPne
    have key : ∃ k : ℕ, k ≠ 0 ∧ P * conjAut hK2 • P = Ideal.span {((k : ℤ) : 𝓞 K)} := by
      rcases h with ⟨_, h⟩ | ⟨hs, h⟩ | ⟨hs, h⟩
      · exact ⟨n, hn.ne_zero, h⟩
      · refine ⟨n * n, mul_ne_zero hn.ne_zero hn.ne_zero, ?_⟩
        rw [hs, h, Ideal.span_singleton_mul_span_singleton]; push_cast; rfl
      · exact ⟨n, hn.ne_zero, by rw [hs, ← sq, h]⟩
    obtain ⟨k, hk, hkP⟩ := key
    refine ⟨k * m, mul_ne_zero hk hm, ?_⟩
    rw [MulDistribMulAction.smul_mul, show P * a * (conjAut hK2 • P * conjAut hK2 • a) =
      (P * conjAut hK2 • P) * (a * conjAut hK2 • a) by ring, hkP, hma,
      Ideal.span_singleton_mul_span_singleton]
    push_cast; rfl

end ZInQ.Contrib.CloudB3RC53.RankCounts.Genus
