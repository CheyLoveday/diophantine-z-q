import ZInQKernel.Contrib.CloudB3RC53.RankCounts.Genus.Statements

/-!
# Genus bound, stage 6: ambiguous ideals (tex 4504–4506)

Elliot (tex 4504–4506): "so `β𝔞` is a conjugation-invariant fractional ideal. Modulo rational
principal ideals such ideals are generated by the ramified prime ideals." For integral ideals:
a nonzero ideal `J` of `𝒪_K` with `σJ = J` is `(n)·∏_{P ∈ R} P` for a positive integer `n` and a
finite set `R` of distinct ramified primes (`ambiguous_of`), given the split/inert/ramified
trichotomy of the primes of `𝒪_K` (`PrimeTrichotomy`).

Proof: strong induction on `N(J)`. For a prime factor `P` of `J`: if `P` is split, `σP` also
divides `J`, so `P·σP = (p)` divides `J`; if `P` is inert, `P = (p)`; if `P` is ramified and
`P² = (p)` divides `J`, again `(p)` divides `J`. In these cases `J = (p)J'` with `σJ' = J'`.
Otherwise `P` is ramified and divides `J` exactly once: `J = PJ'` with `σJ' = J'` and `P ∤ J'`.
Kinds: PROVED.
-/

noncomputable section

open NumberField Pointwise

namespace ZInQ.Contrib.CloudB3RC53.RankCounts.Genus

variable {K : Type} [Field K] [NumberField K]

theorem smul_intCast_ringOfIntegers (σ : K ≃ₐ[ℚ] K) (n : ℤ) : σ • ((n : 𝓞 K)) = n :=
  map_intCast (MulSemiringAction.toRingHom (K ≃ₐ[ℚ] K) (𝓞 K) σ) n

theorem smul_span_intCast (σ : K ≃ₐ[ℚ] K) (n : ℤ) :
    σ • Ideal.span {((n : ℤ) : 𝓞 K)} = Ideal.span {((n : ℤ) : 𝓞 K)} := by
  rw [Ideal.smul_closure, Set.smul_set_singleton, smul_intCast_ringOfIntegers]

omit [NumberField K] in
theorem span_intCast_mul_span_intCast (a b : ℤ) :
    Ideal.span {((a : ℤ) : 𝓞 K)} * Ideal.span {((b : ℤ) : 𝓞 K)} =
      Ideal.span {(((a * b : ℤ)) : 𝓞 K)} := by
  rw [Ideal.span_singleton_mul_span_singleton, Int.cast_mul]

/-- One step of the induction: a nonzero, proper, `σ`-invariant ideal is `(p)J'` with `J'`
invariant, or `PJ'` with `P` a ramified prime, `J'` invariant and `P ∤ J'`. -/
theorem ambiguous_step (hK2 : Module.finrank ℚ K = 2) (hT : PrimeTrichotomy K hK2)
    {J : Ideal (𝓞 K)} (hJ0 : J ≠ ⊥) (hJt : J ≠ ⊤) (hJ : conjAut hK2 • J = J) :
    (∃ (p : ℕ) (J' : Ideal (𝓞 K)), p.Prime ∧ Ideal.span {((p : ℤ) : 𝓞 K)} ≠ ⊤ ∧
        J = Ideal.span {((p : ℤ) : 𝓞 K)} * J' ∧ conjAut hK2 • J' = J') ∨
    (∃ (P J' : Ideal (𝓞 K)), RamPrime K hK2 P ∧ P ≠ ⊤ ∧ J = P * J' ∧ conjAut hK2 • J' = J' ∧
        ¬ J' ≤ P) := by
  set σ := conjAut hK2
  obtain ⟨P, hPmax, hJP⟩ := Ideal.exists_le_maximal J hJt
  have hPprime : P.IsPrime := hPmax.isPrime
  have hP0 : P ≠ ⊥ := fun h => hJ0 (le_bot_iff.mp (h ▸ hJP))
  have hPt : P ≠ ⊤ := hPprime.ne_top
  -- cancellation of a nonzero factor that is `σ`-invariant
  have cancel : ∀ (A J' : Ideal (𝓞 K)), A ≠ ⊥ → σ • A = A → J = A * J' → σ • J' = J' := by
    intro A J' hA hσA hJA
    have h1 : σ • J = σ • A * σ • J' := by rw [hJA]; exact MulDistribMulAction.smul_mul σ A J'
    rw [hJ, hσA, hJA] at h1
    exact (mul_left_cancel₀ hA h1).symm
  obtain ⟨p, hp, hcase⟩ := hT P hPprime hP0
  have hspan0 : Ideal.span {((p : ℤ) : 𝓞 K)} ≠ ⊥ := by
    rw [Ne, Ideal.span_singleton_eq_bot]
    exact_mod_cast hp.ne_zero
  rcases hcase with ⟨hne, hmul⟩ | ⟨hfix, heq⟩ | ⟨hfix, hsq⟩
  · -- split
    have hσPprime : (σ • P).IsPrime := Ideal.IsPrime.smul σ
    have hσP0 : σ • P ≠ ⊥ := by
      intro h
      apply hP0
      have := congrArg (fun I => σ • I) h
      simp only [Ideal.smul_bot] at this
      rwa [smul_smul, conjAut_mul_self, one_smul] at this
    have hσPmax : (σ • P).IsMaximal := hσPprime.isMaximal hσP0
    have hJσP : J ≤ σ • P := by
      rw [← hJ]; exact Ideal.pointwise_smul_le_pointwise_smul_iff.mpr hJP
    have hcop : IsCoprime P (σ • P) := Ideal.isCoprime_of_isMaximal (Ne.symm hne)
    have hdvd : P * σ • P ∣ J :=
      hcop.mul_dvd (Ideal.dvd_iff_le.mpr hJP) (Ideal.dvd_iff_le.mpr hJσP)
    obtain ⟨J', hJ'⟩ := hdvd
    rw [hmul] at hJ'
    refine Or.inl ⟨p, J', hp, ?_, hJ', cancel _ J' hspan0 (smul_span_intCast σ p) hJ'⟩
    rw [← hmul]; exact fun h => hPt (eq_top_iff.mpr (h ▸ Ideal.mul_le_left))
  · -- inert
    obtain ⟨J', hJ'⟩ := Ideal.dvd_iff_le.mpr hJP
    rw [heq] at hJ'
    refine Or.inl ⟨p, J', hp, heq ▸ hPt, hJ', cancel _ J' hspan0 (smul_span_intCast σ p) hJ'⟩
  · -- ramified
    by_cases h2 : J ≤ P ^ 2
    · obtain ⟨J', hJ'⟩ := Ideal.dvd_iff_le.mpr h2
      rw [hsq] at hJ'
      refine Or.inl ⟨p, J', hp, ?_, hJ', cancel _ J' hspan0 (smul_span_intCast σ p) hJ'⟩
      rw [← hsq]; exact fun h => hPt (eq_top_iff.mpr (h ▸ Ideal.pow_le_self two_ne_zero))
    · obtain ⟨J', hJ'⟩ := Ideal.dvd_iff_le.mpr hJP
      refine Or.inr ⟨P, J', ⟨hPprime, hfix, p, hp, hsq⟩, hPt, hJ', cancel P J' hP0 hfix hJ', ?_⟩
      intro hJ'P
      apply h2
      rw [hJ', pow_two]
      exact Ideal.mul_mono_right hJ'P

theorem absNorm_lt_of_eq_mul {A J J' : Ideal (𝓞 K)} (hJ0 : J ≠ ⊥) (hAt : A ≠ ⊤) (h : J = A * J') :
    Ideal.absNorm J' < Ideal.absNorm J := by
  have hJ'0 : J' ≠ ⊥ := fun h' => hJ0 (by rw [h, h', Ideal.mul_bot])
  have hA0 : A ≠ ⊥ := fun h' => hJ0 (by rw [h, h', Ideal.bot_mul])
  have hn : Ideal.absNorm J' ≠ 0 := fun h' => hJ'0 (Ideal.absNorm_eq_zero_iff.mp h')
  have hA1 : Ideal.absNorm A ≠ 1 := fun h' => hAt (Ideal.absNorm_eq_one_iff.mp h')
  have hA0' : Ideal.absNorm A ≠ 0 := fun h' => hA0 (Ideal.absNorm_eq_zero_iff.mp h')
  rw [h, map_mul]
  have : 2 ≤ Ideal.absNorm A := by omega
  calc Ideal.absNorm J' = 1 * Ideal.absNorm J' := (one_mul _).symm
    _ < Ideal.absNorm A * Ideal.absNorm J' :=
        Nat.mul_lt_mul_of_pos_right (by omega) (Nat.pos_of_ne_zero hn)

/-- **Stage 6 (tex 4504–4506): ambiguous ideals.** Given the split/inert/ramified trichotomy, a
nonzero `σ`-invariant ideal of `𝒪_K` is a positive integer times a product of distinct ramified
primes. PROVED. -/
theorem ambiguous_of (hK2 : Module.finrank ℚ K = 2) (hT : PrimeTrichotomy K hK2) :
    Ambiguous K hK2 := by
  classical
  intro J
  induction hN : Ideal.absNorm J using Nat.strong_induction_on generalizing J with
  | _ N ih =>
  intro hJ0 hJ
  by_cases hJt : J = ⊤
  · refine ⟨1, ∅, one_ne_zero, by simp, ?_⟩
    simp [hJt, Ideal.span_singleton_one]
  rcases ambiguous_step hK2 hT hJ0 hJt hJ with
    ⟨p, J', hp, hpt, hJeq, hJ'⟩ | ⟨P, J', hP, hPt, hJeq, hJ', hJ'P⟩
  · have hlt := absNorm_lt_of_eq_mul hJ0 hpt hJeq
    have hJ'0 : J' ≠ ⊥ := fun h' => hJ0 (by rw [hJeq, h', Ideal.mul_bot])
    obtain ⟨n, R, hn, hR, hJ'eq⟩ := ih _ (hN ▸ hlt) J' rfl hJ'0 hJ'
    refine ⟨p * n, R, Nat.mul_ne_zero hp.ne_zero hn, hR, ?_⟩
    rw [hJeq, hJ'eq, ← mul_assoc, span_intCast_mul_span_intCast]
    push_cast; rfl
  · have hlt := absNorm_lt_of_eq_mul hJ0 hPt hJeq
    have hJ'0 : J' ≠ ⊥ := fun h' => hJ0 (by rw [hJeq, h', Ideal.mul_bot])
    obtain ⟨n, R, hn, hR, hJ'eq⟩ := ih _ (hN ▸ hlt) J' rfl hJ'0 hJ'
    have hPR : P ∉ R := by
      intro hPmem
      apply hJ'P
      rw [hJ'eq]
      refine Ideal.mul_le_right.trans ?_
      rw [← Finset.mul_prod_erase R (fun Q => Q) hPmem]
      exact Ideal.mul_le_left
    refine ⟨n, insert P R, hn, ?_, ?_⟩
    · intro Q hQ
      rcases Finset.mem_insert.mp hQ with rfl | hQ
      · exact hP
      · exact hR Q hQ
    · rw [hJeq, hJ'eq, Finset.prod_insert hPR]
      ring

end ZInQ.Contrib.CloudB3RC53.RankCounts.Genus
