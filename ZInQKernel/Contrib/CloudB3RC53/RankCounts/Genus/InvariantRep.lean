import ZInQKernel.Contrib.CloudB3RC53.RankCounts.Genus.Statements

/-!
# Genus bound, stages 2–5: a class of order two is the class of a conjugation-invariant ideal

Manuscript `diophantine_zq.tex`, proof of Lemma `ex:limits-residual-bound`, tex 4497–4504:

> Conjugation acts by inversion on the ideal class group. If `[𝔞]` has order dividing two, write
> `𝔞̄ = (α)𝔞`. Taking ideal norms gives `N_{K/ℚ}α = 1`, since this norm is positive. Hilbert 90
> gives `α = β/β̄` (take `β = 1 + α` unless `α = −1`, and take `β = √k` in that case), so `β𝔞` is
> a conjugation-invariant fractional ideal.

`invariantRep_of` proves `InvariantRep` (every class of order dividing two is the class of a
`σ`-invariant ideal) from `MulConjRational` (`I·σ(I)` is generated by a positive integer), in
integral form: `𝔞̄ = (α)𝔞` becomes `(x)·σ(I) = (y)·I` with `x, y ∈ 𝒪_K` nonzero (`α = y/x`);
"taking norms" becomes `x σ(x) = y σ(y)`, obtained by cancelling `I·σ(I)` and using that
`x σ(x)`, `y σ(y)` are positive rationals; Hilbert 90 becomes the integral element
`b = σ(x + y)·y` (`b/σ(b) = σ(β)/β` up to the rational factor `y σ(y)`), and `J = (b)·I` is
`σ`-invariant.

DEPARTURE (minor): when `α = −1` (here `x + y = 0`) the ideal `I` itself is already `σ`-invariant,
so `J = I` is used instead of `√k·I`; both are `σ`-invariant representatives of the same class.

Kinds: PROVED.
-/

noncomputable section

open NumberField Pointwise
open scoped nonZeroDivisors

namespace ZInQ.Contrib.CloudB3RC53.RankCounts.Genus

variable {K : Type} [Field K] [NumberField K]

theorem conjAut_smul_smul (hK2 : Module.finrank ℚ K = 2) (I : Ideal (𝓞 K)) :
    conjAut hK2 • conjAut hK2 • I = I := by
  rw [smul_smul, conjAut_mul_self, one_smul]

theorem conjAut_smul_smul_elt (hK2 : Module.finrank ℚ K = 2) (x : 𝓞 K) :
    conjAut hK2 • conjAut hK2 • x = x := by
  rw [smul_smul, conjAut_mul_self, one_smul]

theorem conjAut_smul_span (hK2 : Module.finrank ℚ K = 2) (x : 𝓞 K) :
    conjAut hK2 • Ideal.span {x} = Ideal.span {conjAut hK2 • x} := by
  rw [Ideal.smul_closure, Set.smul_set_singleton]

theorem conjAut_smul_ne_bot (hK2 : Module.finrank ℚ K = 2) {I : Ideal (𝓞 K)} (hI : I ≠ ⊥) :
    conjAut hK2 • I ≠ ⊥ := by
  intro h
  apply hI
  rw [← conjAut_smul_smul hK2 I, h, Ideal.smul_bot]

theorem conjAut_smul_mul (hK2 : Module.finrank ℚ K = 2) (I J : Ideal (𝓞 K)) :
    conjAut hK2 • (I * J) = conjAut hK2 • I * conjAut hK2 • J :=
  MulDistribMulAction.smul_mul _ I J

/-- A unit of `𝒪_K` which is a positive rational is `1` (its norm is `r² = ±1`). -/
theorem unit_eq_one_of_rat (hK2 : Module.finrank ℚ K = 2) (u : (𝓞 K)ˣ) {r : ℚ} (hr : 0 < r)
    (hu : ((u : 𝓞 K) : K) = algebraMap ℚ K r) : (u : 𝓞 K) = 1 := by
  have hn := (isUnit_iff_norm (x := (u : 𝓞 K))).mp u.isUnit
  have hnorm : ((RingOfIntegers.norm ℚ (u : 𝓞 K) : 𝓞 ℚ) : ℚ) = r ^ 2 := by
    rw [RingOfIntegers.coe_norm, hu, Algebra.norm_algebraMap, hK2]
  rw [hnorm, abs_of_nonneg (by positivity)] at hn
  have hr1 : r = 1 := by nlinarith
  apply RingOfIntegers.coe_injective
  show ((u : 𝓞 K) : K) = ((1 : 𝓞 K) : K)
  rw [hu, hr1, map_one]
  rfl

/-- **Taking norms** (tex 4499–4501): if `(x)·σ(I) = (y)·I` with `I ≠ 0`, then `x σ(x) = y σ(y)`. -/
theorem mul_conj_eq_of_span (hK2 : Module.finrank ℚ K = 2) (hTC : IsTotallyComplex K)
    {I : Ideal (𝓞 K)} (hI : I ≠ ⊥) {x y : 𝓞 K} (hx : x ≠ 0) (hy : y ≠ 0)
    (h : Ideal.span {x} * conjAut hK2 • I = Ideal.span {y} * I) :
    x * conjAut hK2 • x = y * conjAut hK2 • y := by
  have h' : Ideal.span {conjAut hK2 • x} * I = Ideal.span {conjAut hK2 • y} * conjAut hK2 • I := by
    have := congrArg (fun J => conjAut hK2 • J) h
    simpa only [conjAut_smul_mul, conjAut_smul_span, conjAut_smul_smul] using this
  have hprod : Ideal.span {x * conjAut hK2 • x} * (I * conjAut hK2 • I) =
      Ideal.span {y * conjAut hK2 • y} * (I * conjAut hK2 • I) := by
    have := congrArg₂ (· * ·) h h'
    rw [← Ideal.span_singleton_mul_span_singleton, ← Ideal.span_singleton_mul_span_singleton]
    calc Ideal.span {x} * Ideal.span {conjAut hK2 • x} * (I * conjAut hK2 • I)
        = (Ideal.span {x} * conjAut hK2 • I) * (Ideal.span {conjAut hK2 • x} * I) := by ring
      _ = (Ideal.span {y} * I) * (Ideal.span {conjAut hK2 • y} * conjAut hK2 • I) := this
      _ = Ideal.span {y} * Ideal.span {conjAut hK2 • y} * (I * conjAut hK2 • I) := by ring
  have hne : I * conjAut hK2 • I ≠ 0 := mul_ne_zero hI (conjAut_smul_ne_bot hK2 hI)
  have hspan := mul_right_cancel₀ hne hprod
  obtain ⟨u, hu⟩ := Ideal.span_singleton_eq_span_singleton.mp hspan
  -- `x σx` and `y σy` are positive rationals
  have hx' : (x : K) ≠ 0 := by exact_mod_cast hx
  have hy' : (y : K) ≠ 0 := by exact_mod_cast hy
  obtain ⟨q₁, hq₁, e₁⟩ := mul_conjAut_pos hK2 hTC hx'
  obtain ⟨q₂, hq₂, e₂⟩ := mul_conjAut_pos hK2 hTC hy'
  have hcx : algebraMap (𝓞 K) K (x * conjAut hK2 • x) = algebraMap ℚ K q₁ := by
    rw [map_mul]; exact e₁
  have hcy : algebraMap (𝓞 K) K (y * conjAut hK2 • y) = algebraMap ℚ K q₂ := by
    rw [map_mul]; exact e₂
  have huK : ((u : 𝓞 K) : K) = algebraMap ℚ K (q₂ / q₁) := by
    have := congrArg (algebraMap (𝓞 K) K) hu
    rw [map_mul, hcx, hcy] at this
    rw [map_div₀]
    have hq : algebraMap ℚ K q₁ ≠ 0 := by
      rw [ne_eq, map_eq_zero_iff _ (algebraMap ℚ K).injective]; exact hq₁.ne'
    field_simp
    rw [mul_comm]; exact this
  have hu1 := unit_eq_one_of_rat hK2 u (div_pos hq₂ hq₁) huK
  rw [hu1, mul_one] at hu
  exact hu

/-- **Stages 2–5 (tex 4497–4504), `InvariantRep` from `MulConjRational`.** PROVED. -/
theorem invariantRep_of (hK2 : Module.finrank ℚ K = 2) (hTC : IsTotallyComplex K)
    (hM : MulConjRational K hK2) : InvariantRep K hK2 := by
  intro c hc
  obtain ⟨⟨I, hI⟩, rfl⟩ := ClassGroup.mk0_surjective c
  have hI0 : I ≠ ⊥ := nonZeroDivisors.ne_zero hI
  have hσI0 : conjAut hK2 • I ≠ ⊥ := conjAut_smul_ne_bot hK2 hI0
  have hσI : conjAut hK2 • I ∈ (Ideal (𝓞 K))⁰ := mem_nonZeroDivisors_of_ne_zero hσI0
  obtain ⟨n, hn, hIn⟩ := hM I hI0
  -- conjugation inverts the class: `[σ I] [I] = 1`
  have hinv : ClassGroup.mk0 ⟨conjAut hK2 • I, hσI⟩ * ClassGroup.mk0 ⟨I, hI⟩ = 1 := by
    rw [← map_mul]
    have hmem : conjAut hK2 • I * I ∈ (Ideal (𝓞 K))⁰ :=
      mem_nonZeroDivisors_of_ne_zero (mul_ne_zero hσI0 hI0)
    have : (⟨conjAut hK2 • I, hσI⟩ * ⟨I, hI⟩ : (Ideal (𝓞 K))⁰) = ⟨conjAut hK2 • I * I, hmem⟩ := rfl
    rw [this, ClassGroup.mk0_eq_one_iff, mul_comm, hIn]
    exact ⟨_, rfl⟩
  have hsq : ClassGroup.mk0 ⟨I, hI⟩ * ClassGroup.mk0 ⟨I, hI⟩ = 1 := by rw [← sq]; exact hc
  have heq : ClassGroup.mk0 ⟨conjAut hK2 • I, hσI⟩ = ClassGroup.mk0 ⟨I, hI⟩ :=
    mul_right_cancel (hinv.trans hsq.symm)
  obtain ⟨x, y, hx, hy, hxy⟩ := ClassGroup.mk0_eq_mk0_iff.mp heq
  simp only at hxy
  have hnorm := mul_conj_eq_of_span hK2 hTC hI0 hx hy hxy
  have hspx0 : Ideal.span {x} ≠ 0 := by
    rw [ne_eq, Ideal.zero_eq_bot, Ideal.span_singleton_eq_bot]; exact hx
  by_cases hs : x + y = 0
  · -- `α = −1`: `I` is already invariant
    have hyx : y = -x := by linear_combination hs
    refine ⟨I, hI, ?_, rfl⟩
    rw [hyx, Ideal.span_singleton_neg] at hxy
    exact mul_left_cancel₀ hspx0 hxy
  · -- Hilbert 90: `b = σ(x + y)·y`
    set b : 𝓞 K := conjAut hK2 • (x + y) * y with hb
    have hb0 : b ≠ 0 := by
      refine mul_ne_zero ?_ hy
      rw [ne_eq, smul_eq_zero_iff_eq]; exact hs
    have hσb : conjAut hK2 • b = (x + y) * conjAut hK2 • y := by
      rw [hb, smul_mul', conjAut_smul_smul_elt]
    have hkey : conjAut hK2 • b * y = b * x := by
      rw [hσb, hb, smul_add]
      linear_combination y * hnorm.symm
    set J := Ideal.span {b} * I with hJ
    have hJ0 : J ≠ ⊥ := mul_ne_zero (by
      rw [ne_eq, Ideal.zero_eq_bot, Ideal.span_singleton_eq_bot]; exact hb0) hI0
    refine ⟨J, mem_nonZeroDivisors_of_ne_zero hJ0, ?_, ?_⟩
    · apply mul_left_cancel₀ hspx0
      calc Ideal.span {x} * conjAut hK2 • J
          = Ideal.span {conjAut hK2 • b} * (Ideal.span {x} * conjAut hK2 • I) := by
            rw [hJ, conjAut_smul_mul, conjAut_smul_span]; ring
        _ = Ideal.span {conjAut hK2 • b} * (Ideal.span {y} * I) := by rw [hxy]
        _ = Ideal.span {conjAut hK2 • b * y} * I := by
            rw [← Ideal.span_singleton_mul_span_singleton]; ring
        _ = Ideal.span {b * x} * I := by rw [hkey]
        _ = Ideal.span {x} * J := by
            rw [hJ, ← Ideal.span_singleton_mul_span_singleton]; ring
    · apply ClassGroup.mk0_eq_mk0_iff.mpr
      refine ⟨1, b, one_ne_zero, hb0, ?_⟩
      simp only [Ideal.span_singleton_one, Ideal.top_mul, hJ]

end ZInQ.Contrib.CloudB3RC53.RankCounts.Genus
