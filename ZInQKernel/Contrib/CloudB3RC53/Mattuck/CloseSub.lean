import ZInQKernel.Contrib.TauCeti.AlgebraicGeometry.EllipticCurve.Affine.ValuationIntegrality
import ZInQKernel.Contrib.TauCeti.AlgebraicGeometry.EllipticCurve.Affine.Point.Reduction
import Mathlib.AlgebraicGeometry.EllipticCurve.VariableChange

/-!
# Mattuck, odd residue characteristic, part 2: nearby points differ by a point of `E₁`

Manuscript `diophantine_zq.tex`, tex 4551–4556 (the old Kummer row; Mattuck's theorem). This is the
algebraic core of "`E₁(K_w)` is open, hence of finite index in the compact group `E(K_w)`".

Let `v` be a valuation on a field `F`, `W` a Weierstrass curve over `F` with `v`-integral
coefficients and `Δ ≠ 0`, and put `δ = v(Δ)`.

* `exists_delta_eq` (the **discriminant certificate**): for a point `(x, y)` of the equation over
  any commutative ring, `Δ = α · (2y + a₁x + a₃) + β · (3x² + 2a₂x + a₄ − a₁y)` for some `α, β`
  (translate the point to the origin, `a₆' = 0`, and every term of `Δ'` contains `a₃'` or `a₄'`).
  Hence at an integral point the two partial derivatives cannot both have valuation `< δ`
  (`not_lt_and_lt`).
* `one_lt_valuation_slope`: if `(x₁, y₁)`, `(x₂, y₂)` are integral points with
  `v(x₁ − x₂) < δ` and `v(y₁ + y₂ + a₁x₂ + a₃) < δ` (so the second is close to the negative of the
  first) and they are not opposite, the chord–tangent slope has a pole.
* **`sub_eq_zero_or_one_lt_valuation_xCoord`**: two integral points whose coordinates are
  `δ`-close differ by `0` or by a point whose `x`-coordinate has a pole, i.e. by a point of the
  kernel of reduction `E₁` (`Affine.Point.reduction_eq_zero_iff`).
-/

noncomputable section

namespace ZInQ.Contrib.CloudB3RC53.Mattuck

open WeierstrassCurve

/-- The `a₃`-coefficient of the certificate (for a curve with `a₆ = 0`). -/
def certA {R : Type*} [CommRing R] (W : WeierstrassCurve R) : R :=
  -W.b₂ ^ 2 * (W.a₂ * W.a₃ - W.a₁ * W.a₄) - 8 * W.a₁ * W.b₄ ^ 2 - 27 * W.a₃ ^ 3 +
    9 * W.b₂ * W.b₄ * W.a₃

/-- The `a₄`-coefficient of the certificate (for a curve with `a₆ = 0`). -/
def certB {R : Type*} [CommRing R] (W : WeierstrassCurve R) : R :=
  W.b₂ ^ 2 * W.a₄ - 16 * W.b₄ ^ 2

/-- For a Weierstrass curve with `a₆ = 0`, `Δ ∈ (a₃, a₄)`. -/
theorem delta_eq_of_a₆ {R : Type*} [CommRing R] (W : WeierstrassCurve R) (h : W.a₆ = 0) :
    W.Δ = certA W * W.a₃ + certB W * W.a₄ := by
  simp only [WeierstrassCurve.Δ, WeierstrassCurve.b₂, WeierstrassCurve.b₄, WeierstrassCurve.b₆,
    WeierstrassCurve.b₈, certA, certB, h]
  ring

/-- **The discriminant certificate**: at a point `(x, y)` of the Weierstrass equation over any
commutative ring, `Δ` lies in the ideal generated by the two partial derivatives
`2y + a₁x + a₃` and `3x² + 2a₂x + a₄ − a₁y`. PROVED. -/
theorem exists_delta_eq {R : Type*} [CommRing R] (W : WeierstrassCurve R) {x y : R}
    (h : y ^ 2 + W.a₁ * x * y + W.a₃ * y - (x ^ 3 + W.a₂ * x ^ 2 + W.a₄ * x + W.a₆) = 0) :
    ∃ α β : R, W.Δ = α * (2 * y + W.a₁ * x + W.a₃) +
      β * (3 * x ^ 2 + 2 * W.a₂ * x + W.a₄ - W.a₁ * y) := by
  let e : VariableChange R := ⟨1, x, 0, y⟩
  have h6 : (e • W).a₆ = 0 := by
    rw [variableChange_a₆]
    simp only [e, inv_one, Units.val_one, one_pow, one_mul]
    linear_combination (-1 : R) * h
  have hΔ : (e • W).Δ = W.Δ := by
    rw [variableChange_Δ]
    simp [e]
  have h3 : (e • W).a₃ = 2 * y + W.a₁ * x + W.a₃ := by
    rw [variableChange_a₃]
    simp only [e, inv_one, Units.val_one, one_pow, one_mul]
    ring
  have h4 : (e • W).a₄ = 3 * x ^ 2 + 2 * W.a₂ * x + W.a₄ - W.a₁ * y := by
    rw [variableChange_a₄]
    simp only [e, inv_one, Units.val_one, one_pow, one_mul]
    ring
  exact ⟨certA (e • W), certB (e • W), by rw [← hΔ, delta_eq_of_a₆ _ h6, h3, h4]⟩

variable {F Γ₀ : Type*} [Field F] [LinearOrderedCommGroupWithZero Γ₀] (v : Valuation F Γ₀)
  {W : WeierstrassCurve.Affine F} [WeierstrassCurve.IsIntegral v.valuationSubring W]

/-- **At an integral point the two partial derivatives are not both `v(Δ)`-small.** PROVED. -/
theorem not_lt_and_lt {x y : F} (h : W.Equation x y) (hx : v x ≤ 1)
    (hFy : v (2 * y + W.a₁ * x + W.a₃) < v W.Δ)
    (hFx : v (3 * x ^ 2 + 2 * W.a₂ * x + W.a₄ - W.a₁ * y) < v W.Δ) : False := by
  have hy := Affine.valuation_y_le_one_of_valuation_x_le_one v h hx
  set O := v.valuationSubring
  let x' : O := ⟨x, (v.mem_valuationSubring_iff x).mpr hx⟩
  let y' : O := ⟨y, (v.mem_valuationSubring_iff y).mpr hy⟩
  set WO := integralModel O W
  have hO : WO.toAffine.Equation x' y' := (Affine.equation_integralModel_iff v).mpr h
  rw [Affine.equation_iff'] at hO
  obtain ⟨α, β, hαβ⟩ := exists_delta_eq WO hO
  have hc := congrArg (fun z : O => (z : F)) hαβ
  have hWΔ : ((WO.Δ : O) : F) = W.Δ := by
    have : (WO.baseChange F).Δ = W.Δ := by rw [baseChange_integralModel_eq]
    rw [← this]
    exact (WeierstrassCurve.map_Δ WO (algebraMap O F)).symm
  simp only [hWΔ] at hc
  push_cast at hc
  have h2 : ((2 : O) : F) = 2 := map_ofNat O.subtype 2
  have h3 : ((3 : O) : F) = 3 := map_ofNat O.subtype 3
  rw [h2, h3] at hc
  rw [Affine.coe_integralModel_a₁ v, Affine.coe_integralModel_a₂ v, Affine.coe_integralModel_a₃ v,
    Affine.coe_integralModel_a₄ v] at hc
  have hαv : v (α : F) ≤ 1 := (v.mem_valuationSubring_iff _).mp α.2
  have hβv : v (β : F) ≤ 1 := (v.mem_valuationSubring_iff _).mp β.2
  have key : v W.Δ < v W.Δ := by
    conv_lhs => rw [hc]
    refine v.map_add_lt ?_ ?_
    · rw [map_mul]
      exact (mul_le_of_le_one_left' hαv).trans_lt (by simpa [x', y'] using hFy)
    · rw [map_mul]
      exact (mul_le_of_le_one_left' hβv).trans_lt (by simpa [x', y'] using hFx)
  exact lt_irrefl _ key

omit [WeierstrassCurve.IsIntegral v.valuationSubring W] in
/-- `1 < v (a / b)` when `v b < v a`. -/
theorem one_lt_valuation_div {a b : F} (hb : b ≠ 0) (h : v b < v a) : 1 < v (a / b) := by
  by_contra! hle
  have : v a = v (a / b) * v b := by rw [← map_mul, div_mul_cancel₀ _ hb]
  exact absurd (this ▸ mul_le_of_le_one_left' hle) (not_le.mpr h)

omit [WeierstrassCurve.IsIntegral v.valuationSubring W] in
theorem le_valuation_add_of_lt {a b : F} {δ : Γ₀} (ha : δ ≤ v a) (hb : v b < δ) :
    δ ≤ v (a + b) := by
  rw [v.map_add_eq_of_lt_left (hb.trans_le ha)]
  exact ha

variable [DecidableEq F]

/-- **The chord–tangent slope through two `δ`-close points has a pole** (`δ = v(Δ)`): if
`(x₁, y₁)`, `(x₂, y₂)` are points with integral `x`-coordinates, `v(x₁ − x₂) < δ`,
`v(y₁ + y₂ + a₁x₂ + a₃) < δ`, and they are not opposite, then `1 < v(slope)`. PROVED. -/
theorem one_lt_valuation_slope {x₁ y₁ x₂ y₂ : F} (h₁ : W.Equation x₁ y₁) (h₂ : W.Equation x₂ y₂)
    (hx₁ : v x₁ ≤ 1) (hx₂ : v x₂ ≤ 1) (hΔ : W.Δ ≠ 0) (hx : v (x₁ - x₂) < v W.Δ)
    (hD : v (y₁ + y₂ + W.a₁ * x₂ + W.a₃) < v W.Δ) (hxy : ¬(x₁ = x₂ ∧ y₁ = W.negY x₂ y₂)) :
    1 < v (W.slope x₁ x₂ y₁ y₂) := by
  have hδ : (0 : Γ₀) < v W.Δ := by
    rw [zero_lt_iff]; exact (Valuation.ne_zero_iff v).mpr hΔ
  have ha₁ := Affine.valuation_a₁_le_one v (W := W)
  have ha₂ := Affine.valuation_a₂_le_one v (W := W)
  -- one of the two partial derivatives at `(x₁, y₁)` is not small
  have hcert : v W.Δ ≤ v (2 * y₁ + W.a₁ * x₁ + W.a₃) ∨
      v W.Δ ≤ v (3 * x₁ ^ 2 + 2 * W.a₂ * x₁ + W.a₄ - W.a₁ * y₁) := by
    by_contra! hc
    exact not_lt_and_lt v h₁ hx₁ hc.1 hc.2
  by_cases hx12 : x₁ = x₂
  · subst hx12
    have hy : y₁ ≠ W.negY x₁ y₂ := fun h => hxy ⟨rfl, h⟩
    have hy12 : y₁ = y₂ := Affine.Y_eq_of_Y_ne h₁ h₂ rfl hy
    subst hy12
    rw [Affine.slope_of_Y_ne rfl hy]
    have hFy : y₁ - W.negY x₁ y₁ = 2 * y₁ + W.a₁ * x₁ + W.a₃ := by
      rw [Affine.negY]; ring
    have hsmall : v (y₁ - W.negY x₁ y₁) < v W.Δ := by
      rw [hFy]; convert hD using 2; ring
    have hne : y₁ - W.negY x₁ y₁ ≠ 0 := sub_ne_zero.mpr hy
    have hFx : v W.Δ ≤ v (3 * x₁ ^ 2 + 2 * W.a₂ * x₁ + W.a₄ - W.a₁ * y₁) := by
      rcases hcert with h | h
      · exact absurd (h.trans_lt (hFy ▸ hsmall)) (lt_irrefl _)
      · exact h
    exact one_lt_valuation_div v hne (hsmall.trans_le hFx)
  · rw [Affine.slope_of_X_ne hx12]
    have hxne : x₁ - x₂ ≠ 0 := sub_ne_zero.mpr hx12
    rcases hcert with hFy | hFx
    · -- the numerator `y₁ − y₂` is not small
      have hnum : y₁ - y₂ = (2 * y₁ + W.a₁ * x₁ + W.a₃) +
          -((y₁ + y₂ + W.a₁ * x₂ + W.a₃) + W.a₁ * (x₁ - x₂)) := by ring
      have hsm : v ((y₁ + y₂ + W.a₁ * x₂ + W.a₃) + W.a₁ * (x₁ - x₂)) < v W.Δ :=
        v.map_add_lt hD (by rw [map_mul]; exact (mul_le_of_le_one_left' ha₁).trans_lt hx)
      have hbig : v W.Δ ≤ v (y₁ - y₂) := by
        rw [hnum]; exact le_valuation_add_of_lt v hFy (by rwa [v.map_neg])
      exact one_lt_valuation_div v hxne (hx.trans_le hbig)
    · -- the other slope formula `N / D`
      set N := x₁ ^ 2 + x₁ * x₂ + x₂ ^ 2 + W.a₂ * (x₁ + x₂) + W.a₄ - W.a₁ * y₁ with hN
      set D := y₁ + y₂ + W.a₁ * x₂ + W.a₃ with hDdef
      have hid : (y₁ - y₂) * D = (x₁ - x₂) * N := by
        rw [Affine.equation_iff] at h₁ h₂
        rw [hN, hDdef]
        linear_combination h₁ - h₂
      have hNbig : v W.Δ ≤ v N := by
        have : N = (3 * x₁ ^ 2 + 2 * W.a₂ * x₁ + W.a₄ - W.a₁ * y₁) +
            (x₂ - x₁) * (x₂ + 2 * x₁ + W.a₂) := by rw [hN]; ring
        rw [this]
        refine le_valuation_add_of_lt v hFx ?_
        rw [map_mul]
        have h3 : v (x₂ + 2 * x₁ + W.a₂) ≤ 1 := by
          refine v.map_add_le (v.map_add_le hx₂ ?_) ha₂
          rw [map_mul]
          have h2 : v (2 : F) ≤ 1 := by
            have := v.map_add_le (map_one v).le (map_one v).le
            rwa [one_add_one_eq_two] at this
          exact (mul_le_of_le_one_left' h2).trans hx₁
        exact (mul_le_of_le_one_right' h3).trans_lt (by rw [← neg_sub, v.map_neg]; exact hx)
      have hN0 : N ≠ 0 := by
        intro h0; rw [h0, map_zero] at hNbig; exact absurd hδ (not_lt.mpr hNbig)
      have hD0 : D ≠ 0 := by
        intro h0
        rw [h0, mul_zero] at hid
        exact (mul_ne_zero hxne hN0) hid.symm
      have : (y₁ - y₂) / (x₁ - x₂) = N / D := by
        rw [div_eq_div_iff hxne hD0, hid, mul_comm]
      rw [this]
      exact one_lt_valuation_div v hD0 (hD.trans_le hNbig)

/-- **Two `δ`-close integral points differ by a point of the kernel of reduction** (`δ = v(Δ)`):
if `P = (x₁, y₁)`, `Q = (x₂, y₂)` have integral `x`-coordinates, `v(x₁ − x₂) < δ` and
`v(y₁ − y₂) < δ`, then `P − Q = 0` or the `x`-coordinate of `P − Q` has a pole. PROVED. -/
theorem sub_eq_zero_or_one_lt_valuation_xCoord {x₁ y₁ x₂ y₂ : F} (h₁ : W.Nonsingular x₁ y₁)
    (h₂ : W.Nonsingular x₂ y₂) (hx₁ : v x₁ ≤ 1) (hx₂ : v x₂ ≤ 1) (hΔ : W.Δ ≠ 0)
    (hx : v (x₁ - x₂) < v W.Δ) (hy : v (y₁ - y₂) < v W.Δ) :
    Affine.Point.some x₁ y₁ h₁ - Affine.Point.some x₂ y₂ h₂ = 0 ∨
      1 < v (Affine.Point.some x₁ y₁ h₁ - Affine.Point.some x₂ y₂ h₂).xCoord := by
  rw [sub_eq_add_neg, Affine.Point.neg_some]
  set y₂' := W.negY x₂ y₂
  have h₂' : W.Nonsingular x₂ y₂' := (Affine.nonsingular_neg ..).mpr h₂
  by_cases hxy : x₁ = x₂ ∧ y₁ = W.negY x₂ y₂'
  · left
    exact Affine.Point.add_of_Y_eq hxy.1 hxy.2
  · right
    rw [Affine.Point.add_some hxy, Affine.Point.xCoord_some]
    have hD : v (y₁ + y₂' + W.a₁ * x₂ + W.a₃) < v W.Δ := by
      convert hy using 2
      simp only [y₂', Affine.negY]
      ring
    have hℓ := one_lt_valuation_slope v h₁.1 h₂'.1 hx₁ hx₂ hΔ hx hD hxy
    by_contra! hle
    exact absurd (Affine.valuation_le_one_of_valuation_addX_le_one v hx₁ hx₂ hle) (not_le.mpr hℓ)

end ZInQ.Contrib.CloudB3RC53.Mattuck
