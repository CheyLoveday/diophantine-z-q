import ZInQKernel.Contrib.CloudB3RC53.TameModel.TrivialF2Chain
import ZInQKernel.Contrib.CloudB3RC53.TameModel.QIsoCriterion
import ZInQKernel.Contrib.CloudB3RC53.TameModel.UnramifiedQIso

/-!
# The tame model with trivial `𝔽₂` coefficients is a quasi-isomorphic model (rows 2, 5)

Manuscript `diophantine_zq.tex`, the tame model (4.4), tex L3443–3448, L3470–3479. Continues
`TrivialF2Chain.lean`.

* `LocalCohomologyF2 K` (**PRINT, UNVERIFIED**; Serre, *Galois Cohomology*, II §5.2–5.3;
  Neukirch–Schmidt–Wingberg, *Cohomology of Number Fields*, 7.1.8 and 7.2.x): for a nonarchimedean
  local field `K` of odd residue characteristic, `H²(G_K, 𝔽₂) ≅ 𝔽₂`, generated by the class of the
  cup product `χ_ur ∪ χ_ϖ` of the unramified and the ramified quadratic characters (the Hilbert
  symbol `(u, ϖ)` of a non-square unit and a uniformizer is `−1`), and `Hⁿ(G_K, 𝔽₂) = 0` for
  `n ≥ 3` (`cd₂ G_K = 2`). Stated on lane RC26's genuine cochains, elementwise: every continuous
  `2`-cocycle is `m·(χ_ur ∪ χ_ϖ)` up to a coboundary, `χ_ur ∪ χ_ϖ` is not a coboundary, and
  `contCohomology` vanishes in degrees `≥ 3`.
* `tameF2L_quasiIsoAt_le_one` (PROVED): the comparison `tameF2L` is a quasi-isomorphism in all
  degrees `≤ 1` (degree `1`: the tame coordinates of `TameQuotient`, `H¹ = Hom_cont(G_K, 𝔽₂) ≅ 𝔽₂²`);
* `tameF2L_quasiIso` (PROVED from the print): a quasi-isomorphism in every degree;
* `tameF2U_quasiIso` (PROVED): the unramified comparison `tameF2U` is a quasi-isomorphism
  (`Gal(K^{ur}/K) ≃ ℤ̂`: a continuous character is determined by its value at Frobenius;
  degrees `≥ 2` by cohomological dimension one, `subsingleton_contCohomology_ge_two`);
* `tameModelQIsoF2` (PROVED from the print): **`TameModelQIso` for `M = 𝔽₂`, `Φ = 1`, `q` odd**, with
  `L` the genuine local cochains of `G_K`, `U` those of `Gal(K^{ur}/K)` and `ι` inflation along
  restriction.
-/

noncomputable section

namespace ZInQ.Contrib.CloudB3RC53.TameModel

open CategoryTheory TauCeti ValuativeRel
open ZInQ.Contrib.CloudB3RC53.TameQuotient
open ZInQ.Manuscript.RC.SelmerComplex
open ZInQ.Contrib.CloudB3RC53.ClearingComplex (tL tLX tLd tU tUX tUd tιH TameModelQIso)
open ZInQ.Contrib.CloudB3RC53.PairedFunctional (GHom GCx)
open ZInQ.Contrib.CloudB3RC53.UnramifiedComplex (frobElt closure_frob_eq_top)

variable {K : Type} [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]

section Full

variable [DistribMulAction (Gal(AlgebraicClosure K/K)) (ZMod 2)]
  [SMulCommClass (Gal(AlgebraicClosure K/K)) (ZMod 2) (ZMod 2)]
  [ContinuousSMul (Gal(AlgebraicClosure K/K)) (ZMod 2)]

variable (K) in
/-- **PRINT (UNVERIFIED)**: local cohomology of `𝔽₂` in degrees `≥ 2` (Serre, *Galois Cohomology*,
II §5.2–5.3; NSW 7.1.8, 7.2.x). For `p` odd: `H²(G_K, 𝔽₂)` is generated by the class of
`χ_ur ∪ χ_ϖ`, which is nonzero (so `H² ≅ 𝔽₂`), and `Hⁿ(G_K, 𝔽₂) = 0` for `n ≥ 3`. -/
def LocalCohomologyF2 : Prop :=
  ∀ hp : ringChar 𝓀[K] ≠ 2,
    (∀ y : (contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).X 2,
      ((contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).d 2 3).hom y = 0 →
        ∃ (m : ZMod 2) (z : (contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).X 1),
          lin2 hp m = y + ((contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).d 1 2).hom z) ∧
    (∀ z : (contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).X 1,
      lin2 hp 1 ≠ ((contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).d 1 2).hom z) ∧
    ∀ n : ℕ, 3 ≤ n →
      Subsingleton (contCohomology (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2) n)


/-- A Frobenius lift fixing `√ϖ` and a tame generator moving it. -/
theorem exists_phi_sigma (hp : ringChar 𝓀[K] ≠ 2) :
    ∃ φ σ : Gal(AlgebraicClosure K/K), IsArithFrobeniusLift K φ ∧ φ (sqrtUnif K) = sqrtUnif K ∧
      σ ∈ inertiaSubgroup K ∧ σ (sqrtUnif K) = -sqrtUnif K := by
  have hpr : (ringChar 𝓀[K]).Prime := CharP.prime_ringChar 𝓀[K]
  have h2c : (2 : ℕ).Coprime (ringChar 𝓀[K]) :=
    (Nat.coprime_primes Nat.prime_two hpr).2 (Ne.symm hp)
  have hv : (normalizedValuation K (Units.mk0 ((unif K : Kˣ) : K) (unif K).ne_zero)).toAdd = 1 := by
    rw [Units.mk0_val, unif_spec, toAdd_ofAdd]
  obtain ⟨φ, hφ, hφα⟩ := exists_frobeniusLift_fix h2c (sqrtUnif_sq K) (sqrtUnif_ne_zero K)
    (unif K).ne_zero hv
  obtain ⟨σ, hσI, hσprim⟩ := exists_tame_generator h2c (sqrtUnif_sq K) (sqrtUnif_ne_zero K)
    (unif K).ne_zero hv
  refine ⟨φ, σ, hφ, hφα, hσI, ?_⟩
  rw [apply_eq_kummerVal_mul (sqrtUnif_ne_zero K), hσprim.eq_neg_one_of_two_right, neg_one_mul]

/-- The character of a continuous `1`-cocycle with trivial `𝔽₂` coefficients. -/
theorem cocycle_additive (y : (contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).X 1) (hy : ((contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).d 1 2).hom y = 0)
    (g h : Gal(AlgebraicClosure K/K)) :
    contFun (k := ZMod 2) y (fun _ => g * h) =
      contFun (k := ZMod 2) y (fun _ => g) + contFun (k := ZMod 2) y (fun _ => h) := by
  have := congrArg (fun c => contFun (k := ZMod 2) (G := Gal(AlgebraicClosure K/K)) (M := ZMod 2) c
    ![g, h]) hy
  beta_reduce at this
  rw [contFun_d12, smul_zmod_two, contFun_zero_apply] at this
  linear_combination -this

theorem tL_toCC_d (q : ℕ) (i j : ℤ) (h : i + 1 = j)
    (x : (tL (ZMod 2) (LinearMap.id : ZMod 2 →ₗ[ZMod 2] ZMod 2) q).X i) :
    (((tL (ZMod 2) (LinearMap.id : ZMod 2 →ₗ[ZMod 2] ZMod 2) q).toCC).d i j).hom x =
      (tL (ZMod 2) (LinearMap.id : ZMod 2 →ₗ[ZMod 2] ZMod 2) q).d i j h x :=
  PairedFunctional.GCx.toCC_d_hom _ i j h x

omit [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K] in
theorem natCx_toCC_d {G : Type} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    [DistribMulAction G (ZMod 2)] [SMulCommClass G (ZMod 2) (ZMod 2)] [ContinuousSMul G (ZMod 2)]
    (n : ℕ) (x : (contCochains (ZMod 2) G (ZMod 2)).X n) :
    (((natCx (contCochains (ZMod 2) G (ZMod 2))).toCC).d (n : ℤ) ((n + 1 : ℕ) : ℤ)).hom x =
      ((contCochains (ZMod 2) G (ZMod 2)).d n (n + 1)).hom x :=
  PairedFunctional.GCx.toCC_d_hom (natCx (contCochains (ZMod 2) G (ZMod 2))) (n : ℤ)
    ((n + 1 : ℕ) : ℤ) (by push_cast; rfl) x


theorem tL_eq_zero (q : ℕ) (n : ℤ) (h0 : n ≠ 0) (h1 : n ≠ 1) (h2 : n ≠ 2) (x : (tL (ZMod 2) (LinearMap.id : ZMod 2 →ₗ[ZMod 2] ZMod 2) q).X n) : x = 0 :=
  @Subsingleton.elim _ (ZInQ.Contrib.CloudB3RC53.ClearingComplex.tLX_subsingleton
    (S := ZMod 2) (M := ZMod 2) n h0 h1 h2) x 0

variable {q : ℕ}

/-- **Degree `0`**: both sides are `𝔽₂`. -/
theorem tameF2L_quasiIsoAt_zero (hp : ringChar 𝓀[K] ≠ 2) (hq : Odd q) :
    QuasiIsoAt (SelmerDuality.GHom.toCC (tameF2L (K := K) hp hq)) 0 := by
  refine quasiIsoAt_of_elem _ (-1) 0 1 (by simp) (by simp) ?_ ?_
  · intro (y : (contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).X 0) hy
    have hy' : ((contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).d 0 1).hom y = 0 := (natCx_toCC_d 0 y).symm.trans hy
    refine ⟨(contFun (k := ZMod 2) y Fin.elim0 : ZMod 2), ?_, 0, ?_⟩
    · refine (tL_toCC_d q 0 1 rfl _).trans ?_
      change ((contFun (k := ZMod 2) y Fin.elim0 - contFun (k := ZMod 2) y Fin.elim0, 0) :
        ZMod 2 × ZMod 2) = 0
      simp
    · have key : lin0 (K := K) (contFun (k := ZMod 2) y Fin.elim0) = y := by
        refine contCochains_ext fun v => ?_
        rw [Subsingleton.elim v Fin.elim0]
        rfl
      rw [map_zero]
      exact key.trans (add_zero y).symm
  · intro x _ z hxz
    have hz0 : z = 0 := rfl
    rw [hz0, map_zero] at hxz
    have hval := congrArg (fun c : (contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).X 0 => contFun (k := ZMod 2) c Fin.elim0) hxz
    change (x : ZMod 2) = 0 at hval
    refine ⟨0, ?_⟩
    rw [map_zero]
    exact hval.symm

/-- **Degree `1`**: `H¹(G_K, 𝔽₂) ≅ 𝔽₂²` through the tame coordinates. -/
theorem tameF2L_quasiIsoAt_one (hp : ringChar 𝓀[K] ≠ 2) (hq : Odd q) :
    QuasiIsoAt (SelmerDuality.GHom.toCC (tameF2L (K := K) hp hq)) 1 := by
  obtain ⟨φ, σ, hφ, hφα, hσI, hσα⟩ := exists_phi_sigma hp
  have hne : -sqrtUnif K ≠ sqrtUnif K := by
    intro h
    exact mul_ne_zero (two_ne_zero_algClosure hp) (sqrtUnif_ne_zero K) (by linear_combination -h)
  have hσne : ¬ σ (sqrtUnif K) = sqrtUnif K := fun h => hne (hσα.symm.trans h)
  have hbij := coord_bijective hp (unif_spec K) (sqrtUnif_sq K) hφ hφα hσI hσα
  have hc1φ : ∀ a b : ZMod 2, c1 (K := K) a b φ = a := fun a b => by
    simp [c1, urChar_frobenius hφ, ramChar, hφα]
  have hc1σ : ∀ a b : ZMod 2, c1 (K := K) a b σ = b := fun a b => by
    simp [c1, urChar_inertia hσI, ramChar, hσne]
  have hq2 : ((q : ℕ) : ZMod 2) = 1 := by
    rw [ZMod.natCast_eq_iff]
    obtain ⟨r, hr⟩ := hq
    exact ⟨r, by simp [hr, ZMod.val_one]; ring⟩
  refine quasiIsoAt_of_elem _ 0 1 2 (by simp) (by simp) ?_ ?_
  · intro (y : (contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).X 1) hy
    have hy' : ((contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).d 1 2).hom y = 0 := (natCx_toCC_d 1 y).symm.trans hy
    set zf : Gal(AlgebraicClosure K/K) → ZMod 2 := fun g => contFun (k := ZMod 2) y (fun _ => g)
    have hZ : Continuous zf ∧ ∀ g h, zf (g * h) = zf g + zf h :=
      ⟨continuous_contFun_one y, cocycle_additive y hy'⟩
    have hW : Continuous (c1 (K := K) (zf φ) (zf σ)) ∧
        ∀ g h, c1 (K := K) (zf φ) (zf σ) (g * h) =
          c1 (K := K) (zf φ) (zf σ) g + c1 (K := K) (zf φ) (zf σ) h :=
      ⟨continuous_c1 hp _ _, c1_mul hp _ _⟩
    have heq : c1 (K := K) (zf φ) (zf σ) = zf := by
      have := hbij.1 (a₁ := ⟨_, hW⟩) (a₂ := ⟨zf, hZ⟩) (by
        simp only [Prod.mk.injEq]
        exact ⟨hc1φ _ _, hc1σ _ _⟩)
      exact congrArg Subtype.val this
    refine ⟨((zf φ, zf σ) : ZMod 2 × ZMod 2), ?_, 0, ?_⟩
    · refine (tL_toCC_d q 1 2 rfl _).trans ?_
      change (zf σ - ((q : ℕ) : ZMod 2) • zf σ : ZMod 2) = 0
      rw [hq2, one_smul, sub_self]
    · have key : lin1 (K := K) hp (zf φ, zf σ) = y := by
        refine contCochains_ext fun v => ?_
        rw [fin1_eq'' v]
        change c1 (zf φ) (zf σ) (v 0) = zf (v 0)
        rw [heq]
      rw [map_zero]
      exact key.trans (add_zero y).symm
  · intro x _ (z : (contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).X 0) hxz
    have hxz' := hxz.trans (natCx_toCC_d 0 z)
    have hdz : ((contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).d 0 1).hom z = 0 := by
      refine contCochains_ext fun v => ?_
      rw [fin1_eq'' v, contFun_d01, smul_zmod_two, sub_self]
      rfl
    rw [hdz] at hxz'
    have hfun : ∀ g, c1 (K := K) (show ZMod 2 × ZMod 2 from x).1
        (show ZMod 2 × ZMod 2 from x).2 g = 0 := fun g =>
      congrArg (fun c : (contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).X 1 => contFun (k := ZMod 2) c (fun _ => g)) hxz'
    have ha := hfun φ
    have hb := hfun σ
    rw [hc1φ] at ha
    rw [hc1σ] at hb
    refine ⟨0, ?_⟩
    rw [map_zero]
    exact (Prod.ext ha hb).symm

/-- **Degree `2`** (from the print). -/
theorem tameF2L_quasiIsoAt_two (hp : ringChar 𝓀[K] ≠ 2) (hq : Odd q) (hL : LocalCohomologyF2 K) :
    QuasiIsoAt (SelmerDuality.GHom.toCC (tameF2L (K := K) hp hq)) 2 := by
  obtain ⟨hsurj, hnz, -⟩ := hL hp
  refine quasiIsoAt_of_elem _ 1 2 3 (by simp) (by simp) ?_ ?_
  · intro (y : (contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).X 2) hy
    have hy' : ((contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).d 2 3).hom y = 0 := (natCx_toCC_d 2 y).symm.trans hy
    obtain ⟨m, z, hmz⟩ := hsurj y hy'
    refine ⟨(m : ZMod 2), rfl, z, ?_⟩
    exact hmz.trans (congrArg (fun t => y + t) (natCx_toCC_d 1 z).symm)
  · intro x _ (z : (contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).X 1) hxz
    have hxz' := hxz.trans (natCx_toCC_d 1 z)
    have hx0 : (show ZMod 2 from x) = 0 := by
      have h01 : ∀ t : ZMod 2, t = 0 ∨ t = 1 := by decide
      rcases h01 (show ZMod 2 from x) with h | h
      · exact h
      · exact absurd (h ▸ hxz') (hnz z)
    refine ⟨0, ?_⟩
    rw [map_zero]
    exact hx0.symm

/-- **Degrees `≥ 3`** (from the print). -/
theorem tameF2L_quasiIsoAt_ge_three (hp : ringChar 𝓀[K] ≠ 2) (hq : Odd q)
    (hL : LocalCohomologyF2 K) (m : ℕ) :
    QuasiIsoAt (SelmerDuality.GHom.toCC (tameF2L (K := K) hp hq)) ((m + 3 : ℕ) : ℤ) := by
  obtain ⟨-, -, hge⟩ := hL hp
  refine quasiIsoAt_of_elem _ ((m + 2 : ℕ) : ℤ) ((m + 3 : ℕ) : ℤ) ((m + 3 + 1 : ℕ) : ℤ)
    (by simp; omega) (by simp) ?_ ?_
  · intro (y : (contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).X (m + 3)) hy
    have hy' : ((contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).d (m + 3) (m + 3 + 1)).hom y = 0 := (natCx_toCC_d (m + 3) y).symm.trans hy
    have hsub := hge (m + 3) (by omega)
    have hex : (contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).ExactAt (m + 3) :=
      (HomologicalComplex.exactAt_iff_isZero_homology _ _).2 (ModuleCat.isZero_of_subsingleton _)
    rw [HomologicalComplex.exactAt_iff' _ (m + 2) (m + 3) (m + 3 + 1) (by simp) (by simp),
      ShortComplex.moduleCat_exact_iff] at hex
    obtain ⟨z, hz⟩ := hex y hy'
    have h2 : (((natCx (contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2))).toCC).d ((m + 2 : ℕ) : ℤ) ((m + 3 : ℕ) : ℤ)).hom (-z) = -y :=
      (natCx_toCC_d (m + 2) (-z)).trans ((map_neg _ z).trans (congrArg Neg.neg hz))
    refine ⟨0, map_zero _, -z, ?_⟩
    refine (map_zero _).trans ?_
    rw [h2]
    exact (add_neg_cancel y).symm
  · intro x _ _ _
    refine ⟨0, ?_⟩
    exact (map_zero _).trans (tL_eq_zero q _ (by omega) (by omega) (by omega) x).symm

/-- **Negative degrees**: both complexes vanish. -/
theorem tameF2L_quasiIsoAt_neg (hp : ringChar 𝓀[K] ≠ 2) (hq : Odd q) (m : ℕ) :
    QuasiIsoAt (SelmerDuality.GHom.toCC (tameF2L (K := K) hp hq)) (Int.negSucc m) := by
  refine quasiIsoAt_of_elem _ (Int.negSucc m - 1) (Int.negSucc m) (Int.negSucc m + 1)
    (by simp) (by simp) ?_ ?_
  · intro y _
    refine ⟨0, map_zero _, 0, ?_⟩
    have hy : y = 0 := rfl
    rw [hy, map_zero, map_zero, add_zero]
  · intro x _ _ _
    refine ⟨0, ?_⟩
    exact (map_zero _).trans (tL_eq_zero q _ (by omega) (by omega) (by omega) x).symm

/-- **The tame model computes the local cohomology of `𝔽₂` in degrees `≤ 1`** (PROVED). -/
theorem tameF2L_quasiIsoAt_le_one (hp : ringChar 𝓀[K] ≠ 2) (hq : Odd q) (n : ℤ) (hn : n ≤ 1) :
    QuasiIsoAt (SelmerDuality.GHom.toCC (tameF2L (K := K) hp hq)) n := by
  rcases n with (_ | _ | m) | m
  · exact tameF2L_quasiIsoAt_zero hp hq
  · exact tameF2L_quasiIsoAt_one hp hq
  · exfalso
    have : ((m + 2 : ℕ) : ℤ) ≤ 1 := hn
    omega
  · exact tameF2L_quasiIsoAt_neg hp hq m

/-- **The tame model is a quasi-isomorphic model of the local cochains of `𝔽₂`** (from the print). -/
theorem tameF2L_quasiIso (hp : ringChar 𝓀[K] ≠ 2) (hq : Odd q) (hL : LocalCohomologyF2 K) :
    QuasiIso (SelmerDuality.GHom.toCC (tameF2L (K := K) hp hq)) := by
  refine ⟨fun n => ?_⟩
  rcases n with (_ | _ | _ | m) | m
  · exact tameF2L_quasiIsoAt_zero hp hq
  · exact tameF2L_quasiIsoAt_one hp hq
  · exact tameF2L_quasiIsoAt_two hp hq hL
  · exact tameF2L_quasiIsoAt_ge_three hp hq hL m
  · exact tameF2L_quasiIsoAt_neg hp hq m

end Full

end ZInQ.Contrib.CloudB3RC53.TameModel
