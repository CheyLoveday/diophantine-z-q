import ZInQKernel.Contrib.CloudB3RC53.GenusOdd.GenusAction
import ZInQKernel.Contrib.CloudB3RC53.GenusOdd.TwistDescentProof

/-!
# GenusOdd: `√d ∈ H_c` when `χ_d ∘ N` is a character of `Pic(O_c)` (PROVED)

`exists_sqrt_mem_ringClassField`: if `χ = χ_d ∘ N` on `Pic(O_c)` (`IsQuadRingClassChar`,
`d ≡ 1 mod 4`), then `d` is a square in the ring class field `H_c`. Proof: otherwise
`M = H_c(√d)` is a quadratic extension; by Frobenius generation for the tower `K ⊆ H_c ⊆ M`
(`closure_isArithFrobAt_eq_top_tower`) `Gal(M/H_c)` is generated by Frobenius elements at primes
`Q` of `M` over primes `v ∤ 2 d f_O` of `K`. Such a Frobenius acts on `√d` by the Jacobi symbol
`(N w / |d|) = (N v / |d|)^f = χ([v])^f` (`frob_smul_sqrt`, `w = Q ∩ H_c`, `f` the residue degree of
`w` over `v`), and `f` is the order of `[v]` in `Pic(O_c)` (`orderOf_picClass_eq_inertiaDeg`), so
it fixes `√d`. Hence `Gal(M/H_c)` fixes `√d`, which is then in `H_c`: a contradiction.
-/

noncomputable section

open NumberField IsDedekindDomain TauCeti.GlobalNumberFields TauCeti.GlobalNumberFields.NumberFieldOrder
  TauCeti.ClassFieldTheory Polynomial

namespace ZInQ.Contrib.CloudB3RC53.GenusOdd

open ZInQ.Contrib.CloudB3RC53.CST

section

variable {K : Type} [Field K] [NumberField K] {c : ℕ} [NeZero c]

theorem irreducible_X_sq_sub {F : Type*} [Field F] {a : F} (h : ∀ s : F, s ^ 2 ≠ a) :
    Irreducible (X ^ 2 - C a : F[X]) := by
  have hmon : (X ^ 2 - C a : F[X]).Monic := monic_X_pow_sub_C a two_ne_zero
  have hdeg : (X ^ 2 - C a : F[X]).natDegree = 2 := natDegree_X_pow_sub_C
  rw [hmon.irreducible_iff_roots_eq_zero_of_degree_le_three (by omega) (by omega)]
  refine Multiset.eq_zero_of_forall_notMem fun x hx => ?_
  rw [mem_roots hmon.ne_zero, IsRoot, eval_sub, eval_pow, eval_X, eval_C, sub_eq_zero] at hx
  exact h x hx

/-- The Frobenius argument in a quadratic extension `M` of `H_c` generated by `√d` (PROVED). -/
theorem sqrt_mem_of_quadratic {d : ℤ} (hd : d % 4 = 1)
    {χ : Pic (conductorOrder K c) →* ℂˣ} (hχ : IsQuadRingClassChar K c d χ)
    (M : Type) [Field M] [NumberField M] [Algebra (ringClassField (conductorOrder K c)) M]
    [Algebra K M] [IsScalarTower K (ringClassField (conductorOrder K c)) M]
    (hrank : Module.finrank (ringClassField (conductorOrder K c)) M = 2) (t : M)
    (ht : t ^ 2 = (d : M)) :
    ∃ u : ringClassField (conductorOrder K c), u ^ 2 = (d : ringClassField (conductorOrder K c)) := by
  have : Module.Free (ringClassField (conductorOrder K c)) M := Module.Free.of_divisionRing _ _
  have : Module.Finite (ringClassField (conductorOrder K c)) M :=
    Module.finite_of_finrank_pos (by rw [hrank]; norm_num)
  have : Algebra.IsQuadraticExtension (ringClassField (conductorOrder K c)) M := ⟨hrank⟩
  have hcard : Nat.card (M ≃ₐ[ringClassField (conductorOrder K c)] M) = 2 := by
    rw [IsGalois.card_aut_eq_finrank, hrank]
  have : Group.IsSolvable (M ≃ₐ[ringClassField (conductorOrder K c)] M) := by
    refine Group.isSolvable_of_comm fun a b => ?_
    by_cases ha : a = 1
    · rw [ha, one_mul, mul_one]
    by_cases hb : b = 1
    · rw [hb, one_mul, mul_one]
    rw [eq_of_ne_one_of_card_two hcard ha hb]
  -- the excluded primes
  have hd0 : d ≠ 0 := by rintro rfl; norm_num at hd
  set I : Ideal (𝓞 K) := (conductorOrder K c).conductor * Ideal.span {((2 * d : ℤ) : 𝓞 K)}
  have hI : I ≠ 0 := by
    refine mul_ne_zero (conductorOrder K c).conductor_ne_bot ?_
    rw [Ne, Ideal.zero_eq_bot, Ideal.span_singleton_eq_bot]
    exact_mod_cast (mul_ne_zero two_ne_zero hd0 : (2 * d : ℤ) ≠ 0)
  set S := (Ideal.finite_factors hI).toFinset
  have hgen := closure_isArithFrobAt_eq_top_tower (K := K) (L := ringClassField (conductorOrder K c))
    (M := M) S
  -- `t` as an integer of `M`
  have hint : IsIntegral ℤ t := IsIntegral.of_pow (n := 2) (by norm_num)
    (by rw [ht, ← eq_intCast (algebraMap ℤ M) d]; exact isIntegral_algebraMap)
  set t' : 𝓞 M := ⟨t, hint⟩
  have ht' : t' ^ 2 = (d : 𝓞 M) := by apply RingOfIntegers.ext; push_cast; exact ht
  -- the stabilizer of `t`
  let Fix : Subgroup (M ≃ₐ[ringClassField (conductorOrder K c)] M) :=
    { carrier := {τ | τ t = t}
      one_mem' := rfl
      mul_mem' := fun {a b} ha hb => by
        show (a * b) t = t
        rw [AlgEquiv.mul_apply, show b t = t from hb, show a t = t from ha]
      inv_mem' := fun {a} ha => by
        show a⁻¹ t = t
        conv_lhs => rw [← show a t = t from ha]
        exact AlgEquiv.symm_apply_apply a t }
  have hle : Subgroup.closure {τ : M ≃ₐ[ringClassField (conductorOrder K c)] M | ∃ v ∉ S,
      ∃ Q : {Q : HeightOneSpectrum (𝓞 M) // Q.asIdeal.LiesOver v.asIdeal},
        IsArithFrobAt (𝓞 (ringClassField (conductorOrder K c))) τ Q.1.asIdeal} ≤ Fix := by
    rw [Subgroup.closure_le]
    rintro τ ⟨v, hv, Q, hτ⟩
    have hvI : ¬ v.asIdeal ∣ I := by simpa [S] using hv
    have hvc : ¬ v.asIdeal ∣ (conductorOrder K c).conductor :=
      fun h => hvI (dvd_mul_of_dvd_left h _)
    have h2d : ((2 * d : ℤ) : 𝓞 K) ∉ v.asIdeal := fun h =>
      hvI (dvd_mul_of_dvd_right (Ideal.dvd_span_singleton.mpr h) _)
    have hdv : ((d : ℤ) : 𝓞 K) ∉ v.asIdeal := fun h => h2d (by
      push_cast; exact v.asIdeal.mul_mem_left 2 h)
    have := v.isMaximal
    have := Q.2
    set w : Ideal (𝓞 (ringClassField (conductorOrder K c))) :=
      Q.1.asIdeal.under (𝓞 (ringClassField (conductorOrder K c)))
    have hwv : w.LiesOver v.asIdeal := by
      constructor
      rw [Ideal.under_under]
      exact Q.2.over
    have hwne : w ≠ ⊥ := by
      intro h0
      apply v.ne_bot
      rw [hwv.over, h0]
      exact Ideal.comap_bot_of_injective _ (FaithfulSMul.algebraMap_injective (𝓞 K) _)
    have : w.IsMaximal := Ideal.IsPrime.isMaximal inferInstance hwne
    have h2dw : ((2 * d : ℤ) : 𝓞 (ringClassField (conductorOrder K c))) ∉ w := by
      intro h
      apply h2d
      rw [hwv.over]
      show algebraMap (𝓞 K) _ ((2 * d : ℤ) : 𝓞 K) ∈ w
      rw [map_intCast]; exact h
    have hfrob := frob_smul_sqrt (K := ringClassField (conductorOrder K c)) (L := M) hd t' ht' τ
      Q.1.asIdeal w h2dw hτ
    -- the Jacobi symbol is `χ([v])^f = 1`
    have hnorm := Ideal.absNorm_pow_inertiaDeg (R := 𝓞 K) v.asIdeal w
    have hord := orderOf_picClass_eq_inertiaDeg (conductorOrder K c)
      ⟨v.asIdeal, mem_primeTo_of_not_dvd hvc⟩ w
    have hval := hχ.2 v (mem_primeTo_of_not_dvd hvc) hdv
    have hJ : jacobiSym (Ideal.absNorm w) d.natAbs = 1 := by
      rw [← hnorm, Nat.cast_pow, jacobiSym.pow_left, ← hord]
      have h1 : ((jacobiSym (Ideal.absNorm v.asIdeal) d.natAbs ^ orderOf
          ((conductorOrder K c).picClass ⟨v.asIdeal, mem_primeTo_of_not_dvd hvc⟩) : ℤ) : ℂ) = 1 := by
        push_cast
        have : ((jacobiSym (Ideal.absNorm v.asIdeal) d.natAbs : ℤ) : ℂ) =
            ((χ ((conductorOrder K c).picClass ⟨v.asIdeal, mem_primeTo_of_not_dvd hvc⟩) : ℂˣ) : ℂ) :=
          hval.symm
        rw [this, ← Units.val_pow_eq_pow_val, ← map_pow, pow_orderOf_eq_one, map_one, Units.val_one]
      exact_mod_cast h1
    show τ t = t
    have hτt : τ t = ((τ • t' : 𝓞 M) : M) := rfl
    rw [hτt, hfrob, hJ, Int.cast_one, one_mul]
    rfl
  have hall : ∀ τ : M ≃ₐ[ringClassField (conductorOrder K c)] M, τ t = t := fun τ =>
    hle (hgen ▸ Subgroup.mem_top τ)
  obtain ⟨u, hu⟩ := (IsGalois.mem_range_algebraMap_iff_fixed
    (F := ringClassField (conductorOrder K c)) t).mpr hall
  refine ⟨u, (algebraMap (ringClassField (conductorOrder K c)) M).injective ?_⟩
  rw [map_pow, hu, ht, map_intCast]

/-- **`√d ∈ H_c`** (PROVED): if `χ_d ∘ N` is (the restriction to primes of) a quadratic character of
`Pic(O_c)`, then `d` is a square in the ring class field. -/
theorem exists_sqrt_mem_ringClassField {d : ℤ} (hd : d % 4 = 1)
    {χ : Pic (conductorOrder K c) →* ℂˣ} (hχ : IsQuadRingClassChar K c d χ) :
    ∃ s : ringClassField (conductorOrder K c), s ^ 2 = (d : ringClassField (conductorOrder K c)) := by
  by_contra hno
  push Not at hno
  have hirr := irreducible_X_sq_sub hno
  have : Fact (Irreducible (X ^ 2 - C (d : ringClassField (conductorOrder K c)))) := ⟨hirr⟩
  have hmon : (X ^ 2 - C (d : ringClassField (conductorOrder K c))).Monic :=
    monic_X_pow_sub_C _ two_ne_zero
  have hpdeg : (X ^ 2 - C (d : ringClassField (conductorOrder K c))).natDegree = 2 :=
    natDegree_X_pow_sub_C
  have hfin : Module.Finite (ringClassField (conductorOrder K c))
      (AdjoinRoot (X ^ 2 - C (d : ringClassField (conductorOrder K c)))) :=
    (AdjoinRoot.powerBasis hmon.ne_zero).finite
  have : Module.Free (ringClassField (conductorOrder K c))
      (AdjoinRoot (X ^ 2 - C (d : ringClassField (conductorOrder K c)))) :=
    Module.Free.of_basis (AdjoinRoot.powerBasis hmon.ne_zero).basis
  have hrank : Module.finrank (ringClassField (conductorOrder K c))
      (AdjoinRoot (X ^ 2 - C (d : ringClassField (conductorOrder K c)))) = 2 := by
    rw [(AdjoinRoot.powerBasis hmon.ne_zero).finrank, AdjoinRoot.powerBasis_dim, hpdeg]
  have : NumberField (AdjoinRoot (X ^ 2 - C (d : ringClassField (conductorOrder K c)))) :=
    NumberField.of_module_finite (ringClassField (conductorOrder K c)) _
  have ht : (AdjoinRoot.root (X ^ 2 - C (d : ringClassField (conductorOrder K c)))) ^ 2 =
      ((d : ℤ) : AdjoinRoot (X ^ 2 - C (d : ringClassField (conductorOrder K c)))) := by
    have := AdjoinRoot.eval₂_root (X ^ 2 - C (d : ringClassField (conductorOrder K c)))
    rw [eval₂_sub, eval₂_X_pow, eval₂_C, sub_eq_zero] at this
    exact this.trans (map_intCast _ _)
  obtain ⟨u, hu⟩ := sqrt_mem_of_quadratic hd hχ _ hrank _ ht
  exact hno u hu

end

end ZInQ.Contrib.CloudB3RC53.GenusOdd
