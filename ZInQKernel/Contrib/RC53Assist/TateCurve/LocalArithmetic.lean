/-!
# Independent local-field inputs for the Tate readings

The remaining local-field inputs concern the unramified extension and its
Frobenius, not elliptic curves or Tate-module coordinates.

Locators: Serre, *Local Fields*, English translation, Springer GTM 67,
III, §5 (Unramified Extensions) and I, §8 (Frobenius Substitution).
The table-of-contents locators were checked; theorem bodies and pages were
not checked. The statements are mathematical transcriptions, not claimed
verbatim quotations. The elliptic-curve semistability input is the indicated
specialization of Silverberg-Zarhin, *Reduction of Abelian Varieties*,
arXiv:alg-geom/9602014v2, Theorem 4.1, PDF page 4; text body read. Its
original references are SGA 7 I, IX, Proposition 3.5 and Corollaire 3.8;
those original pages have not been checked.

These are proposition parameters. They are not new axioms and contain no
basis, Kummer cocycle, or coinvariant conclusion.
-/

noncomputable section

set_option maxHeartbeats 800000

namespace ZInQ.Contrib.RC53Assist.TateCurve

open Module TauCeti
open ZInQ.Contrib.RC53Assist.GlobalTrace
open ZInQ.Contrib.RC53Assist.NewformGlueG0.Completion
open ZInQ.Contrib.RC53Assist.NewformPeriodsDictionary
open scoped Classical WithZero

/-- **GLUE (a reading, not a located printed statement)**: the field fixed by
inertia is the maximal unramified extension; its value group is the same
as the base field's. The displayed consequence says that a fixed nonzero
algebraic element has the value of a base-field element.
Locator: Serre, *Local Fields*, III, §5. Section locator checked in the
contents; theorem body and page not checked. -/
def LocalUnramifiedValueGroupPrint : Prop :=
  ∀ (p : ℕ) (hp : p.Prime) (Γ : Type) [LinearOrderedCommGroupWithZero Γ]
    (w : Valuation (AlgebraicClosure ((primeIdealQ p hp).adicCompletion ℚ)) Γ),
    (w.comap (algebraMap ((primeIdealQ p hp).adicCompletion ℚ)
      (AlgebraicClosure ((primeIdealQ p hp).adicCompletion ℚ)))).IsEquiv
      (Valued.v : Valuation ((primeIdealQ p hp).adicCompletion ℚ) ℤᵐ⁰) →
    ∀ x : (AlgebraicClosure ((primeIdealQ p hp).adicCompletion ℚ))ˣ,
      (∀ σ ∈ localInertia w, Units.map σ.toAlgHom.toMonoidHom x = x) →
      ∃ a : ((primeIdealQ p hp).adicCompletion ℚ)ˣ,
        w (x : AlgebraicClosure ((primeIdealQ p hp).adicCompletion ℚ)) =
          w (algebraMap ((primeIdealQ p hp).adicCompletion ℚ)
            (AlgebraicClosure ((primeIdealQ p hp).adicCompletion ℚ)) (a : _))

/-- **GLUE (a reading, not a located printed statement)**: the unramified Galois
quotient is procyclic, topologically generated by arithmetic Frobenius.
Its open-subgroup formulation below is independent of elliptic curves.
Locators: Serre, *Local Fields*, I, §8 and III, §5. Section locators checked
in the contents; theorem bodies and pages not checked. -/
def LocalFrobeniusGenerationPrint : Prop :=
  ∀ (p : ℕ) (hp : p.Prime) (Γ : Type) [LinearOrderedCommGroupWithZero Γ]
    (w : Valuation (AlgebraicClosure ((primeIdealQ p hp).adicCompletion ℚ)) Γ),
    (w.comap (algebraMap ((primeIdealQ p hp).adicCompletion ℚ)
      (AlgebraicClosure ((primeIdealQ p hp).adicCompletion ℚ)))).IsEquiv
      (Valued.v : Valuation ((primeIdealQ p hp).adicCompletion ℚ) ℤᵐ⁰) →
    ∀ σ : LocalGaloisQ p hp,
      IsArithmeticFrobeniusOnClosureQ (primeIdealQ p hp) Γ w σ →
      ∀ H : Subgroup (LocalGaloisQ p hp), IsOpen (H : Set (LocalGaloisQ p hp)) →
        localInertia w ≤ H → σ ∈ H → H = ⊤

/-- **PRINT INPUT, MULTIPLICATIVE SPECIALIZATION**: semistable reduction
makes every inertia operator unipotent on the integral Tate module.
Locator: Silverberg-Zarhin, *Reduction of Abelian Varieties*,
arXiv:alg-geom/9602014v2, Theorem 4.1(i)-(ii), PDF page 4; text body read.
Its proof cites SGA 7 I, Exposé IX, Proposition 3.5 and Corollaire 3.8;
those original pages have not been checked. No twist character or basis
formula is an input. This source is not one of the manuscript's bibliography entries
(the manuscript cites a different Silverberg-Zarhin paper, Theorem 3.5). -/
def LocalSemistableTatePrint : Prop :=
  ∀ (E : WeierstrassCurve ℚ) [E.IsElliptic] (p : ℕ) (hp : p.Prime)
    (ℓ : ℕ) [Fact ℓ.Prime], ℓ ≠ p →
    ((E.baseChange ((primeIdealQ p hp).adicCompletion ℚ)).minimal
      ((primeIdealQ p hp).adicCompletionIntegers ℚ)).HasMultiplicativeReduction
        ((primeIdealQ p hp).adicCompletionIntegers ℚ) →
    ∀ (Γ : Type) [LinearOrderedCommGroupWithZero Γ]
      (w : Valuation (AlgebraicClosure ((primeIdealQ p hp).adicCompletion ℚ)) Γ),
      (w.comap (algebraMap ((primeIdealQ p hp).adicCompletion ℚ)
        (AlgebraicClosure ((primeIdealQ p hp).adicCompletion ℚ)))).IsEquiv
        (Valued.v : Valuation ((primeIdealQ p hp).adicCompletion ℚ) ℤᵐ⁰) →
      ∀ σ ∈ localInertia w, IsNilpotent
        ((E.baseChange ((primeIdealQ p hp).adicCompletion ℚ)).tateModuleGaloisRepresentation
          ℓ σ - 1)

section RootMotion

/-- **PROVED**: powers of an integer at least two eventually exceed any
integer bound. The stated uniform bound is enough for the divisibility
argument. Locator: induction on the exponent. -/
theorem nat_lt_two_power (n : ℕ) : n < 2 ^ n := by
  induction n with
  | zero => norm_num
  | succ n ih =>
    have hp : 0 < 2 ^ n := by positivity
    rw [pow_succ]
    omega

/-- **PROVED FROM THE UNRAMIFIED VALUE-GROUP PRINT**: inertia moves some
compatible root of an admissible parameter. Otherwise its valuation would
be divisible by every power of `ℓ`, hence zero. No Kummer cocycle or
Tate-module assertion is an input.
Locator: Serre, *Local Fields*, III, §5 and the displayed integer divisibility
argument. -/
theorem inertia_moves_parameter_root (hV : LocalUnramifiedValueGroupPrint)
    (p : ℕ) (hp : p.Prime) (ℓ : ℕ) [Fact ℓ.Prime]
    (Γ : Type) [LinearOrderedCommGroupWithZero Γ]
    (w : Valuation (AlgebraicClosure ((primeIdealQ p hp).adicCompletion ℚ)) Γ)
    (hw : (w.comap (algebraMap ((primeIdealQ p hp).adicCompletion ℚ)
      (AlgebraicClosure ((primeIdealQ p hp).adicCompletion ℚ)))).IsEquiv
      (Valued.v : Valuation ((primeIdealQ p hp).adicCompletion ℚ) ℤᵐ⁰))
    (q : ((primeIdealQ p hp).adicCompletion ℚ)ˣ)
    (hq : Valued.v (q : (primeIdealQ p hp).adicCompletion ℚ) < 1)
    (S : KummerRoots (closureParameter q) ℓ) :
    ∃ σ ∈ localInertia w, ∃ n, Units.map σ.toAlgHom.toMonoidHom (S.root n) ≠ S.root n := by
  classical
  let K := (primeIdealQ p hp).adicCompletion ℚ
  let F := AlgebraicClosure K
  have hq0 : (Valued.v : Valuation K ℤᵐ⁰) (q : K) ≠ 0 :=
    (Valuation.ne_zero_iff _).mpr q.ne_zero
  cases hqv : (Valued.v : Valuation K ℤᵐ⁰) (q : K) with
  | zero => exact (hq0 hqv).elim
  | coe z =>
    have hz0 : Multiplicative.toAdd z ≠ 0 := by
      intro hz
      have hz1 : z = 1 := by exact congrArg Multiplicative.ofAdd hz
      rw [hqv, hz1, WithZero.coe_one] at hq
      exact lt_irrefl _ hq
    by_contra hmove
    push Not at hmove
    have hdiv : ∀ n, ((ℓ ^ n : ℕ) : ℤ) ∣ Multiplicative.toAdd z := by
      intro n
      obtain ⟨a, ha⟩ := hV p hp Γ w hw (S.root n) (fun σ hσ => hmove σ hσ n)
      have hs := congrArg (fun u : Fˣ => w (u : F)) (S.root_power n)
      simp only [Units.val_pow_eq_pow_val] at hs
      change w ((S.root n : F) ^ (ℓ ^ n)) = w (algebraMap K F (q : K)) at hs
      have hpow : w (algebraMap K F ((a : K) ^ (ℓ ^ n))) =
          w (algebraMap K F (q : K)) := by
        calc
          w (algebraMap K F ((a : K) ^ (ℓ ^ n))) =
              w (algebraMap K F (a : K)) ^ (ℓ ^ n) := by rw [map_pow, map_pow]
          _ = w (S.root n : F) ^ (ℓ ^ n) := by rw [← ha]
          _ = w ((S.root n : F) ^ (ℓ ^ n)) := (map_pow w _ _).symm
          _ = w (algebraMap K F (q : K)) := hs
      have hb : (Valued.v : Valuation K ℤᵐ⁰) ((a : K) ^ (ℓ ^ n)) =
          Valued.v (q : K) :=
        le_antisymm ((hw _ _).mp hpow.le) ((hw _ _).mp hpow.symm.le)
      rw [map_pow, hqv] at hb
      have ha0 : (Valued.v : Valuation K ℤᵐ⁰) (a : K) ≠ 0 :=
        (Valuation.ne_zero_iff _).mpr a.ne_zero
      cases hav : (Valued.v : Valuation K ℤᵐ⁰) (a : K) with
      | zero => exact (ha0 hav).elim
      | coe y =>
        rw [hav, ← WithZero.coe_pow] at hb
        have hi := congrArg Multiplicative.toAdd (WithZero.coe_injective hb)
        change (ℓ ^ n) • Multiplicative.toAdd y = Multiplicative.toAdd z at hi
        rw [nsmul_eq_mul] at hi
        exact ⟨Multiplicative.toAdd y, hi.symm⟩
    let m := (Multiplicative.toAdd z).natAbs
    have hm : 0 < m := Int.natAbs_pos.mpr hz0
    have hnat : ℓ ^ m ∣ m := by
      have h := Int.natAbs_dvd_natAbs.mpr (hdiv m)
      simpa only [Int.natAbs_natCast, m] using h
    have hle : ℓ ^ m ≤ m := Nat.le_of_dvd hm hnat
    have hlt : m < ℓ ^ m := (nat_lt_two_power m).trans_le
      (Nat.pow_le_pow_left (Fact.out : ℓ.Prime).two_le m)
    exact not_le_of_gt hlt hle

end RootMotion

end ZInQ.Contrib.RC53Assist.TateCurve
