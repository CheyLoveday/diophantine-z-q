import ZInQKernel.Contrib.RC53Assist.TateCurve.PrescribedBasis

/-!
# Kummer generators from a multiplicative uniformization

A surjective homomorphism from the multiplicative group of a field, with
kernel generated by an infinite-order element `q`, identifies the point group
with `Fˣ / q^ℤ`. Compatible primitive roots of unity and compatible roots of
`q` then give the two generators of its Tate module.

Reference: Silverman, *The Arithmetic of Elliptic Curves*, Appendix C, §14
and III.7. Pages have not been checked. The construction and the independence
calculation below are proved, not supplied as Tate-module readings.
-/

noncomputable section

set_option maxHeartbeats 800000

namespace ZInQ.Contrib.RC53Assist.TateCurve

open TauCeti Module

section Uniformization

variable {F P : Type*} [Field F] [AddCommGroup P] (q : Fˣ)

/-- **DEFINITION**: a multiplicative uniformization, in its equivalent
surjective-homomorphism form with kernel exactly `q^ℤ`.
Locator: Silverman, Appendix C, §14; pages not checked. -/
structure MultiplicativeUniformization where
  map : Additive Fˣ →+ P
  surjective : Function.Surjective map
  kernel : ∀ x : Fˣ, map (Additive.ofMul x) = 0 ↔ ∃ m : ℤ, x = q ^ m

/-- **DEFINITION**: the two compatible root systems. This contains no basis,
Galois representation, inertia assertion, or coinvariant conclusion.
Locator: the elementary root choices in Kummer theory. -/
structure KummerRoots (ℓ : ℕ) where
  unity : ℕ → Fˣ
  root : ℕ → Fˣ
  primitive : ∀ n, IsPrimitiveRoot (unity n) (ℓ ^ n)
  root_power : ∀ n, root n ^ (ℓ ^ n) = q
  unity_step : ∀ n, unity (n + 1) ^ ℓ = unity n
  root_step : ∀ n, root (n + 1) ^ ℓ = root n

variable {q}

/-- **PROVED**: the parameter maps to the identity point.
Locator: the exact kernel of the uniformization. -/
theorem uniformization_parameter_zero (U : MultiplicativeUniformization (P := P) q) :
    U.map (Additive.ofMul q) = 0 :=
  (U.kernel q).mpr ⟨1, by simp⟩

/-- **PROVED DEFINITION**: the finite-level root-of-unity point.
Locator: `KummerRoots.primitive`. -/
def unityLevel {ℓ : ℕ} (U : MultiplicativeUniformization (P := P) q)
    (S : KummerRoots q ℓ) (n : ℕ) : TateModuleLevel ℓ P n :=
  ⟨U.map (Additive.ofMul (S.unity n)), by
    apply AddSubgroup.torsionBy.nsmul_iff.mpr
    rw [← map_nsmul]
    change U.map (Additive.ofMul (S.unity n ^ (ℓ ^ n))) = 0
    rw [(S.primitive n).pow_eq_one]
    exact map_zero _⟩

/-- **PROVED DEFINITION**: the finite-level point from a root of `q`.
Locator: `KummerRoots.root_power` and the exact uniformization kernel. -/
def rootLevel {ℓ : ℕ} (U : MultiplicativeUniformization (P := P) q)
    (S : KummerRoots q ℓ) (n : ℕ) : TateModuleLevel ℓ P n :=
  ⟨U.map (Additive.ofMul (S.root n)), by
    apply AddSubgroup.torsionBy.nsmul_iff.mpr
    rw [← map_nsmul]
    change U.map (Additive.ofMul (S.root n ^ (ℓ ^ n))) = 0
    rw [S.root_power]
    exact uniformization_parameter_zero U⟩

/-- **PROVED DEFINITION**: the compatible roots of unity as a Tate-module
point. Locator: `KummerRoots.unity_step`. -/
def unityTate {ℓ : ℕ} (U : MultiplicativeUniformization (P := P) q)
    (S : KummerRoots q ℓ) : TateModule ℓ P :=
  TateModule.mk (unityLevel U S) fun n => Subtype.ext <| by
    change ℓ • U.map (Additive.ofMul (S.unity (n + 1))) =
      U.map (Additive.ofMul (S.unity n))
    rw [← map_nsmul]
    change U.map (Additive.ofMul (S.unity (n + 1) ^ ℓ)) = _
    rw [S.unity_step]

/-- **PROVED DEFINITION**: the compatible roots of `q` as a Tate-module
point. Locator: `KummerRoots.root_step`. -/
def rootTate {ℓ : ℕ} (U : MultiplicativeUniformization (P := P) q)
    (S : KummerRoots q ℓ) : TateModule ℓ P :=
  TateModule.mk (rootLevel U S) fun n => Subtype.ext <| by
    change ℓ • U.map (Additive.ofMul (S.root (n + 1))) =
      U.map (Additive.ofMul (S.root n))
    rw [← map_nsmul]
    change U.map (Additive.ofMul (S.root (n + 1) ^ ℓ)) = _
    rw [S.root_step]

/-- **PROVED**: natural powers commute with integer powers.
Locator: `zpow_mul`. -/
theorem power_zpower_commute (x : Fˣ) (a : ℤ) (N : ℕ) :
    (x ^ a) ^ N = (x ^ N) ^ a := by
  simp only [← zpow_natCast, ← zpow_mul, mul_comm]

/-- **PROVED**: the Kummer generators have no nontrivial relation modulo
`N`. Raise a relation to the `N`-th power, use the infinite order of `q` to
show that its root exponent is divisible by `N`, then use primitivity for
the root-of-unity exponent. Locator: the exact uniformization kernel. -/
theorem kummer_relation_divisibility (U : MultiplicativeUniformization (P := P) q)
    (hq : Function.Injective fun m : ℤ => q ^ m) (N : ℕ)
    (ζ r : Fˣ) (hζ : IsPrimitiveRoot ζ N) (hr : r ^ N = q)
    (a b : ℤ) (h : U.map (Additive.ofMul (ζ ^ a * r ^ b)) = 0) :
    (N : ℤ) ∣ a ∧ (N : ℤ) ∣ b := by
  obtain ⟨m, hm⟩ := (U.kernel _).mp h
  have hpow := congrArg (fun x : Fˣ => x ^ N) hm
  rw [mul_pow, power_zpower_commute, power_zpower_commute,
    hζ.pow_eq_one, one_zpow, one_mul, hr, power_zpower_commute] at hpow
  have hb : b = (N : ℤ) * m := by
    apply hq
    simpa only [zpow_mul, zpow_natCast] using hpow
  have hrb : r ^ b = q ^ m := by rw [hb, zpow_mul, zpow_natCast, hr]
  rw [hrb] at hm
  have hζa : ζ ^ a = 1 := by
    apply mul_right_cancel (b := q ^ m)
    simpa only [one_mul] using hm
  exact ⟨(hζ.zpow_eq_one_iff_dvd a).mp hζa, ⟨m, hb⟩⟩

variable {ℓ : ℕ} [Fact ℓ.Prime]

/-- **DEFINITION**: the ordered family `(e₀,e₁)` supplied by the root
systems. Locator: `unityTate` and `rootTate`. -/
def kummerFamily (U : MultiplicativeUniformization (P := P) q) (S : KummerRoots q ℓ) :
    Fin 2 → TateModule ℓ P := ![unityTate U S, rootTate U S]

/-- **PROVED**: independence of the Kummer family at each finite level.
Locator: `kummer_relation_divisibility`. -/
theorem kummer_level_injective (U : MultiplicativeUniformization (P := P) q)
    (S : KummerRoots q ℓ) (hq : Function.Injective fun m : ℤ => q ^ m) (n : ℕ) :
    Function.Injective fun c : Fin 2 → ZMod (ℓ ^ n) =>
      ∑ i, c i • TateModule.proj n (kummerFamily U S i) := by
  classical
  have : NeZero ℓ := ⟨(Fact.out : ℓ.Prime).ne_zero⟩
  have hz : ∀ c : Fin 2 → ZMod (ℓ ^ n),
      (∑ i, c i • TateModule.proj n (kummerFamily U S i)) = 0 → c = 0 := by
    intro c hc
    have hcP := congrArg Subtype.val hc
    simp only [Fin.sum_univ_two, AddSubgroup.coe_add, TateModule.coe_zmod_smul,
      kummerFamily, Matrix.cons_val_zero, Matrix.cons_val_one, TateModule.proj_mk,
      unityTate, rootTate, unityLevel, rootLevel, ZeroMemClass.coe_zero] at hcP
    have hrel : U.map (Additive.ofMul
        (S.unity n ^ ((c 0).val : ℤ) * S.root n ^ ((c 1).val : ℤ))) = 0 := by
      change U.map (((c 0).val : ℤ) • Additive.ofMul (S.unity n) +
        ((c 1).val : ℤ) • Additive.ofMul (S.root n)) = 0
      rw [map_add, map_zsmul, map_zsmul]
      simpa only [natCast_zsmul] using hcP
    obtain ⟨ha, hb⟩ := kummer_relation_divisibility U hq (ℓ ^ n)
      (S.unity n) (S.root n) (S.primitive n) (S.root_power n) _ _ hrel
    funext i
    fin_cases i
    · change c 0 = 0
      rw [← ZMod.natCast_zmod_val (c 0), ZMod.natCast_eq_zero_iff]
      exact_mod_cast ha
    · change c 1 = 0
      rw [← ZMod.natCast_zmod_val (c 1), ZMod.natCast_eq_zero_iff]
      exact_mod_cast hb
  intro c d hcd
  apply sub_eq_zero.mp
  apply hz
  simpa only [Pi.sub_apply, sub_smul, Finset.sum_sub_distrib, sub_eq_zero] using hcd

/-- **PROVED DEFINITION**: the Kummer basis of the Tate module. The only
cardinality input is the usual size `N²` of elliptic-curve torsion; no
representation-shape or coinvariant assertion is assumed.
Locator: `kummer_level_injective` and `prescribedTateBasis`. -/
def kummerTateBasis (U : MultiplicativeUniformization (P := P) q) (S : KummerRoots q ℓ)
    (hq : Function.Injective fun m : ℤ => q ^ m)
    (hcard : ∀ n, Nat.card (TateModuleLevel ℓ P n) = (ℓ ^ n) ^ 2) :
    Basis (Fin 2) ℤ_[ℓ] (TateModule ℓ P) :=
  prescribedTateBasis (kummerFamily U S) hcard (kummer_level_injective U S hq)

/-- **PROVED**: the first basis vector is the compatible roots of unity.
Locator: `prescribedTateBasis_apply`. -/
theorem kummerTateBasis_zero (U : MultiplicativeUniformization (P := P) q)
    (S : KummerRoots q ℓ) (hq : Function.Injective fun m : ℤ => q ^ m)
    (hcard : ∀ n, Nat.card (TateModuleLevel ℓ P n) = (ℓ ^ n) ^ 2) :
    kummerTateBasis U S hq hcard 0 = unityTate U S :=
  prescribedTateBasis_apply _ _ _ _

/-- **PROVED**: the second basis vector is the compatible roots of `q`.
Locator: `prescribedTateBasis_apply`. -/
theorem kummerTateBasis_one (U : MultiplicativeUniformization (P := P) q)
    (S : KummerRoots q ℓ) (hq : Function.Injective fun m : ℤ => q ^ m)
    (hcard : ∀ n, Nat.card (TateModuleLevel ℓ P n) = (ℓ ^ n) ^ 2) :
    kummerTateBasis U S hq hcard 1 = rootTate U S :=
  prescribedTateBasis_apply _ _ _ _

end Uniformization

end ZInQ.Contrib.RC53Assist.TateCurve
