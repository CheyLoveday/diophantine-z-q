/-- **A number field generated by the square root of a negative integer is totally complex**
(PROVED). -/
theorem isTotallyComplex_of_sqrt {K : Type} [Field K] [NumberField K] {r : K} {k : ℤ}
    (hr : r ^ 2 = ((k : ℤ) : K)) (hk : k < 0) : IsTotallyComplex K := by
  refine ⟨fun v => ?_⟩
  by_contra h
  rw [InfinitePlace.not_isComplex_iff_isReal] at h
  have e := congrArg (InfinitePlace.embedding_of_isReal h) hr
  rw [map_pow, map_intCast] at e
  have h0 : (0 : ℝ) ≤ (InfinitePlace.embedding_of_isReal h r) ^ 2 := sq_nonneg _
  have hk' : ((k : ℤ) : ℝ) < 0 := by exact_mod_cast hk
  linarith

variable {ℓ : ℕ} [(Ecurve ℓ).IsElliptic] {C : TateCoef (Ecurve ℓ)} {D : RCData ℓ}
  {Fam : Family} {x : Addr Fam.b} {Ψ : FamilyMovingCharacter C.K ℓ Fam.Q}
  (P : StagedPresentation C D Fam x Ψ)

omit [(Ecurve ℓ).IsElliptic] in
/-- `P.S s` is finite (PROVED from the named finiteness of `P.S₀ s` and of the chain indices). -/
theorem staged_finite (s : ℕ) [Finite P.ι] (hS0fin : (P.S₀ s).Finite) : (P.S s).Finite :=
  hS0fin.union (Set.finite_range P.pl)

/-- **The producer bounds of the standard-old family for the staged presentation** (PROVED from
the contributor's `standardOld_producerBounds`, with `hTor`, `hK`, `h2`, `hSfin` derived and the
Milne prints named). -/
theorem standardOld_producerBounds_staged (s : ℕ) [Finite P.ι] (hS0fin : (P.S₀ s).Finite)
    (hk0 : D.kfin < 0)
    (h410 : MilneADT_I_4_10_totallyComplex) (hlcd : MilneLocalDimensionTwo)
    (hloc : MilneLocalFiniteness) (hglob : MilneGlobalFiniteness)
    [∀ v : Places C.K (P.S s), DecidableEq (v.1.adicCompletion C.K)]
    (Bv : ∀ v : Places C.K (P.S s), WeierstrassCurve (v.1.adicCompletion C.K))
    [∀ v, (Bv v).IsElliptic]
    (label : ℕ → Places C.K (P.S s) → ℕ) (m : ℕ → ℕ) [∀ i, NeZero (m i)]
    (ι : ∀ i (v : Places C.K (P.S s)), TorsAlg (v.1.adicCompletion C.K) (Bv v) (m i) →+
      ResMod (locMap C.K (P.S s) v.1) (MinS (P.hS s) ((Ecurve ℓ).baseChange C.K) i (P.alphaF s i)))
    (hι : ∀ i (v : Places C.K (P.S s)) (g : Gloc C.K v.1) t, ι i v (g • t) = g • ι i v t) :
    ∃ B : ℕ,
      (∀ i [NeZero i] (n : ℤ), n < 0 ∨ 3 < n → Module.finrank (ResidueField (Acoef i))
        (residualCohomologyAt (selCx (actualSelData (P.hS s) ((Ecurve ℓ).baseChange C.K) i
          (P.alphaF s i)
          (fun v _ => standardOldAt C.K (P.S s) (Acoef i)
            (MinS (P.hS s) ((Ecurve ℓ).baseChange C.K) i (P.alphaF s i))
            v (label i v) (Bv v) (m i) (ι i v) (hι i v)))) n) = 0) ∧
      (∀ i [NeZero i] (n : ℤ), Module.finrank (ResidueField (Acoef i))
        (residualCohomologyAt (selCx (actualSelData (P.hS s) ((Ecurve ℓ).baseChange C.K) i
          (P.alphaF s i)
          (fun v _ => standardOldAt C.K (P.S s) (Acoef i)
            (MinS (P.hS s) ((Ecurve ℓ).baseChange C.K) i (P.alphaF s i))
            v (label i v) (Bv v) (m i) (ι i v) (hι i v)))) n) ≤ B) := by
  have hFull := P.full s
  exact standardOld_producerBounds (P.hS s) ((Ecurve ℓ).baseChange C.K) (P.alphaF s)
    hFull.full h410 hlcd hloc hglob (isTotallyComplex_of_sqrt P.hr hk0)
    (staged_finite P s hS0fin)
    (fun v hv => P.hS s
      (ZInQ.Contrib.CloudB3RC53.Finiteness.h2_of_hasFullTwoTorsion_proof
        ((Ecurve ℓ).baseChange C.K) v hv))
    Bv label m ι hι

end ZInQ.Contrib.CloudB3E2.St0Shape
