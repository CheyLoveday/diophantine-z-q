import ZInQKernel.Contrib.OneProof.RC.Wiring.CalPointFreeLine
import ZInQKernel.Contrib.RC53Assist.CentralUniversal.Arithmetic
import ZInQKernel.Contrib.OneProof.RC.Wiring.CalPointKmIdent

/-!
# The Kummer class of a free generator generates `H¹(C_K)` modulo torsion

Manuscript `diophantine_zq.tex`, tex 3905, 4005–4014 (proof of Proposition
`ex:arith-central-calibration`): "`H¹(C_K)` … its free quotient is generated by the Kummer class
of a generator".

* **`isFreeLineGenerator_of_tmul_injective`** (PROVED): in a finitely generated `ℤ₂`-module `M`
  of free rank one, an element `h` with `d ⊗ h ≠ 0` in `ℚ₂/ℤ₂ ⊗ M` for every `d ≠ 0` generates
  `M` modulo torsion. (Its free coordinate `c` satisfies `c · d = 0 ⇒ d = 0` on `ℚ₂/ℤ₂`, so `c`
  is a unit: otherwise `c · [1/2] = 0`.)
* **`isFreeLineGenerator_of_kummer`** (PROVED): for a Kummer map `κ : E(K) → M`, a map
  `u : M ⊗ ℚ₂/ℤ₂ → A` (the universal-coefficient map into the Selmer group) and a point Kummer
  map `δ : E(K) × ℚ₂/ℤ₂ → A` with `u(κ P ⊗ d) = δ(P, d)` and `δ(gen, d) = 0 ⇒ d = 0`, the class
  `κ(gen)` generates `M` modulo torsion.
* **`hκ_arithmetic`** (PROVED): the genuine instance — `M = H¹(C_K)` of the compact Kummer complex
  of `E_ℓ` over `K = ℚ(√k)`, `u` the universal-coefficient map of the coefficient comparison `I`,
  free rank one from Selmer corank one
  (`arithmeticRank_eq_one`). The remaining inputs are named:
  * `hcomp` (GLUE, tex 4005–4014): the comparison `I` carries `κ(P) ⊗ d` to the Kummer image
    `δ(P, d)` of `P ⊗ d` in `Sel_{2^∞}(E_ℓ/K)` (the comparison is the standard one, compatible with
    the Kummer maps);
  * `hδ` (PRINT consequence, Silverman X.4.2 in the direct limit, tex 1098–1104): the Kummer map
    `E(K) ⊗ ℚ₂/ℤ₂ → Sel_{2^∞}` is injective, and `gen ⊗ d ≠ 0` for a free generator and `d ≠ 0`.

* **`hκ_central`** (PROVED): the same for lane RC34's genuine Kummer map `centralKummer G hdiv`
  into `H¹(compactCentralComplex G)` (the field `hκ` of `RetainedPointData`), along
  `compactCentral_eq_arithmetic`.

Kinds: PROVED (with the named inputs `hcomp`, `hδ`).
-/

noncomputable section

namespace ZInQ.Contrib.CloudB3E2.KappaGen

open ZInQ.Manuscript.RC.CalPoint (IsFreeLineGenerator)
open ZInQ.Manuscript.RC53Assist.CentralUniversal
open ZInQ.Manuscript.SelmerTwoPower (Q2Z2)
open scoped TensorProduct

/-! ### The free-rank-one algebra -/

section Algebra

variable {M : Type} [AddCommGroup M] [Module ℤ_[2] M] [Module.Finite ℤ_[2] M]

/-- `[1/2] ≠ 0` in `ℚ₂/ℤ₂`. Kind: PROVED. -/
theorem divisibleQuotient_half_ne_zero : divisibleQuotient ((2 : ℚ_[2])⁻¹) ≠ 0 := by
  intro h
  obtain ⟨a, ha⟩ := (coefficient_exact ((2 : ℚ_[2])⁻¹)).1 h
  have h1 : ‖(integralInclusion a : ℚ_[2])‖ ≤ 1 := a.2
  rw [ha, norm_inv] at h1
  have h2 : ‖(2 : ℚ_[2])‖ = 2⁻¹ := by exact_mod_cast Padic.norm_p (p := 2)
  rw [h2] at h1
  norm_num at h1

/-- A non-unit `c` of `ℤ₂` kills `[1/2]`. Kind: PROVED. -/
theorem smul_half_eq_zero {c : ℤ_[2]} (hc : ¬ IsUnit c) :
    c • divisibleQuotient ((2 : ℚ_[2])⁻¹) = 0 := by
  have hlt : ‖c‖ < 1 := lt_of_le_of_ne (PadicInt.norm_le_one c) (fun h =>
    hc (PadicInt.isUnit_iff.2 h))
  obtain ⟨c', rfl⟩ := (PadicInt.norm_lt_one_iff_dvd c).1 hlt
  rw [← map_smul]
  refine (coefficient_exact _).2 ⟨c', ?_⟩
  change ((c' : ℤ_[2]) : ℚ_[2]) = ((((2 : ℕ) : ℤ_[2]) * c' : ℤ_[2]) : ℚ_[2]) * (2 : ℚ_[2])⁻¹
  rw [PadicInt.coe_mul, PadicInt.coe_natCast]
  push_cast
  field_simp

/-- **A generator modulo torsion from the divisible tensor** (PROVED): in a finitely generated
`ℤ₂`-module of free rank one, if `d ⊗ h = 0` forces `d = 0`, then `h` generates the free line. -/
theorem isFreeLineGenerator_of_tmul_injective (hr : freeRank M = 1) (h : M)
    (hinj : ∀ d : Q2Z2, d ⊗ₜ[ℤ_[2]] h = 0 → d = 0) : IsFreeLineGenerator ℤ_[2] h := by
  classical
  set b := freePartBasis M
  let i₀ : Fin (freeRank M) := ⟨0, by omega⟩
  have huniq : ∀ i : Fin (freeRank M), i = i₀ := fun i => Fin.ext (by omega)
  set c : ℤ_[2] := b.equivFun ((Submodule.torsion ℤ_[2] M).mkQ h) i₀
  -- `c · d = 0 ⇒ d = 0`
  have hcd : ∀ d : Q2Z2, c • d = 0 → d = 0 := by
    intro d hd
    apply hinj
    apply (divisibleCoordinates M).injective
    rw [map_zero]
    funext i
    rw [divisibleCoordinates_tmul, huniq i]
    exact hd
  have hcu : IsUnit c := by
    by_contra hc
    exact divisibleQuotient_half_ne_zero (hcd _ (smul_half_eq_zero hc))
  obtain ⟨cu, hcu'⟩ := hcu
  -- an element of the free part with zero coordinate is zero
  have hzero : ∀ y : FreePart M, b.equivFun y i₀ = 0 → y = 0 := by
    intro y hy
    apply b.equivFun.injective
    rw [map_zero]
    funext i
    rw [huniq i]
    exact hy
  refine ⟨fun r hr0 => ?_, fun z => ?_⟩
  · have hq : (Submodule.torsion ℤ_[2] M).mkQ (r • h) = 0 :=
      (Submodule.Quotient.mk_eq_zero _).2 hr0
    have := congrArg (fun y => b.equivFun y i₀) hq
    simp only [map_smul, LinearEquiv.map_zero, Pi.smul_apply, smul_eq_mul, Pi.zero_apply] at this
    change r * c = 0 at this
    rw [← hcu'] at this
    exact (Units.mul_left_eq_zero cu).1 this
  · refine ⟨b.equivFun ((Submodule.torsion ℤ_[2] M).mkQ z) i₀ * ↑cu⁻¹, ?_⟩
    rw [← Submodule.Quotient.mk_eq_zero]
    apply hzero
    change b.equivFun ((Submodule.torsion ℤ_[2] M).mkQ (z - _ • h)) i₀ = 0
    rw [map_sub, map_smul, map_sub, map_smul, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
    change _ - _ * c = 0
    rw [← hcu', mul_assoc, Units.inv_mul, mul_one, sub_self]

end Algebra

/-! ### The Kummer class of a free generator -/

section Kummer

variable {M V A : Type} [AddCommGroup M] [Module ℤ_[2] M] [Module.Finite ℤ_[2] M]
  [AddCommGroup V] [AddCommGroup A]

/-- **The Kummer class of a free generator generates modulo torsion** (PROVED): from a map
`u : M ⊗ ℚ₂/ℤ₂ → A` and a point Kummer map `δ` compatible with `κ` (`u(κ P ⊗ d) = δ(P, d)`) and
injective on `gen` (no injectivity of `u` is needed). -/
theorem isFreeLineGenerator_of_kummer (hr : freeRank M = 1) (κ : V →+ M) (gen : V)
    (u : M ⊗[ℤ_[2]] Q2Z2 →+ A) (δ : V → Q2Z2 → A)
    (hcomp : ∀ P d, u (κ P ⊗ₜ[ℤ_[2]] d) = δ P d) (hδ : ∀ d, δ gen d = 0 → d = 0) :
    IsFreeLineGenerator ℤ_[2] (κ gen) := by
  refine isFreeLineGenerator_of_tmul_injective hr (κ gen) fun d hd => hδ d ?_
  have h0 : κ gen ⊗ₜ[ℤ_[2]] d = 0 := by
    rw [← TensorProduct.comm_tmul ℤ_[2] Q2Z2 M d (κ gen), hd, map_zero]
  rw [← hcomp, h0, map_zero]

end Kummer

/-! ### The genuine instance at the address curves -/

section Arithmetic

open NumberField IsDedekindDomain
open ZInQ.Contrib.CloudB3RC53 ZInQ.Manuscript.RC.CoefModules
open ZInQ.Manuscript.RC53Assist.QuadraticDescent
open ZInQ.Manuscript.RC (SelmerCorankOneOverK)

variable (ℓ : ℕ) (k : ℤ) [(Ecurve ℓ).IsElliptic]
  (S : Set (HeightOneSpectrum (𝓞 (QuadraticField k))))
  (hFull : ∀ n : ℕ, FullTorsion (QuadraticField k) S
    ((Ecurve ℓ).baseChange (QuadraticField k)) (2 ^ n))

/-- **`hκ` at the address curves** (PROVED from the named inputs; tex 3905, 4005–4014): for
`K = ℚ(√k)` with `k` not a square, the coefficient comparison `I`, finite generation `F`, Selmer
corank one over `K`, a Kummer map `κ : E_ℓ(K) → H¹(C_K)` and a free generator `gen`, given the
compatibility `hcomp` of `κ` with the Kummer map `δ` into `Sel_{2^∞}(E_ℓ/K)` through `I` (GLUE)
and the injectivity `hδ` of `δ` on `gen ⊗ ℚ₂/ℤ₂` (Kummer sequence, Silverman X.4.2), `κ(gen)`
generates `H¹(C_K)` modulo torsion. -/
theorem hκ_arithmetic (hk : ¬ IsSquare (k : ℚ)) (I : KummerCoefficientComparison ℓ k S hFull)
    (F : KummerCohomologyFinite ℓ k S hFull) (hSel : SelmerCorankOneOverK ℓ k) {V : Type}
    [AddCommGroup V] (κ : V →+ (arithmeticCompactComplex ℓ k S hFull).homology 1) (gen : V)
    (δ : V → Q2Z2 → SelK ℓ k)
    (hcomp : ∀ P d, arithmeticUniversalCoefficientMap ℓ k S hFull I (κ P ⊗ₜ[ℤ_[2]] d) = δ P d)
    (hδ : ∀ d, δ gen d = 0 → d = 0) :
    IsFreeLineGenerator ℤ_[2] (κ gen) := by
  have := F.finite_one
  exact isFreeLineGenerator_of_kummer (arithmeticRank_eq_one ℓ k S hFull hk I F hSel) κ gen
    (arithmeticUniversalCoefficientMap ℓ k S hFull I) δ hcomp hδ

end Arithmetic

/-! ### The calibration point: `hκ` for lane RC34's genuine Kummer map -/

section Central

open NumberField IsDedekindDomain CategoryTheory
open ZInQ.Contrib.CloudB3RC53 ZInQ.Manuscript.RC.CoefModules
open ZInQ.Manuscript.RC53Assist.QuadraticDescent
open ZInQ.Manuscript.RC (SelmerCorankOneOverK)
open ZInQ.Contrib.RC53Assist.Calibration (GenuineKummerData)
open ZInQ.Contrib.RC53Assist.CalibrationIntegral (compactCentralComplex centralCurve)
open ZInQ.Contrib.RC53Assist.CalibrationShape (compactCentral_eq_arithmetic arithmeticCentralFull)
open ZInQ.Manuscript.RC.CalPoint (centralKummer)
open ZInQ.Manuscript.RC.CalPoint (GlobalDivisionTowers)

variable (ℓ : ℕ) (k : ℤ) [(Ecurve ℓ).IsElliptic] {E₀ : WeierstrassCurve ℚ} {hZ : ℤ}
  (G : GenuineKummerData (QuadraticField k) E₀ hZ)
  (hcurve : centralCurve G = (Ecurve ℓ).baseChange (QuadraticField k))

/-- **`H¹(C_K)` of the central complex is that of the arithmetic compact complex** (the two
complexes are equal, `compactCentral_eq_arithmetic`). Kind: definition. -/
def centralH1Equiv : (compactCentralComplex G).homology 1 ≃ₗ[ℤ_[2]]
    (arithmeticCompactComplex ℓ k G.S (arithmeticCentralFull ℓ k G hcurve)).homology 1 :=
  ((HomologicalComplex.homologyFunctor (ModuleCat ℤ_[2]) (ComplexShape.up ℤ) 1).mapIso
    (eqToIso (compactCentral_eq_arithmetic ℓ k G hcurve))).toLinearEquiv

/-- **`hκ` for lane RC34's genuine Kummer map** (PROVED from the named inputs; tex 3905,
4005–4014): for Kummer data `G` over `ℚ(√k)` (`k` not a square) whose central twist is the base
change of `E_ℓ` (`hcurve`), the coefficient comparison `I`, finite generation, Selmer corank one
over `K`, and a free generator `gen`, given the compatibility `hcomp` of `centralKummer` with a
point Kummer map `δ` into `Sel_{2^∞}(E_ℓ/K)` through `I` (GLUE) and the injectivity `hδ` of `δ` on
`gen ⊗ ℚ₂/ℤ₂` (Kummer sequence), the field `hκ` of `RetainedPointData` holds:
`κ(gen)` generates `H¹(C_K)` modulo torsion. -/
theorem hκ_central (hk : ¬ IsSquare (k : ℚ))
    (I : KummerCoefficientComparison ℓ k G.S (arithmeticCentralFull ℓ k G hcurve))
    (F : KummerCohomologyFinite ℓ k G.S (arithmeticCentralFull ℓ k G hcurve))
    (hSel : SelmerCorankOneOverK ℓ k) (hdiv : GlobalDivisionTowers G.S (centralCurve G))
    (gen : (centralCurve G).toAffine.Point) (δ : (centralCurve G).toAffine.Point → Q2Z2 → SelK ℓ k)
    (hcomp : ∀ P d, arithmeticUniversalCoefficientMap ℓ k G.S (arithmeticCentralFull ℓ k G hcurve)
      I (centralH1Equiv ℓ k G hcurve (centralKummer G hdiv P) ⊗ₜ[ℤ_[2]] d) = δ P d)
    (hδ : ∀ d, δ gen d = 0 → d = 0) :
    IsFreeLineGenerator ℤ_[2] (centralKummer G hdiv gen) := by
  have := F.finite_one
  have h1 := hκ_arithmetic ℓ k G.S (arithmeticCentralFull ℓ k G hcurve) hk I F hSel
    ((centralH1Equiv ℓ k G hcurve).toLinearMap.toAddMonoidHom.comp (centralKummer G hdiv)) gen δ
    hcomp hδ
  have h2 := h1.map_linearEquiv (centralH1Equiv ℓ k G hcurve).symm
  simpa using h2

end Central

end ZInQ.Contrib.CloudB3E2.KappaGen
